--@name schedprobe
--@version 0.0.2
--@deps
--@description real-machine probe: which kind of load starves the other terminals (test image only)
--[[ 用户实测: 抢占模式下 `find /` 会让**其他终端**卡死。这里把 `find /` 拆成两半分别压:
       A) 只走全树(等价 `find` 的文件系统调用, 不输出)
       B) 只往自己的 tty 狂写(等价 `find` 的输出路径)
       C) 两者一起(= 真正的 `find /`)
     每秒记一行: 合成事件投递延迟、每轮调度 CPU、以及**等 tty 输入的那些进程每秒被恢复了多少次**
     (读键盘的进程被恢复多少次 = 终端还能不能响应)。结果写电脑自带存储 /sched.log。

     抢占从引导就开着(boot 的 /etc/preempt), 这里不再切模式。 ]]

local function initModule()
    local fs = _G.fs
    local now = os.epoch
    local process = require("kernel.process")
    -- 标记文件写在**进程的 VFS 根**(ext2 root)上, 所以判据也要用同一个门面 ——
    -- 内核上下文里的 _G.fs 是电脑自带存储(CC 原生 fs), 两个不是一个地方(踩过)。
    local vfsfs = require("kernel.vfs_api").fs

    local lines = {}
    local function say(s) lines[#lines + 1] = s end
    local function flush()
        local f = fs.open("/sched.log", "w")
        if f then f.write(table.concat(lines, "\n") .. "\n"); f.close() end
    end

    ------------------------------------------------------------------
    -- 负载
    ------------------------------------------------------------------
    local SRC_WALK = [[
-- 走全树(等价 find / 的 fs 调用), 不输出
local function walk(p, acc)
    local ok, names = pcall(fs.list, p)
    if not ok or type(names) ~= "table" then return acc end
    for i = 1, #names do
        local c = (p == "/") and ("/" .. names[i]) or (p .. "/" .. names[i])
        local ok2, a = pcall(fs.attributes, c)
        if ok2 and a and a.isDir then acc = walk(c, acc) else acc = acc + 1 end
    end
    return acc
end
local t = os.epoch("utc")
local n = 0
while os.epoch("utc") - t < 14000 do n = walk("/", n) end
-- 跑完了就留个标记(探针据此判断"有没有进程永久停在等锁上")
if args and args[1] then
    local f = fs.open("/tmp/sched_mark_" .. args[1], "w")
    if f then f.write("done\n"); f.close() end
end
return n
]]
    local SRC_OUT = [[
-- 往自己的 stdout(= 控制台 tty)狂写: 等价 find 的输出路径
local t = os.epoch("utc")
local i = 0
while os.epoch("utc") - t < 14000 do
    i = i + 1
    io.write("/usr/share/some/quite/long/path/entry-" .. i .. ".txt\n")
end
return i
]]

    local loads = {}
    local function startLoad(src, name, tag)
        local argv = { [0] = name }
        if tag then argv[1] = tag end
        local pid = process.spawn(src, name, 1, 0, 0, argv, nil)
        if pid then loads[#loads + 1] = pid; say("load " .. name .. " pid=" .. pid) end
    end
    --- 等锁挂死的探测器: 数一数有几个 walker 留了"跑完"标记
    local function marks(prefix, n)
        local got = 0
        for i = 1, n do
            if vfsfs.exists("/tmp/sched_mark_" .. prefix .. i) then got = got + 1 end
        end
        return got
    end
    local function killLoads()
        local n = 0
        for _, p in ipairs(process.list()) do
            if tostring(p.name or ""):sub(1, 5) == "sched" then p.sig.pending[9] = true; n = n + 1 end
        end
        return n
    end

    ------------------------------------------------------------------
    -- 统计: 事件延迟 + 每轮 CPU + 每个进程被恢复的次数
    ------------------------------------------------------------------
    local acc = {} -- co -> {ms=, n=}
    local origResume = coroutine.resume
    local wrappedResume
    wrappedResume = function(co, ...)
        local t0 = now("utc")
        local a, b, c, d, e = origResume(co, ...)
        local dt = now("utc") - t0
        local r = acc[co]
        if r then r.ms = r.ms + dt; r.n = r.n + 1 else acc[co] = { ms = dt, n = 1 } end
        return a, b, c, d, e
    end
    coroutine.resume = wrappedResume

    local passN, passSum = 0, 0
    local latSum, latN, latMax = 0, 0, 0
    local pend = nil
    local lastReturn = nil
    local armedAt, bootAt = now("utc"), nil
    local phase, lastTick = 0, nil

    --- 等 tty 输入的那些进程(login/sh/lua): 报"被恢复次数最少"的那个 —— 那就是终端卡不卡。
    local function readerStats()
        local byCo = {}
        for _, p in ipairs(process.list()) do byCo[p.co] = p end
        local worst, worstN = "-", nil
        local total = 0
        for co, r in pairs(acc) do
            local p = byCo[co]
            if p then
                total = total + r.n
                local nm = tostring(p.name)
                if nm:find("login") or nm:find("sh") or nm:find("desh") or nm:find("lua") then
                    if worstN == nil or r.n < worstN then worst, worstN = nm .. "(" .. p.pid .. ")", r.n end
                end
            end
        end
        return worst ~= "-" and (worst .. "=" .. worstN .. "/s") or "none", total
    end

    local function report(t)
        local reader, totalResumes = readerStats()
        say(string.format("t=%3ds lat=%6.1f max=%5d npass=%4d workavg=%5.1f resumes=%4d reader[%s] procs=%d",
            math.floor((t - bootAt) / 1000), latN > 0 and (latSum / latN) or -1, latMax, passN,
            passN > 0 and (passSum / passN) or 0, totalResumes, reader, #process.list()))
        passN, passSum, latSum, latN, latMax = 0, 0, 0, 0, 0
        acc = {}
    end

    local function step(t)
        if not bootAt then
            if not process.info(1) then return end
            bootAt = t
            say("== 终端饥饿探针(抢占模式) ==")
            say("preempt=" .. tostring(require("kernel.scheduler").preemptActive()))
        end
        local el = t - bootAt
        if not lastTick or t - lastTick >= 1000 then
            lastTick = t
            if pend then say(string.format("t=%3ds !! 上一秒的事件 >1s 没回来", math.floor(el / 1000))); pend = nil end
            report(t)
            pend = { t0 = t, tag = "findping" }
            os.queueEvent("findping")
        end
        if phase == 0 and el >= 3000 then
            phase = 1; say("-- A: 只走全树(等价 find 的 fs 调用, 无输出) --"); startLoad(SRC_WALK, "schedwalkA")
        elseif phase == 1 and el >= 20000 then
            phase = 2; say("-- 杀 A(" .. killLoads() .. ") / B: 只往 tty 狂写(等价 find 的输出) --")
            startLoad(SRC_OUT, "schedoutB")
        elseif phase == 2 and el >= 37000 then
            phase = 3; say("-- 杀 B(" .. killLoads() .. ") / C: 两者一起(= 真正的 find /) --")
            startLoad(SRC_WALK, "schedwalkC1"); startLoad(SRC_OUT, "schedoutC2")
        elseif phase == 3 and el >= 54000 then
            phase = 4
            say("-- D: 3 个走全树的进程同时压(等价两个 tty 同时 find /, 制造内核锁竞争) --")
            for i = 1, 3 do startLoad(SRC_WALK, "schedwD" .. i, "D" .. i) end
        elseif phase == 4 and el >= 78000 then
            phase = 5
            local got = marks("D", 3)
            say(string.format("-- D 结束: 跑完的 walker = %d/3 %s --", got,
                got == 3 and "(没有进程停在等锁上)" or "**有进程没跑完 -> 疑似等锁挂死**"))
            say("-- 收尾: 杀掉 " .. killLoads() .. " 个负载 --")
            report(t)
            say(string.format("-- 收尾后仍在的负载: %d 个(应为 0) --", killLoads()))
            flush()
            local d = fs.open("/tmp/findprobe_done", "w")
            if d then d.write("done\n"); d.close() end
            if os.pullEventRaw == wrapper then os.pullEventRaw = pull end
            if coroutine.resume == wrappedResume then coroutine.resume = origResume end
            return
        end
    end

    local pull = os.pullEventRaw
    local wrapper
    local mainCo = coroutine.running()
    wrapper = function(...)
        if coroutine.running() ~= mainCo then return pull(...) end
        local tEnter = now("utc")
        if lastReturn then
            local d = tEnter - lastReturn
            passN = passN + 1; passSum = passSum + d
        end
        local r = table.pack(pull(...))
        local tReturn = now("utc")
        lastReturn = tReturn
        if pend and r[1] == pend.tag then
            local lat = tReturn - pend.t0
            latN = latN + 1; latSum = latSum + lat
            if lat > latMax then latMax = lat end
            pend = nil
        end
        if phase < 5 then
            local ok, err = pcall(step, now("utc"))
            if not ok then
                say("STEP ERROR: " .. tostring(err)); flush(); phase = 5
                if os.pullEventRaw == wrapper then os.pullEventRaw = pull end
            end
        end
        return table.unpack(r, 1, r.n)
    end
    os.pullEventRaw = wrapper
    say("findprobe armed (preempt mode expected)")
end

return { init = initModule }
