--@name watchprobe
--@version 0.0.1
--@deps
--@description real-machine watchdog: log any interactive process that stops being scheduled (test image only)
--[[ 用途: 用户复现"提示符不回来"时(整机正常、光标在闪、别的 tty 能用), 自动留下现场 ——
     不需要用户抄屏, 也不依赖那个卡住的进程自己会写日志。

     判据: 一个交互进程(名字像 sh/login/lua/desh)多久没有被调度器 resume 过。
       正常: 等输入(裸 pullEvent)每来一个事件就被唤醒 -> gap 几十毫秒;
             等子进程(pollWait 的 os.sleep(0.05)) -> gap ~50ms。
       异常: gap 持续 > 3s -> 说明它停在一个永远等不到的东西上(记录它最后 yield 出去的 filter,
             那个 filter 就是答案: "__lock"=等内核锁 / "hse_wake"=等 HSE 拍 / "timer"=等定时器 /
             其它字符串=等某个事件 / nil=在裸等)。

     输出: 电脑自带存储的 /watchdog.log(宿主机 /mnt/computer/3/watchdog.log 直接可读),
     每 30s 一行心跳(证明看门狗自己在跑), 命中异常时把整张进程表 + 每个 tty 的行规程状态写下来。 ]]

local function initModule(kapi)
    local fs = _G.fs
    local now = os.epoch
    local process = require("kernel.process")
    local tty = require("kernel.tty")

    local bootT0 = now("utc") -- 注意: 必须在任何使用它的闭包**之前**声明(否则解析成全局 nil, 踩过)
    local lines = {}
    local function say(s) lines[#lines + 1] = s end
    local function flush()
        local f = fs.open("/watchdog.log", "w")
        if f then f.write(table.concat(lines, "\n") .. "\n"); f.close() end
    end

    -- 记录每个协程最后一次被 resume 的时刻与它上次 yield 出去的 filter
    local lastAt, lastYield = {}, {}
    local origResume = coroutine.resume
    local wrappedResume
    wrappedResume = function(co, ...)
        local r = table.pack(origResume(co, ...))
        lastAt[co] = now("utc")
        if coroutine.status(co) == "suspended" then lastYield[co] = tostring(r[2]) end
        return table.unpack(r, 1, r.n)
    end
    coroutine.resume = wrappedResume

    local sc = require("kernel.modules").syscalls()
    local lock = require("kernel.lock")

    -- 输出出口计数: storm 到底从哪条路把字吐出去的
    local sink = { write = 0, print = 0, termwrite = 0, stdio = 0 }
    do
        local w0, p0 = _G.write, _G.print
        _G.write = function(...) sink.write = sink.write + 1; return w0(...) end
        _G.print = function(...) sink.print = sink.print + 1; return p0(...) end
        if _G.term and _G.term.write then
            local t0 = _G.term.write
            _G.term.write = function(...) sink.termwrite = sink.termwrite + 1; return t0(...) end
        end
        local vapi = require("kernel.vfs_api")
        local stdio = vapi.getStdio and vapi.getStdio()
        if stdio and stdio.output and stdio.output.write then
            local s0 = stdio.output.write
            stdio.output.write = function(...) sink.stdio = sink.stdio + 1; return s0(...) end
        end
    end
    local reports = {}
    kapi.registerSyscall("watch.report", function(who, what)
        reports[#reports + 1] = tostring(who) .. ": " .. tostring(what)
        return true
    end)
    local infoRing = {}
    do
        local origInfo = sc["proc.info"]
        sc["proc.info"] = function(pid)
            local cur = require("kernel.process").current()
            local p = origInfo(pid)
            if #infoRing > 24 then table.remove(infoRing, 1) end
            infoRing[#infoRing + 1] = string.format("by=%s ask=%s -> %s st=%s",
                cur and tostring(cur.pid) or "?", tostring(pid), p and "yes" or "nil",
                p and tostring(p.status) or "-")
            return p
        end
    end

    local function sinkStat()
        return string.format("sink[w=%d print=%d term=%d stdio=%d] lock[%s on=%s inproc=%s] rep=%d",
            sink.write, sink.print, sink.termwrite, sink.stdio, tostring(lock),
            tostring(lock.preemptOn()), tostring(lock.inProcess()), #reports)
    end

    local function tickStat()
        local ok, p = pcall(require, "kernel.procenv")
        if not ok or not p then return "tick=?" end
        return string.format("tick[calls=%s yields=%s]", tostring(p.tickCalls), tostring(p.tickYields))
    end

    local function hseStat()
        local ok, st = pcall(function() return sc["hse.stat"]() end)
        if not ok or type(st) ~= "table" then return "hse.stat=?" end
        return string.format("hse[waiters=%s clock=%.1f]", tostring(st.waiters), tonumber(st.clockMs) or -1)
    end

    ------------------------------------------------------------------
    -- 显示路径 bench(回答"为什么 find / 会卡死整机"): 往每个 tty 写 60 行(会滚动/整屏重画),
    -- 量各自要多久 —— 像素设备(台式机上 tty2 = Tom GPU)每格 2 次外设调用, 一次滚屏近千格。
    ------------------------------------------------------------------
    --- 设备路径 bench: `find /` 会 stat /dev 下的节点; 若那一步去枚举所有外设
    --- (含 modem 枢纽后面的远端驱动器, 每次 disk.* 都是网络往返), 整机就会同步卡住几秒。
    local devBenchDone = false
    local function devBench()
        devBenchDone = true
        local vfs = require("kernel.vfs_api")
        local cases = {
            { "fs.attributes(/dev)", function() return vfs.fs.attributes("/dev") end },
            { "fs.attributes(/dev/sda)", function() return vfs.fs.attributes("/dev/sda") end },
            { "fs.attributes(/dev/sda1)", function() return vfs.fs.attributes("/dev/sda1") end },
            { "fs.list(/dev)", function() return vfs.fs.list("/dev") end },
            { "fs.list(/sys)", function() return vfs.fs.list("/sys") end },
            { "blkdev.list()", function() return sc["blkdev.list"]() end },
            { "blkdev.list() again", function() return sc["blkdev.list"]() end },
        }
        for _, c in ipairs(cases) do
            local t0 = now("utc")
            local ok, r = pcall(c[2])
            local n = (type(r) == "table") and #r or -1
            say(string.format("DEVBENCH %-22s = %5dms ok=%s n=%d", c[1], now("utc") - t0,
                tostring(ok), n))
            flush()
        end
    end

    --- **输出风暴**回归: 一个进程狂写 stdout(= 控制台 tty)。修好之前, 它会连续几秒不让出 ->
    --- 别的进程 gap 涨到秒级、它自己被 CC watchdog 杀掉; 修好之后 gap 应该一直很小。
    local stormDone, stormB = false, false
    local function stormB()
        stormB = true
        local SRC = [[
local t = os.epoch("utc")
local f = fs.open("/dev/tty0", "w")
if not f then return -1 end
local i = 0
while os.epoch("utc") - t < 6000 do
    i = i + 1
    f:write("stormB line " .. i .. " abcdefghijklmnopqrstuvwxyz\n")
end
f:close()
return i
]]
        local pid = process.spawn(SRC, "stormB", 1, 0, 0, { [0] = "stormB" }, nil)
        say("STORMB (写 /dev/tty0) started pid=" .. tostring(pid))
        flush()
    end

    local function storm()
        stormDone = true
        local SRC = [[
local out = io.stdout()
syscalls["watch.report"]("storm", "stdio=" .. tostring(out) .. " hasWrite=" .. tostring(out ~= nil and out.write ~= nil))
local t = os.epoch("utc")
local i = 0
while os.epoch("utc") - t < 6000 do
    i = i + 1
    io.write("storm line " .. i .. " abcdefghijklmnopqrstuvwxyz\n")
end
syscalls["watch.report"]("storm", "wrote=" .. i)
return i
]]
        local pid = process.spawn(SRC, "storm", 1, 0, 0, { [0] = "storm" }, nil)
        say("STORM started pid=" .. tostring(pid))
        flush()
    end

    local benchDone = false
    local function bench()
        benchDone = true
        for _, name in ipairs({ "tty0", "tty1", "tty2" }) do
            local h = tty.open(name)
            if h then
                local t0 = now("utc")
                local ok, err = pcall(function()
                    for i = 1, 60 do h:write("bench line " .. i .. " abcdefghijklmnopqrstuvwxyz\n") end
                end)
                say(string.format("BENCH %s: 60 行 = %dms ok=%s %s", name, now("utc") - t0,
                    tostring(ok), ok and "" or tostring(err)))
                flush()
            else
                say("BENCH " .. name .. ": 打不开")
            end
        end
    end

    local function interesting(name)
        return name:find("login") or name:find("sh") or name:find("lua") or name:find("desh")
    end

    --- 该 tty 的前台进程组(^C/^Z 就是发给它的)。
    local function fgPgrp(name)
        local ok, process = pcall(require, "kernel.process")
        if not ok then return "?" end
        local ok2, p = pcall(process.tcgetpgrp, name)
        return ok2 and tostring(p) or "?"
    end

    local function ttyState(name)
        local c = tty.get(name)
        if not c then return name .. "=(none)" end
        return string.format("%s{raw=%s rd=%s q=%d buf=%d kb=%d fg=%s}", name,
            tostring(c.raw), tostring(c.reading), #c.lineQueue, #c.inputBuffer, #c.keyBuf,
            fgPgrp(name))
    end

    local alerted = {}
    local heartbeatAt, lastCheck = nil, nil

    local function check(t)
        -- 第一次进来只是记基准(写 `if not lastCheck then return end` 又不赋值 = 永远不干活, 踩过)
        if not lastCheck then lastCheck = t; heartbeatAt = t; return end
        if t - lastCheck < 1000 then return end
        lastCheck = t
        local bad = {}
        for _, p in ipairs(process.list()) do
            local nm = tostring(p.name)
            if interesting(nm) then
                local at = lastAt[p.co]
                local gap = at and (t - at) or -1
                if gap > 1200 then
                    bad[#bad + 1] = { pid = p.pid, name = nm, gap = gap,
                                      y = lastYield[p.co], p = p }
                end
            end
        end
        if #bad > 0 then
            say(string.format("!! t=%dms 有 %d 个交互进程超过 3s 没被调度:", t, #bad))
            for _, b in ipairs(bad) do
                say(string.format("   pid=%s %s gap=%dms lastYield=%s", tostring(b.pid), b.name,
                    b.gap, tostring(b.y)))
            end
            say("   focus=" .. tostring(tty.getFocus()) .. " " .. ttyState("tty0") .. " "
                .. ttyState("tty1") .. " " .. ttyState("tty2"))
            for _, p in ipairs(process.list()) do
                say(string.format("   pid=%-4d %-14s ppid=%-4s pgrp=%-4s sid=%-4s st=%-8s y=%s",
                    p.pid, tostring(p.name), tostring(p.ppid), tostring(p.pgrp), tostring(p.sid),
                    tostring(p.status), tostring(lastYield[p.co])))
            end
            say("   " .. hseStat())
            for _, l in ipairs(infoRing) do say("   info| " .. l) end
            flush() -- 立刻落盘, 免得整机真的卡死时丢现场
        end
        if not devBenchDone and t - bootT0 > 20000 then devBench() end
        if not stormDone and t - bootT0 > 15000 then storm() end
        if not stormB and t - bootT0 > 30000 then stormB() end
        if not benchDone and t - bootT0 > 45000 then bench() end
        if not heartbeatAt or t - heartbeatAt > 5000 then
            heartbeatAt = t
            say(string.format("t=%dms heartbeat procs=%d bad=%d focus=%s %s %s %s", t, #process.list(),
                #bad, tostring(tty.getFocus()), ttyState("tty0"), ttyState("tty2"),
                hseStat() .. " " .. tickStat() .. " " .. sinkStat()))
            for _, p in ipairs(process.list()) do
                local at = lastAt[p.co]
                say(string.format("   pid=%-4d %-14s ppid=%-4s pgrp=%-4s sid=%-4s st=%-8s y=%-10s gap=%sms",
                    p.pid, tostring(p.name), tostring(p.ppid), tostring(p.pgrp), tostring(p.sid),
                    tostring(p.status), tostring(lastYield[p.co]),
                    at and tostring(t - at) or "-"))
            end
            -- proc.info 轨迹: 交互 shell 卡在"等子进程"时, 这里能看见它在问谁、内核答的什么状态
            for _, l in ipairs(infoRing) do say("   info| " .. l) end
            if #infoRing > 0 then infoRing = {} end
            for _, l in ipairs(reports) do say("   rep| " .. l) end
            reports = {}
            flush()
        end
    end

    local pull = os.pullEventRaw
    local wrapper
    local mainCo = coroutine.running()
    local t0 = now("utc")
    wrapper = function(...)
        if coroutine.running() ~= mainCo then return pull(...) end
        local r = table.pack(pull(...))
        local ok, err = pcall(check, now("utc"))
        if not ok then say("CHECK ERROR: " .. tostring(err)); flush() end
        return table.unpack(r, 1, r.n)
    end
    os.pullEventRaw = wrapper
    say("watchdog armed (threshold 1200ms, table+info trace every 5s)")
    flush()
end

return { init = initModule }
