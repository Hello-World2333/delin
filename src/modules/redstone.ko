--@name redstone
--@version 0.2.0
--@description CC 红石驱动: /sys/class/redstone/<side>/{digital,analog,bundled}; 三个属性一律
--             读 = 该面输入, 写 = 该面输出。
--@deps

--[[ 抽象(对齐 Linux gpio 的 sysfs 接口 /sys/class/gpio/gpioN/{direction,value}):
      CC 的红石 API 是函数式的(redstone.getInput(side) / redstone.setAnalogOutput(side, v)),
      本驱动把它摊成文件 —— 每个面一个目录, 属性文件是单行值, 读一次即 EOF(sysfs 语义)。
      每个面**只有三个**属性, 一个红石量一个文件, 读和写都落在同一个文件上:

        /sys/class/redstone/<side>/digital   读 0|1      (getInput)  写 0|1      (setOutput)
        /sys/class/redstone/<side>/analog    读 0..15    (getAnalogInput) 写 0..15 (setAnalogOutput)
        /sys/class/redstone/<side>/bundled   读 0..65535 (getBundledInput) 写 0..65535 (setBundledOutput)

      不设 input/output 变体: 一个面的一种红石量就是一个文件, 读是"线上的值"(输入),
      写是"我驱动的值"(输出) —— 与真实红石口一样, 口本身没有第二个文件。

      于是 shell 里就是 `cat /sys/class/redstone/left/analog` 与
      `echo 15 > /sys/class/redstone/left/analog`, 不需要 Lua 也不需要任何工具。

      语义与 CC 一致: digital 与 analog 的**输出**侧是同一份状态 —— 写 digital=1 后
      setAnalogOutput 得 15(CC 的 setOutput(true) 等价于 setAnalogOutput(15)), 写 analog=0
      后 getOutput 为 false。bundled 用十进制位掩码(colors.white=1 .. colors.black=32768),
      与 colors.combine/subtract 对齐。

      读的是**输入**(getInput/getAnalogInput/getBundledInput): 线对面接的是什么, 读到的就是什么;
      CC 的 getOutput/getAnalogOutput/getBundledOutput(本机自己驱动了什么)没有对应文件,
      要读它就写脚本用 CC 的 redstone API(用户态进程白名单里有 redstone)。

      写校验 fail-fast: 值必须是十进制整数且在范围内, 否则返回错误且**不改动**输出状态
      (属性文件是内核接口, 不做 "0x10"/"1e2"/负数/小数的模糊解析)。六个面恒定存在
      (CC 电脑六面都能收发红石), 因此没有 Linux gpio 的 export/unexport, 也没有只读属性。 ]]

local ATTRS = { "digital", "analog", "bundled" }

local SIDES = nil

--- 六个面的稳定顺序(按名排序, 使 ls /sys/class/redstone 与真机/宿主一致)。
local function sides()
    if not SIDES then
        local out = {}
        for _, s in ipairs(redstone.getSides()) do out[#out + 1] = s end
        table.sort(out)
        SIDES = out
    end
    return SIDES
end

local function isSide(entry)
    for _, s in ipairs(sides()) do
        if s == entry then return true end
    end
    return false
end

--- 解析属性值: 严格十进制整数, 0..max。
---@return number|nil, string|nil
local function parseValue(value, max, what)
    local text = tostring(value)
    local n = text:match("^%d+$") and tonumber(text) or nil
    if not n or n > max then
        return nil, "invalid " .. what .. ": '" .. text .. "' (expected decimal integer 0.." .. max .. ")"
    end
    return n
end

--- 读属性 = 该面的输入(getInput/getAnalogInput/getBundledInput)。
local function get(entry, attr)
    if attr == "digital" then return redstone.getInput(entry) and "1" or "0" end
    if attr == "analog" then return tostring(redstone.getAnalogInput(entry)) end
    if attr == "bundled" then return tostring(redstone.getBundledInput(entry)) end
    return nil
end

--- 写属性 = 设该面的输出(setOutput/setAnalogOutput/setBundledOutput)。
local function set(entry, attr, value)
    if attr == "digital" then
        local n, err = parseValue(value, 1, "digital")
        if not n then return nil, err end
        redstone.setOutput(entry, n == 1)
        return true
    end
    if attr == "analog" then
        local n, err = parseValue(value, 15, "analog")
        if not n then return nil, err end
        redstone.setAnalogOutput(entry, n)
        return true
    end
    if attr == "bundled" then
        local n, err = parseValue(value, 65535, "bundled")
        if not n then return nil, err end
        redstone.setBundledOutput(entry, n)
        return true
    end
    return nil, "no such attribute: " .. tostring(attr)
end

local activeKapi = nil

return {
    init = function(kapi)
        activeKapi = kapi
        kapi.registerSysfsClass("redstone", {
            list = function() return sides() end,
            attrs = function(entry)
                if not isSide(entry) then return nil end
                return ATTRS
            end,
            get = get,
            set = set,
        })
        kapi.log("redstone: /sys/class/redstone registered (" .. #sides() .. " sides)")
    end,

    exit = function()
        if not activeKapi then return end
        activeKapi.unregisterSysfsClass("redstone")
        activeKapi = nil
    end,
}
