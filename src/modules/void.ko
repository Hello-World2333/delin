--@name void
--@version 0.1.0
--@description Void PowerMod hologram display driver (0-based; unified ARGB -> 8bit index translation).
--@deps

local function toVoidColor(c)
    -- ARGB(0xAARRGGBB) -> Void 8 位 RRGGBBAA(每通道 2bit, 映射[0,90,180,255])。
    -- 先量化每个 8bit 通道到最近映射等级, 再打包。
    c = c or 0
    local map = { 0, 90, 180, 255 }
    local function q(v)
        local best, bi = 0, 0
        for i = 1, 4 do
            local d = math.abs(v - map[i])
            if i == 1 or d < best then best, bi = d, i - 1 end
        end
        return bi
    end
    local r = q(math.floor(c / 65536) % 256)
    local g = q(math.floor(c / 256) % 256)
    local b = q(c % 256)
    local a = q(math.floor(c / 16777216) % 256)
    return r * 64 + g * 16 + b * 4 + a
end

return {
    init = function(kapi, device)
        local side = device
        local hol = peripheral.wrap(side)

        local w, h = 256, 192
        local okFb, fb = pcall(hol.allocateFrameBuffer, w, h)
        if not okFb or not fb then
            kapi.log("void: allocateFrameBuffer failed (" .. tostring(fb) .. ")")
            return
        end
        pcall(hol.activateFrameBuffer, fb)
        pcall(hol.setScale, 1)
        pcall(hol.setRotation, 0, 0, 0)
        pcall(hol.setColorMapping, 0, 90, 180, 255)
        kapi.log("void: hologram fb=" .. tostring(fb) .. " " .. w .. "x" .. h)

        -- 投影配置状态(外设无 getter, 由驱动缓存)
        local cfg = { offset = { x = 0, y = 0, z = 0 }, rotation = { yaw = 0, pitch = 0, roll = 0 }, scale = 1 }

        local dev = {
            id = "void:" .. side,
            type = "hologram",
            mode = "pixel",        -- 像素帧缓冲: /dev/ttyN + /dev/fbN
            cellW = 6, cellH = 8,  -- 字格(px)
            name = side,
            device = hol,
            fb = fb,
            width = w, height = h,
            getSize = function() return w, h end,
            blit = function(x, y, text, fg, bg) pcall(hol.drawText, x, y, text, toVoidColor(fg or 0xFFFFFF), 1) end,
            text = function(x, y, s, fg, bg) pcall(hol.drawText, x, y, s, toVoidColor(fg or 0xFFFFFF), 1) end,
            fill = function(color) pcall(hol.fill, 0, 0, w, h, toVoidColor(color or 0), 0) end,
            setPixel = function(x, y, color) pcall(hol.drawPixel, x, y, toVoidColor(color or 0)) end,
            rect = function(x, y, w2, h2, color)
                if w2 > 0 and h2 > 0 then pcall(hol.fill, x, y, w2, h2, toVoidColor(color or 0), 0) end
            end,
            -- 可配置项(sysfs): 投影位置/旋转/缩放
            listConfig = function() return { "offset", "rotation", "scale" } end,
            getConfig = function(attr)
                if attr == "offset" then return string.format("%s %s %s", cfg.offset.x, cfg.offset.y, cfg.offset.z)
                elseif attr == "rotation" then return string.format("%s %s %s", cfg.rotation.yaw, cfg.rotation.pitch, cfg.rotation.roll)
                elseif attr == "scale" then return tostring(cfg.scale)
                elseif attr == "size" then return w .. "x" .. h end
                return nil
            end,
            setConfig = function(attr, value)
                local v = (value or ""):gsub("^%s*(.-)%s*$", "%1")
                if attr == "offset" then
                    local x, y, z = v:match("^(%-?%d+%.?%d*)%s+(%-?%d+%.?%d*)%s+(%-?%d+%.?%d*)$")
                    if not x then return nil, "bad offset (expected 'x y z')" end
                    cfg.offset = { x = tonumber(x), y = tonumber(y), z = tonumber(z) }
                    pcall(hol.setOffset, cfg.offset.x, cfg.offset.y, cfg.offset.z)
                    return true
                elseif attr == "rotation" then
                    local yaw, pitch, roll = v:match("^(%-?%d+%.?%d*)%s+(%-?%d+%.?%d*)%s+(%-?%d+%.?%d*)$")
                    if not yaw then return nil, "bad rotation (expected 'yaw pitch roll')" end
                    cfg.rotation = { yaw = tonumber(yaw), pitch = tonumber(pitch), roll = tonumber(roll) }
                    pcall(hol.setRotation, cfg.rotation.yaw, cfg.rotation.pitch, cfg.rotation.roll)
                    return true
                elseif attr == "scale" then
                    local s = tonumber(v)
                    if not s then return nil, "bad scale (expected number)" end
                    cfg.scale = s
                    pcall(hol.setScale, s)
                    return true
                end
                return nil, "read-only or unknown config: " .. tostring(attr)
            end,
            -- sync 每 tick 只生效一次, 同 tick 内重复调用浪费时间。
            -- 用 os.clock() 去重: 同 0.05s 窗口内只 sync 一次。
            flush = (function()
                local lastSync = 0
                return function()
                    local now = os.clock()
                    if now - lastSync < 0.05 then return end
                    lastSync = now
                    pcall(hol.sync)
                end
            end)(),
            release = function() pcall(hol.releaseFrameBuffer, fb) end,
        }
        kapi.registerDisplay(dev)
        kapi.log("void: display '" .. dev.id .. "' registered (" .. w .. "x" .. h .. ")")
    end,
}
