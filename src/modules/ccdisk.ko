--@name ccdisk
--@version 0.2.0
--@description CC native filesystem driver: registers the ccdisk fstype (whole disk /dev/sda, or any CC fs path) plus the legacy mount.ccdisk syscall.
--@deps

local vfs = require("kernel.vfs")

return {
    init = function(kapi)
        -- fstype 处理器: source.ccpath = CC fs 真实路径(整盘设备 /dev/sda 的 mount path)。
        kapi.registerFstype("ccdisk", function(source)
            return vfs.real(source.ccpath)
        end)
        -- 兼容旧接口: 把任意 CC fs 路径挂到 VFS 目录。
        kapi.registerSyscall("mount.ccdisk", function(realPath, mountPath)
            vfs.mount(mountPath, vfs.real(realPath))
            return true
        end)
        kapi.log("ccdisk: fstype registered (mount -t ccdisk /dev/sda DIR)")
    end,
}
