--@name cc_hse
--@version 0.5.0
--@description HSE clock acceleration: dedicated pump process owns waitNextTick and wakes every os.msleep waiter at its deadline
--@deps

--[[ HSE 时钟加速(亚刻精度的 os.msleep)。

     结构(一个泵 + 一群等待者):
       1) **泵进程**: 内核在第一次有人要睡时 spawn 一个独立进程(`hse-pump`), 只有它调
          waitNextTick()。它把读到的拍累加进一条**全系统共享的单调时钟**, 每推进一次就
          queue 一个 "hse_wake" 事件。没有等待者时不推进(去 os.sleep(0.05) 歇着), 所以既不
          白烧 CPU, 也不会像 2kHz 推模式那样淹事件队列(上限 256, CC 对满队列是静默丢弃)。
       2) **等待者**: 进程侧 os.msleep(ms) 只算自己的 deadline, 然后 `pulledEvent("hse_wake")`
          让出, 醒来重新判定(condition-variable 风格)。进程侧**永不碰**那个外设计数器。

     为什么不能各自去等: hse.waitNextTick() 返回「距上一次调用过了多少拍」, 那个计数器是
     **以外设为单位**记的、读后即清 —— 只允许一个读者(用户指出的, 实测证实): 各自去等的时候,
     单进程 7.6ms/次, 三个进程同时 49.5ms/次, 而且**并发之后单进程仍然 49ms**(粘性)。

     实测(电脑 #3, 干净镜像; 每项是 10 次 os.msleep(0) 的累计耗时):
       单进程  : ~24ms/次     三个进程同时: ~29ms/次(三者完全同步, 谁也不吃亏)
       并发之后: ~29ms/次 —— 没有 0.3.0 那种"并发过后整机钉在 50ms"的粘性退化
     比 0.3.0 的单进程(6-8ms)慢, 因为多了一跳: 等待者 -> 泵(等拍) -> 事件 -> 等待者;
     实测每多一次"调度器往返"就多 ~6-10ms(这也是为什么进程侧拿不到 2ms 级的睡眠)。
     换来的是一致性: **所有等待者同等精度, 没有互斥, 也没有互相偷拍**。

     坑(记下来): 模块在 init 里 spawn 会**抢走 pid 1**(实测进程表 `1:hse-pump 2:init`),
     因为模块装载早于 init —— 所以泵必须**延迟到第一次有人要睡时**再 spawn, ppid 显式给 1。
     (0.4.0 挂在 pid 1 被抢, 现象是工具完全不响应; 0.4.1 改成延迟 spawn 之后就正常了。) ]]

local FREQ = 2000            -- Hz, 每拍 0.5ms
local TICK_MS = 1000 / FREQ

--- 泵进程的程序(内核进程, 只调模块注册的那两个 syscall)。
local PUMP_SRC = [[
local sc = syscalls
while true do
    if not sc["hse.pump"]() then
        sc["hse.idle"]()
    end
end
]]

return {
    init = function(kapi, device)
        local log = kapi.log
        -- 内核临界区锁(抢占式调度): 外设调用/等待都可能是让出点, 持锁让出会把锁焊死。
        local lock = require("kernel.lock")
        local hse = peripheral.wrap(device)
        if not hse then
            error("cc_hse: cannot wrap peripheral '" .. tostring(device) .. "'", 2)
        end
        if type(hse.waitNextTick) ~= "function" then
            error("cc_hse: peripheral has no waitNextTick (need pull-mode cc_hse)", 2)
        end

        hse.setFrequency(FREQ)
        hse.setPushEvents(false)
        hse.setOn(true)
        log("cc_hse: pull mode on " .. device .. " @ " .. FREQ .. "Hz (pushEvents=false)")

        local pulledEvent = os.pullEvent    -- 模块持有的内核态引用(进程环境里没有它)
        local queueEvent = os.queueEvent
        local realSleep = os.sleep

        local clockMs = 0
        local waiters = 0
        local pumpPid = nil

        --- 泵一拍: 推进共享时钟 + 唤醒所有等待者。
        local function hsePump()
            if waiters <= 0 then return false end
            -- waitNextTick 会挂起电脑(实测: 挂起期间别的协程会跑起来), 所以它是个让出点。
            local elapsed = lock.pause(function() return hse.waitNextTick() end)
            if type(elapsed) ~= "number" or elapsed < 1 then elapsed = 1 end
            clockMs = clockMs + elapsed * TICK_MS
            queueEvent("hse_wake")
            return true
        end

        local function ensurePump()
            if pumpPid then return pumpPid end
            local process = require("kernel.process")
            -- 签名是 (src, name, ppid, uid, gid, argv, opts) —— **别漏 gid**: 漏了的话那个 argv
            -- 表会落到 gid 上, 进程的 gid 变成 table, /proc/<pid>/stat 随之写坏, 真机上表现为
            -- `ps` 输出为空(proc_test 里 ps_*_nonempty 全 ng)。
            pumpPid = process.spawn(PUMP_SRC, "hse-pump", 1, 0, 0, { [0] = "hse-pump" }, nil)
            log("cc_hse: pump process pid " .. tostring(pumpPid) .. " (single waitNextTick owner)")
            return pumpPid
        end

        --- 进程侧等待(跑在调用者的协程里, 所以 pulledEvent 让出的是这个进程)。
        local function hseWait(ms)
            ensurePump()
            local ticks = math.floor((ms or 0) * FREQ / 1000 + 0.5)
            if ticks < 4 then ticks = 4 end
            local wantMs = ticks * TICK_MS
            local deadline = clockMs + wantMs
            local t0 = os.epoch("utc")
            waiters = waiters + 1
            while clockMs < deadline do
                local ok = pcall(lock.pause, function() return pulledEvent("hse_wake") end)
                if not ok then break end -- pullEvent 不可用(理论上不会): 走下面的兜底
                if os.epoch("utc") - t0 > wantMs + 200 then
                    lock.pause(function() realSleep(math.max(wantMs, 1) / 1000) end)
                    break
                end
            end
            waiters = waiters - 1
            return true
        end

        kapi.registerSyscall("hse.pump", hsePump)
        kapi.registerSyscall("hse.idle", function() lock.pause(function() realSleep(0.05) end) end)
        kapi.registerSyscall("hse.now", function() return clockMs end)
        -- 诊断: 等待者计数 + 共享时钟 + 泵是否在推进(排查"等着 hse_wake 的进程几十秒不被唤醒")。
        kapi.registerSyscall("hse.stat", function()
            return { waiters = waiters, clockMs = clockMs, pumpPid = pumpPid }
        end)
        kapi.registerSyscall("hse.wait", hseWait)

        os.msleep = function(ms)
            ms = tonumber(ms) or 0
            if ms >= 50 then
                realSleep(ms / 1000)
                return
            end
            hseWait(ms)
        end
        os.hseClockMs = function() return clockMs end

        log("cc_hse: os.msleep installed (0.4.1: pump on first sleep, file-logged)")
    end,

    exit = function()
        for _, name in ipairs(peripheral.getNames()) do
            if peripheral.getType(name) == "cc_hse" then
                local hse = peripheral.wrap(name)
                if hse then pcall(hse.setOn, false) end
            end
        end
        os.msleep = nil
        os.hseClockMs = nil
    end,
}
