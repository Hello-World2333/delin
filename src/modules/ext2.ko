--@name ext2
--@version 0.1.0
--@description EXT2 filesystem module (read-only in phase A). Mounts the boot disk's first /parts/*.img onto the VFS.
--@deps

local blockdev = require("kernel.blockdev")
local ext2      = require("kernel.ext2")

local function findDiskImg()
    for _, name in ipairs(peripheral.getNames()) do
        if disk.hasData(name) then
            local mp = disk.getMountPath(name)
            if mp then
                local partsDir = mp .. "/parts"
                if fs.isDir(partsDir) then
                    for _, fi in ipairs(fs.list(partsDir)) do
                        if fi:match("%.img$") then
                            return partsDir .. "/" .. fi, mp
                        end
                    end
                end
            end
        end
    end
    return nil, nil
end

return {
    init = function(kapi)
        local imgPath = findDiskImg()
        if not imgPath then
            kapi.log("ext2: no /parts/*.img found on any disk")
            return
        end
        local bd, err = blockdev.file(imgPath)
        if not bd then
            kapi.log("ext2: blockdev failed for " .. imgPath .. ": " .. tostring(err))
            return
        end
        local fs, ferr = ext2.mount(bd)
        if not fs then
            kapi.log("ext2: mount failed: " .. tostring(ferr))
            return
        end
        -- 只读挂到 /mnt/ext2 (phase A; 后续由挂载系统决定根)
        kapi.registerFS("/mnt/ext2", ext2.backend(fs))
        kapi.log("ext2: mounted " .. imgPath .. " at /mnt/ext2 (blockSize=" .. fs.blockSize .. ")")
    end,
}
