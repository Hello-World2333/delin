--@name ext2
--@version 0.2.0
--@description EXT2 filesystem driver: registers the ext2 fstype for `mount -t ext2 /dev/sdXN DIR` (a partition is a /parts/*.img image on the disk).
--@deps

local blockdev = require("kernel.blockdev")
local ext2     = require("kernel.ext2")

return {
    init = function(kapi)
        -- fstype 处理器: source.img = 分区镜像的真实路径(由 devdisk 给出)。
        kapi.registerFstype("ext2", function(source, dir)
            local bd, err = blockdev.file(source.img)
            if not bd then return nil, tostring(err) end
            local rfs, ferr = ext2.mount(bd)
            if not rfs then
                bd.close()
                return nil, tostring(ferr)
            end
            -- 卸载时关闭块设备句柄(否则每次 mount 泄漏一个文件句柄)。
            return ext2.backend(rfs), { cleanup = function() bd.close() end }
        end)
        kapi.log("ext2: fstype registered (mount -t ext2 /dev/sdXN DIR)")
    end,
}
