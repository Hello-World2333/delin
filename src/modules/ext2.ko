--@name ext2
--@version 0.3.0
--@description EXT2 filesystem driver: registers the ext2 fstype for `mount -t ext2 /dev/sdXN DIR` (a partition is a /parts/*.img image on the disk; a /dev/mdN array is a byte device too).
--@deps

local ext2 = require("kernel.ext2")

return {
    init = function(kapi)
        -- fstype 处理器: source.bd = 取块设备的工厂(物理分区 = 盘上的镜像文件,
        -- 虚拟阵列 /dev/mdN = 内核 md 的块设备视图)。块设备的来源由 devdisk 决定, 这里不猜。
        kapi.registerFstype("ext2", function(source, dir)
            local bd, err = source.bd()
            if not bd then return nil, tostring(err) end
            local rfs, ferr = ext2.mount(bd)
            if not rfs then
                bd.close()
                return nil, tostring(ferr)
            end
            -- 卸载时关闭块设备句柄(否则每次 mount 泄漏一个文件句柄)。
            return ext2.backend(rfs), { cleanup = function() bd.close() end }
        end)
        kapi.log("ext2: fstype registered (mount -t ext2 /dev/sdXN DIR)")
    end,
}
