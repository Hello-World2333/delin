--@name tom
--@version 0.1.0
--@description Tom's Peripherals GPU display driver (unified 0-based ScreenDevice).
--@deps

return {
    init = function(kapi, device)
        -- device = 外设名(由 modules.use(type, device) 传入)
        local side = device
        local gpu = peripheral.wrap(side)

        -- 启动顺序(必须): refreshSize -> (让检测完成) -> setSize -> getSize
        gpu.refreshSize()
        if sleep and type(sleep) == "function" then pcall(sleep, 0) end -- 等一个 tick, 让 GPU 完成检测
        gpu.setSize(64)
        local wPx, hPx, wBlk, hBlk, res = gpu.getSize()
        kapi.log("tom: refreshSize+getSize -> " .. tostring(wPx) .. "x" .. tostring(hPx)
            .. " px " .. tostring(wBlk) .. "x" .. tostring(hBlk) .. " blk res " .. tostring(res))
        if not wPx or wPx == 0 then
            kapi.log("tom: NO monitor detected by GPU (0 blocks). Is a Tom's Monitor arranged to the GPU's right/up?")
            return -- 不注册; 没有可显示的屏幕
        end

        -- Tom 的 drawText/filledRectangle 是 1-based; 统一层 0-based -> +1。
        -- line/rectangle/drawPixel 等基准存疑, 这里用 verified 的 filledRectangle 当像素/矩形。
        local currentRes = res or 64
        local dev = {
            id = "tom:" .. side,
            type = "gpu",
            mode = "pixel",        -- 像素帧缓冲: /dev/ttyN + /dev/fbN
            cellW = 6, cellH = 8,  -- 字格(px), 与 Tom 默认字体一致
            name = side,
            device = gpu,
            width = wPx, height = hPx,
            getSize = function() return wPx, hPx end,
            getTextWidth = function(s) return gpu.getTextLength(s) end, -- 比例字体宽度(供 tty 居中字元)
            blit = function(x, y, text, fg, bg)
                gpu.drawText(x + 1, y + 1, text, fg or -1, bg or -1)
            end,
            text = function(x, y, s, fg, bg)
                gpu.drawText(x + 1, y + 1, s, fg or -1, bg or -1)
            end,
            fill = function(color) pcall(gpu.fill, color or -1) end,
            rect = function(x, y, w, h, color)
                pcall(gpu.filledRectangle, math.max(x + 1, 1), math.max(y + 1, 1), w, h, color)
            end,
            setPixel = function(x, y, color)
                pcall(gpu.filledRectangle, x + 1, y + 1, 1, 1, color)
            end,
            flush = function() if gpu.sync then pcall(gpu.sync) end end,
            release = function() end,
            -- 可配置项(sysfs): resolution 改变会触发 tty/fb 热重算
            listConfig = function() return { "resolution" } end,
            getConfig = function(attr)
                if attr == "resolution" then return tostring(currentRes)
                elseif attr == "size" then return wPx .. "x" .. hPx end
                return nil
            end,
            setConfig = function(attr, value)
                if attr ~= "resolution" then return nil, "read-only or unknown config: " .. tostring(attr) end
                local v = tonumber((value or ""):match("^%s*(.-)%s*$"))
                if not v or v < 16 or v > 64 then return nil, "bad resolution (expected 16-64)" end
                currentRes = v
                local ok, err = pcall(gpu.setSize, v)
                if not ok then return nil, "setSize failed: " .. tostring(err) end
                -- 重查像素尺寸并更新缓存(wPx/hPx 为 getSize 的 upvalue)
                local nw, nh = gpu.getSize()
                if nw and nw > 0 then wPx, hPx = nw, nh end
                return true
            end,
        }
        kapi.registerDisplay(dev)
        kapi.log("tom: display '" .. dev.id .. "' registered (" .. wPx .. "x" .. hPx .. ")")
    end,
}
