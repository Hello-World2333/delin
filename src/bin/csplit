-- Delin csplit: 按行号/正则把文件切成多段 (POSIX + GNU 子集)。用法:
--   csplit [-f PREFIX] [-n N] [-k] [-s] [-q] [-z] FILE ARG...
-- 选项:
--   -f PREFIX   输出文件前缀(缺省 "xx")
--   -n N        后缀数字位数(缺省 2)
--   -k          出错时保留已生成的文件(缺省删除)
--   -s, -q      不打印每段的字节数
--   -z          不生成空段(elide empty files)
-- ARG 形式:
--   行号 N              新段从第 N 行开始(相对 1); 带 {N}/{*} 重复时, 后续按"当前行 + N"推进
--   /RE/[OFFSET]        匹配正则的行作为切点, OFFSET 可带符号(如 +2 / -2)
--   {N} / {*}           重复前一个模式 N 次 / 重复到文件尾或再也匹配不到
-- FILE 为 "-" 时读 stdin。每生成一段, 向 stdout 打印该段的字节数(除非 -s)。
-- 已知偏离:
--   - **正则用 Lua pattern**(不是 POSIX ERE): 如 /line0[1-9]/ 可用, 但 POSIX 的 \( \) \{ \} 等写法不适用。
--   - 不支持 %RE% (跳过不切) 与 -b/--suffix-format; 只实现任务要求的选项集。
--   - 需要把输入整读进内存(正则回溯与字节数统计都要全量), 不做流式。
local args = args or {}
local cwd = (type(cwd) == "string" and cwd) or "/"
local function resolve(p)
    p = p or ""
    if p == "" then return (cwd == "/") and "/" or cwd end
    if p:sub(1, 1) == "/" then
        if p == "/" then return "/" end
        return p:gsub("/+$", "")
    end
    local base = (cwd == "/") and "" or cwd
    return (base .. "/" .. p):gsub("/+", "/")
end
local function stderr(s)
    local e = io.stderr()
    if e and e.write then e:write(s) end
end
local function ioeMsg(err)
    if err and (err:find("permission") or err:find("denied")) then return "Permission denied" end
    -- 必须先判 ENOENT: "No such file or directory" 里本来就含 "directory" 这个词,
    -- 先匹 "directory" 会把"文件不存在"误报成 "Is a directory"(老模板的 bug)。
    if err and err:lower():find("no such file") then return "No such file or directory" end
    if err and err:find("directory") then return "Is a directory" end
    return "No such file or directory"
end

local prefix = "xx"
local digits = 2
local keep, silent, elide = false, false, false
local operands = {}
local noMoreOpts = false

local i = 1
while i <= #args do
    local a = args[i]
    if noMoreOpts then
        operands[#operands + 1] = a
    elseif a == "--" then
        noMoreOpts = true
    elseif a == "-k" or a == "--keep-files" then keep = true
    elseif a == "-s" or a == "-q" or a == "--quiet" or a == "--silent" then silent = true
    elseif a == "-z" or a == "--elide-empty-files" then elide = true
    elseif a:match("^%-%-prefix=") then prefix = a:sub(10)
    elseif a:match("^%-%-digits=") then
        digits = tonumber(a:sub(10))
        if not digits or digits < 1 then stderr("csplit: invalid number: '" .. a:sub(10) .. "'\n"); return 1 end
    elseif a:sub(1, 1) == "-" and a ~= "-" and a:sub(1, 2) ~= "--" then
        local k = 2
        while k <= #a do
            local ch = a:sub(k, k)
            if ch == "k" then keep = true; k = k + 1
            elseif ch == "s" or ch == "q" then silent = true; k = k + 1
            elseif ch == "z" then elide = true; k = k + 1
            elseif ch == "f" or ch == "n" then
                local val = a:sub(k + 1)
                if val == "" then
                    i = i + 1
                    if not args[i] then stderr("csplit: option requires an argument -- '" .. ch .. "'\n"); return 1 end
                    val = args[i]
                end
                if ch == "f" then prefix = val
                else
                    digits = tonumber(val)
                    if not digits or digits < 1 then stderr("csplit: invalid number: '" .. val .. "'\n"); return 1 end
                end
                k = #a + 1
            else
                stderr("csplit: invalid option -- '" .. ch .. "'\n")
                return 1
            end
        end
    elseif a:sub(1, 2) == "--" then
        stderr("csplit: unrecognized option '" .. a .. "'\n")
        return 1
    else
        operands[#operands + 1] = a
    end
    i = i + 1
end
if #operands < 1 then
    stderr("csplit: missing operand\n")
    return 1
end
local inName = operands[1]
if #operands < 2 then
    stderr("csplit: missing operand after '" .. inName .. "'\n")
    return 1
end

-- 读入整个输入: 拆成"带行尾换行的原始行"数组, 保证字节数精确。
local h
if inName == "-" then
    h = io.stdin()
    if not h then stderr("csplit: 无法读取 stdin\n"); return 1 end
else
    local err
    h, err = fs.open(resolve(inName), "r")
    if not h then
        stderr("csplit: cannot open '" .. inName .. "' for reading: " .. ioeMsg(err) .. "\n")
        return 1
    end
end
local content = ""
do
    local parts = {}
    if h.readAll then
        parts[1] = h:readAll() or ""
    else
        while true do
            local l = h:readLine()
            if l == nil then break end
            parts[#parts + 1] = l .. "\n"
        end
    end
    content = table.concat(parts)
end
if inName ~= "-" then h:close() end

local lines = {}      -- lines[n] = 含行尾换行的原始文本
do
    local pos = 1
    while pos <= #content do
        local e = content:find("\n", pos, true)
        if not e then lines[#lines + 1] = content:sub(pos); break end
        lines[#lines + 1] = content:sub(pos, e)
        pos = e + 1
    end
end

local created = {}
local outIndex = 0
local function cleanUp()
    if keep then return end
    for _, f in ipairs(created) do fs.delete(f) end
end
local function fail(msg)
    cleanUp()
    stderr(msg)
    return 1
end

-- 写出一段 [from, to](行号, 含端点); 空段在 -z 下跳过。
local function writePiece(from, to)
    local body = {}
    for n = from, to do body[#body + 1] = lines[n] end
    local text = table.concat(body)
    if #text == 0 and elide then return true end
    local name = prefix .. string.format("%0" .. digits .. "d", outIndex)
    outIndex = outIndex + 1
    local fh, err = fs.open(resolve(name), "w")
    if not fh then
        cleanUp()
        stderr("csplit: " .. name .. ": " .. ioeMsg(err) .. "\n")
        return false
    end
    fh:write(text)
    fh:close()
    created[#created + 1] = name
    if not silent then io.write(#text .. "\n") end
    return true
end

-- 解析一个模式参数。
local function parsePattern(arg)
    local re = arg:match("^/(.*)/$")
    if re then return { kind = "re", pat = re, offset = 0 } end
    local re2, off = arg:match("^/(.*)/([%+%-]%d+)$")
    if re2 then return { kind = "re", pat = re2, offset = tonumber(off) } end
    if arg:match("^/") then
        stderr("csplit: '" .. arg .. "': integer expected after delimiter\n")
        return nil
    end
    local n = tonumber(arg)
    if n then
        if n < 0 then stderr("csplit: " .. arg .. ": line number must be greater than zero\n"); return nil end
        if n == 0 then stderr("csplit: " .. arg .. ": line number must be greater than zero\n"); return nil end
        return { kind = "line", num = n }
    end
    stderr("csplit: '" .. arg .. "': invalid pattern\n")
    return nil
end

local pos = 1                 -- 当前段起始行号
local total = #lines
local argIdx = 2
while argIdx <= #operands do
    local pat = parsePattern(operands[argIdx])
    if not pat then return fail("") end
    -- 重复次数。
    local repeatAll, repeatN = false, 0
    local nextIdx = argIdx + 1
    if nextIdx <= #operands then
        local r = operands[nextIdx]:match("^{(%d+)}$")
        if operands[nextIdx] == "{*}" then repeatAll = true; nextIdx = nextIdx + 1
        elseif r then repeatN = tonumber(r); nextIdx = nextIdx + 1 end
    end
    local searchFrom = pos     -- 正则搜索起点
    local times = 1
    if repeatAll then times = math.huge elseif repeatN > 0 then times = repeatN + 1 end
    for round = 1, times do
        local splitAt
        if pat.kind == "line" then
            if round == 1 then splitAt = pat.num
            else splitAt = pos + pat.num end
        else
            local found = nil
            for n = searchFrom, total do
                if lines[n]:sub(1, -2):match(pat.pat) or lines[n]:match(pat.pat) then found = n; break end
            end
            if not found then
                if repeatAll and round > 1 then break end
                if repeatAll then break end
                if round > 1 then
                    return fail("csplit: '" .. operands[argIdx] .. "': match not found on repetition " .. (round - 1) .. "\n")
                end
                return fail("csplit: '" .. operands[argIdx] .. "': match not found\n")
            end
            searchFrom = found + 1
            splitAt = found + pat.offset
            if splitAt < pos then splitAt = pos end
        end
        if pat.kind == "line" and splitAt > total then
            -- 与 GNU 一致: 先把当前段写出去, 再报行号越界。
            if not writePiece(pos, total) then return 1 end
            return fail("csplit: '" .. operands[argIdx] .. "': line number out of range\n")
        end
        if splitAt > total then
            -- 正则 + 偏移越过文件尾: 直接把剩余部分作为最后一段。
            if not writePiece(pos, total) then return 1 end
            pos = total + 1
            break
        end
        if not writePiece(pos, splitAt - 1) then return 1 end
        pos = splitAt
        if pat.kind == "line" and round == times then break end
    end
    argIdx = nextIdx
end
-- 最后一段。
if not writePiece(pos, total) then return 1 end
