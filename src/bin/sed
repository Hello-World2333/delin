-- Delin sed: 流式文本编辑器 (GNU sed 子集)。
--   用法: sed [OPTION]... {script-only-if-no-other-script} [file...]
--   无 file 时读 stdin。输出到 stdout。
--
--   支持的命令: s y d p q a i c =  ; 行号/ $ / /regex/ 地址与区间, ! 取反。
--   支持的选项: -n -s -e script -f file -i[suffix] -E/-r。
--   正则用**标准正则**(POSIX 1003.1; 引擎见 kernel/regex.lua, 与 grep 同一份):
--     默认 = BRE(\(...\) 分组, \{m,n\} 区间, \1 逆引用, GNU 扩展 \+ \? \|);
--     -E / -r / --regexp-extended = ERE(( ) {m,n} + ? | 直接写)。
--   替换串: & = 整串匹配, \1..\9 = 捕获组, \n \t \r 转义, \& 与 \\ = 字面量。
-- 让出调度器: 防止长输出/长计算饿死事件循环(CC 的 ~7s no-yield 限制)。
-- 时间片式: 每累计 ~50ms CPU 时间让出一次, 不按字节让出 —— HSE 已改拉模式(waitNextTick),
-- 每次让出都是一次事件往返, 高频让出会淹没事件队列并拖死键盘。50ms 时间片同时保证
-- 长命令运行期间按键/^C 的投递延迟不超过一个时间片。
local _msleep = os.msleep or function(ms) os.sleep(math.max((ms or 0) / 1000, 0.05)) end
local _sliceAt = os.epoch("utc")
local function yieldCheck(_n)
    local now = os.epoch("utc")
    if now - _sliceAt >= 50 then
        _sliceAt = now
        _msleep(0)
    end
end

local args = args or {}
local cwd = (type(cwd) == "string" and cwd) or "/"
local function resolve(p)
    p = p or ""
    if p:sub(1, 1) == "/" then
        if p == "/" then return "/" end
        return p:gsub("/+$", "")
    end
    local base = (cwd == "/") and "" or cwd
    return (base .. "/" .. p):gsub("/+", "/")
end
local function stderr(s)
    local e = io.stderr()
    if e and e.write then e:write(s) end
end
local function ioeMsg(err)
    if err and (err:find("permission") or err:find("denied")) then return "Permission denied" end
    -- 必须先判 ENOENT: "No such file or directory" 里本来就含 "directory" 这个词,
    -- 先匹 "directory" 会把"文件不存在"误报成 "Is a directory"(老模板的 bug)。
    if err and err:lower():find("no such file") then return "No such file or directory" end
    if err and err:find("directory") then return "Is a directory" end
    return "No such file or directory"
end

-- ---------------------------------------------------------------
-- 标准正则(kernel/regex.lua 是唯一真源): sed 默认 BRE, -E/-r 切 ERE
-- ---------------------------------------------------------------
local flavor = "bre"
local compileRegex = syscalls and syscalls["regex.compile"]
local function compileRe(pat, icase)
    if not compileRegex then
        stderr("sed: regex syscall not available\n")
        return nil
    end
    local re, err = compileRegex(pat, flavor, { icase = icase })
    if not re then
        stderr("sed: invalid regular expression (" .. tostring(err) .. "): " .. pat .. "\n")
        return nil
    end
    return re
end

-- ---------------------------------------------------------------
-- 命令行解析
-- ---------------------------------------------------------------
local quiet, inplace, inSuffix, perFile = false, false, nil, false
local scripts = {}
local files = {}
local seenScriptOpt = false
local i = 1
while i <= #args do
    local a = args[i]
    if a == "-n" or a == "--quiet" or a == "--silent" then
        quiet = true
    elseif a == "-s" or a == "--separate" then
        perFile = true
    elseif a == "-E" or a == "-r" or a == "--regexp-extended" then
        flavor = "ere"
    elseif a == "-e" or a == "--expression" then
        i = i + 1
        if not args[i] then stderr("sed: option requires an argument -- e\n"); return end
        scripts[#scripts + 1] = args[i]
        seenScriptOpt = true
    elseif a:match("^%-%-expression=(.*)$") then
        scripts[#scripts + 1] = a:match("^%-%-expression=(.*)$")
        seenScriptOpt = true
    elseif a == "-f" or a == "--file" then
        i = i + 1
        if not args[i] then stderr("sed: option requires an argument -- f\n"); return end
        local sp = resolve(args[i])
        local fh, ferr = fs.open(sp, "r")
        if not fh then stderr("sed: can't read " .. sp .. ": " .. ioeMsg(ferr) .. "\n"); return end
        scripts[#scripts + 1] = fh:readAll()
        fh:close()
        seenScriptOpt = true
    elseif a:match("^%-%-file=(.*)$") then
        local sp = resolve(a:match("^%-%-file=(.*)$"))
        local fh, ferr = fs.open(sp, "r")
        if not fh then stderr("sed: can't read " .. sp .. ": " .. ioeMsg(ferr) .. "\n"); return end
        scripts[#scripts + 1] = fh:readAll()
        fh:close()
        seenScriptOpt = true
    elseif a == "-i" or a == "--in-place" then
        inplace = true; inSuffix = nil
    elseif a:match("^%-%-in%-place=(.*)$") then
        inplace = true; inSuffix = a:match("^%-%-in%-place=(.*)$")
    elseif a:match("^%-i(.*)$") and #a > 2 then
        inplace = true; inSuffix = a:sub(3)
    elseif a == "--" then
        i = i + 1
        while i <= #args do files[#files + 1] = args[i]; i = i + 1 end
        break
    elseif a:sub(1, 1) == "-" and a ~= "-" then
        stderr("sed: invalid option -- " .. a .. "\n")
        return 1
    else
        -- 第一个非选项参数是脚本; 若已用 -e/-f, 则都当文件。
        if not seenScriptOpt and #scripts == 0 and #files == 0 then
            scripts[#scripts + 1] = a
            seenScriptOpt = true
        else
            files[#files + 1] = a
        end
    end
    i = i + 1
end

if #scripts == 0 then
    stderr("sed: no script specified\n")
    return 1
end
if inplace and #files == 0 then
    stderr("sed: can't read stdin (in-place needs files)\n")
    return 1
end

local function translit(pattern, cmd)
    local src, dst = cmd.src, cmd.dst
    local map = {}
    for j = 1, #src do
        local k = math.min(j, #dst)
        map[src:sub(j, j)] = dst:sub(k, k)
    end
    local out = {}
    for j = 1, #pattern do
        local ch = pattern:sub(j, j)
        out[#out + 1] = map[ch] or ch
    end
    return table.concat(out)
end

-- ---------------------------------------------------------------
-- 脚本编译: 把一条脚本字符串编译成命令表
-- ---------------------------------------------------------------
local function skipSep(script, i, n)
    while i <= n do
        local c = script:sub(i, i)
        if c == " " or c == "\t" or c == "\n" or c == "\r" or c == ";" then
            i = i + 1
        else
            break
        end
    end
    return i
end
local function parseAddr(script, i, n)
    if i > n then return nil, i end
    local c = script:sub(i, i)
    if c == "$" then
        return { kind = "dollar" }, i + 1
    elseif c == "/" then
        local buf = {}
        local j = i + 1
        while j <= n do
            local ch = script:sub(j, j)
            if ch == "\\" and script:sub(j + 1, j + 1) == "/" then
                buf[#buf + 1] = "/"; j = j + 2
            elseif ch == "/" then
                local pat = table.concat(buf)
                local re = compileRe(pat)
                if not re then return nil, i end
                return { kind = "regex", pat = pat, re = re }, j + 1
            else
                buf[#buf + 1] = ch; j = j + 1
            end
        end
        return nil, i
    elseif c:match("%d") then
        local num = script:match("^%d+", i)
        return { kind = "num", n = tonumber(num) }, i + #num
    end
    return nil, i
end
local function readDelimited(script, i, n, delim)
    local buf = {}
    while i <= n do
        local c = script:sub(i, i)
        if c == "\\" then
            local nx = script:sub(i + 1, i + 1)
            if nx == delim then
                buf[#buf + 1] = delim; i = i + 2
            else
                buf[#buf + 1] = "\\"; i = i + 1
            end
        elseif c == delim then
            return table.concat(buf), i + 1
        else
            buf[#buf + 1] = c; i = i + 1
        end
    end
    return nil, i
end

local function parseCmd(script, i)
    local n = #script
    i = skipSep(script, i, n)
    if i > n then return nil, i end
    local addr
    local a1, ni = parseAddr(script, i, n)
    if a1 then
        i = skipSep(script, ni, n)
        if script:sub(i, i) == "," then
            local a2, ni2 = parseAddr(script, skipSep(script, i + 1, n), n)
            if not a2 then return nil, i end
            addr = { kind = "range", start = a1, stop = a2 }
            i = skipSep(script, ni2, n)
        else
            addr = a1
        end
    end
    if addr and addr.kind == "num" and addr.n == 0 then
        return nil, i -- 0 只允许作范围起点
    end
    local neg = false
    if script:sub(i, i) == "!" then
        neg = true; i = i + 1
    end
    i = skipSep(script, i, n)
    local c = script:sub(i, i)
    if c == "" then return nil, i end
    i = i + 1
    local cmd = { addr = addr, neg = neg, type = c, inRange = false, atStart = false, atEnd = false }
    if c == "s" then
        local d = script:sub(i, i)
        if d == "" or d == ";" or d == "\n" then return nil, i end
        i = i + 1
        local pat, ni = readDelimited(script, i, n, d)
        if not pat then return nil, i end
        i = ni
        local repl, ni2 = readDelimited(script, i, n, d)
        if not repl then return nil, i end
        i = ni2
        -- flags
        local g, count, pr, ci = false, nil, false, false
        while i <= n do
            local f = script:sub(i, i)
            if f:match("%d") then count = tonumber(f)
            elseif f == "g" then g = true
            elseif f == "p" then pr = true
            elseif f == "i" or f == "I" then ci = true
            else break end
            i = i + 1
        end
        cmd.pat = pat
        cmd.repl = repl
        cmd.global = g
        cmd.count = count
        cmd.print = pr
        cmd.ignorecase = ci
        cmd.re = compileRe(pat, ci)
        if not cmd.re then return nil, i end
    elseif c == "y" then
        local d = script:sub(i, i)
        if d == "" or d == ";" or d == "\n" then return nil, i end
        i = i + 1
        local src, ni = readDelimited(script, i, n, d)
        if not src then return nil, i end
        local dst, ni2 = readDelimited(script, ni, n, d)
        if not dst then return nil, i end
        i = ni2
        cmd.src = src; cmd.dst = dst
    elseif c == "a" or c == "i" or c == "c" then
        local text = script:sub(i)
        text = text:gsub("^\\", ""):gsub("^%s+", "")
        -- 文本到下一个 ';' 或换行为止
        local stop = text:find("[\n;]")
        if stop then
            cmd.text = text:sub(1, stop - 1)
            i = i + (stop - 1)
        else
            cmd.text = text
            i = n + 1
        end
    elseif c == "q" then
        local num = script:match("^%d+", i)
        if num then cmd.code = tonumber(num); i = i + #num end
    elseif c == "d" or c == "p" or c == "=" then
        -- 无参数
    else
        return nil, i
    end
    return cmd, i
end

local function compileScript(script)
    local cmds = {}
    local i = 1
    local n = #script
    while i <= n do
        i = skipSep(script, i, n)
        if i > n then break end
        if script:sub(i, i) == "#" then
            while i <= n and script:sub(i, i) ~= "\n" do i = i + 1 end
            i = i + 1
        else
            local cmd, ni = parseCmd(script, i)
            if not cmd then
                stderr("sed: can't parse command near: " .. script:sub(i) .. "\n")
                return nil
            end
            cmds[#cmds + 1] = cmd
            i = ni
        end
    end
    return cmds
end

local cmds = {}
for _, s in ipairs(scripts) do
    local compiled = compileScript(s)
    if not compiled then return end
    for _, c in ipairs(compiled) do cmds[#cmds + 1] = c end
end
if #cmds == 0 then
    stderr("sed: no usable commands\n")
    return 1
end

-- ---------------------------------------------------------------
-- 地址匹配
-- ---------------------------------------------------------------
local function singleMatch(a, ln, pattern, L)
    if a.kind == "num" then return ln == a.n
    elseif a.kind == "dollar" then return ln == L
    elseif a.kind == "regex" then return a.re:find(pattern) ~= nil end
    return false
end
local function startMatch(a, ln, pattern, L)
    if a.kind == "num" then
        if a.n == 0 then return true end
        return ln == a.n
    elseif a.kind == "dollar" then return ln == L
    elseif a.kind == "regex" then return a.re:find(pattern) ~= nil end
    return false
end
local function endMatch(a, ln, pattern, L)
    if a.kind == "num" then return ln == a.n
    elseif a.kind == "dollar" then return ln == L
    elseif a.kind == "regex" then return a.re:find(pattern) ~= nil end
    return false
end
local function addrMatch(cmd, ln, pattern, L)
    local a = cmd.addr
    if not a then return true end
    if a.kind ~= "range" then return singleMatch(a, ln, pattern, L) end
    local aStart, aStop = a.start, a.stop
    if not cmd.inRange then
        if startMatch(aStart, ln, pattern, L) then
            cmd.inRange = true
            cmd.atStart = true
            if endMatch(aStop, ln, pattern, L) then
                cmd.inRange = false
                cmd.atEnd = true
            else
                cmd.atEnd = false
            end
            return true
        end
        cmd.atStart, cmd.atEnd = false, false
        return false
    else
        cmd.atStart = false
        if endMatch(aStop, ln, pattern, L) then
            cmd.inRange = false
            cmd.atEnd = true
        else
            cmd.atEnd = false
        end
        return true
    end
end

-- ---------------------------------------------------------------
-- 替换 / 主循环
-- ---------------------------------------------------------------
--- s/// 的替换: mode = true(全部) | 数字(只替第 n 次) | false(只替第一次)。
local function subst(pattern, cmd)
    local mode = cmd.count or cmd.global
    local res, n = cmd.re:sub(pattern, cmd.repl, mode)
    return res, (n > 0)
end

local curOut -- nil => stdout; 否则为写入的文件句柄
local function wline(s)
    local out = (s or "") .. "\n"
    if curOut then curOut:write(out) else io.write(out) end
    yieldCheck(#out)
end

local function readAllLines(handle)
    local lines = {}
    while true do
        local l = handle:readLine()
        if l == nil then break end
        lines[#lines + 1] = l
    end
    return lines
end

local function process(lines, source)
    local L = #lines
    local quit = false
    local quitCode = 0
    for ln = 1, L do
        if quit then break end
        local pattern = lines[ln]
        local deleted = false
        local skipRest = false
        -- a 命令排队要追加的文本, 等本行输出后再写 (GNU sed: append after line)。
        local appends = {}
        for ci = 1, #cmds do
            local cmd = cmds[ci]
            if skipRest then break end
            local matched = addrMatch(cmd, ln, pattern, L)
            if cmd.neg then matched = not matched end
            if matched then
                local t = cmd.type
                if t == "s" then
                    local np, changed = subst(pattern, cmd)
                    pattern = np
                    if changed and cmd.print then wline(pattern) end
                elseif t == "d" then
                    deleted = true; skipRest = true
                elseif t == "p" then
                    wline(pattern)
                elseif t == "=" then
                    wline(tostring(ln))
                elseif t == "q" then
                    if not quiet then wline(pattern) end
                    quit = true; quitCode = cmd.code or 0; skipRest = true
                elseif t == "y" then
                    pattern = translit(pattern, cmd)
                elseif t == "a" then
                    -- 命中即排队(含区间内每一行), 在本行(或整段)输出后才写。
                    appends[#appends + 1] = cmd.text
                elseif t == "i" then
                    -- 命中即写(含区间内每一行), 在本行输出前插入。
                    wline(cmd.text)
                elseif t == "c" then
                    if cmd.addr and cmd.addr.kind == "range" then
                        deleted = true; skipRest = true
                        if cmd.atEnd then wline(cmd.text) end
                    else
                        wline(cmd.text); deleted = true; skipRest = true
                    end
                end
            end
            if skipRest then break end
        end
        if not quit and not deleted and not quiet then
            wline(pattern)
        end
        -- append 文本总是写在本行之后: 无论 -n、被 d 删除还是被 q 退出。
        for ai = 1, #appends do wline(appends[ai]) end
    end
    return quit, quitCode
end

-- 写出(仅其自身路径)文件名
local function sourceName(path)
    if path == "/" then return "/" end
    return path:gsub("/+$", "")
end

-- ---------------------------------------------------------------
-- 逐源处理
-- ---------------------------------------------------------------
local function runOne(lines, absPath)
    local outH
    if inplace and absPath then
        -- 读回写: 先读进内存(上面已读), 再以 "w" 打开(会截断)写回。
        local oerr
        outH, oerr = fs.open(absPath, "w")
        if not outH then
            stderr("sed: " .. sourceName(absPath) .. ": " .. ioeMsg(oerr) .. "\n")
            return true, 0
        end
        curOut = outH
    else
        curOut = nil
    end
    local quit, quitCode = process(lines, absPath)
    if outH then outH:close() end
    return quit, quitCode
end

if #files == 0 then
    -- stdin
    local h = io.stdin()
    if not h then return end
    local lines = readAllLines(h)
    runOne(lines, nil)
else
    if inplace then
        for _, p in ipairs(files) do
            local abs = resolve(p)
            local fh, e = fs.open(abs, "r")
            if not fh then
                stderr("sed: " .. sourceName(abs) .. ": " .. ioeMsg(e) .. "\n"); return
            end
            local lines = readAllLines(fh)
            fh:close()
            if inSuffix then
                local bak = abs .. inSuffix
                local bh = assert(fs.open(bak, "w"))
                for _, l in ipairs(lines) do bh:write(l .. "\n") end
                bh:close()
            end
            local q = runOne(lines, abs)
            if q then return end
        end
    elseif perFile then
        for _, p in ipairs(files) do
            local abs = resolve(p)
            local fh, e = fs.open(abs, "r")
            if not fh then
                stderr("sed: " .. sourceName(abs) .. ": " .. ioeMsg(e) .. "\n"); return
            end
            local lines = readAllLines(fh)
            fh:close()
            local q = nil
            curOut = nil
            q = process(lines, abs)
            if q then return end
        end
    else
        -- 多文件视为连续流: 收集所有行, 行号连续, $ 是最后一行。
        local all = {}
        for _, p in ipairs(files) do
            local abs = resolve(p)
            local fh, e = fs.open(abs, "r")
            if not fh then
                stderr("sed: " .. sourceName(abs) .. ": " .. ioeMsg(e) .. "\n"); return
            end
            for _, l in ipairs(readAllLines(fh)) do all[#all + 1] = l end
            fh:close()
        end
        curOut = nil
        process(all, nil)
    end
end
