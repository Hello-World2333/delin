-- Delin tsort: 拓扑排序 (POSIX tsort(1); 算法与 GNU coreutils 的 tsort.c 同构)。
-- 用法: tsort [FILE]
-- 输入: 成对的记号(空白分隔), 每对表示一条有向边 `前 后`。落单的记号(奇数个)报
--   "tsort: FILE: input contains an odd number of tokens" 并退出 1(GNU 同)。
-- 输出: 一个拓扑序, 每行一个记号; 有环时**照样把剩下的结点打完**(GNU 会拆掉一条边继续),
--   把环上的记号逐个写 stderr("tsort: <记号>"), 最后以 1 退出。
-- 算法(Knuth 的 Algorithm T, 逐条对照 coreutils tsort.c):
--   - 结点放在一棵按**字节序**排序的树里(这里用一个排好序的数组代替, 中序遍历等价),
--     `walk_tree` 就是"按字节序逐个访问";
--   - 前驱计数为 0 且未输出的结点构成一个**先进先出**队列: 每轮开始时按字节序扫描收集,
--     输出一个结点时, 它的后继按"输入顺序的倒序"(coreutils 用前插链表)递减计数,
--     减到 0 的接到队尾;
--   - 队列空了但还有结点 -> 有环: 报错并走 detect_loop 的反向遍历找环、打印环、**删掉一条边**,
--     然后回到"扫描零前驱"继续输出。因此有环的输入也会得到一个完整的打印序列, 只是退出码 1。
--   - **自环**(`x x`)按 GNU 直接丢掉: 它不影响计数(否则每个自环结点都判成环)。
--   - 重复的同一条边按 GNU 照记(前驱计数会累加, 但每条边也各减一次, 结果一致)。
-- 已知偏离:
--   - 不实现 --help/--version(与本项目其它工具一致)。
--   - 只接受一个操作数(与 GNU 同: 多余的报 "extra operand", 退出 1)。
local args = args or {}
local cwd = (type(cwd) == "string" and cwd) or "/"
local function resolve(p)
    p = p or ""
    if p == "" then return (cwd == "/") and "/" or cwd end
    if p:sub(1, 1) == "/" then
        if p == "/" then return "/" end
        return p:gsub("/+$", "")
    end
    local base = (cwd == "/") and "" or cwd
    return (base .. "/" .. p):gsub("/+", "/")
end
local function stderr(s)
    local e = io.stderr()
    if e and e.write then e:write(s) end
end
local function ioeMsg(err)
    if err and (err:find("permission") or err:find("denied")) then return "Permission denied" end
    if err and err:lower():find("no such file") then return "No such file or directory" end
    if err and err:find("directory") then return "Is a directory" end
    return "No such file or directory"
end

local files, noMoreOpts = {}, false
for _, a in ipairs(args) do
    if noMoreOpts then
        files[#files + 1] = a
    elseif a == "--" then
        noMoreOpts = true
    elseif a:sub(1, 1) == "-" and a ~= "-" then
        stderr("tsort: invalid option -- '" .. a:sub(2, 2) .. "'\n")
        return 1
    else
        files[#files + 1] = a
    end
end
if #files > 1 then
    stderr("tsort: extra operand '" .. files[2] .. "'\n")
    return 1
end
local src = files[1] or "-"

-- 读输入: readAll 优先(文件与内核管道都有), 没有就按块读。
local function slurp(h)
    if h.readAll then return h:readAll() end
    local parts = {}
    while true do
        local chunk = h:read(4096)
        if not chunk or chunk == "" then break end
        parts[#parts + 1] = chunk
    end
    return table.concat(parts)
end

local text
if src == "-" then
    text = slurp(io.stdin()) or ""
else
    local h, err = fs.open(resolve(src), "r")
    if not h then
        stderr("tsort: " .. src .. ": " .. ioeMsg(err) .. "\n")
        return 1
    end
    text = slurp(h)
    h:close()
end

-- ---------------------------------------------------------------
-- 图
-- ---------------------------------------------------------------
local byName, names = {}, {}
local function item(name)
    local it = byName[name]
    if not it then
        it = { name = name, count = 0, printed = false, top = nil, qlink = nil }
        byName[name] = it
        names[#names + 1] = name
    end
    return it
end

local tokens = {}
for tok in text:gmatch("%S+") do tokens[#tokens + 1] = tok end
if #tokens % 2 ~= 0 then
    stderr("tsort: " .. src .. ": input contains an odd number of tokens\n")
    return 1
end

for i = 1, #tokens, 2 do
    -- 两个记号都要进树(GNU 的 search_item 对两者都会建结点), 只是自环**不记关系**:
    -- `printf 'a a\n' | tsort` 在 GNU 上输出一个 "a"、退出 0。
    local j, k = item(tokens[i]), item(tokens[i + 1])
    if tokens[i] ~= tokens[i + 1] then
        k.count = k.count + 1
        -- 前插(与 coreutils 的 record_relation 一样): 遍历顺序 = 输入顺序的倒序。
        j.top = { suc = k, next = j.top }
    end
end

-- 结点按下标数组排好序: 中序遍历一棵按字节序的树 = 按字节序访问(代替树, 结果等价)。
table.sort(names, function(a, b) return a < b end)

local head, zeros = nil, nil -- 零前驱队列的头/尾
local loopNode = nil         -- detect_loop 用的全局(与 coreutils 的 loop 同名同义)
local nLeft = #names

--- 按字节序访问每个结点; action 返回 true 即停止(coreutils 的 walk_tree)。
local function walkTree(action)
    for i = 1, #names do
        if action(byName[names[i]]) then return true end
    end
    return false
end

--- 收集零前驱且未输出的结点进队列(coreutils 的 scan_zeros)。
local function scanZeros(k)
    if k.count == 0 and not k.printed then
        if head == nil then head = k else zeros.qlink = k end
        zeros = k
    end
    return false
end

--- 反向遍历找环: 打印环上的记号, 删掉一条边断开它(coreutils 的 detect_loop)。
local function detectLoop(k)
    if k.count > 0 then
        -- k 不一定在环上, 但它所在的图里有环。
        if loopNode == nil then
            loopNode = k -- 从这里开始反向遍历
        else
            local p = k.top
            local prev = nil
            while p do
                if p.suc == loopNode then
                    if k.qlink then
                        -- 找到环了: 沿走过的路径回溯打印。
                        while loopNode do
                            local tmp = loopNode.qlink
                            stderr("tsort: " .. loopNode.name .. "\n")
                            if loopNode == k then
                                -- 删掉这条边(断开环)
                                p.suc.count = p.suc.count - 1
                                if prev then prev.next = p.next else k.top = p.next end
                                break
                            end
                            loopNode.qlink = nil
                            loopNode = tmp
                        end
                        -- 收尾: 清掉还挂在链上的 qlink, 免得影响下一次找环。
                        while loopNode do
                            local tmp = loopNode.qlink
                            loopNode.qlink = nil
                            loopNode = tmp
                        end
                        return true
                    else
                        k.qlink = loopNode
                        loopNode = k
                        break
                    end
                end
                prev = p
                p = p.next
            end
        end
    end
    return false
end

-- ---------------------------------------------------------------
-- T1..T8: 主循环(Knuth 的 Algorithm T, 与 coreutils 同)
-- ---------------------------------------------------------------
local out = {}
local ok = true
while nLeft > 0 do
    -- T4: 扫描零前驱结点(按字节序)
    walkTree(scanZeros)
    while head do
        local p = head.top
        -- T5: 输出队首
        out[#out + 1] = head.name .. "\n"
        head.printed = true
        nLeft = nLeft - 1
        -- T6: 抹掉关系
        while p do
            p.suc.count = p.suc.count - 1
            if p.suc.count == 0 then
                zeros.qlink = p.suc
                zeros = p.suc
            end
            p = p.next
        end
        -- T7: 出队
        head = head.qlink
    end
    -- T8: 还有剩下的一定是环
    if nLeft > 0 then
        stderr("tsort: " .. src .. ": input contains a loop:\n")
        ok = false
        repeat
            walkTree(detectLoop)
        until loopNode == nil
    end
end

io.write(table.concat(out))
return ok and 0 or 1
