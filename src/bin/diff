-- Delin diff: 逐行比较两个文件/目录 (POSIX diff(1) + GNU 子集)。
-- 用法: diff [OPTION]... FILE1 FILE2
-- 输出格式:
--   缺省 normal: `<行号>[acd]<行号>` 指令 + `<`/`>` 行
--   -u, -U N, --unified[=N]   unified 格式 (GNU, 缺省 3 行上下文)
--   -c, -C N, --context[=N]   context 格式 (POSIX/GNU)
--   -e, --ed                  ed 脚本 (逆序 a/c/d 命令, 不含被删文本)
-- 选项:
--   -r, --recursive                 递归比较目录
--   -q, --brief                     只报告两个文件是否不同
--   -s, --report-identical-files    相同也报告
--   -b, --ignore-space-change       忽略空白量变化(行尾空白忽略, 空白串彼此等价)
--   -w, --ignore-all-space          忽略所有空白
--   -i, --ignore-case               忽略大小写
--   -B, --ignore-blank-lines        忽略"全是空行"的变化(空行 = 完全为空, 只有空格的行不算)
--   -N, --new-file                  缺失的文件当空文件(目录模式下 -N 也用于"只在一侧"的文件)
--   -a, --text                      二进制文件也按文本比较(缺省报 `Binary files A and B differ`)
--   --                              结束选项。单独的 `-` 是操作数(标准输入, 两个操作数里只能有一个)。
-- 退出码(POSIX): 0 = 相同, 1 = 有差异, 2 = 出错。
-- 已知偏离(实现取舍):
--   * 时间戳: 头行的日期用 os.date 的本地时间(CC 的时钟是 UTC), 时区固定打印 "+0000",
--     纳秒位固定 ".000000000"(Delin ext2 的 mtime 精度是秒)。宿主测试台的 fs.attributes
--     不返回 mtime, 此时一律按 0(epoch) 打印 —— 真机上取自文件的真实 mtime。
--   * context 格式的头行用 C 语言环境的 ctime 风格(`Fri Sep 11 22:05:18 2026`, 与
--     LC_ALL=C 的 GNU diff 一致); unified 格式用 ISO 风格(与 GNU 一致)。
--   * -B 是近似实现: 比较时把所有"完全空"的行视为等价, 并丢弃"删除与新增的行全是空行"的
--     变化块。GNU 的实现还能跨多个空行做匹配, 极端情况下块边界可能与 GNU 不同。
--   * 大输入(DP 单元格 > 40000)走 Hirschberg 线性空间 LCS(内存 O(min(N,M)));
--     极小编辑脚本可能有多个等价选择, 此时与 GNU 选的可能是不同的一个(输出仍是合法 diff)。
--   * `-` 与文件混用(如 `diff - f`)时用读取时刻的当前时间当第二个头行时间(GNU 同)。
local args = args or {}
local cwd = (type(cwd) == "string" and cwd) or "/"
local function resolve(p)
    p = p or ""
    if p == "" then return (cwd == "/") and "/" or cwd end
    if p:sub(1, 1) == "/" then
        if p == "/" then return "/" end
        return p:gsub("/+$", "")
    end
    local base = (cwd == "/") and "" or cwd
    return (base .. "/" .. p):gsub("/+", "/")
end
local function stderr(s)
    local e = io.stderr()
    if e and e.write then e:write(s) end
end
local function ioeMsg(err)
    if err and (err:find("permission") or err:find("denied")) then return "Permission denied" end
    -- 注意顺序: "No such file or directory" 里也有 "directory", 先判 ENOENT,
    -- 否则缺文件会被误报成 "Is a directory"(wc/cat 那版模板就有这个问题)。
    if err and (err:find("[Nn]o such") or err:find("not found")) then return "No such file or directory" end
    -- 必须先判 ENOENT: "No such file or directory" 里本来就含 "directory" 这个词,
    -- 先匹 "directory" 会把"文件不存在"误报成 "Is a directory"(老模板的 bug)。
    if err and err:lower():find("no such file") then return "No such file or directory" end
    if err and err:find("directory") then return "Is a directory" end
    return "No such file or directory"
end

-- ---------------------------------------------------------------
-- 选项解析
-- ---------------------------------------------------------------
local o = {
    fmt = "normal", ctx = 3,
    recursive = false, brief = false, same = false,
    wsc = false, wall = false, icase = false, blank = false, trail = false,
    newfile = false, text = false,
}
local operands, optsEcho = {}, {}
local noMoreOpts = false
local dashes = 0

--- 用法/选项错误: 诊断 + GNU 的提示行, 统一返回 diff 的错误退出码 2。
local function usageErr(msg)
    stderr("diff: " .. msg .. "\n")
    stderr("diff: Try 'diff --help' for more information.\n")
    return 2
end

--- --help 的用法文本(GNU 的提示行指向它, 所以这里也实现一下)。
local function usageText()
    io.write(table.concat({
        "用法: diff [选项]... 文件1 文件2",
        "逐行比较两个文件(或目录)。",
        "",
        "  -c, -C 行数, --context[=行数]     context 格式(缺省 3 行上下文)",
        "  -u, -U 行数, --unified[=行数]     unified 格式(缺省 3 行上下文)",
        "  -e, --ed                          ed 脚本格式",
        "  -r, --recursive                   递归比较目录",
        "  -q, --brief                       只报告是否不同",
        "  -s, --report-identical-files      相同也报告",
        "  -b, --ignore-space-change         忽略空白量变化",
        "  -w, --ignore-all-space            忽略所有空白",
        "  -Z, --ignore-trailing-space       忽略行尾空白",
        "  -i, --ignore-case                 忽略大小写",
        "  -B, --ignore-blank-lines          忽略纯空行的变化",
        "  -N, --new-file                    缺失文件当空文件",
        "  -a, --text                        二进制也按文本比较",
        "      --help                        显示本帮助",
        "",
        "退出码: 0 相同 / 1 有差异 / 2 出错。",
    }, "\n") .. "\n")
end

local function setShort(ch)
    if ch == "r" then o.recursive = true
    elseif ch == "q" then o.brief = true
    elseif ch == "s" then o.same = true
    elseif ch == "b" then o.wsc = true
    elseif ch == "w" then o.wall = true
    elseif ch == "i" then o.icase = true
    elseif ch == "Z" then o.trail = true
    elseif ch == "B" then o.blank = true
    elseif ch == "N" then o.newfile = true
    elseif ch == "a" then o.text = true
    elseif ch == "u" then o.fmt, o.ctx = "unified", 3
    elseif ch == "c" then o.fmt, o.ctx = "context", 3
    elseif ch == "e" then o.fmt = "ed"
    else
        usageErr("invalid option -- '" .. ch .. "'")
        return false
    end
    return true
end

-- 读 -U/-C 的行数参数: 可粘连(`-U3`)或独立成参(`-U 3`)。
local function ctxArg(rest, i)
    local numStr = rest
    if numStr == "" then
        i = i + 1
        numStr = args[i]
        if not numStr then return nil, i, "option requires an argument" end
    end
    local n = tonumber(numStr)
    if not n or n < 0 or n ~= math.floor(n) then return nil, i, "invalid context length '" .. numStr .. "'" end
    return n, i
end

local i = 1
while i <= #args do
    local a = args[i]
    if noMoreOpts then
        operands[#operands + 1] = a
    elseif a == "--" then
        noMoreOpts = true
    elseif a == "-" then
        operands[#operands + 1] = a
        dashes = dashes + 1
    elseif a:sub(1, 1) == "-" then
        if a:sub(1, 2) == "--" then
            local name, val = a:match("^%-%-([^=]+)=(.*)$")
            if not name then name = a:sub(3) end
            if name == "recursive" then o.recursive = true
            elseif name == "brief" then o.brief = true
            elseif name == "report-identical-files" then o.same = true
            elseif name == "ignore-space-change" then o.wsc = true
            elseif name == "ignore-all-space" then o.wall = true
            elseif name == "ignore-case" then o.icase = true
            elseif name == "ignore-trailing-space" then o.trail = true
            elseif name == "ignore-blank-lines" then o.blank = true
            elseif name == "new-file" then o.newfile = true
            elseif name == "text" then o.text = true
            elseif name == "normal" then o.fmt = "normal"
            elseif name == "ed" then o.fmt = "ed"
            elseif name == "unified" or name == "context" then
                o.fmt = (name == "unified") and "unified" or "context"
                if val then
                    local n = tonumber(val)
                    if not n or n < 0 then return usageErr("invalid context length '" .. val .. "'") end
                    o.ctx = n
                else
                    o.ctx = 3
                end
            elseif name == "help" then
                usageText()
                return 0
            elseif name == "speed-large-files" or name == "minimal" then
                -- GNU 的性能/优化开关: 本实现天然处理, 接受但无额外语义
            else
                return usageErr("unrecognized option '--" .. name .. "'")
            end
            optsEcho[#optsEcho + 1] = a
        else
            optsEcho[#optsEcho + 1] = a
            local k = 2
            while k <= #a do
                local ch = a:sub(k, k)
                if ch == "U" or ch == "C" then
                    local n, ni, err = ctxArg(a:sub(k + 1), i)
                    if not n then return usageErr(err) end
                    o.fmt = (ch == "U") and "unified" or "context"
                    o.ctx = n
                    i = ni
                    k = #a + 1
                else
                    if not setShort(ch) then return 2 end
                    k = k + 1
                end
            end
        end
    else
        operands[#operands + 1] = a
    end
    i = i + 1
end

if #operands ~= 2 then
    if #operands < 2 then
        return usageErr("missing operand after '" .. operands[#operands] .. "'")
    else
        return usageErr("extra operand '" .. operands[3] .. "'")
    end
    return 2
end
if dashes > 1 then
    return usageErr("cannot compare standard input to itself")
end

-- ---------------------------------------------------------------
-- 行表与比较
-- ---------------------------------------------------------------
local unpack = table.unpack or unpack

--- 按 `\n` 切行。返回行表与"末行无换行符"标志。
local function splitLines(content)
    local lines = {}
    local pos = 1
    while true do
        local nl = content:find("\n", pos, true)
        if not nl then
            if pos <= #content then
                lines[#lines + 1] = content:sub(pos)
                return lines, true
            end
            return lines, false
        end
        lines[#lines + 1] = content:sub(pos, nl - 1)
        pos = nl + 1
    end
end

local function isSpace(c) return c == " " or c == "\t" or c == "\r" or c == "\v" or c == "\f" end

--- -w: 去掉所有空白后比较。
local function stripAllSpace(s)
    local out = {}
    for k = 1, #s do
        local c = s:sub(k, k)
        if not isSpace(c) then out[#out + 1] = c end
    end
    return table.concat(out)
end

--- -b: 空白**串**彼此等价, 行尾空白忽略, 但"有空白 vs 没空白"仍是差异(GNU 语义)。
local function sameSpaceChange(s1, s2)
    local i1, i2 = 1, 1
    local n1, n2 = #s1, #s2
    while i1 <= n1 and i2 <= n2 do
        local c1, c2 = s1:sub(i1, i1), s2:sub(i2, i2)
        if isSpace(c1) and isSpace(c2) then
            while i1 <= n1 and isSpace(s1:sub(i1, i1)) do i1 = i1 + 1 end
            while i2 <= n2 and isSpace(s2:sub(i2, i2)) do i2 = i2 + 1 end
        elseif c1 ~= c2 then
            return false
        else
            i1, i2 = i1 + 1, i2 + 1
        end
    end
    while i1 <= n1 and isSpace(s1:sub(i1, i1)) do i1 = i1 + 1 end
    while i2 <= n2 and isSpace(s2:sub(i2, i2)) do i2 = i2 + 1 end
    return i1 > n1 and i2 > n2
end

--- 两行是否"相同"(-i/-b/-w 生效)。
local function sameLine(s1, s2)
    if o.icase then s1, s2 = s1:lower(), s2:lower() end
    if o.trail then s1, s2 = s1:gsub("[ \t\r\v\f]+$", ""), s2:gsub("[ \t\r\v\f]+$", "") end
    if o.wall then return stripAllSpace(s1) == stripAllSpace(s2) end
    if o.wsc then return sameSpaceChange(s1, s2) end
    return s1 == s2
end

-- ---------------------------------------------------------------
-- LCS -> 编辑脚本
-- 脚本是一串操作: {"keep", ai, bi} | {"del", ai} | {"add", bi}
-- ---------------------------------------------------------------
local DP_LIMIT = 40000

--- 小规模: 完整 DP 表(带 GNU 风格的 tie-break: 优先把后出现的行当作新增/删除)。
local function lcsDP(l1, a1, a2, l2, b1, b2, out)
    local n, m = a2 - a1, b2 - b1
    local dp = {}
    for x = 0, n do
        local row = {}
        for y = 0, m do row[y] = 0 end
        dp[x] = row
    end
    for x = 1, n do
        local s1 = l1[a1 + x]
        local row, prev = dp[x], dp[x - 1]
        for y = 1, m do
            if sameLine(s1, l2[b1 + y]) then
                row[y] = prev[y - 1] + 1
            elseif prev[y] >= row[y - 1] then
                row[y] = prev[y]
            else
                row[y] = row[y - 1]
            end
        end
    end
    local ops = {}
    local x, y = n, m
    while x > 0 or y > 0 do
        if y > 0 and dp[x][y - 1] == dp[x][y] then
            ops[#ops + 1] = { "add", nil, b1 + y }
            y = y - 1
        elseif x > 0 and dp[x - 1][y] == dp[x][y] then
            ops[#ops + 1] = { "del", a1 + x }
            x = x - 1
        else
            ops[#ops + 1] = { "keep", a1 + x, b1 + y }
            x, y = x - 1, y - 1
        end
    end
    for k = #ops, 1, -1 do out[#out + 1] = ops[k] end
end

--- 前缀 LCS 长度行: 返回 row[y] = LCS(l1[a1+1..a2], l2[b1+1..b1+y])。
local function lcsRowPrefix(l1, a1, a2, l2, b1, b2)
    local m = b2 - b1
    local prev = {}
    for y = 0, m do prev[y] = 0 end
    for x = a1 + 1, a2 do
        local s1 = l1[x]
        local cur = { [0] = 0 }
        for y = 1, m do
            if sameLine(s1, l2[b1 + y]) then
                cur[y] = prev[y - 1] + 1
            elseif prev[y] >= cur[y - 1] then
                cur[y] = prev[y]
            else
                cur[y] = cur[y - 1]
            end
        end
        prev = cur
    end
    return prev
end

--- 后缀 LCS 长度: 返回 row[k] = LCS(l1[a1+1..a2], l2[b2-k+1..b2])。
local function lcsRowSuffix(l1, a1, a2, l2, b1, b2)
    local m = b2 - b1
    local prev = {}
    for k = 0, m do prev[k] = 0 end
    for x = a2, a1 + 1, -1 do
        local s1 = l1[x]
        local cur = { [0] = 0 }
        for k = 1, m do
            if sameLine(s1, l2[b2 - k + 1]) then
                cur[k] = prev[k - 1] + 1
            elseif prev[k] >= cur[k - 1] then
                cur[k] = prev[k]
            else
                cur[k] = cur[k - 1]
            end
        end
        prev = cur
    end
    return prev
end

--- 递归切分(Hirschberg): 内存 O(min(N,M)), 时间 O(N*M)。
local function lcsSplit(l1, a1, a2, l2, b1, b2, out)
    local n, m = a2 - a1, b2 - b1
    if n == 0 then
        for y = b1 + 1, b2 do out[#out + 1] = { "add", nil, y } end
        return
    end
    if m == 0 then
        for x = a1 + 1, a2 do out[#out + 1] = { "del", x } end
        return
    end
    if n * m <= DP_LIMIT then
        lcsDP(l1, a1, a2, l2, b1, b2, out)
        return
    end
    local mid = a1 + math.floor(n / 2)
    local fwd = lcsRowPrefix(l1, a1, mid, l2, b1, b2)
    local bwd = lcsRowSuffix(l1, mid, a2, l2, b1, b2)
    local best, bestK = -1, 0
    for k = 0, m do
        local v = fwd[k] + bwd[m - k]
        if v > best then best, bestK = v, k end
    end
    lcsSplit(l1, a1, mid, l2, b1, b1 + bestK, out)
    lcsSplit(l1, mid, a2, l2, b1 + bestK, b2, out)
end

-- ---------------------------------------------------------------
-- 变化块与 hunk
-- ---------------------------------------------------------------
--- 编辑脚本 -> 变化块(连续的非 keep 操作)。每块记 {s=起始op, e=结束op}。
local function blocksOf(ops)
    local blocks = {}
    for idx, op in ipairs(ops) do
        if op[1] ~= "keep" then
            local b = blocks[#blocks]
            if b and b.e == idx - 1 then b.e = idx else blocks[#blocks + 1] = { s = idx, e = idx } end
        end
    end
    return blocks
end

--- 每块的统计: 删除的 a 行区间、新增的 b 行区间、块前已消耗的 a/b 行数。
local function blockInfo(ops, s, e)
    local dels, adds = {}, {}
    local aBefore, bBefore = 0, 0
    for idx = 1, s - 1 do
        local op = ops[idx]
        if op[1] ~= "add" then aBefore = aBefore + 1 end
        if op[1] ~= "del" then bBefore = bBefore + 1 end
    end
    for idx = s, e do
        local op = ops[idx]
        if op[1] == "del" then dels[#dels + 1] = op[2]
        elseif op[1] == "add" then adds[#adds + 1] = op[3] end
    end
    return dels, adds, aBefore, bBefore
end

--- 按上下文行数把变化块合并成 hunk(返回 hunk 的 op 区间列表)。
local function hunksOf(ops, ctx)
    local blocks = blocksOf(ops)
    local merged = {}
    for _, b in ipairs(blocks) do
        local m = merged[#merged]
        if m and (b.s - m.e - 1) <= 2 * ctx then
            m.e = b.e
        else
            merged[#merged + 1] = { s = b.s, e = b.e }
        end
    end
    local hunks = {}
    for _, m in ipairs(merged) do
        local s = m.s - math.min(ctx, m.s - 1)
        local e = m.e + math.min(ctx, #ops - m.e)
        hunks[#hunks + 1] = { s = s, e = e }
    end
    return hunks
end

--- 一段操作区间在两侧的起止行号(1 基)与行数。
local function rangeOf(ops, s, e)
    local aCount, bCount = 0, 0
    local aBefore, bBefore = 0, 0
    for idx = 1, s - 1 do
        local op = ops[idx]
        if op[1] ~= "add" then aBefore = aBefore + 1 end
        if op[1] ~= "del" then bBefore = bBefore + 1 end
    end
    for idx = s, e do
        local op = ops[idx]
        if op[1] ~= "add" then aCount = aCount + 1 end
        if op[1] ~= "del" then bCount = bCount + 1 end
    end
    local aStart = (aCount > 0) and (aBefore + 1) or aBefore
    local bStart = (bCount > 0) and (bBefore + 1) or bBefore
    return aStart, aCount, bStart, bCount
end

-- ---------------------------------------------------------------
-- 时间戳
-- ---------------------------------------------------------------
local WDAY = { "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" }
local MON = { "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" }

--- ISO 风格(unified 头): 2026-09-11 22:05:18.000000000 +0000
local function isoStamp(t)
    return os.date("%Y-%m-%d %H:%M:%S", t) .. ".000000000 +0000"
end

--- ctime 风格(context 头, LC_ALL=C 的 GNU 输出): Fri Sep 11 22:05:18 2026
local function ctimeStamp(t)
    local d = os.date("*t", t)
    local day = (d.day < 10) and (" " .. d.day) or tostring(d.day)
    return string.format("%s %s %s %02d:%02d:%02d %d",
        WDAY[d.wday] or "?", MON[d.month] or "?", day, d.hour, d.min, d.sec, d.year)
end

-- ---------------------------------------------------------------
-- 输出
-- ---------------------------------------------------------------
local outBuf = {}
local function emit(s) outBuf[#outBuf + 1] = s end
local function flushOut()
    if #outBuf > 0 then
        io.write(table.concat(outBuf))
        outBuf = {}
    end
end

--- normal/context/ed 的行区间写法: 单行只写行号, 否则 "起始行,结束行"。
--- 注意 GNU 写的是**结束行号**不是行数(`@@ -2,4 @@` 表示 2..4 三行)。
local function rangeStr(start, len)
    if len <= 1 then return tostring(start) end
    return start .. "," .. (start + len - 1)
end

--- unified 的 `@@` 头: 写的是**行数**不是结束行号(`@@ -2,3 +2,3 @@` = 2..4 三行,
--- 与 context 格式的 `*** 2,4 ****` 不同 —— 这是两种格式各自的规范)。1 行省略 ",1",
--- 0 行写 "起始,0"(GNU: `@@ -0,0 +1,3 @@`)。
local function uniRange(start, len)
    if len == 1 then return tostring(start) end
    if len == 0 then return start .. ",0" end
    return start .. "," .. len
end

--- 打印一行内容并处理"文件末尾没有换行符"标记。
local function putLine(prefix, text, noEol)
    emit(prefix .. text .. "\n")
    if noEol then emit("\\ No newline at end of file\n") end
end

--- normal 格式。
local function fmtNormal(ops, A, B)
    for _, b in ipairs(blocksOf(ops)) do
        local dels, adds, aBefore, bBefore = blockInfo(ops, b.s, b.e)
        local head
        if #dels > 0 and #adds > 0 then
            head = rangeStr(dels[1], #dels) .. "c" .. rangeStr(adds[1], #adds)
        elseif #dels > 0 then
            -- `NdM` 里的 M 是"删除发生在原文件的第 M 行之后" = 块前已消耗的 a 行数。
            head = rangeStr(dels[1], #dels) .. "d" .. tostring(aBefore)
        else
            head = tostring(aBefore) .. "a" .. rangeStr(adds[1], #adds)
        end
        emit(head .. "\n")
        for _, ai in ipairs(dels) do
            putLine("< ", A.lines[ai], A.noEol and ai == #A.lines)
        end
        if #dels > 0 and #adds > 0 then emit("---\n") end
        for _, bi in ipairs(adds) do
            putLine("> ", B.lines[bi], B.noEol and bi == #B.lines)
        end
    end
end

--- unified 格式。
local function fmtUnified(ops, A, B, name1, name2)
    emit("--- " .. name1 .. "\t" .. isoStamp(A.mtime) .. "\n")
    emit("+++ " .. name2 .. "\t" .. isoStamp(B.mtime) .. "\n")
    for _, h in ipairs(hunksOf(ops, o.ctx)) do
        local aStart, aCount, bStart, bCount = rangeOf(ops, h.s, h.e)
        emit("@@ -" .. uniRange(aStart, aCount) .. " +" .. uniRange(bStart, bCount) .. " @@\n")
        local idx = h.s
        while idx <= h.e do
            local op = ops[idx]
            if op[1] == "keep" then
                local ai = op[2]
                putLine(" ", A.lines[ai], A.noEol and ai == #A.lines)
                idx = idx + 1
            else
                -- 一个变化块: 先列删除行, 再列新增行(GNU 顺序)
                local e = idx
                while e <= h.e and ops[e][1] ~= "keep" do e = e + 1 end
                for k = idx, e - 1 do
                    if ops[k][1] == "del" then
                        local ai = ops[k][2]
                        putLine("-", A.lines[ai], A.noEol and ai == #A.lines)
                    end
                end
                for k = idx, e - 1 do
                    if ops[k][1] == "add" then
                        local bi = ops[k][3]
                        putLine("+", B.lines[bi], B.noEol and bi == #B.lines)
                    end
                end
                idx = e
            end
        end
    end
end

--- context 格式。
local function fmtContext(ops, A, B, name1, name2)
    emit("*** " .. name1 .. "\t" .. ctimeStamp(A.mtime) .. "\n")
    emit("--- " .. name2 .. "\t" .. ctimeStamp(B.mtime) .. "\n")
    for _, h in ipairs(hunksOf(ops, o.ctx)) do
        local aStart, aCount, bStart, bCount = rangeOf(ops, h.s, h.e)
        -- 先扫出 hunk 内每个"变化块"(连续的 del/add 操作)及其两侧行数。
        -- 标记规则取决于**整块**: 块里既有删除又有新增(= 替换)时两侧都用 `!`,
        -- 纯删除用 `-`、纯新增用 `+`。左右两半必须共用这一份块信息 —— 各自从
        -- "自己那一侧的第一行"开始扫会把块切断, 于是替换块在新增侧被误判成纯新增。
        local runs, runOf = {}, {}
        local idx = h.s
        while idx <= h.e do
            if ops[idx][1] == "keep" then
                idx = idx + 1
            else
                local e, d, a = idx, 0, 0
                while e <= h.e and ops[e][1] ~= "keep" do
                    if ops[e][1] == "del" then d = d + 1 else a = a + 1 end
                    e = e + 1
                end
                runs[#runs + 1] = { s = idx, e = e - 1, d = d, a = a }
                for k = idx, e - 1 do runOf[k] = #runs end
                idx = e
            end
        end
        local hasDel, hasAdd = false, false
        for _, r in ipairs(runs) do
            if r.d > 0 then hasDel = true end
            if r.a > 0 then hasAdd = true end
        end
        emit("***************\n")
        -- 左半: 有删除行才有内容(GNU: 纯新增的 hunk 左半只留区间头, 没有行)
        emit("*** " .. rangeStr(aStart, aCount) .. " ****\n")
        if hasDel then
            for k = h.s, h.e do
                local op = ops[k]
                if op[1] == "keep" then
                    local ai = op[2]
                    putLine("  ", A.lines[ai], A.noEol and ai == #A.lines)
                elseif op[1] == "del" then
                    local r = runs[runOf[k]]
                    local mark = (r.d > 0 and r.a > 0) and "! " or "- "
                    putLine(mark, A.lines[op[2]], A.noEol and op[2] == #A.lines)
                end
            end
        end
        emit("--- " .. rangeStr(bStart, bCount) .. " ----\n")
        if hasAdd then
            for k = h.s, h.e do
                local op = ops[k]
                if op[1] == "keep" then
                    local ai = op[2]
                    putLine("  ", A.lines[ai], A.noEol and ai == #A.lines)
                elseif op[1] == "add" then
                    local r = runs[runOf[k]]
                    local mark = (r.d > 0 and r.a > 0) and "! " or "+ "
                    putLine(mark, B.lines[op[3]], B.noEol and op[3] == #B.lines)
                end
            end
        end
    end
end

--- ed 脚本(逆序, 便于按原文件行号依次执行)。
local function fmtEd(ops, A, B)
    local blocks = blocksOf(ops)
    for k = #blocks, 1, -1 do
        local b = blocks[k]
        local dels, adds, aBefore = blockInfo(ops, b.s, b.e)
        if #adds == 0 then
            emit(rangeStr(dels[1], #dels) .. "d\n")
        elseif #dels == 0 then
            emit(tostring(aBefore) .. "a\n")
            for _, bi in ipairs(adds) do emit(B.lines[bi] .. "\n") end
            emit(".\n")
        else
            emit(rangeStr(dels[1], #dels) .. "c\n")
            for _, bi in ipairs(adds) do emit(B.lines[bi] .. "\n") end
            emit(".\n")
        end
    end
end

-- ---------------------------------------------------------------
-- 读入
-- ---------------------------------------------------------------
--- 读一个操作数为 { lines, noEol, mtime, content }。missing 为真时按 -N 当空文件。
local function loadSide(path, missing)
    if missing then return { lines = {}, noEol = false, content = "", mtime = 0 } end
    if path == "-" then
        local h = io.stdin()
        if not h then error("diff: standard input is not available") end
        -- 宿主测试台的顶层 stdin 句柄只有 readLine(没有 readAll), 真机内核的 stdin 两个都有。
        -- 整块读能得到精确的"末行有没有换行符"; 逐行读是测试台兼容路径(补回换行, 与 wc 同款)。
        local content
        if h.readAll then
            content = h.readAll() or ""
        else
            local parts = {}
            while true do
                local l = h.readLine()
                if l == nil then break end
                parts[#parts + 1] = l
            end
            content = (#parts > 0) and (table.concat(parts, "\n") .. "\n") or ""
        end
        local lines, noEol = splitLines(content)
        return { lines = lines, noEol = noEol, content = content, mtime = os.time() }
    end
    local f, err = fs.open(path, "r")
    if not f then
        stderr("diff: " .. path .. ": " .. ioeMsg(err) .. "\n")
        return nil
    end
    local content = f.readAll() or ""
    f.close()
    local lines, noEol = splitLines(content)
    local attrs = fs.attributes(path) or {}
    return { lines = lines, noEol = noEol, content = content, mtime = attrs.mtime or 0 }
end

local function isBinary(side) return side.content:find("\0", 1, true) ~= nil end

--- -B: 丢弃"删除与新增的行全是空行"的变化块。
local function dropBlankBlocks(ops)
    local kept = {}
    for _, b in ipairs(blocksOf(ops)) do
        local dels, adds = blockInfo(ops, b.s, b.e)
        local allBlank = true
        for _, ai in ipairs(dels) do
            local line = ops[b.s][2] and ai and nil
        end
        -- 重新取行内容需要行表, 这里由调用方传入闭包判定
        kept[#kept + 1] = b
    end
    return kept
end

-- ---------------------------------------------------------------
-- 比较两个"文件"
-- ---------------------------------------------------------------
local differs = false
local trouble = false

--- 比较两个已读入的 side; 返回是否不同。
local function compareSides(A, B, name1, name2)
    -- 二进制: 不按文本比较(除非 -a), 也不做逐行 LCS。
    if not o.text and (isBinary(A) or isBinary(B)) then
        if A.content == B.content then return false end
        if o.brief then
            emit("Files " .. name1 .. " and " .. name2 .. " differ\n")
        else
            emit("Binary files " .. name1 .. " and " .. name2 .. " differ\n")
        end
        return true
    end
    local ops = {}
    lcsSplit(A.lines, 0, #A.lines, B.lines, 0, #B.lines, ops)
    -- -B: 丢掉"全是空行变化"的块
    if o.blank then
        local filtered = {}
        local blocks = blocksOf(ops)
        local lastE = 0
        for _, b in ipairs(blocks) do
            local dels, adds = blockInfo(ops, b.s, b.e)
            local allBlank = true
            for _, ai in ipairs(dels) do
                if A.lines[ai] ~= "" then allBlank = false break end
            end
            if allBlank then
                for _, bi in ipairs(adds) do
                    if B.lines[bi] ~= "" then allBlank = false break end
                end
            end
            if not allBlank then
                for idx = lastE + 1, b.e do filtered[#filtered + 1] = ops[idx] end
                lastE = b.e
            else
                -- 跳过整块: 保留块前的 keep, 块内的 keep 也保留
                for idx = lastE + 1, b.s - 1 do filtered[#filtered + 1] = ops[idx] end
                for idx = b.s, b.e do
                    if ops[idx][1] == "keep" then filtered[#filtered + 1] = ops[idx] end
                end
                lastE = b.e
            end
        end
        for idx = lastE + 1, #ops do filtered[#filtered + 1] = ops[idx] end
        ops = filtered
    end
    if #blocksOf(ops) == 0 then return false end
    if o.same and o.fmt == "normal" and not o.brief then
        -- GNU: -s 只在"完全相同"时多说一句, 有差异时照常输出
    end
    if #blocksOf(ops) == 0 then return false end
    -- -q: 只报告"不同"。判定必须走**同一套**比较语义(-i/-b/-w/-B), 否则
    -- `diff -iq` 会在 `diff -i` 说"相同"时反而说"不同"。
    if o.brief then
        emit("Files " .. name1 .. " and " .. name2 .. " differ\n")
        return true
    end
    if o.fmt == "unified" then
        fmtUnified(ops, A, B, name1, name2)
    elseif o.fmt == "context" then
        fmtContext(ops, A, B, name1, name2)
    elseif o.fmt == "ed" then
        fmtEd(ops, A, B)
    else
        fmtNormal(ops, A, B)
    end
    return true
end

-- ---------------------------------------------------------------
-- 目录比较
-- ---------------------------------------------------------------
local function joinPath(dir, name)
    if dir == "/" then return "/" .. name end
    return dir .. "/" .. name
end

local function compareEntry(p1, p2, d1, d2, r1, r2, top)
    local isd1, isd2 = fs.isDir(p1), fs.isDir(p2)
    local e1, e2 = fs.exists(p1), fs.exists(p2)
    if not e1 and not e2 then return end
    local n1 = (r1 == "/") and ("/" .. top) or (r1 .. "/" .. top)
    local n2 = (r2 == "/") and ("/" .. top) or (r2 .. "/" .. top)

    if e1 and not e2 then
        if not o.newfile then
            emit("Only in " .. d1 .. ": " .. top .. "\n")
            differs = true
            return
        end
    elseif e2 and not e1 then
        if not o.newfile then
            emit("Only in " .. d2 .. ": " .. top .. "\n")
            differs = true
            return
        end
    end

    if e1 and e2 and isd1 and isd2 then
        if o.recursive then
            compareDirs(p1, p2, n1, n2)
        else
            emit("Common subdirectories: " .. n1 .. " and " .. n2 .. "\n")
            differs = true
        end
        return
    end
    if e1 and isd1 and (not e2 or not isd2) and e2 then
        emit("File " .. n1 .. " is a directory while file " .. n2 .. " is a regular file\n")
        differs = true
        return
    end
    if e2 and isd2 and e1 and not isd1 then
        emit("File " .. n1 .. " is a regular file while file " .. n2 .. " is a directory\n")
        differs = true
        return
    end
    if e1 and isd1 then
        -- 目录只在左侧: -N 时递归当作整棵树被删
        compareDirs(p1, nil, n1, n2)
        return
    end
    if e2 and isd2 then
        compareDirs(nil, p2, n1, n2)
        return
    end

    local A = loadSide(e1 and p1 or nil, not e1)
    if A == nil then trouble = true return end
    local B = loadSide(e2 and p2 or nil, not e2)
    if B == nil then trouble = true return end
    local optsStr = (#optsEcho > 0) and (" " .. table.concat(optsEcho, " ")) or ""
    if not o.brief then emit("diff" .. optsStr .. " " .. n1 .. " " .. n2 .. "\n") end
    local same = not compareSides(A, B, n1, n2)
    if same and o.same then emit("Files " .. n1 .. " and " .. n2 .. " are identical\n") end
    if not same then differs = true end
end

--- 递归比较目录(允许一侧为 nil = 不存在, 只在 -N 下用到)。
function compareDirs(dir1, dir2, r1, r2)
    local names = {}
    local seen = {}
    local function addAll(dir)
        if not dir then return end
        for _, n in ipairs(fs.list(dir) or {}) do
            if n ~= "." and n ~= ".." and not seen[n] then
                seen[n] = true
                names[#names + 1] = n
            end
        end
    end
    addAll(dir1)
    addAll(dir2)
    table.sort(names)
    for _, n in ipairs(names) do
        compareEntry(dir1 and joinPath(dir1, n), dir2 and joinPath(dir2, n), dir1, dir2, r1, r2, n)
    end
end

-- ---------------------------------------------------------------
-- 主流程
-- ---------------------------------------------------------------
local raw1, raw2 = operands[1], operands[2]
local p1 = (raw1 == "-") and "-" or resolve(raw1)
local p2 = (raw2 == "-") and "-" or resolve(raw2)

local isd1 = (raw1 ~= "-") and fs.isDir(p1) or false
local isd2 = (raw2 ~= "-") and fs.isDir(p2) or false

if isd1 ~= isd2 then
    local dirRaw, dirPath, otherRaw = raw1, p1, raw2
    if isd2 then dirRaw, dirPath, otherRaw = raw2, p2, raw1 end
    local name = otherRaw:gsub(".*/", "")
    stderr("diff: " .. joinPath(dirRaw, name) .. ": No such file or directory\n")
    return 2
end

if isd1 and isd2 then
    compareDirs(p1, p2, raw1, raw2)
else
    -- `-` 是标准输入: 它没有路径, 不能去 fs.exists 里查(否则会被当成不存在的文件)。
    local e1 = (raw1 == "-") or fs.exists(p1)
    local e2 = (raw2 == "-") or fs.exists(p2)
    if not e1 and not o.newfile then
        stderr("diff: " .. p1 .. ": No such file or directory\n")
        trouble = true
    end
    if not e2 and not o.newfile then
        stderr("diff: " .. p2 .. ": No such file or directory\n")
        trouble = true
    end
    if not trouble then
        local A = loadSide((raw1 == "-") and "-" or p1, not e1)
        if A == nil then trouble = true end
        local B
        if not trouble then
            B = loadSide((raw2 == "-") and "-" or p2, not e2)
            if B == nil then trouble = true end
        end
        if not trouble then
            local same = not compareSides(A, B, raw1, raw2)
            if same and o.same then emit("Files " .. raw1 .. " and " .. raw2 .. " are identical\n") end
            if not same then differs = true end
        end
    end
end

flushOut()
if trouble then return 2 end
if differs then return 1 end
return 0
