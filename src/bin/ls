-- Delin ls: 列目录 (GNU 子集)。用法: ls [OPTION]... [FILE]...
-- 选项:
--   -a, --all            显示所有条目, 含 . 与 ..
--   -A, --almost-all     显示所有条目, 但不含 . 与 ..
--   -l, --long           长格式: 权限 链接 属主 组 大小 时间 名字
--   -h, --human-readable 与 -l 配合, 大小用 K/M/G
--   -d, --directory      仅列出目录本身, 不进入其内容
--   -R, --recursive      递归列出子目录
--   -t                  按修改时间排序(新的在前)
--   -r, --reverse        逆序输出
-- 支持短选项组合(-la)与 -- 结束选项。FILE 缺省为当前目录。
-- 让出调度器: 防止长输出/长计算饿死事件循环(CC 的 ~7s no-yield 限制)。
-- 时间片式: 每累计 ~50ms CPU 时间让出一次, 不按字节让出 —— HSE 已改拉模式(waitNextTick),
-- 每次让出都是一次事件往返, 高频让出会淹没事件队列并拖死键盘。50ms 时间片同时保证
-- 长命令运行期间按键/^C 的投递延迟不超过一个时间片。
local _msleep = os.msleep or function(ms) os.sleep(math.max((ms or 0) / 1000, 0.05)) end
local _sliceAt = os.epoch("utc")
local function yieldCheck(_n)
    local now = os.epoch("utc")
    if now - _sliceAt >= 50 then
        _sliceAt = now
        _msleep(0)
    end
end

local args = args or {}
local cwd = (type(cwd) == "string" and cwd) or "/"
local function resolve(p)
    p = p or ""
    if p == "" or p == "." then
        return (cwd == "/") and "/" or cwd
    end
    if p:sub(1, 1) == "/" then
        if p == "/" then return "/" end
        return p:gsub("/+$", "")
    end
    local base = (cwd == "/") and "" or cwd
    return (base .. "/" .. p):gsub("/+", "/"):gsub("/+$", "")
end

local function stderr(s)
    local e = io.stderr()
    if e and e.write then e:write(s) end
end
local function ioeMsg(err)
    if err and (err:find("permission") or err:find("denied")) then return "Permission denied" end
    return "No such file or directory"
end

-- 读 fs.lstat(不跟随符号链接, 等价 Linux ls -l 的 lstat), 兼容 ext2(mode/uid/gid/mtime/links)
-- 与 CC 原生(modificationTime)。用 fs.lstat 而不是 fs.attributes 才看得到链接本身:
-- 否则 `ls -l link` 显示的是目标, 类型字符也不是 "l"。
local function attrs(p, follow)
    if fs.lstat or fs.attributes then
        local fn = (follow and fs.attributes) or fs.lstat or fs.attributes
        local a = fn(p)
        if a then
            if not a.mtime and a.modificationTime then a.mtime = a.modificationTime end
            return a
        end
    end
    return { size = (fs.getSize and fs.getSize(p)) or 0, isDir = fs.isDir(p), isReadOnly = false }
end

-- ---------------------------------------------------------------
-- 选项解析
-- ---------------------------------------------------------------
local optAll, optAlmost, optLong, optHuman = false, false, false, false
local optDir, optRecursive, optReverse, optTime = false, false, false, false
local optInode, optNumeric, optClassify, optSlash = false, false, false, false
local optSizeSort, optNoSort, optExtSort = false, false, false
local optQuote, optDeref, optDerefCmdline = false, false, false
local optNoGroup, optNoOwner = false, false
local optBlocks, optCtime, optAtime = false, false, false
local optColorWhen = "never"

local paths = {}
local noMoreOpts = false

local function setShort(ch)
    if ch == "a" then optAll = true
    elseif ch == "A" then optAlmost = true
    elseif ch == "l" then optLong = true
    elseif ch == "h" then optHuman = true
    elseif ch == "d" then optDir = true
    elseif ch == "R" then optRecursive = true
    elseif ch == "r" then optReverse = true
    elseif ch == "t" then optTime = true
    elseif ch == "1" then optLong = false
    elseif ch == "i" then optInode = true
    elseif ch == "n" then optLong, optNumeric = true, true
    elseif ch == "F" then optClassify = true
    elseif ch == "p" then optSlash = true
    elseif ch == "S" then optSizeSort = true
    elseif ch == "U" then optNoSort = true
    elseif ch == "X" then optExtSort = true
    elseif ch == "Q" then optQuote = true
    elseif ch == "L" then optDeref = true
    elseif ch == "H" then optDerefCmdline = true
    elseif ch == "G" or ch == "o" then optNoGroup = true
    elseif ch == "g" then optLong, optNoOwner = true, true
    elseif ch == "s" then optBlocks = true
    elseif ch == "c" then optCtime = true
    elseif ch == "u" then optAtime = true
    else stderr("ls: invalid option -- '" .. ch .. "'\n"); return false end
    return true
end

for _, a in ipairs(args) do
    if noMoreOpts then
        paths[#paths + 1] = a
    elseif a == "--" then
        noMoreOpts = true
    elseif a == "--all" then optAll = true
    elseif a == "--almost-all" then optAlmost = true
    elseif a == "--long" then optLong = true
    elseif a == "--human-readable" then optHuman = true
    elseif a == "--directory" then optDir = true
    elseif a == "--recursive" then optRecursive = true
    elseif a == "--reverse" then optReverse = true
    elseif a == "--sort=time" then optTime = true
    elseif a == "--inode" then optInode = true
    elseif a == "--numeric-uid-gid" then optLong, optNumeric = true, true
    elseif a == "--classify" or a == "--file-type" then optClassify = true
    elseif a == "--indicator-style=slash" then optSlash = true
    elseif a == "--indicator-style=none" then optClassify, optSlash = false, false
    elseif a == "--quote-name" then optQuote = true
    elseif a == "--dereference" or a == "--dereference-command-line" then optDeref = true
    elseif a == "--no-group" then optNoGroup = true
    elseif a == "--color=always" or a == "--colour=always" then optColorWhen = "always"
    elseif a == "--color=never" or a == "--colour=never" then optColorWhen = "never"
    elseif a == "--color=auto" or a == "--colour=auto" or a == "--color" or a == "--colour" then
        optColorWhen = "auto"
    elseif a == "--full-time" or a:match("^%-%-time%-style") then
        stderr("ls: option '" .. a .. "' is not supported\n")
        return 2
    elseif a:sub(1, 2) == "--" then
        stderr("ls: unrecognized option '" .. a .. "'\n")
        return 2
    elseif a:sub(1, 1) == "-" and a ~= "-" then
        for k = 2, #a do if not setShort(a:sub(k, k)) then return 2 end end
    else
        paths[#paths + 1] = a
    end
end
if #paths == 0 then paths = { "." } end

-- ---------------------------------------------------------------
-- 长格式辅助
-- ---------------------------------------------------------------
local function rwx(b)
    local r = (math.floor(b / 4) % 2 == 1) and "r" or "-"
    local w = (math.floor(b / 2) % 2 == 1) and "w" or "-"
    local x = (b % 2 == 1) and "x" or "-"
    return r .. w .. x
end
local function modeStr(a)
    -- 类型字符与 Linux ls 一致: l 符号链接 / p 命名管道 / c,b 字符与块设备 / d 目录 / - 普通文件。
    local k = a.kind
    local tchar = (k == "symlink" and "l")
        or (k == "fifo" and "p")
        or (a.isDir and "d")
        or (k == "device" and "c")
        or "-"
    local perm
    if a.mode then
        local bits = a.mode % 512
        perm = rwx(math.floor(bits / 64) % 8) .. rwx(math.floor(bits / 8) % 8) .. rwx(bits % 8)
    elseif a.isDir then
        perm = "rwxr-xr-x"
    else
        perm = "rw-r--r--"
    end
    return tchar .. perm
end
local function ownerName(uid)
    if not uid then return "0" end
    -- 先试按 uid 反查(ext2 有 uid; CC 原生无), 失败则显示数字。
    if syscalls and syscalls["user.byUid"] then
        local u = syscalls["user.byUid"](uid)
        if u and u.name then return u.name end
    end
    return tostring(uid)
end
local function human(n)
    n = tonumber(n) or 0
    local units = { "", "K", "M", "G", "T" }
    local i, v = 1, n
    while v >= 1024 and i < #units do v = v / 1024; i = i + 1 end
    if i == 1 then return tostring(n) end
    return string.format("%.1f%s", v, units[i])
end
--- 长格式里显示哪个时间: 缺省 mtime; -c 用 ctime; -u 用 atime(GNU 语义, 后给的赢)。
local function entryTime(a)
    if optCtime and a.ctime then return a.ctime end
    if optAtime and a.atime then return a.atime end
    return a.mtime
end

--- 已分配块数(512 字节单位, 与 stat(2) 的 st_blocks 一致); 没有就退回表观大小折算。
local function blocksOf(a)
    if a.blocks then return a.blocks end
    local sz = a.size or 0
    if sz == 0 then return 0 end
    return math.ceil(sz / 512)
end

local function fmtTime(t)
    if not t or t <= 0 then return "             " end
    local ok, mon = pcall(os.date, "%b", t)
    if not ok or not mon then return "             " end
    local day = os.date("%d", t)
    if day:sub(1, 1) == "0" then day = " " .. day:sub(2) end
    local y, curY = os.date("%Y", t), os.date("%Y")
    local hhmm = os.date("%H:%M", t)
    if y == curY then
        return mon .. " " .. day .. " " .. hhmm
    end
    return mon .. " " .. day .. "  " .. y
end
--- 名字末尾的类型指示符(-F / -p): GNU ls 的 */=@| 与"可执行 *"。
local function indicator(a, p)
    if a.isDir then return "/" end
    if a.kind == "symlink" then return "@" end
    if a.kind == "fifo" then return "|" end
    if a.kind == "socket" then return "=" end
    if optClassify and p then
        local x = fs.canExecute and fs.canExecute(p)
        if x == nil and a.mode then
            -- 没有 canExecute 时退回看 mode 的三个 x 位(root 也要至少一个 x 才算可执行)
            local bits = a.mode % 512
            x = (math.floor(bits / 64) % 8 % 2 == 1) or (math.floor(bits / 8) % 8 % 2 == 1)
                or (bits % 8 % 2 == 1)
        end
        if x then return "*" end
    end
    return ""
end

--- 名字装饰: 指示符 + -Q 的双引号(-Q 与 -F 可同用, 与 GNU 一致: 引号在外)。
local function decorate(a, name, p)
    local ind = ""
    if optClassify then ind = indicator(a, p)
    elseif optSlash and a.isDir then ind = "/" end
    if optQuote then return '"' .. name .. '"' .. ind end
    return name .. ind
end

--- --color[=WHEN]: 按文件类型上色。默认表取 Linux LS_COLORS 的常用项(可被环境覆盖)。
local colorOn = false
do
    if optColorWhen == "always" then colorOn = true
    elseif optColorWhen == "auto" then
        local out = io.stdout()
        colorOn = (out and out.isTTY) and true or false
    end
end
local LSCOL = { di = "01;34", ln = "01;36", ex = "01;32", pi = "40;33", so = "01;35",
                bd = "40;33;01", cd = "40;33;01", ["or"] = "40;31;01", mi = "00" }
do
    local spec = os.getenv and os.getenv("LS_COLORS") or nil
    if spec and spec ~= "" then
        for item in (spec .. ":"):gmatch("([^:]*):") do
            local k, v = item:match("^([%a]+)=(.*)$")
            if k and LSCOL[k] ~= nil then LSCOL[k] = v end
        end
    end
end
local function colorizeName(a, p, text)
    if not colorOn then return text end
    local key = a.isDir and "di" or (a.kind == "symlink" and "ln") or (a.kind == "fifo" and "pi")
        or (a.kind == "socket" and "so")
        or ((not a.isDir) and fs.canExecute and fs.canExecute(p) and "ex" or nil)
    local code = key and LSCOL[key]
    if not code or code == "" or code == "0" or code == "00" then return text end
    return "\27[" .. code .. "m" .. text .. "\27[0m"
end
local function lineLong(a, name, p)
    local s = ""
    if optInode then s = string.format("%7s ", tostring(a.ino or 0)) end
    if optBlocks then
        local blk = blocksOf(a)
        local txt = optHuman and human(blk * 512) or tostring(blk)
        if optHuman then txt = string.format("%4s", txt) else txt = string.format("%4s", txt) end
        s = s .. txt .. " "
    end
    s = s .. modeStr(a)
    s = s .. " " .. string.format("%2d", a.links or 1)
    if not optNoOwner then
        s = s .. " " .. (optNumeric and tostring(a.uid or 0) or ownerName(a.uid))
    end
    if not optNoGroup then
        local gname = tostring(a.gid or 0)
        if not optNumeric and a.gid and syscalls and syscalls["user.groupByGid"] then
            local g = syscalls["user.groupByGid"](a.gid)
            if g and g.name then gname = g.name end
        end
        s = s .. " " .. gname
    end
    s = s .. " " .. string.format("%8s", optHuman and human(a.size) or tostring(a.size or 0))
    s = s .. " " .. fmtTime(entryTime(a))
    local shown = decorate(a, name, p)
    s = s .. " " .. colorizeName(a, p, shown)
    -- 符号链接要显示指向(GNU: "name -> target"), 除非 -L/-H 已经把链接解开了
    if a.kind == "symlink" and not (optDeref or optDerefCmdline) and fs.readlink then
        local tgt = fs.readlink(p)
        if tgt then s = s .. " -> " .. tgt end
    end
    io.write(s .. "\n")
    yieldCheck(#s + 1)
end

-- ---------------------------------------------------------------
-- 目录扫描与渲染
-- ---------------------------------------------------------------
local function entry(p, follow)
    local a = attrs(p, follow)
    return { isDir = a.isDir, size = a.size, mode = a.mode, uid = a.uid, gid = a.gid,
             mtime = a.mtime, atime = a.atime, ctime = a.ctime, blocks = a.blocks,
             links = a.links, kind = a.kind, isReadOnly = a.isReadOnly, ino = a.ino }
end
local function classifyHidden(name)
    return name:sub(1, 1) == "."
end

local function renderOne(full, name)
    local a = entry(full, optDeref)
    if optLong then
        lineLong(a, name, full)
    else
        local out = ""
        if optInode then out = string.format("%7s ", tostring(a.ino or 0)) end
        if optBlocks then
            local blk = blocksOf(a)
            out = out .. string.format("%4s ", optHuman and human(blk * 512) or tostring(blk))
        end
        out = out .. colorizeName(a, full, decorate(a, name, full)) .. "\n"
        io.write(out)
        yieldCheck(#out)
    end
end

local function sortNames(out, dir)
    local function full(x) return (dir == "/") and ("/" .. x) or (dir .. "/" .. x) end
    if optNoSort then
        -- -U: 不排序(目录顺序)
    elseif optSizeSort then
        table.sort(out, function(x, y)
            local ax, ay = entry(full(x)), entry(full(y))
            if (ax.size or 0) ~= (ay.size or 0) then return (ax.size or 0) > (ay.size or 0) end
            return x < y
        end)
    elseif optExtSort then
        table.sort(out, function(x, y)
            local ex = x:match("%.([^.]*)$") or ""
            local ey = y:match("%.([^.]*)$") or ""
            if ex ~= ey then return ex < ey end
            return x < y
        end)
    elseif optTime then
        table.sort(out, function(x, y)
            local ax = entry(full(x))
            local ay = entry(full(y))
            -- -t 的排序键与"显示哪个时间"一致(GNU: -c/-u 也换排序键)
            local tx = entryTime(ax) or 0
            local ty = entryTime(ay) or 0
            if tx ~= ty then return tx > ty end
            return x < y
        end)
    else
        table.sort(out)
    end
    if optReverse then
        local rev = {}
        for i = #out, 1, -1 do rev[#rev + 1] = out[i] end
        return rev
    end
    return out
end

local function printDir(p)
    local names, lerr = fs.list(p)
    if not names then
        stderr("ls: " .. p .. ": " .. ioeMsg(lerr) .. "\n")
        return false
    end
    local hideAll = not (optAll or optAlmost)
    local out = {}
    if optAll then out[#out + 1] = "."; out[#out + 1] = ".." end
    for _, name in ipairs(names) do
        if not (hideAll and classifyHidden(name)) then out[#out + 1] = name end
    end
    out = sortNames(out, p)
    -- GNU: 目录列表在长格式/块数格式下先打一行 "total <块数>"(1K 单位 = 512 字节块数 / 2)
    if optLong or optBlocks then
        local half = 0
        for _, name in ipairs(out) do
            half = half + blocksOf(entry((p == "/") and ("/" .. name) or (p .. "/" .. name)))
        end
        io.write("total " .. tostring(math.ceil(half / 2)) .. "\n")
    end
    for _, name in ipairs(out) do
        local full = (p == "/") and ("/" .. name) or (p .. "/" .. name)
        renderOne(full, name)
    end
    return true
end

-- 递归进入子目录(跳过隐藏目录, 除非 -a/-A; 永不进入 . / ..)。
local function recurse(p)
    local names = fs.list(p) or {}
    table.sort(names)
    for _, name in ipairs(names) do
        if (not classifyHidden(name)) or (optAll or optAlmost) then
            if name ~= "." and name ~= ".." then
                local full = (p == "/") and ("/" .. name) or (p .. "/" .. name)
                if fs.isDir(full) then
                    io.write("\n" .. full .. ":\n")
                    printDir(full)
                    recurse(full)
                end
            end
        end
    end
end

-- ---------------------------------------------------------------
-- 主循环
-- ---------------------------------------------------------------
for pi, raw in ipairs(paths) do
    local path = resolve(raw)
    if not fs.exists(path) then
        stderr("ls: " .. raw .. ": No such file or directory\n")
    elseif fs.isDir(path) and not optDir then
        if #paths > 1 then io.write(path .. ":\n") end
        printDir(path)
        if optRecursive then recurse(path) end
        if pi < #paths then io.write("\n") end
    else
        local a = entry(path, optDeref or optDerefCmdline)
        if optLong then
            lineLong(a, raw, path)
        else
            local pre = ""
            if optInode then pre = pre .. string.format("%7s ", tostring(a.ino or 0)) end
            if optBlocks then
                pre = pre .. string.format("%4s ", optHuman and human(blocksOf(a) * 512) or tostring(blocksOf(a)))
            end
            io.write(pre .. colorizeName(a, path, decorate(a, raw, path)) .. "\n")
        end
    end
end
