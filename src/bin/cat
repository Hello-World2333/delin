-- Delin cat: 连接并打印文件。用法: cat <file>...
local args = args or {}
local cwd = (type(cwd) == "string" and cwd) or "/"
local function resolve(p)
    p = p or ""
    if p:sub(1, 1) == "/" then
        if p == "/" then return "/" end
        return p:gsub("/+$", "")
    end
    local base = (cwd == "/") and "" or cwd
    return (base .. "/" .. p):gsub("/+", "/")
end
local function stderr(s)
    local e = io.stderr()
    if e and e.write then e:write(s) end
end

local function catFile(p)
    p = resolve(p)
    local f, err = fs.open(p, "r")
    if not f then
        -- 区分"不存在"(ENOENT)、"无读权限"(EACCES)、"是目录"(EISDIR)。
        local msg = "No such file or directory"
        if err and (err:find("permission") or err:find("denied")) then
            msg = "Permission denied"
        elseif err and err:find("directory") then
            msg = "Is a directory"
        end
        stderr("cat: " .. p .. ": " .. msg .. "\n")
        return false
    end
    io.write(f.readAll())
    f.close()
    return true
end

local noMoreOpts = false
for _, a in ipairs(args) do
    if noMoreOpts then
        if not catFile(a) then return end
    elseif a == "--" then
        noMoreOpts = true
    elseif a:sub(1, 1) == "-" and a ~= "-" then
        stderr("cat: invalid option -- " .. a .. "\n")
        return
    else
        if not catFile(a) then return end
    end
end
