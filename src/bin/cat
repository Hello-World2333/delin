-- Delin cat: 连接并打印文件 (GNU 子集)。用法: cat [OPTION]... [FILE]...
-- 选项:
--   -n, --number          对所有输出行编号
--   -b, --number-nonblank 对非空行编号(空行不编号)
--   -s, --squeeze-blank   连续多个空行压缩为一个
--   -E, --show-ends       每行末尾显示 $
--   -T, --show-tabs       制表符显示为 ^I
--   -A, --show-all        等价于 -vET
--   -v, --show-nonprinting 以 ^ 与 M- 记号显示不可打印字符
--   -u                    忽略(无缓冲)
-- FILE 为 "-" 或缺省时读 stdin。支持组合短选项与 --。
-- 让出调度器: 防止长输出/长计算饿死事件循环(CC 的 ~7s no-yield 限制)。
-- 时间片式: 每累计 ~50ms CPU 时间让出一次, 不按字节让出 —— HSE 已改拉模式(waitNextTick),
-- 每次让出都是一次事件往返, 高频让出会淹没事件队列并拖死键盘。50ms 时间片同时保证
-- 长命令运行期间按键/^C 的投递延迟不超过一个时间片。
local _msleep = os.msleep or function(ms) os.sleep(math.max((ms or 0) / 1000, 0.05)) end
local _sliceAt = os.epoch("utc")
local function yieldCheck(_n)
    local now = os.epoch("utc")
    if now - _sliceAt >= 50 then
        _sliceAt = now
        _msleep(0)
    end
end

-- 安装 SIGINT handler: 收到 ^C 时跳出输出循环, 而非依赖默认终止。
-- 默认终止依赖调度器在下一次 resume 前检查信号; 若进程正在输出(未阻塞在 pullEvent),
-- 可能要等到下次 yield 才终止, 期间继续输出。
local _interrupted = false
if syscalls and syscalls["signal.install"] then
    syscalls["signal.install"](2, function() _interrupted = true end)
end

local args = args or {}
local cwd = (type(cwd) == "string" and cwd) or "/"
local function resolve(p)
    p = p or ""
    if p == "" then return (cwd == "/") and "/" or cwd end
    if p:sub(1, 1) == "/" then
        if p == "/" then return "/" end
        return p:gsub("/+$", "")
    end
    local base = (cwd == "/") and "" or cwd
    return (base .. "/" .. p):gsub("/+", "/")
end
local function stderr(s)
    local e = io.stderr()
    if e and e.write then e:write(s) end
end

local optNum, optNumNb, optSqueeze, optEnds, optTabs, optShowAll, optNonprint = false, false, false, false, false, false, false
local files = {}
local noMoreOpts = false

local function setShort(ch)
    if ch == "n" then optNum = true
    elseif ch == "b" then optNumNb = true
    elseif ch == "s" then optSqueeze = true
    elseif ch == "E" then optEnds = true
    elseif ch == "T" then optTabs = true
    elseif ch == "A" then optShowAll = true; optNonprint = true; optEnds = true; optTabs = true
    elseif ch == "v" then optNonprint = true
    elseif ch == "e" then optNonprint = true; optEnds = true
    elseif ch == "t" then optNonprint = true; optTabs = true
    elseif ch == "u" then -- 忽略
    else stderr("cat: invalid option -- '" .. ch .. "'\n"); return false end
    return true
end

for _, a in ipairs(args) do
    if noMoreOpts then
        files[#files + 1] = a
    elseif a == "--" then
        noMoreOpts = true
    elseif a == "--number" then optNum = true
    elseif a == "--number-nonblank" then optNumNb = true
    elseif a == "--squeeze-blank" then optSqueeze = true
    elseif a == "--show-ends" then optEnds = true
    elseif a == "--show-tabs" then optTabs = true
    elseif a == "--show-all" then optShowAll, optNonprint, optEnds, optTabs = true, true, true, true
    elseif a == "--show-nonprinting" then optNonprint = true
    elseif a:sub(1, 1) == "-" and a ~= "-" then
        for k = 2, #a do if not setShort(a:sub(k, k)) then return 1 end end
    else
        files[#files + 1] = a
    end
end
if #files == 0 then files = { "-" } end

-- 渲染一行。
local function showLine(s)
    if not (optNonprint or optEnds or optTabs) then return s end
    local out = {}
    for i = 1, #s do
        local b = s:byte(i)
        if b == 9 then
            out[#out + 1] = (optTabs and "^I") or "\t"
        elseif b < 32 then
            out[#out + 1] = "^" .. string.char(b + 64)
        elseif b == 127 then
            out[#out + 1] = "^?"
        elseif b >= 128 then
            out[#out + 1] = "M-" .. showLine(string.char(b - 128))
        else
            out[#out + 1] = s:sub(i, i)
        end
    end
    return table.concat(out)
end

local nLine, nNb, blankRun = 0, 0, 0

local function emit(fh)
    while not _interrupted do
        local line = fh.readLine()
        if line == nil then break end
        nLine = nLine + 1
        local isBlank = (line == "")
        if isBlank then
            blankRun = blankRun + 1
        else
            blankRun = 0
            nNb = nNb + 1
        end
        -- -s: 连续空行只打第一个
        if optSqueeze and isBlank and blankRun > 1 then
            -- 跳过该空行
        else
            local prefix = ""
            if optNum then
                prefix = string.format("%6d\t", nLine)
            elseif optNumNb then
                if not isBlank then prefix = string.format("%6d\t", nNb) end
            end
            local body = showLine(line)
            if optEnds then body = body .. "$" end
            local out = prefix .. body .. "\n"
            io.write(out)
            yieldCheck(#out)
        end
    end
end

local function catFile(p)
    if p == "-" then
        local stdin = io.stdin()
        if stdin then emit(stdin) else return true end
        return true
    end
    p = resolve(p)
    local f, err = fs.open(p, "r")
    if not f then
        local msg = "No such file or directory"
        if err and (err:find("permission") or err:find("denied")) then msg = "Permission denied"
        -- 先判 ENOENT: "No such file or directory" 里含 "directory",
        -- 先匹 "directory" 会把"文件不存在"误报成"Is a directory"(老模板的 bug)。
        elseif err and err:lower():find("no such file") then msg = "No such file or directory"
        elseif err and err:find("directory") then msg = "Is a directory" end
        stderr("cat: " .. p .. ": " .. msg .. "\n")
        return false
    end
    emit(f)
    f.close()
    return true
end

-- POSIX cat: 某个文件出错时**继续处理其余操作数**, 但最终退出码必须非 0
-- (老实现是出错就裸 return, 于是 `cat /nope` 报完错却返回 0)。
local rc = 0
for _, a in ipairs(files) do
    if _interrupted then return 130 end
    if not catFile(a) then rc = 1 end
end
return rc
