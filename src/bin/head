-- Delin head: 打印文件开头 (GNU 子集)。用法: head [OPTION]... [FILE]...
-- 选项:
--   -n N, --lines=N    前 N 行(缺省 10); -n -N 表示"除末尾 N 行外的全部"
--   -c N, --bytes=N    前 N 字节;        -c -N 表示"除末尾 N 字节外的全部"
--   -q, --quiet        多文件时不打印文件名头
--   -v, --verbose      总是打印文件名头
--   -z, --zero-terminated  以 NUL 而不是换行作为记录分隔符
--   -N / -nN / -cN     粘连形式亦支持; 组合短选项(-qv)亦支持; 无 FILE 或 FILE 为 "-" 时读 stdin。
-- 负计数(-n -N)必须先读完整个输入才知道边界 —— 与 GNU 一致, 此时按整文件缓冲处理。
local args = args or {}
local cwd = (type(cwd) == "string" and cwd) or "/"
local function resolve(p)
    p = p or ""
    if p == "" then return (cwd == "/") and "/" or cwd end
    if p:sub(1, 1) == "/" then
        if p == "/" then return "/" end
        return p:gsub("/+$", "")
    end
    local base = (cwd == "/") and "" or cwd
    return (base .. "/" .. p):gsub("/+", "/")
end
local function stderr(s)
    local e = io.stderr()
    if e and e.write then e:write(s) end
end
local function ioeMsg(err)
    if err and (err:find("permission") or err:find("denied")) then return "Permission denied" end
    -- 必须先判 ENOENT: "No such file or directory" 里本来就含 "directory" 这个词,
    -- 先匹 "directory" 会把"文件不存在"误报成 "Is a directory"(老模板的 bug)。
    if err and err:lower():find("no such file") then return "No such file or directory" end
    if err and err:find("directory") then return "Is a directory" end
    return "No such file or directory"
end

local n, mode = 10, "lines" -- mode = "lines" | "bytes"
local negative = false      -- -n -N / -c -N: 除末尾 N 条外的全部
local zeroTerm = false
local files = {}
local quiet, verbose = false, false
local noMoreOpts = false

--- 解析计数: "-N" 表示"除末尾 N 条外"(GNU head), 其余是"前 N 条"。
local function setCount(val, m)
    val = tostring(val or "")
    local sign, digits = val:match("^%s*([+%-]?)(%d+)")
    if not digits then return false end
    local c = tonumber(digits)
    if c < 0 then return false end
    n, mode = c, m
    negative = (sign == "-")
    return true
end

local i = 1
while i <= #args do
    local a = args[i]
    if noMoreOpts then
        files[#files + 1] = a
    elseif a == "--" then
        noMoreOpts = true
    elseif a == "--quiet" or a == "--silent" then quiet, verbose, quiet = true, false, false
    elseif a == "--verbose" then verbose, quiet = true, false
    elseif a == "--zero-terminated" then zeroTerm = true
    elseif a:match("^%-%-lines=") then
        if not setCount(a:sub(9), "lines") then stderr("head: invalid number of lines: '" .. a:sub(9) .. "'\n"); return 1 end
    elseif a:match("^%-%-bytes=") then
        if not setCount(a:sub(9), "bytes") then stderr("head: invalid number of bytes: '" .. a:sub(9) .. "'\n"); return 1 end
    elseif a == "-n" or a == "--lines" then
        i = i + 1
        if not args[i] then stderr("head: option requires an argument -- 'n'\n"); return 1 end
        if not setCount(args[i], "lines") then stderr("head: invalid number of lines: '" .. args[i] .. "'\n"); return 1 end
    elseif a == "-c" or a == "--bytes" then
        i = i + 1
        if not args[i] then stderr("head: option requires an argument -- 'c'\n"); return 1 end
        if not setCount(args[i], "bytes") then stderr("head: invalid number of bytes: '" .. args[i] .. "'\n"); return 1 end
    elseif a:sub(1, 2) == "--" then
        stderr("head: unrecognized option '" .. a .. "'\n")
        return 1
    elseif a:sub(1, 1) == "-" and a ~= "-" then
        if a:match("^%-(%d+)$") then
            setCount(a:sub(2), "lines")
        else
            local k = 2
            while k <= #a do
                local ch = a:sub(k, k)
                if ch == "n" or ch == "c" then
                    local rest = a:sub(k + 1)
                    if rest == "" then
                        i = i + 1
                        rest = args[i]
                        if not rest then stderr("head: option requires an argument -- '" .. ch .. "'\n"); return 1 end
                    end
                    local what = (ch == "n") and "lines" or "bytes"
                    if not setCount(rest, what) then stderr("head: invalid number of " .. what .. ": '" .. rest .. "'\n"); return 1 end
                    k = #a + 1
                else
                    if ch == "q" then quiet, verbose, quiet = true, false, false
                    elseif ch == "v" then verbose, quiet = true, false
                    elseif ch == "z" then zeroTerm = true
                    else stderr("head: invalid option -- '" .. ch .. "'\n"); return 1 end
                    k = k + 1
                end
            end
        end
    else
        files[#files + 1] = a
    end
    i = i + 1
end
if #files == 0 then files = { "-" } end

local total = #files
local showHeader = (not quiet) and (total > 1 or verbose)

local function header(name)
    if not showHeader then return end
    local disp = (name == "-") and "standard input" or name
    io.write("==> " .. disp .. " <==\n")
end

--- 整个输入读成字符串(-z 与负计数都要整份数据)。
local function slurp(fh)
    if fh.readAll then return fh:readAll() or "" end
    local buf = {}
    while true do
        local line = fh:readLine()
        if line == nil then break end
        buf[#buf + 1] = line
    end
    return table.concat(buf, "\n")
end

local function emitLines(fh)
    if negative or zeroTerm then
--- 按分隔符切记录(不丢"末尾没有分隔符"的残段, 也不把结尾分隔符算成空记录)。
local function splitRecords(s, sep)
    local recs, pos = {}, 1
    while true do
        local at = s:find(sep, pos, true)
        if not at then
            if pos <= #s then recs[#recs + 1] = s:sub(pos) end
            return recs
        end
        recs[#recs + 1] = s:sub(pos, at - 1)
        pos = at + 1
    end
end

        local sep = zeroTerm and "\0" or "\n"
        local recs = splitRecords(slurp(fh), sep)
        local stop = negative and math.max(0, #recs - n) or math.min(n, #recs)
        for k = 1, stop do io.write(recs[k] .. sep) end
        return
    end
    local c = 0
    while c < n do
        local line = fh:readLine()
        if line == nil then break end
        io.write(line .. "\n")
        c = c + 1
    end
end

local function emitBytes(fh)
    if negative then
        local s = slurp(fh)
        io.write(s:sub(1, math.max(0, #s - n)))
        return
    end
    local remaining = n
    if fh and fh.read then
        local hadData = false
        while remaining > 0 do
            local chunk = fh:read(remaining)
            if not chunk or chunk == "" then break end
            hadData = true
            io.write(chunk)
            remaining = remaining - #chunk
        end
        if hadData then return end
    end
    -- 生数据读取不可用(如 stdin): 逐行缓冲后截取前 n 字节。
    local s = slurp(fh)
    io.write(s:sub(1, n))
end

local function emit(fh)
    if mode == "bytes" then emitBytes(fh) else emitLines(fh) end
end

for _, raw in ipairs(files) do
    if raw == "-" then
        header("-")
        local stdin = io.stdin()
        if stdin then emit(stdin) end
    else
        local p = resolve(raw)
        local f, err = fs.open(p, "r")
        if not f then
            stderr("head: " .. p .. ": " .. ioeMsg(err) .. "\n")
            return 1
        end
        header(raw)
        emit(f)
        f:close()
    end
end
return 0
