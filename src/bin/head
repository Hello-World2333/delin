-- Delin head: 打印文件开头 (GNU 子集)。用法: head [OPTION]... [FILE]...
-- 选项:
--   -n N, --lines=N    打印前 N 行(缺省 10)
--   -c N, --bytes=N    打印前 N 字节
--   -q, --quiet        多文件时不打印文件名头
--   -v, --verbose      总是打印文件名头
--   -N / -nN / -cN     粘连形式亦支持; 无 FILE 或 FILE 为 "-" 时读 stdin。
local args = args or {}
local cwd = (type(cwd) == "string" and cwd) or "/"
local function resolve(p)
    p = p or ""
    if p == "" then return (cwd == "/") and "/" or cwd end
    if p:sub(1, 1) == "/" then
        if p == "/" then return "/" end
        return p:gsub("/+$", "")
    end
    local base = (cwd == "/") and "" or cwd
    return (base .. "/" .. p):gsub("/+", "/")
end
local function stderr(s)
    local e = io.stderr()
    if e and e.write then e:write(s) end
end
local function ioeMsg(err)
    if err and (err:find("permission") or err:find("denied")) then return "Permission denied" end
    -- 必须先判 ENOENT: "No such file or directory" 里本来就含 "directory" 这个词,
    -- 先匹 "directory" 会把"文件不存在"误报成 "Is a directory"(老模板的 bug)。
    if err and err:lower():find("no such file") then return "No such file or directory" end
    if err and err:find("directory") then return "Is a directory" end
    return "No such file or directory"
end

local n, mode = 10, "lines" -- mode = "lines" | "bytes"
local files = {}
local quiet, verbose = false, false
local noMoreOpts = false

-- 解析数值参数。
local function setCount(val, m)
    local c = tonumber((val:match("%s*%-?(%d+)")) or val)
    if c and c >= 0 then n = c; mode = m end
end

local i = 1
while i <= #args do
    local a = args[i]
    if noMoreOpts then
        files[#files + 1] = a
    elseif a == "--" then
        noMoreOpts = true
    elseif a == "--quiet" or a == "--silent" then quiet = true
    elseif a == "--verbose" then verbose = true
    elseif a == "-q" then quiet = true
    elseif a == "-v" then verbose = true
    elseif a:sub(1, 2) == "--" and a:match("^%-%-lines=") then
        setCount(a:sub(9), "lines")
    elseif a:sub(1, 2) == "--" and a:match("^%-%-bytes=") then
        setCount(a:sub(9), "bytes")
    elseif a:sub(1, 1) == "-" and a ~= "-" then
        local opt = a:match("^%-n(.*)$")
        local optc = a:match("^%-c(.*)$")
        local optglued = a:match("^%-(%d+)$")
        if opt then
            if opt == "" then
                i = i + 1
                if not args[i] then stderr("head: option requires an argument -- 'n'\n"); return end
                setCount(args[i], "lines")
            else
                setCount(opt, "lines")
            end
        elseif optc then
            if optc == "" then
                i = i + 1
                if not args[i] then stderr("head: option requires an argument -- 'c'\n"); return end
                setCount(args[i], "bytes")
            else
                setCount(optc, "bytes")
            end
        elseif optglued then
            setCount(optglued, "lines")
        else
            stderr("head: invalid option -- '" .. a .. "'\n")
            return 1
        end
    else
        files[#files + 1] = a
    end
    i = i + 1
end
if #files == 0 then files = { "-" } end

local total = #files
local showHeader = (not quiet) and (total > 1 or verbose)

local function header(name)
    if not showHeader then return end
    local disp = (name == "-") and "standard input" or name
    io.write("==> " .. disp .. " <==\n")
end

local function emitLines(fh)
    local c = 0
    while c < n do
        local line = fh:readLine()
        if line == nil then break end
        io.write(line .. "\n")
        c = c + 1
    end
end

local function emitBytes(fh)
    local remaining = n
    if fh and fh.read then
        local hadData = false
        while remaining > 0 do
            local chunk = fh:read(remaining)
            if not chunk or chunk == "" then break end
            hadData = true
            io.write(chunk)
            remaining = remaining - #chunk
        end
        if hadData then return end
    end
    -- 生数据读取不可用(如 stdin): 逐行缓冲后截取前 n 字节。
    local buf = {}
    while true do
        local line = fh:readLine()
        if line == nil then break end
        buf[#buf + 1] = line
    end
    local s = table.concat(buf, "\n")
    io.write(s:sub(1, n))
end

local function emit(fh)
    if mode == "bytes" then emitBytes(fh) else emitLines(fh) end
end

for idx, raw in ipairs(files) do
    if raw == "-" then
        header("-")
        local stdin = io.stdin()
        if stdin then emit(stdin) end
    else
        local p = resolve(raw)
        local f, err = fs.open(p, "r")
        if not f then
            stderr("head: " .. p .. ": " .. ioeMsg(err) .. "\n")
            return 1
        end
        header(raw)
        emit(f)
        f:close()
    end
end
