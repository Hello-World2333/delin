-- Delin grep: 按 Lua 模式查找行。用法: grep [-n|-i|-v] <pattern> [file...]
--   -n 显示行号, -i 忽略大小写, -v 反转(打印不匹配行)。无 file 时读 stdin。
local args = args or {}
local cwd = (type(cwd) == "string" and cwd) or "/"
local function resolve(p)
    p = p or ""
    if p:sub(1, 1) == "/" then
        if p == "/" then return "/" end
        return p:gsub("/+$", "")
    end
    local base = (cwd == "/") and "" or cwd
    return (base .. "/" .. p):gsub("/+", "/")
end
local function stderr(s)
    local e = io.stderr()
    if e and e.write then e:write(s) end
end

local withNum, ci, invert = false, false, false
local rest = {}
for _, a in ipairs(args) do
    if a:sub(1, 1) == "-" and a ~= "-" then
        if a == "-n" then withNum = true
        elseif a == "-i" then ci = true
        elseif a == "-v" then invert = true
        else stderr("grep: invalid option -- " .. a .. "\n"); return end
    else
        rest[#rest + 1] = a
    end
end
if #rest < 1 then
    stderr("grep: missing pattern\n")
    return
end
local pat = rest[1]
if ci then pat = pat:lower() end
local files = {}
for j = 2, #rest do files[#files + 1] = rest[j] end

local function test(line)
    local hay = ci and line:lower() or line
    local hit = hay:find(pat, 1) ~= nil
    return invert and (not hit) or hit
end

local function emit(fh)
    local n = 0
    while true do
        local line = fh.readLine()
        if line == nil then break end
        n = n + 1
        if test(line) then
            local prefix = withNum and (n .. ":") or ""
            io.write(prefix .. line .. "\n")
        end
    end
end

if #files == 0 then
    local stdin = io.stdin()
    if not stdin then return end
    emit(stdin)
    return
end

for _, p in ipairs(files) do
    p = resolve(p)
    local f = fs.open(p, "r")
    if not f then
        stderr("grep: " .. p .. ": No such file or directory\n")
        return
    end
    emit(f)
    f.close()
end
