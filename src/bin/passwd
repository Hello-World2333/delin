-- Delin passwd: 修改密码 / 锁定账号 (shadow-utils passwd(1) 子集)。
--   用法: passwd [-d] [-l] [-u] [-S] [name]
--     无 name  = 自己的账号; root 改自己不需要旧密码, 普通用户必须先给旧密码。
--     给 name  = 改别人的账号, 仅 root(普通用户会拿到 permission denied)。
--     -S  只打印密码状态(P = 可用, L = 已锁定, NP = 无密码/空密码登录);
--         Linux 的 passwd -S 还打印最后修改日期与 aging 上限/下限/警告/失效, Delin 的
--         /etc/shadow 没有这几个字段(user.* 也不造假), 所以只打印状态那一列。
--     -d  删除密码(此后空密码即可登录), -l 锁定, -u 解锁; 三者仅 root(与 shadow-utils 同)。
--   授权由**内核** syscall 判定(user.setPassword/user.setLocked), 工具绕不过去:
--   改自己的密码要验旧密码, 改别人的/锁定/删除都要 root。
--   交互: 提示写 stderr, 密码从 stdin 读(是终端时关回显)。因此
--   `passwd < pwfile` 或 `echo pw | passwd` 可以在脚本里改密码 ——
--   这是 Delin 的偏离(shadow-utils 从 /dev/tty 读, 管道一律失败), 牺牲的是"密码不进管道"。
--   退出码: 0 成功; 1 失败(旧密码错/两次不一致/权限不足/用户不存在); 2 用法错误。
local args = args or {}

local stdinH, stderrH = io.stdin(), io.stderr()

local function out(s)
    local o = io.stdout()
    if o and o.write then o:write(s) end
end
local function err(s)
    if stderrH and stderrH.write then stderrH:write(s) end
end

-- ---------------------------------------------------------------
-- 选项解析(-d/-l/-u/-S 与操作数)
-- ---------------------------------------------------------------
local optDelete, optLock, optUnlock, optStatus = false, false, false, false
local operand, noMore = nil, false
local function usage(msg)
    if msg then err("passwd: " .. msg .. "\n") end
    err("usage: passwd [-d] [-l] [-u] [-S] [name]\n")
    return 2
end

for _, a in ipairs(args) do
    if noMore then
        if operand then return usage("extra operand '" .. a .. "'") end
        operand = a
    elseif a == "--" then
        noMore = true
    elseif a:sub(1, 1) == "-" and a ~= "-" then
        for k = 2, #a do
            local ch = a:sub(k, k)
            if ch == "d" then optDelete = true
            elseif ch == "l" then optLock = true
            elseif ch == "u" then optUnlock = true
            elseif ch == "S" then optStatus = true
            else return usage("invalid option -- '" .. ch .. "'") end
        end
    else
        if operand then return usage("extra operand '" .. a .. "'") end
        operand = a
    end
end

local flags = (optDelete and 1 or 0) + (optLock and 1 or 0) + (optUnlock and 1 or 0)
if flags > 1 then return usage("the options -d, -l and -u are mutually exclusive") end
if flags > 0 and optStatus then return usage("the options -S and -d/-l/-u are mutually exclusive") end

if not (syscalls and syscalls["user.setPassword"]) then
    err("passwd: user syscalls not available\n")
    return 1
end

-- 目标账号: 无操作数 = 自己(按 uid 反查); uid 无记录时报错(GNU 同此)。
local name = operand
if not name then
    local me = syscalls["user.byUid"] and syscalls["user.byUid"](uid)
    if not me then
        err("passwd: cannot find name for user ID " .. tostring(uid) .. "\n")
        return 1
    end
    name = me.name
end
if not syscalls["user.get"](name) then
    err("passwd: user '" .. name .. "' does not exist\n")
    return 1
end

-- ---------------------------------------------------------------
-- -S: 打印密码状态
-- ---------------------------------------------------------------
if optStatus then
    local st = syscalls["user.passwordStatus"](name)
    if not st then
        err("passwd: user '" .. name .. "' does not exist\n")
        return 1
    end
    out(name .. " " .. st .. "\n")
    return 0
end

-- ---------------------------------------------------------------
-- -d/-l/-u: 删除/锁定/解锁密码(内核判定 root-only)
-- ---------------------------------------------------------------
if flags > 0 then
    local errmsg
    if optDelete then
        -- 删除密码 = 把密码字段清空(空密码登录), 因此 newpw 传 nil
        local ok
        ok, errmsg = syscalls["user.setPassword"](name, nil, nil)
        if not ok then err("passwd: " .. tostring(errmsg) .. "\n"); return 1 end
        out("passwd: password for '" .. name .. "' removed\n")
    else
        local ok
        ok, errmsg = syscalls["user.setLocked"](name, optLock)
        if not ok then err("passwd: " .. tostring(errmsg) .. "\n"); return 1 end
        out("passwd: password for '" .. name .. "' " .. (optLock and "locked" or "unlocked") .. "\n")
    end
    return 0
end

-- ---------------------------------------------------------------
-- 改密码: 旧密码(非 root 改自己时) + 两遍新密码
-- ---------------------------------------------------------------
--- 读一行密码: 提示走 stderr, 是终端就关回显(与 login 的 readHidden 一致)。
local function ask(prompt)
    if stderrH and stderrH.write then stderrH:write(prompt) end
    local hidden = false
    if stdinH.setEcho then stdinH:setEcho(false); hidden = true end
    local line = stdinH:readLine()
    if stdinH.setEcho then stdinH:setEcho(true) end
    if line == nil then
        if hidden then err("\n") end
        return nil
    end
    if hidden then err("\n") end -- 回显关着时终端不会自己换行, 提示与下一行会挤在一起
    return line
end

-- root 改自己的或改别人: 不问旧密码(shadow-utils 同)
local oldpw = nil
if uid ~= 0 then
    oldpw = ask("Current password: ")
    if oldpw == nil then return 1 end
end

local newpw = ask("New password: ")
if newpw == nil then return 1 end
if newpw == "" then
    err("passwd: you must choose a non-empty password (use -d to remove it)\n")
    return 1
end
local again = ask("Retype new password: ")
if again == nil then return 1 end
if newpw ~= again then
    err("passwd: passwords do not match\n")
    return 1
end

local ok, errmsg = syscalls["user.setPassword"](name, oldpw, newpw)
if not ok then
    err("passwd: " .. tostring(errmsg) .. "\n")
    return 1
end
out("passwd: password updated successfully\n")
return 0
