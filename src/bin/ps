-- Delin ps: 报告进程状态 (POSIX ps + procps/GNU/BSD 常用子集)。
-- 数据源是 /proc(procfs), 与 Linux ps 一样不依赖任何 syscall。
-- 用法:
--   ps                     本控制终端上属于本用户的进程(POSIX 默认选择)
--   ps -e | -A | ax        所有进程
--   ps -a                  所有带控制终端的进程(不含会话首进程)
--   ps -x                   本用户的所有进程(含无控制终端)
--   ps -f                  完整格式;  -l 长格式;  BSD u / aux 用户格式
--   ps -p PID...           按 pid 选择
--   ps -t TTY...           按终端选择(ttyN / N / /dev/ttyN / ? = 无控制终端)
--   ps -u USER...          按有效用户选择
--   ps -o FIELD,...        自定义列(可多次); --no-headers 不打印表头
-- 列: pid ppid pgrp pgid sess uid user gid group stat state tty comm cmd args cwd
-- Delin 不统计 CPU 时间/内存/启动时间, 因此没有 TIME/%CPU/%MEM/VSZ/RSS/STIME 列。
-- 未知选项/未知列名一律报错退出(2), 不静默忽略。
local args = args or {}

local function stderr(s)
    local e = io.stderr()
    if e and e.write then e:write(s) end
end

local function readFile(path)
    local h = fs.open(path, "r")
    if not h then return nil end
    local c = h:readAll()
    h:close()
    return c
end

--- /proc/<pid>/cmdline 是 NUL 分隔的 argv -> 空格分隔的可读命令行。
--- (Lua 5.1 的 pattern 不能含 NUL, 所以按字节转换, 不用 gsub。)
local function cmdOf(text)
    if not text or text == "" then return nil end
    local out, n = {}, 0
    for i = 1, #text do
        local b = text:byte(i)
        n = n + 1
        out[n] = (b == 0) and " " or text:sub(i, i)
    end
    local s = table.concat(out, ""):gsub("%s+$", "")
    if s == "" then return nil end
    return s
end

--- /proc/<pid>/status 的 key:value 行 -> 表。
local function parseStatus(text)
    local t = {}
    for line in text:gmatch("[^\n]+") do
        local k, v = line:match("^(%w+):%s*(.*)$")
        if k then t[k] = v end
    end
    return t
end

--- /proc/<pid>/stat 的 Linux 字段 1..8 (comm 可能含空格, 从最后一个 ")" 往回切)。
local function parseStat(text)
    local pid, comm, st, ppid, pgrp, sess, tty, tpgid =
        text:match("^(%d+) %((.*)%) (%a+) (%d+) (%d+) (%d+) (%S+) (%-?%d+)")
    if not pid then return nil end
    return {
        pid = tonumber(pid), comm = comm, state = st, ppid = tonumber(ppid),
        pgrp = tonumber(pgrp), sess = tonumber(sess), tty = tty, tpgid = tonumber(tpgid),
    }
end

--- 终端名归一化: "tty0"/"0"/"/dev/tty0" -> "tty0"; "?" -> "0"(无控制终端)。
local function normTty(spec)
    if spec == "?" then return "0" end
    local n = spec:match("^/dev/(.+)$") or spec
    if n:match("^%d+$") then return "tty" .. n end
    return n
end

local function userName(uid)
    local byUid = syscalls and syscalls["user.byUid"]
    local u = byUid and byUid(uid)
    return (u and u.name) or tostring(uid)
end

local function groupName(gid)
    local byGid = syscalls and syscalls["user.groupByGid"]
    local g = byGid and byGid(gid)
    return (g and g.name) or tostring(gid)
end

-- ---------------------------------------------------------------
-- 选项解析
-- ---------------------------------------------------------------
local o = {
    selAll = false, selA = false, selX = false, posixA = false,
    format = nil,          -- nil|"full"|"long"|"user"
    fields = {},           -- -o 的列名(按出现顺序)
    pids = {}, ttys = {}, users = {},
    noHeaders = false,
}

local function splitList(dst, val)
    for w in tostring(val):gmatch("[^,%s]+") do dst[#dst + 1] = w end
end

local function splitFields(val)
    for w in tostring(val):gmatch("[^,%s]+") do o.fields[#o.fields + 1] = w end
end

local function badOpt(s)
    stderr("ps: " .. s .. "\n")
end

local i = 1
while i <= #args do
    local a = args[i]
    if a == "--" then
        if args[i + 1] then badOpt("unexpected operand: " .. args[i + 1]); return 2 end
        break
    elseif a:sub(1, 2) == "--" then
        local name, val = a:match("^%-%-([%w%-]+)=?(.*)$")
        if name == "no-headers" then o.noHeaders = true
        elseif name == "pid" or name == "tty" or name == "user" then
            if val == "" then i = i + 1; val = args[i] end
            if not val then badOpt("option '--" .. name .. "' requires an argument"); return 2 end
            if name == "pid" then splitList(o.pids, val)
            elseif name == "tty" then splitList(o.ttys, val)
            else splitList(o.users, val) end
        else
            badOpt("unrecognized option '--" .. tostring(name) .. "'"); return 2
        end
    elseif a:sub(1, 1) == "-" and #a > 1 then
        local j = 2
        while j <= #a do
            local c = a:sub(j, j)
            if c == "e" or c == "A" then o.selAll = true
            elseif c == "a" then o.selA = true; o.posixA = true
            elseif c == "x" then o.selX = true
            elseif c == "f" then o.format = "full"
            elseif c == "l" then o.format = "long"
            elseif c == "h" then o.noHeaders = true
            elseif c == "p" or c == "t" or c == "u" or c == "U" or c == "o" then
                local val = a:sub(j + 1)
                if val == "" then i = i + 1; val = args[i] end
                if not val then badOpt("option requires an argument -- '" .. c .. "'"); return 2 end
                if c == "p" then splitList(o.pids, val)
                elseif c == "t" then splitList(o.ttys, val)
                elseif c == "o" then splitFields(val)
                else splitList(o.users, val) end
                j = #a -- 值已吃掉本参数剩余部分
            else
                badOpt("invalid option -- '" .. c .. "'"); return 2
            end
            j = j + 1
        end
    else
        -- BSD 风格字母: aux / ax / axf ...
        for j = 1, #a do
            local c = a:sub(j, j)
            if c == "a" then o.selA = true
            elseif c == "x" then o.selX = true
            elseif c == "u" then o.format = "user"
            elseif c == "e" then o.selAll = true
            elseif c == "f" then o.format = "full"
            elseif c == "l" then o.format = "long"
            else badOpt("invalid option -- '" .. c .. "'"); return 2 end
        end
    end
    i = i + 1
end

-- 选择模式: 有 -p/-t/-u 时按显式列表(等价于先取全集再过滤)。
local base
if o.selAll or (o.selA and o.selX) or #o.pids > 0 or #o.ttys > 0 or #o.users > 0 then
    base = "all"
elseif o.selA then
    base = "alltty"
elseif o.selX then
    base = "anytty"
else
    base = "default"
end

-- ---------------------------------------------------------------
-- 读 /proc
-- ---------------------------------------------------------------
local selfStat = readFile("/proc/self/stat")
local selfStatus = readFile("/proc/self/status")
if not selfStat or not selfStatus then
    stderr("ps: cannot read /proc/self\n")
    return 1
end
local self = parseStat(selfStat)
if not self then
    stderr("ps: malformed /proc/self/stat\n")
    return 1
end
local selfUid = tonumber(parseStatus(selfStatus).Uid) or 0

local pids = {}
for _, e in ipairs(fs.list("/proc") or {}) do
    local pid = tonumber(e)
    if pid then pids[#pids + 1] = pid end
end
table.sort(pids)

local recs = {}
for _, pid in ipairs(pids) do
    local st = readFile("/proc/" .. pid .. "/stat")
    local stat = st and parseStat(st)
    if stat then
        local s = parseStatus(readFile("/proc/" .. pid .. "/status") or "")
        recs[#recs + 1] = {
            pid = pid, comm = stat.comm, state = stat.state,
            ppid = stat.ppid, pgrp = stat.pgrp, sess = stat.sess, tty = stat.tty,
            uid = tonumber(s.Uid) or 0, gid = tonumber(s.Gid) or 0,
            cmd = cmdOf(readFile("/proc/" .. pid .. "/cmdline")),
        }
    end
end

-- ---------------------------------------------------------------
-- 选择
-- ---------------------------------------------------------------
local pidFilter, ttyFilter, uidFilter
if #o.pids > 0 then
    pidFilter = {}
    for _, s in ipairs(o.pids) do
        local n = tonumber(s)
        if not n then badOpt("invalid process id: " .. s); return 2 end
        pidFilter[n] = true
    end
end
if #o.ttys > 0 then
    ttyFilter = {}
    for _, s in ipairs(o.ttys) do ttyFilter[normTty(s)] = true end
end
if #o.users > 0 then
    uidFilter = {}
    for _, s in ipairs(o.users) do
        local n = tonumber(s)
        if not n then
            local u = syscalls and syscalls["user.get"] and syscalls["user.get"](s)
            if not u then badOpt("user '" .. s .. "' does not exist"); return 2 end
            n = u.uid
        end
        uidFilter[n] = true
    end
end

local selfTty = self.tty
local rows = {}
for _, r in ipairs(recs) do
    local keep
    if base == "all" then keep = true
    elseif base == "alltty" then keep = r.tty ~= "0" and not (o.posixA and r.pid == r.sess)
    elseif base == "anytty" then keep = r.uid == selfUid
    else keep = r.uid == selfUid and r.tty == selfTty end
    if keep and pidFilter and not pidFilter[r.pid] then keep = false end
    if keep and ttyFilter and not ttyFilter[r.tty] then keep = false end
    if keep and uidFilter and not uidFilter[r.uid] then keep = false end
    if keep then rows[#rows + 1] = r end
end

-- ---------------------------------------------------------------
-- 列定义与渲染
-- ---------------------------------------------------------------
local FIELDS = {
    pid     = { header = "PID",     get = function(r) return tostring(r.pid) end },
    ppid    = { header = "PPID",    get = function(r) return tostring(r.ppid) end },
    pgrp    = { header = "PGRP",    get = function(r) return tostring(r.pgrp) end },
    pgid    = { header = "PGID",    get = function(r) return tostring(r.pgrp) end },
    sess    = { header = "SESS",    get = function(r) return tostring(r.sess) end },
    session = { header = "SESS",    get = function(r) return tostring(r.sess) end },
    uid     = { header = "UID",     get = function(r) return tostring(r.uid) end },
    user    = { header = "USER",    get = function(r) return userName(r.uid) end },
    gid     = { header = "GID",     get = function(r) return tostring(r.gid) end },
    group   = { header = "GROUP",   get = function(r) return groupName(r.gid) end },
    stat    = { header = "STAT",    get = function(r) return r.state end },
    state   = { header = "STAT",    get = function(r) return r.state end },
    tty     = { header = "TTY",     get = function(r) return r.tty == "0" and "?" or r.tty end },
    comm    = { header = "COMMAND", get = function(r) return r.comm end },
    cmd     = { header = "COMMAND", get = function(r) return r.cmd or ("[" .. r.comm .. "]") end },
    args    = { header = "COMMAND", get = function(r) return r.cmd or ("[" .. r.comm .. "]") end },
    cwd     = { header = "CWD",     get = function(r)
        local c = readFile("/proc/" .. r.pid .. "/cwd")
        if not c then return "?" end
        return (c:gsub("\n$", ""))
    end },
}

local names
if #o.fields > 0 then
    names = o.fields
elseif o.format == "long" then
    names = { "stat", "uid", "pid", "ppid", "pgrp", "sess", "tty", "cmd" }
elseif o.format == "full" then
    names = { "uid", "pid", "ppid", "stat", "tty", "cmd" }
elseif o.format == "user" then
    names = { "user", "pid", "ppid", "stat", "tty", "cmd" }
else
    names = { "pid", "tty", "stat", "cmd" }
end

local cols = {}
for n, name in ipairs(names) do
    local def = FIELDS[name]
    if not def then badOpt("unknown column: " .. name); return 2 end
    cols[n] = { header = def.header, get = def.get }
end

local tableRows = {}
for _, r in ipairs(rows) do
    local vals = {}
    for n, col in ipairs(cols) do vals[n] = col.get(r) end
    tableRows[#tableRows + 1] = vals
end

local widths = {}
for n, col in ipairs(cols) do widths[n] = #col.header end
for _, vals in ipairs(tableRows) do
    for n = 1, #vals do
        if #vals[n] > widths[n] then widths[n] = #vals[n] end
    end
end

local function renderLine(vals)
    local out = {}
    for n, v in ipairs(vals) do
        if n == #vals then out[n] = v else out[n] = v .. string.rep(" ", widths[n] - #v) end
    end
    io.write(table.concat(out, " ") .. "\n")
end

if not o.noHeaders then
    local hdr = {}
    for n, col in ipairs(cols) do hdr[n] = col.header end
    renderLine(hdr)
end
for _, vals in ipairs(tableRows) do renderLine(vals) end

if #tableRows == 0 then return 1 end
