-- Delin tac: 按行倒序输出 (GNU coreutils tac)。
-- 用法: tac [OPTION]... [FILE]...
--   -b, --before            分隔符附在记录**开头**(缺省附在末尾)
--   -r, --regex             分隔符按 BRE 解释
--   -s, --separator=STRING  记录分隔串(缺省换行)
-- 语义(与宿主 GNU 逐项实测对齐):
--   - 文件是一串 `记录 分隔符 记录 分隔符 ... 记录`; 输出把记录倒过来, 分隔符跟着它所属的记录走。
--     所以 `printf 'a\nb\nc' | tac` 得到 "cb\na\n"(最后一段没有分隔符, 倒过来就贴在下一个记录后)。
--   - `-b` 把分隔符算在**后一个**记录的开头(于是 "1,2,3" 配 -s, 得到 ",3,21")。
--   - `-r` 时 -s 是 BRE(kernel/regex.lua 的引擎), 匹配到的整段就是分隔符。
-- 已知偏离:
--   - 不实现 --help/--version(与本项目其它工具一致)。
--   - 先把整个文件读进内存(GNU 从文件尾往前 seek 分块读), CC 上的文件很小, 这个取舍划算。
--   - `-r` 用内核的 POSIX BRE 引擎: 与 GNU 的 glibc BRE 相比, `+` 之类 GNU 方言细节
--     (`[0-9]+` 在 GNU tac 里被当成"单个数字"匹配)不保证一致 —— 写 `\+` 或 `\{n\}` 这类
--     标准写法两边一致。
local args = args or {}
local cwd = (type(cwd) == "string" and cwd) or "/"
local function resolve(p)
    p = p or ""
    if p == "" then return (cwd == "/") and "/" or cwd end
    if p:sub(1, 1) == "/" then
        if p == "/" then return "/" end
        return p:gsub("/+$", "")
    end
    local base = (cwd == "/") and "" or cwd
    return (base .. "/" .. p):gsub("/+", "/")
end
local function stderr(s)
    local e = io.stderr()
    if e and e.write then e:write(s) end
end
local function ioeMsg(err)
    if err and (err:find("permission") or err:find("denied")) then return "Permission denied" end
    if err and err:lower():find("no such file") then return "No such file or directory" end
    if err and err:find("directory") then return "Is a directory" end
    return "No such file or directory"
end

local _msleep = os.msleep or function(ms) os.sleep(math.max((ms or 0) / 1000, 0.05)) end
-- 让出时间片(ms)。**默认 50**: 实测电脑 #3 上一次让出 `os.msleep(0)` 要 ~75ms(不是文档里
-- 说的 2ms —— 那块 HSE 外设的 waitNextTick 实际按游戏刻返回), 让出太勤会把命令拖到 ~1 行/拍。
-- 真·HSE 快让出(每次 ~2ms)的机器可以用环境变量把时间片调小(如 DELIN_YIELD_MS=2):
-- 那是"低延迟换吞吐"的取舍, 由使用者定。见 for-ai.md「os.msleep 与 HSE」。
local _sliceMs = (type(env) == "table" and tonumber(env.DELIN_YIELD_MS)) or 50
local _sliceAt = os.epoch("utc")
local function yieldCheck()
    local now = os.epoch("utc")
    if now - _sliceAt >= _sliceMs then
        _sliceAt = now
        _msleep(0)
    end
end

local before, useRegex = false, false
local separator = "\n"
local files, noMoreOpts = {}, false

local i = 1
while i <= #args do
    local a = args[i]
    if noMoreOpts then
        files[#files + 1] = a
    elseif a == "--" then
        noMoreOpts = true
    elseif a == "-b" or a == "--before" then
        before = true
    elseif a == "-r" or a == "--regex" then
        useRegex = true
    elseif a == "-s" or a == "--separator" then
        i = i + 1
        if not args[i] then stderr("tac: option requires an argument -- 's'\n"); return 1 end
        separator = args[i]
    elseif a:match("^%-%-separator=") then
        separator = a:sub(13)
    elseif a:match("^%-s.") then
        separator = a:sub(3)
    elseif a:sub(1, 2) == "--" then
        stderr("tac: unrecognized option '" .. a .. "'\n")
        return 1
    elseif a:sub(1, 1) == "-" and a ~= "-" then
        stderr("tac: invalid option -- '" .. a:sub(2, 2) .. "'\n")
        return 1
    else
        files[#files + 1] = a
    end
    i = i + 1
end

-- 分隔符位置表: 每项 { s, e }(闭区间, 1 起) —— 支持 -r 的正则分隔符。
local function separators(text)
    local out = {}
    if useRegex then
        local compileRegex = syscalls and syscalls["regex.compile"]
        if not compileRegex then
            stderr("tac: regex syscall not available\n")
            return nil
        end
        local re, err = compileRegex(separator, "bre")
        if not re then
            stderr("tac: invalid regular expression (" .. tostring(err) .. "): " .. separator .. "\n")
            return nil
        end
        local pos = 1
        while pos <= #text do
            local m = re:find(text, pos)
            if not m then break end
            out[#out + 1] = { s = m.s, e = m.e }
            -- 空匹配(如 `x*`)要让位, 否则原地打转。
            pos = (m.e >= m.s) and (m.e + 1) or (m.s + 1)
        end
    else
        if separator == "" then
            stderr("tac: separator cannot be empty\n")
            return nil
        end
        local pos = 1
        while true do
            local at = text:find(separator, pos, true)
            if not at then break end
            out[#out + 1] = { s = at, e = at + #separator - 1 }
            pos = at + #separator
        end
    end
    return out
end

local function processText(text)
    local seps = separators(text)
    if not seps then return 1 end
    local records = {}
    if before then
        -- 分隔符算在后一个记录的开头: 第一段(第一个分隔符之前)自成一条记录。
        local start = 1
        for _, sp in ipairs(seps) do
            records[#records + 1] = { s = start, e = sp.s - 1 }
            start = sp.s
        end
        if start <= #text then records[#records + 1] = { s = start, e = #text } end
    else
        -- 分隔符算在本条记录的末尾。
        local start = 1
        for _, sp in ipairs(seps) do
            records[#records + 1] = { s = start, e = sp.e }
            start = sp.e + 1
        end
        if start <= #text then records[#records + 1] = { s = start, e = #text } end
    end
    local out = {}
    for k = #records, 1, -1 do
        local r = records[k]
        out[#out + 1] = text:sub(r.s, r.e)
        if #out >= 256 then
            io.write(table.concat(out)); out = {}; yieldCheck()
        end
    end
    if #out > 0 then io.write(table.concat(out)) end
    return 0
end

local function slurp(h)
    if h.readAll then return h:readAll() end
    local parts = {}
    while true do
        local chunk = h:read(4096)
        if not chunk or chunk == "" then break end
        parts[#parts + 1] = chunk
    end
    return table.concat(parts)
end

if #files == 0 then files[1] = "-" end
local rc = 0
for _, f in ipairs(files) do
    if f == "-" then
        rc = math.max(rc, processText(slurp(io.stdin()) or ""))
    else
        local h, err = fs.open(resolve(f), "r")
        if not h then
            stderr("tac: " .. f .. ": " .. ioeMsg(err) .. "\n")
            rc = 1
        else
            local r = processText(slurp(h))
            h:close()
            rc = math.max(rc, r)
        end
    end
end
return rc
