-- Delin wc: 统计行/词/字节/字符/最长行 (GNU 子集)。用法: wc [OPTION]... [FILE]...
-- 选项:
--   -l, --lines     只数行
--   -w, --words     只数词
--   -c, --bytes     只数字节
--   -m, --chars     只数字符
--   -L, --max-line-length  只输出最长行长度
--   缺省输出: 行 词 字节。多文件时末尾输出 total。
local args = args or {}
local cwd = (type(cwd) == "string" and cwd) or "/"
local function resolve(p)
    p = p or ""
    if p == "" then return (cwd == "/") and "/" or cwd end
    if p:sub(1, 1) == "/" then
        if p == "/" then return "/" end
        return p:gsub("/+$", "")
    end
    local base = (cwd == "/") and "" or cwd
    return (base .. "/" .. p):gsub("/+", "/")
end
local function stderr(s)
    local e = io.stderr()
    if e and e.write then e:write(s) end
end
local function ioeMsg(err)
    if err and (err:find("permission") or err:find("denied")) then return "Permission denied" end
    if err and err:find("directory") then return "Is a directory" end
    return "No such file or directory"
end

local doL, doW, doC, doM, doLmax = false, false, false, false, false
local files = {}
local noMoreOpts = false

local function setShort(ch)
    if ch == "l" then doL = true
    elseif ch == "w" then doW = true
    elseif ch == "c" then doC = true
    elseif ch == "m" then doM = true
    elseif ch == "L" then doLmax = true
    else stderr("wc: invalid option -- '" .. ch .. "'\n"); return false end
    return true
end

for _, a in ipairs(args) do
    if noMoreOpts then
        files[#files + 1] = a
    elseif a == "--" then
        noMoreOpts = true
    elseif a == "--lines" then doL = true
    elseif a == "--words" then doW = true
    elseif a == "--bytes" then doC = true
    elseif a == "--chars" then doM = true
    elseif a == "--max-line-length" then doLmax = true
    elseif a:sub(1, 1) == "-" and a ~= "-" then
        for k = 2, #a do if not setShort(a:sub(k, k)) then return end end
    else
        files[#files + 1] = a
    end
end
if not (doL or doW or doC or doM or doLmax) then doL, doW, doC = true, true, true end

local function countWords(s) local c = 0; for _ in s:gmatch("%S+") do c = c + 1 end; return c end
local function utf8len(s)
    local n, i = 0, 1
    while i <= #s do
        n = n + 1
        local b = s:byte(i)
        if b < 0xC0 then i = i + 1
        elseif b < 0xE0 then i = i + 2
        elseif b < 0xF0 then i = i + 3
        elseif b < 0xF8 then i = i + 4
        elseif b < 0xFC then i = i + 5
        else i = i + 6 end
    end
    return n
end

local function report(name, st)
    local parts = {}
    if doL then parts[#parts + 1] = tostring(st.l) end
    if doW then parts[#parts + 1] = tostring(st.w) end
    if doC then parts[#parts + 1] = tostring(st.c) end
    if doM then parts[#parts + 1] = tostring(st.m) end
    if doLmax then parts[#parts + 1] = tostring(st.lmax) end
    if name then parts[#parts + 1] = name end
    io.write(table.concat(parts, " ") .. "\n")
end

-- 精确统计一整块原始字节。
local function statsContent(content)
    local l = 0
    for _ in content:gmatch("\n") do l = l + 1 end
    local lmax = 0
    for ln in (content .. "\n"):gmatch("(.-)\n") do
        if #ln > lmax then lmax = #ln end
    end
    return { l = l, w = countWords(content), c = #content, m = utf8len(content), lmax = lmax }
end

-- stdin 逐行统计。
local function statsLines(lines)
    local w, lmax, concat = 0, 0, table.concat(lines, "\n")
    for _, ln in ipairs(lines) do
        w = w + countWords(ln)
        if #ln > lmax then lmax = #ln end
    end
    local nNewlines = math.max(0, #lines - 1)
    return { l = #lines, w = w, c = #concat + nNewlines, m = utf8len(concat) + nNewlines, lmax = lmax }
end

if #files == 0 then files = { "-" } end

local totals = { l = 0, w = 0, c = 0, m = 0, lmax = 0 }
local many = #files > 1

for _, a in ipairs(files) do
    local name = a
    local st
    if a == "-" then
        local stdin = io.stdin()
        if not stdin then return end
        -- 优先整块读取(管道/文件重定向有 EOF): 精确统计字节/行/词(与 GNU 一致)。
        -- 回退到逐行(交互 tty 无 EOF/readAll): 行统计, 字节数按行重构(末行换行不计)。
        if stdin.readAll then
            local content = stdin.readAll() or ""
            st = statsContent(content)
        else
            local lines = {}
            while true do
                local line = stdin.readLine()
                if line == nil then break end
                lines[#lines + 1] = line
            end
            st = statsLines(lines)
        end
        name = nil
    else
        local p = resolve(a)
        local f, err = fs.open(p, "r")
        if not f then
            stderr("wc: " .. p .. ": " .. ioeMsg(err) .. "\n")
            return
        end
        local content = f.readAll() or ""
        f.close()
        st = statsContent(content)
    end
    report(name, st)
    totals.l = totals.l + st.l
    totals.w = totals.w + st.w
    totals.c = totals.c + st.c
    totals.m = totals.m + st.m
    if st.lmax > totals.lmax then totals.lmax = st.lmax end
end

if many then report("total", totals) end
