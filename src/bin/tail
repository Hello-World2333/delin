-- Delin tail: 打印文件末尾 N 行。用法: tail [-n N|-N] [file...]
--   缺省 N=10。无 file 时读 stdin。
local args = args or {}
local cwd = (type(cwd) == "string" and cwd) or "/"
local function resolve(p)
    p = p or ""
    if p:sub(1, 1) == "/" then
        if p == "/" then return "/" end
        return p:gsub("/+$", "")
    end
    local base = (cwd == "/") and "" or cwd
    return (base .. "/" .. p):gsub("/+", "/")
end
local function stderr(s)
    local e = io.stderr()
    if e and e.write then e:write(s) end
end
-- 把 fs.open 错误映射为 POSIX 风格: 不存在 / 无权限 / 是目录。
local function ioeMsg(err)
    if err and (err:find("permission") or err:find("denied")) then return "Permission denied" end
    if err and err:find("directory") then return "Is a directory" end
    return "No such file or directory"
end

local n = 10
local files = {}
local i = 1
while i <= #args do
    local a = args[i]
    if a:sub(1, 1) == "-" and a ~= "-" then
        if a == "-n" then
            i = i + 1
            if not args[i] then stderr("tail: option requires an argument -- n\n"); return end
            n = tonumber(args[i]) or 10
        else
            local glued = a:match("^%-n(%d+)$") or a:match("^%-(%d+)$")
            if glued then
                n = tonumber(glued)
            else
                stderr("tail: invalid option -- " .. a .. "\n")
                return
            end
        end
    else
        files[#files + 1] = a
    end
    i = i + 1
end

local function emit(fh)
    local lines = {}
    while true do
        local line = fh.readLine()
        if line == nil then break end
        lines[#lines + 1] = line
    end
    local start = math.max(1, #lines - n + 1)
    for k = start, #lines do
        io.write(lines[k] .. "\n")
    end
end

if #files == 0 then
    local stdin = io.stdin()
    if not stdin then return end
    emit(stdin)
    return
end

for _, p in ipairs(files) do
    p = resolve(p)
    local f, err = fs.open(p, "r")
    if not f then
        stderr("tail: " .. p .. ": " .. ioeMsg(err) .. "\n")
        return
    end
    emit(f)
    f.close()
end
