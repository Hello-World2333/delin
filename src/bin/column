-- Delin column: 把输入按列排列 (util-linux column 的子集: -t 表格 + 两种填充模式)。
-- 用法: column [OPTION]... [FILE]...
--   -t, --table                    把每一行按分隔符切成单元格, 输出成对齐的表格
--   -s, --separator, --input-separator=STRING  输入分隔串(-t 用; 缺省按"空白串"切)
--   -o, --output-separator=STRING  输出列之间的分隔串(缺省两个空格)
--   -c, --output-width=WIDTH       输出宽度(缺省终端宽度, 拿不到就 80)
--   -x, --fillrows                 按行填充(缺省按列填充)
--   -S, --use-spaces=N             列间至少 N 个空格代替制表符(填充模式用)
--   -L, --keep-empty-lines         保留空行(缺省丢掉)
--   -N, --table-columns=NAMES      逗号分隔的列名(-t 时作为表头, -J 时作为 JSON 键名)
--   -n, --table-name=NAME          -J 输出的表名(缺省 "table")
--   -J, --json                     -J: 用 JSON 输出表格(需要 -N 给出列名)
-- 语义(与宿主 util-linux 的 column 逐项实测对齐):
--   - `-t` 把每行切成单元格; 各列宽度 = 该列所有单元格(含 -N 表头)的最大宽度, 左对齐补空格,
--     列之间插输出分隔串; **最后一列不补空格**(缺的单元格按空串处理, 于是行尾可能留出分隔串)。
--   - 没给 -s 时按**空白串**切(连续空白算一个, 行首空白忽略); 给了 -s 就按字面串切 ——
--     每个出现处都算一个分隔符, 因此 `-s,` 下 `a,,c` 是三个单元格, `a,` 末尾还有一个空单元格。
--   - 空行(或只有空白的行)缺省丢掉, -L 保留(表格里输出一个空行)。
--   - 填充模式(没有 -t): 缺省按列填(先竖着排, 列数 = 宽度 / 列宽), 列宽取最长单元格向上取整到
--     8 的倍数、用制表符对齐; -S N 则改用空格且列宽 = 最长单元格 + N。`-c` 给输出宽度。
--   - 退出码: 0 正常; 1 打不开某个 FILE 或用法错(与 util-linux 一致, 它用 errtryhelp)。
-- 已知偏离(明确报错, 不静默做半套):
--   - libsmartcols 的那一族开关没有实现: -C/--table-column, -O/--table-order, -H/--table-hide,
--     -R/--table-right, -T/--table-truncate, -W/--table-wrap, -E/--table-noextreme, -l/--table-columns-limit,
--     -d/--table-noheadings, -m/--table-maxout, --table-minout, -e/--table-header-repeat,
--     -K/--table-header-as-columns, --table-colorscheme, --color, -r/-i/-p(树形), --wrap-separator
--     —— 给了就 fail-fast(退出 1), 不假装支持。
--   - 宽度一律按**字节**算(Delin 无 locale, 与 LC_ALL=C 的 column 一致)。
local args = args or {}
local cwd = (type(cwd) == "string" and cwd) or "/"
local function resolve(p)
    p = p or ""
    if p == "" then return (cwd == "/") and "/" or cwd end
    if p:sub(1, 1) == "/" then
        if p == "/" then return "/" end
        return p:gsub("/+$", "")
    end
    local base = (cwd == "/") and "" or cwd
    return (base .. "/" .. p):gsub("/+", "/")
end
local function stderr(s)
    local e = io.stderr()
    if e and e.write then e:write(s) end
end
local function ioeMsg(err)
    if err and (err:find("permission") or err:find("denied")) then return "Permission denied" end
    if err and err:lower():find("no such file") then return "No such file or directory" end
    if err and err:find("directory") then return "Is a directory" end
    return "No such file or directory"
end

local _msleep = os.msleep or function(ms) os.sleep(math.max((ms or 0) / 1000, 0.05)) end
-- 让出时间片: **装了 HSE(os.msleep 在) 就压到 2ms** —— 一次让出本体只要 ~2ms,
-- 于是按键/^C 的投递延迟从 50ms 降到 2-4ms(HSE 不做这个就没有意义);
-- 没装 HSE 时让出一次要睡满 50ms(os.sleep 按服务器刻量化), 保持 50ms 判据。
local _sliceMs = os.msleep and 2 or 50
local _sliceAt = os.epoch("utc")
local function yieldCheck()
    local now = os.epoch("utc")
    if now - _sliceAt >= _sliceMs then
        _sliceAt = now
        _msleep(0)
    end
end

local tableMode, fillRows, keepEmpty, json = false, false, false, false
local inSep, outSep = nil, "  "
local width = nil
local minColSep = nil -- -S
local colNames, tableName = nil, "table"
local files, noMoreOpts = {}, false

local UNSUPPORTED = {
    ["-C"] = true, ["-O"] = true, ["-H"] = true, ["-R"] = true, ["-T"] = true, ["-W"] = true,
    ["-E"] = true, ["-l"] = true, ["-d"] = true, ["-m"] = true, ["-e"] = true, ["-K"] = true,
    ["-r"] = true, ["-i"] = true, ["-p"] = true,
}
local UNSUPPORTED_LONG = {
    ["table-column"] = true, ["table-order"] = true, ["table-hide"] = true, ["table-right"] = true,
    ["table-truncate"] = true, ["table-wrap"] = true, ["table-noextreme"] = true,
    ["table-columns-limit"] = true, ["table-noheadings"] = true, ["table-maxout"] = true,
    ["table-minout"] = true, ["table-header-repeat"] = true, ["table-header-as-columns"] = true,
    ["table-colorscheme"] = true, ["color"] = true, ["tree"] = true, ["tree-id"] = true,
    ["tree-parent"] = true, ["wrap-separator"] = true,
}

local i = 1
local function needArg(optName)
    i = i + 1
    if not args[i] then stderr("column: option requires an argument -- '" .. optName .. "'\n"); return nil end
    return args[i]
end
while i <= #args do
    local a = args[i]
    if noMoreOpts then
        files[#files + 1] = a
    elseif a == "--" then
        noMoreOpts = true
    elseif a == "-t" or a == "--table" then
        tableMode = true
    elseif a == "-x" or a == "--fillrows" then
        fillRows = true
    elseif a == "-L" or a == "--keep-empty-lines" then
        keepEmpty = true
    elseif a == "-J" or a == "--json" then
        json = true
    elseif a == "-s" or a == "--separator" or a == "--input-separator" then
        local v = needArg("s"); if not v then return 1 end
        inSep = v
    elseif a:match("^%-%-separator=") then
        inSep = a:sub(13)
    elseif a:match("^%-%-input%-separator=") then
        inSep = a:sub(19)
    elseif a:match("^%-s.") then
        inSep = a:sub(3)
    elseif a == "-o" or a == "--output-separator" then
        local v = needArg("o"); if not v then return 1 end
        outSep = v
    elseif a:match("^%-%-output%-separator=") then
        outSep = a:sub(20)
    elseif a:match("^%-o.") then
        outSep = a:sub(3)
    elseif a == "-c" or a == "--output-width" then
        local v = needArg("c"); local n = v and tonumber(v)
        if not n then stderr("column: invalid columns argument\n"); return 1 end
        width = math.floor(n)
    elseif a:match("^%-%-output%-width=") then
        local n = tonumber(a:sub(16))
        if not n then stderr("column: invalid columns argument\n"); return 1 end
        width = math.floor(n)
    elseif a:match("^%-c%d") then
        local n = tonumber(a:sub(3))
        if not n then stderr("column: invalid columns argument\n"); return 1 end
        width = math.floor(n)
    elseif a == "-S" or a == "--use-spaces" then
        local v = needArg("S"); local n = v and tonumber(v)
        if not n or n < 1 then stderr("column: invalid column count\n"); return 1 end
        minColSep = math.floor(n)
    elseif a:match("^%-%-use%-spaces=") then
        local n = tonumber(a:sub(13))
        if not n or n < 1 then stderr("column: invalid column count\n"); return 1 end
        minColSep = math.floor(n)
    elseif a:match("^%-S%d") then
        local n = tonumber(a:sub(3))
        if not n or n < 1 then stderr("column: invalid column count\n"); return 1 end
        minColSep = math.floor(n)
    elseif a == "-N" or a == "--table-columns" then
        local v = needArg("N"); if not v then return 1 end
        colNames = {}
        for part in (v .. ","):gmatch("([^,]*),") do colNames[#colNames + 1] = part end
    elseif a:match("^%-%-table%-columns=") then
        local v = a:sub(17)
        colNames = {}
        for part in (v .. ","):gmatch("([^,]*),") do colNames[#colNames + 1] = part end
    elseif a == "-n" or a == "--table-name" then
        local v = needArg("n"); if not v then return 1 end
        tableName = v
    elseif a:match("^%-%-table%-name=") then
        tableName = a:sub(14)
    elseif a:sub(1, 2) == "--" then
        local name = a:match("^%-%-([^=]+)")
        if name and UNSUPPORTED_LONG[name] then
            stderr("column: option '--" .. name .. "' is not supported\n")
            return 1
        end
        stderr("column: unrecognized option '" .. a .. "'\n")
        return 1
    elseif a:sub(1, 1) == "-" and a ~= "-" then
        if UNSUPPORTED[a:sub(1, 2)] or (a:sub(3) ~= "" and UNSUPPORTED["-" .. a:sub(2, 2)]) then
            stderr("column: option '" .. a .. "' is not supported\n")
            return 1
        end
        stderr("column: invalid option -- '" .. a:sub(2, 2) .. "'\n")
        return 1
    else
        files[#files + 1] = a
    end
    i = i + 1
end

if not tableMode and (colNames or json) then
    stderr("column: option --table required for all --table-*\n")
    return 1
end
if json and not colNames then
    stderr("column: option --table-columns or --table-column required for --json\n")
    return 1
end
if width == nil then width = 80 end

local function slurp(h)
    if h.readAll then return h:readAll() end
    local parts = {}
    while true do
        local chunk = h:read(4096)
        if not chunk or chunk == "" then break end
        parts[#parts + 1] = chunk
    end
    return table.concat(parts)
end

--- 一行 -> 单元格数组。给 -s 按字面串切(每个出现处都算); 缺省按空白串切(连续空白算一个)。
local function splitLine(line)
    local cells = {}
    if inSep then
        local pos = 1
        while true do
            local at = line:find(inSep, pos, true)
            if not at then
                cells[#cells + 1] = line:sub(pos)
                break
            end
            cells[#cells + 1] = line:sub(pos, at - 1)
            pos = at + #inSep
        end
    else
        for cell in line:gmatch("%S+") do cells[#cells + 1] = cell end
    end
    return cells
end

--- util-linux 的空白判定: 整行只有空白就算空行。
local function blankLine(line)
    return line:match("^[ \t\r]*$") ~= nil
end

local lines = {}
local function addInput(text)
    local pos = 1
    while true do
        local at = text:find("\n", pos, true)
        local line
        if at then
            line = text:sub(pos, at - 1)
            pos = at + 1
        else
            line = text:sub(pos)
            if line == "" then break end
            pos = #text + 1
        end
        if blankLine(line) then
            if keepEmpty then
                lines[#lines + 1] = (inSep or tableMode) and {} or { "" }
            end
        elseif tableMode then
            lines[#lines + 1] = splitLine(line)
        else
            lines[#lines + 1] = { line }
        end
        if at == nil then break end
    end
end

if #files == 0 then files[1] = "-" end
local rc = 0
for _, f in ipairs(files) do
    if f == "-" then
        addInput(slurp(io.stdin()) or "")
    else
        local h, err = fs.open(resolve(f), "r")
        if not h then
            stderr("column: " .. f .. ": " .. ioeMsg(err) .. "\n")
            rc = 1
        else
            addInput(slurp(h))
            h:close()
        end
    end
end

-- ---------------------------------------------------------------
-- 表格模式
-- ---------------------------------------------------------------
if tableMode then
    -- -N 的列名只作**表头**(文本模式)与 **JSON 键名**; JSON 里不把它当数据行(GNU 同)。
    local rows = {}
    for _, cells in ipairs(lines) do rows[#rows + 1] = cells end

    if json then
        -- 一行数据都没有时 GNU 什么都不输出(不吐一个空 JSON 骨架)。
        if #rows == 0 then return rc end
        for _, cells in ipairs(rows) do
            if #cells > #colNames then
                stderr("column: line " .. #cells .. ": for JSON the name of the column "
                    .. #cells .. " is required\n")
                return 1
            end
        end
        local function jsonEscape(v)
            return (v:gsub('[%c"\\]', function(c)
                if c == '"' then return '\\"' end
                if c == "\\" then return "\\\\" end
                if c == "\n" then return "\\n" end
                if c == "\t" then return "\\t" end
                if c == "\r" then return "\\r" end
                return string.format("\\u%04x", string.byte(c))
            end))
        end
        -- 布局与 libsmartcols 的 JSON 输出逐字节一致(3 空格缩进, 行间用 "},{" 相接)
        local out = { '{\n   "' .. jsonEscape(tableName) .. '": [' }
        for r, cells in ipairs(rows) do
            out[#out + 1] = (r == 1) and "\n      {\n" or ",{\n"
            for c = 1, #colNames do
                out[#out + 1] = '         "' .. jsonEscape(colNames[c]) .. '": "'
                    .. jsonEscape(cells[c] or "") .. '"' .. (c < #colNames and ",\n" or "\n")
            end
            if #colNames == 0 then out[#out + 1] = "\n" end
            out[#out + 1] = "      }"
        end
        out[#out + 1] = "\n   ]\n}\n"
        io.write(table.concat(out))
        return rc
    end

    if colNames then table.insert(rows, 1, colNames) end
    local ncols = 0
    for _, cells in ipairs(rows) do
        if #cells > ncols then ncols = #cells end
    end
    local widths = {}
    for c = 1, ncols do widths[c] = 0 end
    for _, cells in ipairs(rows) do
        for c = 1, #cells do
            if #cells[c] > widths[c] then widths[c] = #cells[c] end
        end
    end
    local out = {}
    for _, cells in ipairs(rows) do
        if #cells == 0 then
            out[#out + 1] = "\n"
        else
            local parts = {}
            for c = 1, ncols do
                local cell = cells[c] or ""
                if c == ncols then
                    -- 最后一列不补空格(libsmartcols 同): 少了就留空。
                    parts[#parts + 1] = cell
                else
                    parts[#parts + 1] = cell .. string.rep(" ", widths[c] - #cell)
                end
            end
            out[#out + 1] = table.concat(parts, outSep) .. "\n"
        end
        if #out >= 128 then io.write(table.concat(out)); out = {}; yieldCheck() end
    end
    io.write(table.concat(out))
    return rc
end

-- ---------------------------------------------------------------
-- 填充模式(缺省按列填, -x 按行填)
-- ---------------------------------------------------------------
local ents = {}
for _, cells in ipairs(lines) do
    for _, cell in ipairs(cells) do ents[#ents + 1] = cell end
end
local maxlen = 0
for _, e in ipairs(ents) do if #e > maxlen then maxlen = #e end end

local useSpaces = minColSep ~= nil
local mincolsep = minColSep or 0
local TAB = 8
if useSpaces then
    maxlen = maxlen + mincolsep
else
    maxlen = math.floor((maxlen + TAB) / TAB) * TAB
end
if maxlen <= 0 then maxlen = TAB end
local numcols = math.floor(width / maxlen)
if numcols == 0 then numcols = 1 end
local remains = width % maxlen
if useSpaces and (remains + mincolsep >= maxlen) then numcols = numcols + 1 end

local out = {}
local function push(s)
    out[#out + 1] = s
    if #out >= 256 then io.write(table.concat(out)); out = {}; yieldCheck() end
end

if fillRows then
    local chcnt, col, endcol = 0, 0, maxlen
    for idx = 1, #ents do
        push(ents[idx])
        chcnt = chcnt + #ents[idx]
        if idx == #ents then break end
        col = col + 1
        if col == numcols then
            chcnt, col, endcol = 0, 0, maxlen
            push("\n")
        else
            if useSpaces then
                while chcnt < endcol do push(" "); chcnt = chcnt + 1 end
            else
                while true do
                    local cnt = math.floor((chcnt + TAB) / TAB) * TAB
                    if cnt > endcol then break end
                    push("\t"); chcnt = cnt
                end
            end
            endcol = endcol + maxlen
        end
    end
    if chcnt > 0 then push("\n") end
else
    local numrows = math.floor(#ents / numcols)
    if #ents % numcols ~= 0 then numrows = numrows + 1 end
    for row = 0, numrows - 1 do
        local endcol, chcnt = maxlen, 0
        local base = row + 1
        for col = 0, numcols - 1 do
            if not ents[base] then break end
            push(ents[base])
            chcnt = chcnt + #ents[base]
            base = base + numrows
            if not ents[base] then break end
            if useSpaces then
                while chcnt < endcol do push(" "); chcnt = chcnt + 1 end
            else
                while true do
                    local cnt = math.floor((chcnt + TAB) / TAB) * TAB
                    if cnt > endcol then break end
                    push("\t"); chcnt = cnt
                end
            end
            endcol = endcol + maxlen
        end
        push("\n")
    end
end
io.write(table.concat(out))
return rc
