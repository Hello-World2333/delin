-- Delin kill: 发送信号到进程/进程组 (GNU 子集)。用法:
--   kill [-s SIGNAL | -SIGNAL] pid...     默认 SIGTERM; pid 前加 - 表示进程组(-pgid)
--   kill -l [SIGNAL]                      列出信号名, 或 -l N/-l NAME 输出另一表示
-- 支持 --signal=SIG 与 -- 结束选项。
local args = args or {}

local function stderr(s)
    local e = io.stderr()
    if e and e.write then e:write(s) end
end

local sig = 15 -- SIGTERM
local listMode = false
local targets = {}
local noMoreOpts = false

local function signalName(n)
    return syscalls["signal.name"](n)
end
local function signalNumber(name)
    return syscalls["signal.number"](name)
end

local function parseSig(val)
    -- 接受数字或名字(可带 - 前缀, 可带 SIG 前缀)
    local t = tostring(val)
    t = t:gsub("^%-", "")
    if t:match("^%d+$") then return tonumber(t) end
    if t:match("^SIG") then t = t:sub(4) end
    return signalNumber(t)
end

local i = 1
while i <= #args do
    local a = args[i]
    if noMoreOpts then
        targets[#targets + 1] = a
    elseif a == "--" then
        noMoreOpts = true
    elseif a == "-l" or a == "--list" then
        listMode = true
        -- 可选的操作数: kill -l N(名字) / kill -l NAME(编号); 给了多个就每行一个(procps 同此)
        local rest = {}
        for k = i + 1, #args do rest[#rest + 1] = args[k] end
        if #rest > 0 then
            local out = {}
            for _, r in ipairs(rest) do
                if r:match("^%d+$") then
                    out[#out + 1] = signalName(tonumber(r)) or "?"
                else
                    local num = signalNumber(r:gsub("^SIG", ""))
                    out[#out + 1] = num and tostring(num) or "?"
                end
            end
            io.write(table.concat(out, "\n") .. "\n")
            return 0
        end
    elseif a == "-L" or a == "--table" then
        -- procps 的 -L 打的是**编号表**(与 -l 的平铺列表不同)
        local nums = syscalls["signal.list"]()
        for _, n in ipairs(nums) do
            io.write(string.format("%2d %s\n", n, signalName(n) or "?"))
        end
        return 0
    elseif a == "-h" or a == "--help" then
        io.write("usage: kill [-SIG|-s SIG] pid... | kill -l [SIG...] | kill -L\n")
        return 0
    elseif a == "-V" or a == "--version" then
        io.write("kill (Delin OS)\n")
        return 0
    elseif a == "-q" or a == "--queue" then
        stderr("kill: option '-q' is not supported (no sigqueue payload)\n")
        return 2    elseif a == "-s" or a == "--signal" then
        i = i + 1
        if not args[i] then stderr("kill: option requires an argument -- 's'\n"); return end
        sig = parseSig(args[i])
        if not sig then stderr("kill: unknown signal " .. args[i] .. "\n"); return end
    elseif a:match("^%-%-signal=") then
        sig = parseSig(a:sub(10))
        if not sig then stderr("kill: unknown signal " .. a:sub(10) .. "\n"); return end
    elseif a:match("^%-%d+$") then
        sig = tonumber(a:sub(2))
    elseif a:match("^%-[A-Za-z]+$") then
        sig = parseSig(a)
        if not sig then
            stderr("kill: unknown signal " .. a .. "\n")
            return 1
        end
    else
        targets[#targets + 1] = a
    end
    i = i + 1
end

if listMode then
    local nums = syscalls["signal.list"]()
    local t = {}
    for _, s in ipairs(nums) do t[#t + 1] = signalName(s) end
    io.write(table.concat(t, " ") .. "\n")
    return
end

if #targets == 0 then
    stderr("usage: kill [-SIG] pid...\n")
    return 1
end

for _, tgt in ipairs(targets) do
    local n = tonumber(tgt)
    if not n then
        stderr("kill: invalid pid " .. tostring(tgt) .. "\n")
    else
        local ok, e
        if n < 0 then
            ok, e = syscalls["signal.killpg"](-n, sig)
        else
            ok, e = syscalls["signal.kill"](n, sig)
        end
        if not ok then
            stderr("kill: (" .. tostring(tgt) .. ") " .. tostring(e) .. "\n")
        end
    end
end
