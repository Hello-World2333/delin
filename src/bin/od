-- Delin od: 以多种格式转储文件 (POSIX + GNU 子集)。用法:
--   od [-A RADIX] [-j SKIP] [-N COUNT] [-t TYPE]... [-v] [-w WIDTH]
--      [-b] [-c] [-d] [-o] [-x] [FILE]...
-- 选项:
--   -A RADIX, --address-radix=RADIX   偏移基数: d(十进制) o(八进制, 缺省) x(十六进制) n(不打印)
--   -j SKIP, --skip-bytes=SKIP        跳过开头 SKIP 字节(支持 0x/0 前缀与 b/k/m 后缀)
--   -N COUNT, --read-bytes=COUNT      最多转储 COUNT 字节
--   -t TYPE, --format=TYPE            输出类型: a c d[1|2|4|8] o[...] u[...] x[...] f[4|8]; 可给多次, 可带 z 后缀
--   -v, --output-duplicates           不折叠重复行(缺省用一行 "*" 折叠)
--   -w WIDTH, --width=WIDTH           每行字节数(缺省 16)
--   -b ≡ -t o1, -c ≡ -t c, -d ≡ -t d2, -o ≡ -t o2, -x ≡ -t x2
-- 缺省输出等于 -t o2。FILE 缺省或 "-" 读 stdin, 多个文件按顺序拼接。
-- 已知偏离:
--   - -t 的 z 后缀(在每行右端附 ASCII 可打印字符)已实现; 但 z 只能作后缀, 不能单独当类型用(与 GNU 一致)。
--   - 浮点用"最短可回读表示"输出(host printf 的 %.Ng 试探), f4 会先量化到 IEEE single; 次正规数可能与 GNU 差最后一位。
--   - 只支持任务要求的选项集; --traditional/--endian 之类未实现(字节序固定为小端, 与 CC/host 一致)。
local args = args or {}
local cwd = (type(cwd) == "string" and cwd) or "/"
local function resolve(p)
    p = p or ""
    if p == "" then return (cwd == "/") and "/" or cwd end
    if p:sub(1, 1) == "/" then
        if p == "/" then return "/" end
        return p:gsub("/+$", "")
    end
    local base = (cwd == "/") and "" or cwd
    return (base .. "/" .. p):gsub("/+", "/")
end
local function stderr(s)
    local e = io.stderr()
    if e and e.write then e:write(s) end
end
local function ioeMsg(err)
    if err and (err:find("permission") or err:find("denied")) then return "Permission denied" end
    -- 必须先判 ENOENT: "No such file or directory" 里本来就含 "directory" 这个词,
    -- 先匹 "directory" 会把"文件不存在"误报成 "Is a directory"(老模板的 bug)。
    if err and err:lower():find("no such file") then return "No such file or directory" end
    if err and err:find("directory") then return "Is a directory" end
    return "No such file or directory"
end

local addrRadix = "o"
local skipBytes, limitBytes = 0, nil
local width = 16
local noDupFold = false
local types = {}
local files = {}
local noMoreOpts = false

-- 数值解析: 0x 十六进制 / 0 八进制 / 十进制, 可带 b/k/m 后缀。
local function parseNum(val)
    local s = val
    local mult = 1
    local last = s:sub(-1)
    if last == "b" or last == "B" then mult = 512; s = s:sub(1, -2)
    elseif last == "k" or last == "K" then mult = 1024; s = s:sub(1, -2)
    elseif last == "m" or last == "M" then mult = 1024 * 1024; s = s:sub(1, -2) end
    local n
    if s:match("^0[xX]") then n = tonumber(s:sub(3), 16)
    elseif s:match("^0%d") then n = tonumber(s:sub(2), 8)
    else n = tonumber(s) end
    if not n then return nil end
    return math.floor(n * mult)
end

-- 解析类型串: 形如 "x1"、"cz"、"d2"、"o"、"u4"、"f8"、"a"。
local function parseType(spec)
    local z = false
    if spec:sub(-1) == "z" then z = true; spec = spec:sub(1, -2) end
    local ch = spec:sub(1, 1)
    local rest = spec:sub(2)
    if ch == "a" or ch == "c" then
        if rest ~= "" then stderr("od: invalid character '" .. rest:sub(1, 1) .. "' in type string '" .. spec .. "'\n"); return nil end
        return { kind = ch, size = 1, ascii = z }
    end
    if ch == "z" then
        stderr("od: invalid character '" .. ch .. "' in type string '" .. spec .. "'\n")
        return nil
    end
    if not ch:match("[douxf]") then
        stderr("od: invalid character '" .. ch .. "' in type string '" .. spec .. "'\n")
        return nil
    end
    if ch == "f" then
        if rest == "" then rest = "4" end
        if rest ~= "4" and rest ~= "8" then
            stderr("od: invalid type string '" .. spec .. "'\n")
            return nil
        end
        return { kind = "f", size = tonumber(rest), ascii = z }
    end
    if rest == "" then rest = (ch == "d" or ch == "u") and "2" or "2" end
    local n = tonumber(rest)
    if not n or (n ~= 1 and n ~= 2 and n ~= 4 and n ~= 8) then
        stderr("od: invalid type string '" .. spec .. "'\n")
        return nil
    end
    return { kind = ch, size = n, ascii = z }
end

-- 各类型的字段宽度(值部分; 输出时前面再加一个空格分隔符)。
local FIELD_WIDTH = {
    d1 = 4, d2 = 6, d4 = 11, d8 = 21,
    u1 = 3, u2 = 5, u4 = 10, u8 = 20,
    o1 = 3, o2 = 6, o4 = 11, o8 = 22,
    x1 = 2, x2 = 4, x4 = 8, x8 = 16,
    a1 = 3, c1 = 3,
    f4 = 15, f8 = 24,
}
local function fieldWidth(t)
    if t.kind == "f" then return FIELD_WIDTH["f" .. t.size] end
    return FIELD_WIDTH[t.kind .. t.size]
end

local i = 1
while i <= #args do
    local a = args[i]
    if noMoreOpts then
        files[#files + 1] = a
    elseif a == "--" then
        noMoreOpts = true
    elseif a == "-v" or a == "--output-duplicates" then noDupFold = true
    elseif a == "-b" then types[#types + 1] = assert(parseType("o1"))
    elseif a == "-c" then types[#types + 1] = assert(parseType("c"))
    elseif a == "-d" then types[#types + 1] = assert(parseType("d2"))
    elseif a == "-o" then types[#types + 1] = assert(parseType("o2"))
    elseif a == "-x" then types[#types + 1] = assert(parseType("x2"))
    elseif a:match("^%-%-address%-radix=") then
        local v = a:sub(18)
        if v ~= "d" and v ~= "o" and v ~= "x" and v ~= "n" then
            stderr("od: invalid output address radix '" .. v:sub(1, 1) .. "'; it must be one character from [doxn]\n")
            return 1
        end
        addrRadix = v
    elseif a:match("^%-%-skip%-bytes=") then
        skipBytes = parseNum(a:sub(14))
        if not skipBytes then stderr("od: invalid number: '" .. a:sub(14) .. "'\n"); return 1 end
    elseif a:match("^%-%-read%-bytes=") then
        limitBytes = parseNum(a:sub(14))
        if not limitBytes then stderr("od: invalid number: '" .. a:sub(14) .. "'\n"); return 1 end
    elseif a:match("^%-%-width=") then
        width = tonumber(a:sub(9))
        if not width or width < 1 then stderr("od: invalid number: '" .. a:sub(9) .. "'\n"); return 1 end
    elseif a:match("^%-%-format=") then
        local t = parseType(a:sub(10))
        if not t then return 1 end
        types[#types + 1] = t
    elseif a:match("^%-%-") then
        stderr("od: unrecognized option '" .. a .. "'\n")
        return 1
    elseif a:sub(1, 1) == "-" and a ~= "-" then
        local k = 2
        while k <= #a do
            local ch = a:sub(k, k)
            if ch == "v" then noDupFold = true; k = k + 1
            elseif ch == "b" then types[#types + 1] = assert(parseType("o1")); k = k + 1
            elseif ch == "c" then types[#types + 1] = assert(parseType("c")); k = k + 1
            elseif ch == "d" then types[#types + 1] = assert(parseType("d2")); k = k + 1
            elseif ch == "x" then types[#types + 1] = assert(parseType("x2")); k = k + 1
            elseif ch == "o" then types[#types + 1] = assert(parseType("o2")); k = k + 1
            elseif ch == "A" or ch == "j" or ch == "N" or ch == "t" or ch == "w" then
                local val = a:sub(k + 1)
                if val == "" then
                    i = i + 1
                    if not args[i] then stderr("od: option requires an argument -- '" .. ch .. "'\n"); return 1 end
                    val = args[i]
                end
                if ch == "A" then
                    if val ~= "d" and val ~= "o" and val ~= "x" and val ~= "n" then
                        stderr("od: invalid output address radix '" .. val:sub(1, 1) .. "'; it must be one character from [doxn]\n")
                        return 1
                    end
                    addrRadix = val
                elseif ch == "j" then
                    skipBytes = parseNum(val)
                    if not skipBytes then stderr("od: invalid number: '" .. val .. "'\n"); return 1 end
                elseif ch == "N" then
                    limitBytes = parseNum(val)
                    if not limitBytes then stderr("od: invalid number: '" .. val .. "'\n"); return 1 end
                elseif ch == "w" then
                    width = tonumber(val)
                    if not width or width < 1 then stderr("od: invalid number: '" .. val .. "'\n"); return 1 end
                else
                    local t = parseType(val)
                    if not t then return 1 end
                    types[#types + 1] = t
                end
                k = #a + 1
            else
                stderr("od: invalid option -- '" .. ch .. "'\n")
                return 1
            end
        end
    else
        files[#files + 1] = a
    end
    i = i + 1
end
if #types == 0 then types = { parseType("o2") } end
if #files == 0 then files = { "-" } end

-- 无位运算的数字格式化。
local function fmtOct(v, w)
    local s = ""
    if v == 0 then s = "0" else
        while v > 0 do
            s = string.char(48 + v % 8) .. s
            v = math.floor(v / 8)
        end
    end
    while #s < w do s = "0" .. s end
    return s
end
local function fmtHex(v, w)
    local digits = "0123456789abcdef"
    local s = ""
    if v == 0 then s = "0" else
        while v > 0 do
            s = digits:sub(v % 16 + 1, v % 16 + 1) .. s
            v = math.floor(v / 16)
        end
    end
    while #s < w do s = "0" .. s end
    return s
end
local function fmtDec(v)
    local s = ""
    if v == 0 then return "0" end
    while v > 0 do
        s = string.char(48 + v % 10) .. s
        v = math.floor(v / 10)
    end
    return s
end
local function padLeft(s, w)
    while #s < w do s = " " .. s end
    return s
end

local function pow2(k)
    if k >= -1022 and k <= 1023 then return 2 ^ k end
    if k < -1022 then return 2 ^ (k + 1000) * 2 ^ -1000 end
    return 2 ^ (k - 1000) * 2 ^ 1000
end

-- IEEE754 解码(小端字节)。
local function f32value(b0, b1, b2, b3)
    local v = b0 + b1 * 256 + b2 * 65536 + b3 * 16777216
    local sign = 1
    if v >= 2147483648 then sign = -1; v = v - 2147483648 end
    local exp = math.floor(v / 8388608)
    local frac = v % 8388608
    if exp == 255 then
        if frac == 0 then return sign * math.huge end
        return 0 / 0
    end
    if exp == 0 then
        if frac == 0 then return sign * 0 end
        return sign * frac * pow2(-149)
    end
    return sign * (frac + 8388608) * pow2(exp - 150)
end
local function f64value(b)
    local lo = b[1] + b[2] * 256 + b[3] * 65536 + b[4] * 16777216
    local hi = b[5] + b[6] * 256 + b[7] * 65536 + b[8] * 16777216
    -- 拆成 3 段避开 2^64 精度问题: hi 的高 1 位是符号, 之后 11 位是指数。
    local sign = 1
    if math.floor(hi / 2147483648) >= 1 then sign = -1; hi = hi - 2147483648 end
    local exp = math.floor(hi / 1048576)
    local fracHi = hi % 1048576
    local frac = fracHi * 4294967296 + lo       -- 52 位尾数
    if exp == 2047 then
        if frac == 0 then return sign * math.huge end
        return 0 / 0
    end
    if exp == 0 then
        if frac == 0 then return sign * 0 end
        return sign * frac * pow2(-1074)
    end
    return sign * (frac + 4503599627370496) * pow2(exp - 1075)
end

-- 双精度 -> 最近的 IEEE single(用于 f4 的最短回读判断)。
local function tof32(x)
    if x ~= x or x == math.huge or x == -math.huge or x == 0 then return x end
    local sign = 1
    if x < 0 then sign = -1; x = -x end
    local m, e = math.frexp(x)
    if e > 128 then return sign * math.huge end
    if e < -125 then
        local rv = math.floor(x / pow2(-149) + 0.5)
        return sign * rv * pow2(-149)
    end
    local mm = m * 16777216
    local r = math.floor(mm + 0.5)
    if r >= 16777216 then r = r / 2; e = e + 1 end
    if e > 128 then return sign * math.huge end
    return sign * r * pow2(e - 24)
end

-- 浮点最短可回读表示(GNU od 用最短表示)。
local function fmtFloat(v, single)
    if v ~= v then return "nan" end
    if v == math.huge then return "inf" end
    if v == -math.huge then return "-inf" end
    local maxp = single and 9 or 17
    for p = 1, maxp do
        local s = string.format("%." .. p .. "g", v)
        local back = tonumber(s)
        if back then
            if single then
                if tof32(back) == v then return s end
            else
                if back == v then return s end
            end
        end
    end
    return string.format("%." .. maxp .. "g", v)
end

local CH_ESCAPE = { [0] = "\\0", [7] = "\\a", [8] = "\\b", [9] = "\\t", [10] = "\\n", [11] = "\\v", [12] = "\\f", [13] = "\\r" }
local CH_NAME = {
    "nul", "soh", "stx", "etx", "eot", "enq", "ack", "bel", "bs", "ht", "nl", "vt", "ff", "cr", "so", "si",
    "dle", "dc1", "dc2", "dc3", "dc4", "nak", "syn", "etb", "can", "em", "sub", "esc", "fs", "gs", "rs", "us",
}
local function charCell(b)
    if b >= 32 and b <= 126 then return string.char(b) end
    local e = CH_ESCAPE[b]
    if e then return e end
    return fmtOct(b, 3)
end
local function nameCell(b)
    if b == 32 then return "sp" end
    if b >= 33 and b <= 126 then return string.char(b) end
    if b >= 128 or b == 127 then return "del" end
    return CH_NAME[b + 1] or "?"
end

-- 渲染一个值单元。
local function valueCell(t, block, pos)
    local size = t.size
    local missing = false
    local raw = {}
    for k = 1, size do
        local b = block:byte(pos + k - 1)
        if b == nil then missing = true; b = 0 end
        raw[k] = b
    end
    if t.kind == "a" then return padLeft(nameCell(raw[1]), fieldWidth(t)) end
    if t.kind == "c" then return padLeft(charCell(raw[1]), fieldWidth(t)) end
    if t.kind == "f" then
        local s
        if size == 4 then s = fmtFloat(f32value(raw[1], raw[2], raw[3], raw[4]), true)
        else s = fmtFloat(f64value(raw), false) end
        return padLeft(s, fieldWidth(t))
    end
    local v = 0
    for k = 1, size do v = v + raw[k] * pow2(8 * (k - 1)) end
    local bits = 8 * size
    if t.kind == "o" then return fmtOct(v, fieldWidth(t)) end
    if t.kind == "x" then return fmtHex(v, fieldWidth(t)) end
    if t.kind == "u" then return padLeft(fmtDec(v), fieldWidth(t)) end
    -- d: 有符号
    local half = pow2(bits - 1)
    if v >= half then v = v - pow2(bits) end
    if v < 0 then return padLeft("-" .. fmtDec(-v), fieldWidth(t)) end
    return padLeft(fmtDec(v), fieldWidth(t))
end

-- 偏移字段宽度: -A n 时为 0(不打印), -A x 为 6, 其余 7。
local function offsetFieldWidth()
    if addrRadix == "n" then return 0 end
    if addrRadix == "x" then return 6 end
    return 7
end

local function offsetStr(off, w)
    if addrRadix == "o" then return fmtOct(off, w)
    elseif addrRadix == "x" then return fmtHex(off, w)
    elseif addrRadix == "d" then
        local ds = fmtDec(off)
        while #ds < w do ds = "0" .. ds end
        return ds
    end
    return ""
end

-- 多类型输出时, 同尺寸(size)的字段按该类里最宽的"自然字段宽度"左补空格对齐(与 GNU 一致)。
local classExtra = {}
do
    local classMax = {}
    for _, t in ipairs(types) do
        local w = fieldWidth(t) + 1
        if not classMax[t.size] or classMax[t.size] < w then classMax[t.size] = w end
    end
    for _, t in ipairs(types) do
        classExtra[#classExtra + 1] = classMax[t.size] - (fieldWidth(t) + 1)
    end
end

-- 输入: 多个文件顺序拼接; 支持跳过与截断。
local fileIdx = 1
local curH = nil
local function openNextFile()
    while fileIdx <= #files do
        local name = files[fileIdx]
        fileIdx = fileIdx + 1
        if name == "-" then
            local h = io.stdin()
            if h then return h, name end
        else
            local h, err = fs.open(resolve(name), "r")
            if not h then
                stderr("od: " .. name .. ": " .. ioeMsg(err) .. "\n")
                return nil, nil, true
            end
            return h, name
        end
    end
    return nil
end

-- 读一块最多 n 字节。
local function readSome(n)
    while true do
        if not curH then
            local h, _, fatal = openNextFile()
            if fatal then return nil, true end
            if not h then return nil end
            curH = h
        end
        local chunk
        if curH.read then chunk = curH:read(n) end
        if type(chunk) ~= "string" or chunk == "" then
            -- 无字节读取能力的句柄(宿主测试台 stdin): 逐行 + 换行。
            local l = curH:readLine()
            if l == nil then
                if files[fileIdx - 1] ~= "-" then pcall(function() curH:close() end) end
                curH = nil
            else
                chunk = l .. "\n"
            end
        end
        if chunk and #chunk > 0 then
            if #chunk > n then
                -- 读多了: 只能丢弃(od 只在最后一块需要精确 n, 调用方保证 n 足够大)
                return chunk:sub(1, n), nil, chunk:sub(n + 1)
            end
            return chunk
        end
    end
end

-- 跳过字节。
if skipBytes > 0 then
    local left = skipBytes
    while left > 0 do
        local chunk, fatal = readSome(left > 65536 and 65536 or left)
        if fatal then return 1 end
        if not chunk then
            stderr("od: cannot skip past end of combined input\n")
            return 1
        end
        left = left - #chunk
    end
end

local offset = skipBytes
local pend = nil
local remaining = limitBytes
local lines = {}
local function emit(s)
    lines[#lines + 1] = s
    if #lines >= 256 then io.write(table.concat(lines)); lines = {} end
end

local prevBlock = nil
local printedStar = false
while true do
    local want = width
    if remaining and remaining < want then want = remaining end
    if want == 0 then break end
    local block = pend or ""
    pend = nil
    while #block < want do
        local chunk, fatal, extra = readSome(want - #block)
        if fatal then return 1 end
        if not chunk then break end
        block = block .. chunk
        if extra then pend = extra; break end
    end
    if #block == 0 then break end
    local n = #block
    if n > want then n = want end
    -- 折叠重复的整块。
    local full = (n == width)
    if full and prevBlock and prevBlock == block and not noDupFold then
        if not printedStar then emit("*\n"); printedStar = true end
    else
        printedStar = false
        local offW = offsetFieldWidth()
        for ti, t in ipairs(types) do
            local parts = {}
            if addrRadix ~= "n" then
                if ti == 1 then parts[#parts + 1] = offsetStr(offset, offW)
                else parts[#parts + 1] = string.rep(" ", offW) end
            end
            local size = t.size
            local extra = classExtra[ti] or 0
            local pos = 1
            while pos <= n do
                parts[#parts + 1] = string.rep(" ", extra) .. " " .. valueCell(t, block, pos)
                pos = pos + size
            end
            if t.ascii then
                local dataW = math.floor(width / size) * (fieldWidth(t) + 1)
                local goal = offW + dataW + 2
                local cur = 0
                for _, p in ipairs(parts) do cur = cur + #p end
                if cur < goal then parts[#parts + 1] = string.rep(" ", goal - cur) end
                local asc = {}
                for k = 1, n do
                    local b = block:byte(k)
                    asc[#asc + 1] = (b >= 32 and b <= 126) and string.char(b) or "."
                end
                parts[#parts + 1] = ">" .. table.concat(asc) .. "<"
            end
            emit(table.concat(parts) .. "\n")
        end
    end
    if full then prevBlock = block end
    offset = offset + n
    if remaining then
        remaining = remaining - n
        if remaining <= 0 then break end
    end
end
if addrRadix ~= "n" then
    emit(offsetStr(offset, offsetFieldWidth()) .. "\n")
end
if #lines > 0 then io.write(table.concat(lines)) end
