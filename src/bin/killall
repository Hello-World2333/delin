-- Delin killall: 按进程名给所有同名进程发信号 (psmisc killall 子集)。
-- 数据源 = /proc。用法:
--   killall [-SIGNAL | -s SIGNAL | -l] [-e] [-q] [-u USER] NAME...
--   NAME 必须与进程名(comm)完全相同; 默认信号 SIGTERM。
--   -l  列出信号名;  -e 打印被杀的进程;  -q 名字没匹配到进程时不报错
--   -u USER  只杀该用户的进程(用户名或 uid)
-- 退出码: 0 = 每个 NAME 都至少匹配到一个进程; 1 = 有 NAME 没匹配到; 2 = 用法错误。
-- killall 不杀自己(pgrep/pkill 的同一约定)。
local args = args or {}

local function stderr(s)
    local e = io.stderr()
    if e and e.write then e:write(s) end
end

local function readFile(path)
    local h = fs.open(path, "r")
    if not h then return nil end
    local c = h:readAll()
    h:close()
    return c
end

local function parseStatus(text)
    local t = {}
    for line in text:gmatch("[^\n]+") do
        local k, v = line:match("^(%w+):%s*(.*)$")
        if k then t[k] = v end
    end
    return t
end

local function selfPid()
    local st = readFile("/proc/self/stat")
    if not st then return nil end
    return tonumber(st:match("^(%d+)"))
end

--- 枚举 /proc 下的进程: { pid, comm }。
local function candidates()
    local out = {}
    for _, e in ipairs(fs.list("/proc") or {}) do
        local pid = tonumber(e)
        if pid then
            local comm = readFile("/proc/" .. pid .. "/comm")
            if comm then
                out[#out + 1] = { pid = pid, comm = (comm:gsub("\n$", "")) }
            end
        end
    end
    table.sort(out, function(a, b) return a.pid < b.pid end)
    return out
end

local function resolveUser(spec)
    local n = tonumber(spec)
    if n then return n end
    local u = syscalls and syscalls["user.get"] and syscalls["user.get"](spec)
    if not u then return nil end
    return u.uid
end

local function resolveSignal(spec)
    local t = tostring(spec):gsub("^%-", "")
    if t:match("^%d+$") then return tonumber(t) end
    if t:match("^SIG") then t = t:sub(4) end
    return syscalls["signal.number"](t)
end

local sig = 15
local optE, optQ, optUser = false, false, nil
local names = {}
-- psmisc 的 -e/--exact 是"名字要完全一致"(Delin 本来就按 comm 全等比较, 所以它天然成立);
-- **-v/--verbose 才是"报告每个被杀掉的进程"** —— 老代码把 -e 当成了 -v, 语义错位。
local optVerbose, optInteractive, optWait, optIcase = false, false, false, false
local optRegexp, optPgroup = false, false
local optExact = false

local i = 1
while i <= #args do
    local a = args[i]
    if a == "--" then
        for k = i + 1, #args do names[#names + 1] = args[k] end
        break
    elseif a:sub(1, 2) == "--" then
        local name, val = a:match("^%-%-([%w-]+)=?(.*)$")
        if name == "verbose" then optVerbose = true
        elseif name == "interactive" then optInteractive = true
        elseif name == "wait" then optWait = true
        elseif name == "ignore-case" then optIcase = true
        elseif name == "regexp" then optRegexp = true
        elseif name == "exact" then optExact = true
        elseif name == "process-group" then optPgroup = true
        elseif name == "older-than" or name == "younger-than" then
            stderr("killall: option '--" .. name .. "' is not supported (no process start time)\n")
            return 2
        elseif name == "signal" then
            if val == "" then i = i + 1; val = args[i] end
            if not val then stderr("killall: option '--signal' requires an argument\n"); return 2 end
            sig = resolveSignal(val)
            if not sig then stderr("killall: unknown signal " .. val .. "\n"); return 2 end
        else
            stderr("killall: unrecognized option '" .. a .. "'\n")
            return 2
        end
    elseif a:sub(1, 1) == "-" and #a > 1 then
        local j = 2
        while j <= #a do
            local c = a:sub(j, j)
            if c == "e" then optE, optExact = true, true
            elseif c == "v" then optVerbose = true
            elseif c == "i" then optInteractive = true
            elseif c == "w" then optWait = true
            elseif c == "I" then optIcase = true
            elseif c == "r" then optRegexp = true
            elseif c == "g" then optPgroup = true
            elseif c == "q" then optQ = true
            elseif c == "l" then
                local t = {}
                for _, n in ipairs(syscalls["signal.list"]()) do
                    t[#t + 1] = syscalls["signal.name"](n)
                end
                io.write(table.concat(t, " ") .. "\n")
                return 0
            elseif c == "s" then
                local val = a:sub(j + 1)
                if val == "" then i = i + 1; val = args[i] end
                if not val then stderr("killall: option requires an argument -- 's'\n"); return 2 end
                sig = resolveSignal(val)
                if not sig then stderr("killall: unknown signal " .. val .. "\n"); return 2 end
                j = #a
            elseif c == "u" then
                local val = a:sub(j + 1)
                if val == "" then i = i + 1; val = args[i] end
                if not val then stderr("killall: option requires an argument -- 'u'\n"); return 2 end
                optUser = resolveUser(val)
                if optUser == nil then stderr("killall: user '" .. val .. "' does not exist\n"); return 2 end
                j = #a
            elseif c:match("%d") or c:match("%u") then
                sig = resolveSignal(a:sub(j))
                if not sig then stderr("killall: unknown signal " .. a:sub(j) .. "\n"); return 2 end
                j = #a
            else
                stderr("killall: invalid option -- '" .. c .. "'\n")
                return 2
            end
            j = j + 1
        end
    else
        names[#names + 1] = a
    end
    i = i + 1
end

if #names == 0 then stderr("usage: killall [-SIGNAL] [-v] [-i] [-w] [-I] [-r] [-g] [-q] [-u user] name...\n"); return 2 end

local self = selfPid()
local procs = candidates()
local outcome = 0
local killedPids = {}

--- -r: 名字按 ERE 匹配(procps/psmisc 的 --regexp); 缺省是完全相等。
local function nameMatches(comm, name)
    if optRegexp then
        local re = syscalls["regex.compile"](name, "ere", { icase = optIcase })
        if not re then
            stderr("killall: invalid regular expression: " .. tostring(name) .. "\n")
            outcome = 2
            return false
        end
        return re:find(comm) ~= nil
    end
    if optIcase then return comm:lower() == name:lower() end
    return comm == name
end

for _, name in ipairs(names) do
    local sent, found = 0, 0
    for _, p in ipairs(procs) do
        if p.pid ~= self and nameMatches(p.comm, name) then
            local uidOk = true
            if optUser ~= nil then
                local s = parseStatus(readFile("/proc/" .. p.pid .. "/status") or "")
                uidOk = (tonumber(s.Uid) or -1) == optUser
            end
            if uidOk then
                found = found + 1
                local proceed = true
                if optInteractive then
                    io.write("Kill " .. p.comm .. "(" .. p.pid .. ") ? ")
                    io.flush()
                    local sin = io.stdin()
                    local line = sin and sin.readLine and sin:readLine() or nil
                    proceed = (line ~= nil) and (line:match("^[yY]") ~= nil)
                end
                if proceed then
                    local ok, err
                    if optPgroup then
                        -- -g: 杀进程**组**(psmisc 语义)
                        ok, err = syscalls["signal.killpg"](p.pgrp or p.pid, sig)
                    else
                        ok, err = syscalls["signal.kill"](p.pid, sig)
                    end
                    if ok then
                        sent = sent + 1
                        killedPids[#killedPids + 1] = p.pid
                        if optVerbose or optE then
                            io.write("Killed " .. p.comm .. "(" .. p.pid .. ") with signal "
                                .. tostring(sig) .. "\n")
                        end
                    else
                        stderr("killall: " .. p.pid .. ": " .. tostring(err) .. "\n")
                    end
                end
            end
        end
    end
    if found == 0 then
        if not optQ then stderr("killall: " .. name .. ": no process found\n") end
        outcome = 1
    end
end

-- -w: 等所有被杀的进程真正退出(轮询 /proc/<pid>)
if optWait and #killedPids > 0 then
    for _ = 1, 600 do
        local alive = false
        for _, pid in ipairs(killedPids) do
            if fs.exists("/proc/" .. pid) then alive = true end
        end
        if not alive then break end
        if os.msleep then os.msleep(50) else os.sleep(0.05) end
    end
end

return outcome
