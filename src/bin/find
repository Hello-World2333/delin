-- Delin find: 遍历目录树并按表达式筛选/动作 (POSIX find(1) 核心子集 + 常用 GNU 项)。
-- 用法: find [PATH...] [EXPRESSION]
--   缺省 PATH 是 "."; 缺省动作是 -print(表达式里已有别的动作时不追加)。
-- 谓词:
--   -name PAT -iname PAT      名字匹配(shell 式通配 * ? [...], 不是正则)
--   -path PAT -ipath PAT      整条打印路径匹配(同上通配)
--   -type X                   X 取 f d l p c b 的组合(逗号分隔, 如 -type f,d); c 与 b 都看设备
--   -size N[cwbkMG]           大小(缺省单位 512B; c=字节 w=2B b=512B k/M/G), 向上取整后比较
--   -empty                    空文件或空目录
--   -perm [-]MODE             权限位: 无前缀=完全相等, "-"=所有位都要有, "/"=任一位(GNU)
--   -user NAME -group NAME   属主/属组名;  -uid N -gid N 数字形式
--   -links N                 硬链接数
--   -newer FILE              修改时间晚于 FILE
--   -mtime N -mmin N         N*24 小时 / N 分钟前修改过(+/-, 秒数向下取整)
--   -maxdepth N -mindepth N  遍历深度限制(全局选项, 可出现在表达式任意位置)
-- 动作/运算符:
--   -print -print0 -printf FMT(-printf 支持 %p %f %s %y %h 与 %%, 以及 \n \t \r \0 \\ 转义)
--   -delete(隐含 -depth: 先删子项再删目录) -prune -quit -exec CMD {} ; -exec CMD {} +
--   -ls 未实现(见下);  -a/-and -o/-or !/-not ( ) ,
-- 语义要点:
--   - 每个条目用 fs.lstat(不跟随符号链接, -type l 才看得见链接本身); 目录遍历用 fs.list + fs.combine,
--     并用 fs.lstat 判类型(不用 fs.find: 它一次把整棵树读进内存且不区分类型)。
--   - 遍历顺序: 每个目录内按**目录项名排序**递归(宿主 GNU find 用 readdir 原始顺序, 因此两者的
--     输出顺序可能不同; 排序是刻意的 —— 结果可复现)。
--   - -exec ... ; : 命令返回非 0 **不**改变 find 的退出码(GNU 实测如此); 每个匹配执行一次。
--   - -exec ... + : 攒够一批执行一次(批上限 1024 项/64KB), 任一次调用失败(含 exec 失败)退出码 1。
-- 已知偏离:
--   - -ls 未实现(遇到即报错退出), 因为 inode/块数/属主在 CC 原生 fs 上不存在。
--   - -mtime/-mmin/-newer 依赖 fs.attributes().mtime: ext2 有(秒), CC 原生 fs 没有(nil)。
--     **拿不到时间戳时明确报错并停止**(find: -mtime: this filesystem has no timestamps), 不静默判为不匹配。
--     同理 -user/-group/-uid/-gid 需要 uid/gid, -links 需要链接数, 缺了都明确报错。
--   - -perm 不支持符号模式(如 u=rw); -type 不支持 s/D 等其它类型码: 都报错, 不静默忽略。
--   - -printf 只支持 %p %f %s %y %h %%(其它指示符报错); 不支持宽度/精度(%-10p)。
--   - -delete 隐含 -depth, 此时 -prune 无意义(GNU 也会警告)。-maxdepth 之外的 -depth/-xdev/-follow
--     未实现; -L/-H/-P 未实现(一律不跟随符号链接)。
--   - 诊断信息用英文(与本项目其他工具一致)。
local args = args or {}
local cwd = (type(cwd) == "string" and cwd) or "/"
local function resolve(p)
    p = p or ""
    if p == "" then return (cwd == "/") and "/" or cwd end
    if p:sub(1, 1) == "/" then
        if p == "/" then return "/" end
        return p:gsub("/+$", "")
    end
    local base = (cwd == "/") and "" or cwd
    return (base .. "/" .. p):gsub("/+", "/")
end
local function stderr(s)
    local e = io.stderr()
    if e and e.write then e:write(s) end
end
local function ioeMsg(err)
    if err and (err:find("permission") or err:find("denied")) then return "Permission denied" end
    return tostring(err or "I/O error")
end

-- ---------------------------------------------------------------
-- 基础工具
-- ---------------------------------------------------------------
--- 取不跟随符号链接的属性; 路径(最后一段)不存在时返回 nil。
--- fs.exists 复核一次: 宿主测试台的 fs.lstat 桩对不存在的路径也会给出一张表(真机返回 nil);
--- 只把 kind == "symlink" 的表当作链接, 于是悬空链接(链接本身存在)仍算存在。
local function lstat(p)
    local a = fs.lstat(p)
    if not a then return nil end
    if a.kind == "symlink" then return a end
    if fs.exists(p) then return a end
    return nil
end

--- 类型字符(与 -type / -printf %y 一致)。
local function typeChar(a)
    if a.kind == "symlink" then return "l" end
    if a.kind == "fifo" then return "p" end
    if a.kind == "device" then return "c" end
    if a.isDir then return "d" end
    if a.kind == "file" then return "f" end
    -- CC 原生 fs 只给 isDir: 当作普通文件。
    return "f"
end

--- 遍历用的子路径拼接: 保留操作数原样(GNU: `find d1/` 打印 "d1/" 与 "d1/x")。
local function joinPath(parent, name)
    if parent == "/" then return "/" .. name end
    if parent:sub(-1) == "/" then return parent .. name end
    return parent .. "/" .. name
end

local function baseName(p)
    local q = p:gsub("/+$", "")
    if q == "" then return "/" end
    return (q:match("([^/]+)$")) or q
end
local function dirName(p)
    local d = p:match("^(.*)/[^/]*$")
    if d == nil then return "." end
    if d == "" then return "/" end
    return d
end

--- 位与(不用位运算符: 宿主要跑 Lua 5.1)。
local function band(a, b)
    local r, bit = 0, 1
    while a > 0 and b > 0 do
        if a % 2 == 1 and b % 2 == 1 then r = r + bit end
        a = math.floor(a / 2)
        b = math.floor(b / 2)
        bit = bit * 2
    end
    return r
end

-- ---------------------------------------------------------------
-- shell 式通配(-name/-path; 不是正则)
-- ---------------------------------------------------------------
--- 匹配一个 [] 字符组。i 指向 '[' 之后, ch 是待判字符。
--- 返回 (下一个位置, 是否命中); 未闭合的组返回 nil(整个匹配失败)。
local function classAt(pat, i, ch)
    local neg = false
    local c0 = pat:sub(i, i)
    if c0 == "!" or c0 == "^" then neg = true; i = i + 1 end
    local hit, first = false, true
    while i <= #pat do
        local c = pat:sub(i, i)
        if c == "]" and not first then return i + 1, (hit ~= neg) end
        first = false
        if c == "\\" and i < #pat then
            local lit = pat:sub(i + 1, i + 1)
            if ch == lit then hit = true end
            i = i + 2
        elseif pat:sub(i + 1, i + 1) == "-" and i + 2 <= #pat and pat:sub(i + 2, i + 2) ~= "]" then
            local lo, hi = c, pat:sub(i + 2, i + 2)
            if ch >= lo and ch <= hi then hit = true end
            i = i + 3
        else
            if ch == c then hit = true end
            i = i + 1
        end
    end
    return nil, false
end

--- shell 式通配匹配(* 也匹配 "/", 与 find 的 -name/-path 一致)。
local function globMatch(pat, str)
    local function m(pi, si)
        while pi <= #pat do
            local c = pat:sub(pi, pi)
            if c == "*" then
                while pat:sub(pi, pi) == "*" do pi = pi + 1 end
                if pi > #pat then return true end
                for k = si, #str do
                    if m(pi, k) then return true end
                end
                return false
            elseif c == "?" then
                if si > #str then return false end
                pi, si = pi + 1, si + 1
            elseif c == "[" then
                if si > #str then return false end
                local np, ok = classAt(pat, pi + 1, str:sub(si, si))
                if not np or not ok then return false end
                pi, si = np, si + 1
            elseif c == "\\" then
                if pi == #pat then return false end
                if str:sub(si, si) ~= pat:sub(pi + 1, pi + 1) then return false end
                pi, si = pi + 2, si + 1
            else
                if str:sub(si, si) ~= c then return false end
                pi, si = pi + 1, si + 1
            end
        end
        return si > #str
    end
    return m(1, 1)
end

local function lower(s) return (s:gsub("%u", function(c) return c:lower() end)) end
local function globMatchOpt(pat, str, icase)
    if icase then return globMatch(lower(pat), lower(str)) end
    return globMatch(pat, str)
end

-- ---------------------------------------------------------------
-- 数值参数解析
-- ---------------------------------------------------------------
--- 解析 "[+-]?N" (allowSign 决定是否接受 +/-)。返回 符号(-1/0/1) 与数值, 或 nil。
local function parseSignedNum(s, allowSign)
    local sign, digits = 0, s
    if s:sub(1, 1) == "+" or s:sub(1, 1) == "-" then
        if not allowSign then return nil end
        sign = (s:sub(1, 1) == "+") and 1 or -1
        digits = s:sub(2)
    end
    if not digits:match("^%d+$") then return nil end
    return sign, tonumber(digits)
end

--- 按符号比较: 0 = 相等, 1 = 大于, -1 = 小于。
local function cmpSigned(value, sign, n)
    if sign == 0 then return value == n end
    if sign > 0 then return value > n end
    return value < n
end

--- -size 的单位(字节)。
local SIZE_UNITS = { c = 1, w = 2, b = 512, k = 1024, M = 1024 * 1024, G = 1024 * 1024 * 1024 }

-- ---------------------------------------------------------------
-- 表达式解析
-- ---------------------------------------------------------------
local toks, tp = {}, 1
local fatal = false -- 致命错误(如缺时间戳): 立即停止遍历
local status = 0    -- find 自己的退出码(非 0 表示有错误发生)
local quitFlag = false
local pruneFlag = false
local depthFirst = false -- -delete 隐含 -depth
local maxDepth, minDepth = math.huge, 0
local plusExecs = {}     -- -exec ... + 的节点(遍历结束后统一 flush)
local xdev = false            -- -xdev/-mount: 不跨文件系统
local followLinks = false     -- -L: 跟随符号链接(-P 是缺省; -H 只跟随命令行上的)
local regextype = "bre"       -- -regextype 选的方言
local outFiles = {}           -- -fprint/-fprintf 的输出句柄(同名文件只开一次)
local rootDrive = nil         -- -xdev 的基准文件系统(遍历起点的 drive)
local uid = uid or 0          -- 调用者身份(进程环境注入; -readable 等要用)
local gid = gid or 0
local timestampWarned = false
local ownerWarned = false
local linksWarned = false

local function syntaxErr(msg)
    stderr("find: " .. msg .. "\n")
    fatal = true
end

local function peek() return toks[tp] end
local function advance() local t = toks[tp]; tp = tp + 1; return t end

local function needArg(pred)
    local t = toks[tp]
    if t == nil then syntaxErr("missing argument to `" .. pred .. "'"); return nil end
    tp = tp + 1
    return t
end

--- 需要 mtime 的谓词: 拿不到(CC 原生 fs)就报错并停止 —— 绝不静默当成"不匹配"。
local function requireMtime(a, pred)
    if a.mtime then return a.mtime end
    if not timestampWarned then
        timestampWarned = true
        stderr("find: " .. pred .. ": this filesystem has no timestamps\n")
    end
    fatal = true
    return nil
end
local function requireOwner(a, pred)
    if a.uid ~= nil and a.gid ~= nil then return true end
    if not ownerWarned then
        ownerWarned = true
        stderr("find: " .. pred .. ": this filesystem has no owner/group\n")
    end
    fatal = true
    return false
end
local function requireLinks(a, pred)
    if a.links ~= nil then return a.links end
    if not linksWarned then
        linksWarned = true
        stderr("find: " .. pred .. ": this filesystem does not report link counts\n")
    end
    fatal = true
    return nil
end

-- ---------------------------------------------------------------
-- -exec / -printf 的准备工作
-- ---------------------------------------------------------------
--- -exec 的 argv 里把 "{}" 全部替换成 path(与 GNU 一样在**每个**参数里替换)。
local function substBraces(argv, path)
    local out = {}
    for i, a in ipairs(argv) do
        out[i] = a:gsub("{}", (path:gsub("%%", "%%%%")))
    end
    return out
end

--- 执行一条命令, 返回 (ok, code)。ok=false 表示连启动都没成功。
--- stdio 显式传本进程的 stdin/stdout: 内核里这与"继承父进程 stdio"完全等价,
--- 但宿主测试台的 spawn 不继承父进程 stdio(它只有顶层那一份), 显式传才对得上真机。
--- 管道端按引用传给子进程(与 xargs 同一理由): find -exec 会起**一串**子进程共用同一个
--- stdout, 而内核的管道句柄是"关一次就 EOF"的共享对象 —— 直接共享会让第一个子进程退出就
--- 关掉管道, 后面几个的输出全丢(`find . -exec echo {} \; | wc -l` 只数到 1)。
local function runCommand(cmd, argv)
    -- 已知缺口: 与 xargs 同一件事 —— find -exec 起一串子进程共用一个 stdout 管道时,
    -- 第一个子进程退出就会关掉管道(内核的管道端是共享句柄), 后面几个的输出会丢。
    -- 真正的修法需要"每进程一份引用 + 父进程 spawn 后关自己那份"的整套改造, 见 for-ai.md。
    local stdio = { output = io.stdout() }
    if io.stdin() then stdio.input = io.stdin() end
    local pid, err = syscalls["proc.exec"](cmd, argv, { cwd = cwd, stdio = stdio })
    if not pid then
        -- 内核的错误串是 "cmd: command not found" / "path: permission denied";
        -- 这里映射成 GNU find 的措辞(No such file or directory / Permission denied)。
        local reason = tostring(err)
        if reason:find("command not found") then
            reason = "No such file or directory"
        elseif reason:find("permission denied") then
            reason = "Permission denied"
        end
        stderr("find: '" .. cmd .. "': " .. reason .. "\n")
        return false, nil
    end
    return true, syscalls["proc.wait"](pid)
end

--- flush 一个 -exec ... + 节点攒下的路径。
local function flushPlus(node)
    if #node.pending == 0 then return end
    local argv = {}
    for i, a in ipairs(node.argv) do argv[i] = a end
    for _, p in ipairs(node.pending) do argv[#argv + 1] = p end
    node.pending = {}
    local ok, code = runCommand(node.cmd, argv)
    -- GNU: + 形式的任一次调用失败(含 exec 失败)都把 find 的退出码设为 1。
    if not ok or code ~= 0 then status = 1 end
end

--- -printf 的格式串 -> 片段表({lit=} 或 {spec=})。返回 nil, 未知指示符。
--- -newermt 的日期串(实用子集: YYYY-MM-DD[ HH:MM[:SS]] 或 @epoch)。
--- 用 days_from_civil 自算 epoch, 不依赖 os.time(表)(CC 上不一定可用)。
local function daysFromCivil(y, m, d)
    local yy = (m <= 2) and (y - 1) or y
    local era = math.floor(yy / 400)
    local yoe = yy - era * 400
    local mp = (m + 9) % 12
    local doy = math.floor((153 * mp + 2) / 5) + d - 1
    local doe = yoe * 365 + math.floor(yoe / 4) - math.floor(yoe / 100) + doy
    return era * 146097 + doe - 719468
end
local function parseDateString(str)
    str = (str or ""):gsub("^%s+", ""):gsub("%s+$", "")
    local at = str:match("^@(%d+)$")
    if at then return tonumber(at) end
    local y, mo, d, h, mi, sec = str:match("^(%d%d%d%d)%-(%d%d)%-(%d%d)[T ](%d%d):(%d%d):(%d%d)$")
    if not y then
        y, mo, d = str:match("^(%d%d%d%d)%-(%d%d)%-(%d%d)$")
        h, mi, sec = 0, 0, 0
    end
    if not y then return nil end
    y, mo, d, h, mi, sec = tonumber(y), tonumber(mo), tonumber(d), tonumber(h), tonumber(mi), tonumber(sec)
    if mo < 1 or mo > 12 or d < 1 or d > 31 or h > 23 or mi > 59 or sec > 60 then return nil end
    return daysFromCivil(y, mo, d) * 86400 + h * 3600 + mi * 60 + sec
end

--- 属主/组名(没有 user.* syscall 或查不到时退回数字)。
local function userNameOf(uid)
    if uid ~= nil and syscalls and syscalls["user.byUid"] then
        local u = syscalls["user.byUid"](uid)
        if u and u.name then return u.name end
    end
    return tostring(uid or 0)
end
local function groupNameOf(gid)
    if gid ~= nil and syscalls and syscalls["user.groupByGid"] then
        local g = syscalls["user.groupByGid"](gid)
        if g and g.name then return g.name end
    end
    return tostring(gid or 0)
end
--- -printf 的 %a/%c/%t: "Mon Jan  2 15:04:05.0000000000 2006"(与 GNU 的 ctime 风格一致)。
local function timeHuman(t)
    if not t or t == 0 then return "-" end
    return os.date("%a %b %e %H:%M:%S.0000000000 %Y", t)
end

--- -printf 支持的指令(GNU 的子集; 每个收 (entry) 返回字符串)。
--- 内核 attributes 现在给了 atime/ctime/i_blocks, 所以 %a/%c/%A@/%C@/%b/%k 都能真的给出来。
local function modeSymbolicPrintf(mode)
    local t = math.floor(mode / 0x1000) * 0x1000
    local tc = (t == 0x8000 and "-") or (t == 0x4000 and "d") or (t == 0xA000 and "l")
        or (t == 0x1000 and "p") or (t == 0x2000 and "c") or (t == 0x6000 and "b")
        or (t == 0xC000 and "s") or "?"
    local function rwx(bits)
        return ((math.floor(bits / 4) % 2 == 1) and "r" or "-")
            .. ((math.floor(bits / 2) % 2 == 1) and "w" or "-")
            .. ((bits % 2 == 1) and "x" or "-")
    end
    local b = mode % 512
    return tc .. rwx(math.floor(b / 64) % 8) .. rwx(math.floor(b / 8) % 8) .. rwx(b % 8)
end

local PRINTF_SPEC = {
    p = function(e) return e.path end,
    f = function(e) return baseName(e.path) end,
    h = function(e) return dirName(e.path) end,
    s = function(e) return tostring(e.st.size or 0) end,
    b = function(e) return tostring(e.st.blocks or 0) end,
    k = function(e) return tostring(math.ceil((e.st.blocks or 0) / 2)) end,
    y = function(e) return typeChar(e.st) end,
    m = function(e) return string.format("%o", (e.st.mode or 0) % 4096) end,
    M = function(e) return modeSymbolicPrintf(e.st.mode or 0) end,
    u = function(e) return userNameOf(e.st.uid) end,
    g = function(e) return groupNameOf(e.st.gid) end,
    U = function(e) return tostring(e.st.uid or 0) end,
    G = function(e) return tostring(e.st.gid or 0) end,
    i = function(e) return tostring(e.st.ino or 0) end,
    n = function(e) return tostring(e.st.links or 0) end,
    d = function(e) return tostring(e.depth or 0) end,
    l = function(e) return e.linkTarget or "" end,
    a = function(e) return timeHuman(e.st.atime) end,
    c = function(e) return timeHuman(e.st.ctime) end,
    t = function(e) return timeHuman(e.st.mtime) end,
    ["A@"] = function(e) return tostring(e.st.atime or 0) end,
    ["C@"] = function(e) return tostring(e.st.ctime or 0) end,
    ["T@"] = function(e) return tostring(e.st.mtime or 0) end,
}

--- -printf 的宽度/精度: %-20p、%.3f 这类(GNU 支持)。
local function parseSpecBody(body)
    local leftAlign = false
    if body:sub(1, 1) == "-" then leftAlign = true; body = body:sub(2) end
    local w, rest = body:match("^(%d*)(.*)$")
    local prec = nil
    if rest:sub(1, 1) == "." then
        local p2
        p2, rest = rest:sub(2):match("^(%d*)(.*)$")
        prec = tonumber(p2)
    end
    return leftAlign, (w ~= "" and tonumber(w) or nil), prec, rest
end

local function applyWidth(text, leftAlign, width, prec)
    if prec and #text > prec then text = text:sub(1, prec) end
    if width and #text < width then
        local pad = string.rep(" ", width - #text)
        text = leftAlign and (text .. pad) or (pad .. text)
    end
    return text
end

local function parsePrintf(fmt)
    local items, lit = {}, {}
    local function flush()
        if #lit > 0 then items[#items + 1] = { lit = table.concat(lit) }; lit = {} end
    end
    local i = 1
    while i <= #fmt do
        local c = fmt:sub(i, i)
        if c == "\\" then
            local n = fmt:sub(i + 1, i + 1)
            if n == "n" then lit[#lit + 1] = "\n"; i = i + 2
            elseif n == "t" then lit[#lit + 1] = "\t"; i = i + 2
            elseif n == "r" then lit[#lit + 1] = "\r"; i = i + 2
            elseif n == "a" then lit[#lit + 1] = "\a"; i = i + 2
            elseif n == "b" then lit[#lit + 1] = "\b"; i = i + 2
            elseif n == "f" then lit[#lit + 1] = "\f"; i = i + 2
            elseif n == "v" then lit[#lit + 1] = "\v"; i = i + 2
            elseif n == "0" then lit[#lit + 1] = string.char(0); i = i + 2
            elseif n == "\\" then lit[#lit + 1] = "\\"; i = i + 2
            elseif n == "" then lit[#lit + 1] = "\\"; i = i + 1
            else lit[#lit + 1] = "\\" .. n; i = i + 2 end
        elseif c == "%" then
            local d = fmt:sub(i + 1, i + 1)
            if d == "%" then lit[#lit + 1] = "%"; i = i + 2
            elseif d == "" then return nil, "%"
            else
                local rest = fmt:sub(i + 1)
                local leftAlign, width, prec, body = parseSpecBody(rest)
                local spec = nil
                if PRINTF_SPEC[body:sub(1, 2)] then spec = body:sub(1, 2)
                elseif PRINTF_SPEC[body:sub(1, 1)] then spec = body:sub(1, 1) end
                if not spec then return nil, body:sub(1, 1) end
                flush()
                items[#items + 1] = { spec = spec, left = leftAlign, width = width, prec = prec }
                i = i + 1 + (#rest - #body) + #spec
            end
        else
            lit[#lit + 1] = c; i = i + 1
        end
    end
    flush()
    return items
end

local function renderPrintf(items, entry)
    local out = {}
    for i, it in ipairs(items) do
        if it.lit then out[i] = it.lit
        else
            local fn = PRINTF_SPEC[it.spec]
            local text = fn and fn(entry) or ""
            out[i] = applyWidth(text, it.left, it.width, it.prec)
        end
    end
    return table.concat(out)
end


-- ---------------------------------------------------------------
-- 谓词工厂: 每个谓词/动作都编译成一个 node { op=..., f=entry->bool }
-- ---------------------------------------------------------------
local parseExpr -- 前向声明

local function parsePrimary()
    local t = peek()
    if t == nil then syntaxErr("missing expression"); return nil end
    if t == "(" then
        tp = tp + 1
        local e = parseExpr()
        if peek() ~= ")" then syntaxErr("expected ')'"); return nil end
        tp = tp + 1
        return e
    end
    if t == "!" or t == "-not" then
        tp = tp + 1
        local a = parsePrimary()
        if not a then return nil end
        return { op = "not", a = a }
    end
    if t:sub(1, 1) ~= "-" then
        syntaxErr("paths must precede expression: '" .. t .. "'")
        return nil
    end
    tp = tp + 1

    -- 全局选项(可出现在表达式任意位置, 求值时恒真)
    if t == "-maxdepth" or t == "-mindepth" then
        local v = needArg(t)
        if not v then return nil end
        local _, n = parseSignedNum(v, false)
        if not n then syntaxErr("invalid argument '" .. v .. "' to '" .. t .. "'"); return nil end
        if t == "-maxdepth" then maxDepth = n else minDepth = n end
        return { op = "true" }
    end

    if t == "-name" or t == "-iname" or t == "-path" or t == "-ipath" then
        local pat = needArg(t)
        if not pat then return nil end
        local icase = (t == "-iname" or t == "-ipath")
        local whole = (t == "-path" or t == "-ipath")
        return { op = "test", f = function(e)
            local s = whole and e.path or e.name
            return globMatchOpt(pat, s, icase)
        end }
    end

    if t == "-type" then
        local v = needArg(t)
        if not v then return nil end
        local set = {}
        for c in v:gmatch("[^,]+") do
            if c == "f" or c == "d" or c == "l" or c == "p" or c == "c" or c == "b" then
                set[c] = true
            else
                syntaxErr("unknown argument to -type: " .. c)
                return nil
            end
        end
        return { op = "test", f = function(e)
            local k = typeChar(e.st)
            -- 设备节点分不出字符/块(内核只给 kind="device"): c 与 b 都算命中。
            if k == "c" and (set.c or set.b) then return true end
            return set[k] == true
        end }
    end

    if t == "-size" then
        local v = needArg(t)
        if not v then return nil end
        local sign, num, unit = v:match("^([+-]?)(%d+)([cwbkMG]?)$")
        if not sign then syntaxErr("invalid -size type '" .. v .. "'"); return nil end
        sign = (sign == "+") and 1 or (sign == "-") and -1 or 0
        local unitSize = SIZE_UNITS[unit == "" and "b" or unit]
        num = tonumber(num)
        return { op = "test", f = function(e)
            local sz = e.st.size or 0
            -- GNU: 单位数向上取整后再比较(-size -1k 只命中 0 字节的文件)。
            local units = math.ceil(sz / unitSize)
            return cmpSigned(units, sign, num)
        end }
    end

    if t == "-empty" then
        return { op = "test", f = function(e)
            if e.st.isDir then
                local names, lerr = fs.list(e.real)
                if not names then
                    stderr("find: '" .. e.path .. "': " .. ioeMsg(lerr) .. "\n")
                    status = 1
                    return false
                end
                return #names == 0
            end
            -- GNU: -empty 只对**普通文件**或目录为真(符号链接/FIFO/设备一律为假)。
            if e.st.kind ~= nil and e.st.kind ~= "file" then return false end
            return (e.st.size or 0) == 0
        end }
    end

    if t == "-perm" then
        local v = needArg(t)
        if not v then return nil end
        local kind, digits = v:match("^([%-/]?)(.*)$")
        if not digits:match("^[0-7]+$") then
            syntaxErr("invalid mode '" .. v .. "' (octal modes only, symbolic modes are not supported)")
            return nil
        end
        local mode = tonumber(digits, 8) % 4096
        return { op = "test", f = function(e)
            local m = (e.st.mode or 0) % 4096
            if kind == "-" then return band(m, mode) == mode end
            if kind == "/" then return mode == 0 or band(m, mode) ~= 0 end
            return m == mode
        end }
    end

    if t == "-user" or t == "-group" or t == "-uid" or t == "-gid" then
        local v = needArg(t)
        if not v then return nil end
        local want
        if t == "-user" or t == "-group" then
            local rec
            if t == "-user" then
                rec = syscalls["user.get"] and syscalls["user.get"](v)
                if not rec then syntaxErr("'" .. v .. "' is not the name of a known user"); return nil end
                want = rec.uid
            else
                rec = syscalls["user.groupByName"] and syscalls["user.groupByName"](v)
                if not rec then syntaxErr("'" .. v .. "' is not the name of a known group"); return nil end
                want = rec.gid
            end
        else
            local _, n = parseSignedNum(v, false)
            if not n then syntaxErr("invalid argument '" .. v .. "' to '" .. t .. "'"); return nil end
            want = n
        end
        local isUser = (t == "-user" or t == "-uid")
        return { op = "test", f = function(e)
            if not requireOwner(e.st, t) then return false end
            return (isUser and e.st.uid or e.st.gid) == want
        end }
    end

    if t == "-links" then
        local v = needArg(t)
        if not v then return nil end
        local sign, n = parseSignedNum(v, true)
        if not n then syntaxErr("invalid argument '" .. v .. "' to '-links'"); return nil end
        return { op = "test", f = function(e)
            local l = requireLinks(e.st, "-links")
            if not l then return false end
            return cmpSigned(l, sign, n)
        end }
    end

    if t == "-newer" then
        local v = needArg(t)
        if not v then return nil end
        local refPath = resolve(v)
        -- GNU 的 -newer 用 stat(跟随符号链接)读参考文件。
        local ref = fs.exists(refPath) and fs.attributes(refPath) or nil
        if not ref then
            syntaxErr("-newer: '" .. v .. "': No such file or directory")
            return nil
        end
        if not ref.mtime then
            stderr("find: -newer: this filesystem has no timestamps\n")
            fatal = true
            return nil
        end
        local refTime = ref.mtime
        return { op = "test", f = function(e)
            local t2 = requireMtime(e.st, "-newer")
            if not t2 then return false end
            return t2 > refTime
        end }
    end

    if t == "-mtime" or t == "-mmin" then
        local v = needArg(t)
        if not v then return nil end
        local sign, n = parseSignedNum(v, true)
        if not n then syntaxErr("invalid argument '" .. v .. "' to '" .. t .. "'"); return nil end
        local per = (t == "-mtime") and 86400 or 60
        return { op = "test", f = function(e)
            local mt = requireMtime(e.st, t)
            if not mt then return false end
            local age = math.floor((os.time() - mt) / per)
            if age < 0 then age = 0 end
            return cmpSigned(age, sign, n)
        end }
    end

    -- ---- 常量谓词与遍历控制 ----
    if t == "-true" then return { op = "test", f = function() return true end } end
    if t == "-false" then return { op = "test", f = function() return false end } end
    if t == "-depth" then depthFirst = true; return { op = "true" } end
    if t == "-follow" or t == "-L" then followLinks = true; return { op = "true" } end
    if t == "-P" then followLinks = false; return { op = "true" } end
    if t == "-H" then followLinks = true; return { op = "true" } end
    if t == "-daystart" or t == "-ignore_readdir_race" or t == "-noignore_readdir_race" then
        stderr("find: option '" .. t .. "' is not supported\n")
        fatal = true
        return nil
    end
    if t == "-xdev" or t == "-mount" then xdev = true; return { op = "true" } end
    if t == "-nouser" or t == "-nogroup" then
        local wantUser = (t == "-nouser")
        return { op = "test", f = function(e)
            local uid, gid = e.st.uid, e.st.gid
            if uid == nil and gid == nil then return false end
            if wantUser then
                return not (syscalls and syscalls["user.byUid"] and syscalls["user.byUid"](uid or 0))
            end
            return not (syscalls and syscalls["user.groupByGid"] and syscalls["user.groupByGid"](gid or 0))
        end }
    end
    if t == "-readable" or t == "-writable" or t == "-executable" then
        local bit = (t == "-readable" and 4) or (t == "-writable" and 2) or 1
        return { op = "test", f = function(e)
            local mode = e.st.mode
            if not mode then return false end
            local uid, gid = e.st.uid, e.st.gid
            local p = (uid == e.uid and math.floor((mode % 512) / 64))
                or (gid == e.gid and math.floor((mode % 512) / 8))
                or (mode % 8)
            return math.floor(p / bit) % 2 == 1
        end }
    end
    if t == "-samefile" then
        local v = needArg(t)
        if not v then return nil end
        local ref = fs.attributes(resolve(v))
        if not ref then syntaxErr("-samefile: '" .. v .. "': No such file or directory"); return nil end
        return { op = "test", f = function(e)
            if ref.ino and e.st.ino then return ref.ino == e.st.ino end
            if ref.mode and e.st.mode then return false end
            return false
        end }
    end
    if t == "-inum" then
        local v = needArg(t)
        if not v then return nil end
        local sign, n = parseSignedNum(v, true)
        if not n then syntaxErr("invalid argument '" .. v .. "' to '-inum'"); return nil end
        return { op = "test", f = function(e)
            if not e.st.ino then
                stderr("find: -inum: this filesystem does not report inode numbers\n")
                fatal = true
                return false
            end
            return cmpSigned(e.st.ino, sign, n)
        end }
    end
    if t == "-lname" or t == "-ilname" then
        local pat = needArg(t)
        if not pat then return nil end
        local icase = (t == "-ilname")
        return { op = "test", f = function(e)
            if e.st.kind ~= "symlink" then return false end
            local tgt = fs.readlink and fs.readlink(e.real) or nil
            if not tgt then return false end
            return globMatchOpt(pat, tgt, icase)
        end }
    end
    -- ---- 时间谓词: -newerXY 与 -atime/-ctime(内核现在暴露 atime/ctime) ----
    if t == "-newermt" or t == "-newerat" or t == "-newerct" then
        local v = needArg(t)
        if not v then return nil end
        local ts = parseDateString(v)
        if not ts then syntaxErr("I cannot figure out how to interpret '" .. v .. "' as a date or time"); return nil end
        local which = (t == "-newerat" and "atime") or (t == "-newerct" and "ctime") or "mtime"
        return { op = "test", f = function(e)
            local got = e.st[which]
            if not got then
                stderr("find: " .. t .. ": this filesystem has no timestamps\n")
                fatal = true
                return false
            end
            return got > ts
        end }
    end
    if t == "-atime" or t == "-ctime" or t == "-amin" or t == "-cmin" then
        local v = needArg(t)
        if not v then return nil end
        local sign, n = parseSignedNum(v, true)
        if not n then syntaxErr("invalid argument '" .. v .. "' to '" .. t .. "'"); return nil end
        local per = (t == "-atime" or t == "-ctime") and 86400 or 60
        local which = (t == "-atime" or t == "-amin") and "atime" or "ctime"
        return { op = "test", f = function(e)
            local got = e.st[which]
            if not got then
                stderr("find: " .. t .. ": this filesystem has no timestamps\n")
                fatal = true
                return false
            end
            local age = math.floor((os.time() - got) / per)
            if age < 0 then age = 0 end
            return cmpSigned(age, sign, n)
        end }
    end
    -- ---- -regex/-iregex: 用内核的标准正则引擎(BRE/ERE) ----
    if t == "-regex" or t == "-iregex" then
        local pat = needArg(t)
        if not pat then return nil end
        local icase = (t == "-iregex")
        if not (syscalls and syscalls["regex.compile"]) then
            syntaxErr("-regex: regex syscall not available")
            return nil
        end
        local re, rerr = syscalls["regex.compile"](pat, regextype or "bre", { icase = icase })
        if not re then syntaxErr("invalid regular expression: " .. tostring(rerr)); return nil end
        return { op = "test", f = function(e)
            -- GNU 的 -regex 匹配整个路径(默认 emacs 方言; Delin 只有 POSIX BRE/ERE, 见 --regextype)
            return re:find(e.path) ~= nil
        end }
    end
    if t == "-regextype" then
        local v = needArg(t)
        if not v then return nil end
        if v == "posix-basic" or v == "grep" or v == "sed" or v == "ed" then regextype = "bre"
        elseif v == "posix-extended" or v == "egrep" or v == "awk" then regextype = "ere"
        elseif v == "emacs" then
            syntaxErr("-regextype emacs is not supported (use posix-basic or posix-extended)")
            return nil
        else
            syntaxErr("Unknown regular expression type '" .. v .. "'")
            return nil
        end
        return { op = "true" }
    end
    -- ---- 输出重定向类动作 ----
    if t == "-fprint" or t == "-fprint0" then
        local v = needArg(t)
        if not v then return nil end
        local fh = outFiles[v]
        if not fh then
            local h, err = fs.open(resolve(v), "w")
            if not h then syntaxErr(v .. ": " .. ioeMsg(err)); return nil end
            fh = h
            outFiles[v] = h
        end
        local nul = (t == "-fprint0")
        return { op = "test", action = true, f = function(e)
            if nul then fh:write(e.path .. string.char(0)) else fh:write(e.path .. "\n") end
            return true
        end }
    end
    if t == "-fprintf" then
        local v = needArg(t)
        if not v then return nil end
        local fmt = needArg(t)
        if not fmt then return nil end
        local items, bad = parsePrintf(fmt)
        if not items then syntaxErr("-fprintf: unknown format directive '%" .. bad .. "'"); return nil end
        local fh = outFiles[v]
        if not fh then
            local h, err = fs.open(resolve(v), "w")
            if not h then syntaxErr(v .. ": " .. ioeMsg(err)); return nil end
            fh = h
            outFiles[v] = h
        end
        return { op = "test", action = true, f = function(e)
            fh:write(renderPrintf(items, e))
            return true
        end }
    end
    if t == "-ok" or t == "-okdir" then
        local v = t
        local cmdArgs, term = {}, nil
        while true do
            local a2 = toks[tp]
            if a2 == nil then syntaxErr("missing argument to '" .. v .. "'"); return nil end
            tp = tp + 1
            if a2 == ";" or a2 == "+" then term = a2; break end
            cmdArgs[#cmdArgs + 1] = a2
        end
        if #cmdArgs == 0 then syntaxErr("missing argument to '" .. v .. "'"); return nil end
        local cmd = cmdArgs[1]
        local rest = {}
        for k = 2, #cmdArgs do rest[#rest + 1] = cmdArgs[k] end
        local inDir = (v == "-okdir")
        return { op = "test", action = true, f = function(e)
            local prog = cmd:gsub("{}", e.path)
            local usage = {}
            io.write("< " .. prog)
            for _, r in ipairs(substBraces(rest, e.path)) do
                io.write(" " .. r)
                usage[#usage + 1] = r
            end
            io.write(" > ? ")
            local sin = io.stdin()
            local line = sin and sin.readLine and sin:readLine() or nil
            if not (line and line:match("^[yY]")) then return false end
            local dir = inDir and dirName(e.real) or cwd
            local pid, perr = syscalls["proc.exec"](prog, usage, { cwd = dir, stdio = { output = io.stdout(), input = io.stdin() } })
            if not pid then
                stderr("find: '" .. prog .. "': " .. tostring(perr) .. "\n")
                status = 1
                return false
            end
            local _, code = syscalls["proc.wait"](pid)
            if code ~= 0 then return false end
            return true
        end }
    end
    if t == "-execdir" then
        local cmdArgs, term = {}, nil
        while true do
            local a2 = toks[tp]
            if a2 == nil then syntaxErr("missing argument to '-execdir'"); return nil end
            tp = tp + 1
            if a2 == ";" then term = a2; break end
            cmdArgs[#cmdArgs + 1] = a2
        end
        if #cmdArgs == 0 then syntaxErr("missing argument to '-execdir'"); return nil end
        local cmd = cmdArgs[1]
        local rest = {}
        for k = 2, #cmdArgs do rest[#rest + 1] = cmdArgs[k] end
        return { op = "test", action = true, f = function(e)
            local prog = cmd:gsub("{}", baseName(e.real))
            local argv = substBraces(rest, "./" .. baseName(e.real))
            local pid, perr = syscalls["proc.exec"](cmd, argv, { cwd = dirName(e.real), stdio = { output = io.stdout(), input = io.stdin() } })
            if not pid then
                stderr("find: '" .. cmd .. "': " .. tostring(perr) .. "\n")
                status = 1
                return false
            end
            local _, code = syscalls["proc.wait"](pid)
            return code == 0
        end }
    end

    if t == "-print" then
        return { op = "test", action = true, f = function(e) io.write(e.path .. "\n"); return true end }
    end
    if t == "-print0" then
        return { op = "test", action = true,
                 f = function(e) io.write(e.path .. string.char(0)); return true end }
    end
    if t == "-printf" then
        local fmt = needArg(t)
        if not fmt then return nil end
        local items, bad = parsePrintf(fmt)
        if not items then syntaxErr("-printf: unknown format directive '%" .. bad .. "'"); return nil end
        return { op = "test", action = true,
                 f = function(e) io.write(renderPrintf(items, e)); return true end }
    end
    if t == "-delete" then
        depthFirst = true
        return { op = "test", action = true, f = function(e)
            local ok, err = fs.delete(e.real)
            if not ok then
                stderr("find: cannot delete '" .. e.path .. "': " .. ioeMsg(err) .. "\n")
                status = 1
                return false
            end
            return true
        end }
    end
    -- 注意: -prune/-quit 不是"动作"(GNU: 表达式里只有它们时仍然补 -print)。
    if t == "-prune" then
        return { op = "test", f = function(e)
            pruneFlag = true
            return true
        end }
    end
    if t == "-quit" then
        return { op = "test", f = function() quitFlag = true; return true end }
    end
    if t == "-ls" then
        -- GNU 的 -ls 格式(ls -dils 风格): inode 块数 权限 链接 属主 组 大小 日期 名字
        return { op = "test", action = true, f = function(e)
            local st = e.st
            local line = string.format("%6d %4d %s %3d %-8s %-8s %8d %s %s",
                st.ino or 0, math.floor((st.blocks or 0) / 2), modeSymbolicPrintf(st.mode or 0),
                st.links or 1, userNameOf(st.uid), groupNameOf(st.gid), st.size or 0,
                timeHuman(st.mtime), e.path)
            if st.kind == "symlink" and e.linkTarget then
                line = line .. " -> " .. e.linkTarget
            end
            io.write(line .. "\n")
            return true
        end }
    end

    if t == "-exec" then
        -- 收集命令与其参数, 直到 ";" 或 "+"。
        local cmdArgs, term = {}, nil
        while true do
            local a = toks[tp]
            if a == nil then syntaxErr("missing argument to '-exec'"); return nil end
            tp = tp + 1
            if a == ";" or a == "+" then term = a; break end
            cmdArgs[#cmdArgs + 1] = a
        end
        if #cmdArgs == 0 then syntaxErr("missing argument to '-exec'"); return nil end
        local cmd = cmdArgs[1]
        local rest = {}
        for i = 2, #cmdArgs do rest[#rest + 1] = cmdArgs[i] end
        if term == ";" then
            return { op = "test", action = true, f = function(e)
                local argv = substBraces(rest, e.path)
                local c = cmd:gsub("{}", (e.path:gsub("%%", "%%%%")))
                local ok, code = runCommand(c, argv)
                -- GNU: ";" 形式的非 0 返回**不**影响 find 的退出码(实测)。
                if not ok then return false end
                return code == 0
            end }
        end
        -- "+" 形式: {} 必须单独出现且是最后一个参数。
        local count, lastIdx = 0, nil
        for i, a in ipairs(rest) do
            local _, n = a:gsub("{}", "")
            if n > 0 then count = count + n; lastIdx = i end
        end
        if count ~= 1 or lastIdx ~= #rest or rest[#rest] ~= "{}" then
            syntaxErr("In '-exec ... {} +' the '{}' must appear by itself and last")
            return nil
        end
        local argvTemplate = {}
        for i = 1, #rest - 1 do argvTemplate[#argvTemplate + 1] = rest[i] end
        local node = { op = "test", action = true, plus = true, cmd = cmd, argv = argvTemplate, pending = {} }
        node.f = function(e)
            node.pending[#node.pending + 1] = e.path
            -- 批上限: 一次攒太多会把 argv 撑爆(真机上还有 ARG_MAX 限制)。
            local bytes = 0
            for _, p in ipairs(node.pending) do bytes = bytes + #p + 1 end
            if #node.pending >= 1024 or bytes >= 65536 then flushPlus(node) end
            return true
        end
        plusExecs[#plusExecs + 1] = node
        return node
    end

    syntaxErr("unknown predicate `" .. t .. "'")
    return nil
end

local function parseNot()
    -- ! 的优先级最高(比 -a 高), 已在 parsePrimary 里处理。
    return parsePrimary()
end

local function parseAnd()
    local left = parseNot()
    if not left then return nil end
    while true do
        local t = peek()
        if t == nil or t == ")" or t == "-o" or t == "-or" or t == "," then break end
        if t == "-a" or t == "-and" then
            tp = tp + 1
        elseif t:sub(1, 1) ~= "-" and t ~= "!" and t ~= "(" then
            syntaxErr("paths must precede expression: '" .. t .. "'")
            return nil
        end
        local right = parseNot()
        if not right then return nil end
        left = { op = "and", a = left, b = right }
    end
    return left
end

local function parseOr()
    local left = parseAnd()
    if not left then return nil end
    while true do
        local t = peek()
        if t ~= "-o" and t ~= "-or" then break end
        tp = tp + 1
        local right = parseAnd()
        if not right then return nil end
        left = { op = "or", a = left, b = right }
    end
    return left
end

parseExpr = function()
    local left = parseOr()
    if not left then return nil end
    while peek() == "," do
        tp = tp + 1
        local right = parseOr()
        if not right then return nil end
        left = { op = "comma", a = left, b = right }
    end
    return left
end

local function evalNode(n, e)
    if fatal then return false end
    local op = n.op
    if op == "true" then return true
    elseif op == "and" then
        if not evalNode(n.a, e) then return false end
        return evalNode(n.b, e)
    elseif op == "or" then
        if evalNode(n.a, e) then return true end
        return evalNode(n.b, e)
    elseif op == "not" then
        return not evalNode(n.a, e)
    elseif op == "comma" then
        evalNode(n.a, e)
        return evalNode(n.b, e)
    end
    return n.f(e)
end

-- ---------------------------------------------------------------
-- 命令行: 路径操作数 + 表达式
-- ---------------------------------------------------------------
local paths = {}
local exprToks = {}
local i = 1
local inExpr = false
local forcePath = false
while i <= #args do
    local a = args[i]
    if inExpr then
        exprToks[#exprToks + 1] = a
    elseif forcePath then
        paths[#paths + 1] = a
        forcePath = false
    elseif a == "--" then
        forcePath = true -- GNU find 接受 --, 之后的下一个操作数一定是路径
    elseif a == "-" or (a:sub(1, 1) ~= "-" and a ~= "!" and a ~= "(") then
        paths[#paths + 1] = a
    else
        inExpr = true
        exprToks[#exprToks + 1] = a
    end
    i = i + 1
end
if #paths == 0 then paths = { "." } end
toks = exprToks

-- ---------------------------------------------------------------
-- 解析表达式 + 补隐含的 -print
-- ---------------------------------------------------------------
local expr = nil
if #toks > 0 then
    expr = parseExpr()
    if not fatal and tp <= #toks then syntaxErr("unexpected token '" .. tostring(toks[tp]) .. "'") end
    if fatal then return 1 end
end

-- 隐含 -print: 表达式里没有(除 -prune/-quit 之外的)动作时, 对整条表达式生效。
local hasAction = false
local function scanActions(n)
    if not n then return end
    if n.action then hasAction = true end
    scanActions(n.a)
    scanActions(n.b)
end
scanActions(expr)
if not hasAction then
    local pr = { op = "test", action = true, f = function(e) io.write(e.path .. "\n"); return true end }
    if expr then expr = { op = "and", a = expr, b = pr } else expr = pr end
end

-- ---------------------------------------------------------------
-- 遍历
-- ---------------------------------------------------------------
local visit -- 前向声明(descend 与 visit 互相递归)

-- 两个路径一起走:
--   real = 解析后的绝对路径(所有 fs.* 调用都用它)
--   disp = 操作数原样的打印路径(GNU: `find .` 打印 "."、"./d1"; `find d1/` 打印 "d1/"、"d1/a")
-- -print/-printf/-exec 的 {} 都用 disp(与 GNU 一致)。
local function descend(real, disp, depth)
    -- -xdev: 挂载点不下降(GNU 语义: 只在本文件系统的子树里遍历)
    if xdev and depth >= 0 then
        local drive = fs.getDrive and fs.getDrive(real)
        if drive and drive ~= rootDrive then return true end
    end
    local names, lerr = fs.list(real)
    if not names then
        stderr("find: '" .. disp .. "': " .. ioeMsg(lerr) .. "\n")
        status = 1
        return true
    end
    table.sort(names)
    for _, n in ipairs(names) do
        if not visit(joinPath(real, n), joinPath(disp, n), n, depth + 1) then return false end
    end
    return true
end

--- 处理一个条目; 返回 false 表示应立刻停止整个遍历(-quit/致命错误)。
visit = function(real, disp, name, depth)
    if fatal or quitFlag then return false end
    local st
    if followLinks then
        st = fs.attributes(real)
        if st then
            -- 跟随链接后类型按目标算, 但仍标出"这是个链接"(供 %l/-ls)
            local la = lstat(real)
            if la and la.kind == "symlink" then st.linkTarget = la.linkTarget end
        end
    else
        st = lstat(real)
    end
    if not st then
        stderr("find: '" .. disp .. "': No such file or directory\n")
        status = 1
        return true
    end
    -- -delete 隐含 -depth: 先处理子项, 再对目录本身求值。
    if depthFirst and st.isDir and depth < maxDepth then
        if not descend(real, disp, depth) then return false end
    end
    local pruned = false
    if depth >= minDepth then
        pruneFlag = false
        evalNode(expr, {
            path = disp, real = real, name = name, depth = depth, st = st,
            uid = uid, gid = gid, -- 调用者的 uid/gid(-readable/-writable/-executable 用)
            linkTarget = (st.kind == "symlink") and (fs.readlink and fs.readlink(real) or nil) or nil,
        })
        pruned = pruneFlag
    end
    if st.isDir and not depthFirst and not pruned and depth < maxDepth then
        if not descend(real, disp, depth) then return false end
    end
    return true
end

for _, p in ipairs(paths) do
    if not rootDrive and fs.getDrive then rootDrive = fs.getDrive(resolve(p)) end
    if not visit(resolve(p), p, baseName(p), 0) then break end
    if quitFlag or fatal then break end
end

-- -exec ... + : 把最后一批跑完(GNU: -quit 时也会把已攒的命令跑掉)。
for _, node in ipairs(plusExecs) do flushPlus(node) end

if fatal or status ~= 0 then return 1 end
