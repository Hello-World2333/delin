-- Delin mkdir: 建目录 (GNU 子集)。用法: mkdir [OPTION]... <dir>...
-- 选项:
--   -p, --parents           递归创建父目录(已存在不报错)
--   -v, --verbose           打印每个创建的目录
--   -m, --mode=MODE         设定权限模式(尽力而为, 经 fs.chmod)
local args = args or {}
local cwd = (type(cwd) == "string" and cwd) or "/"
local function resolve(p)
    p = p or ""
    if p == "" then return (cwd == "/") and "/" or cwd end
    if p:sub(1, 1) == "/" then
        if p == "/" then return "/" end
        return p:gsub("/+$", "")
    end
    local base = (cwd == "/") and "" or cwd
    return (base .. "/" .. p):gsub("/+", "/")
end
local function stderr(s)
    local e = io.stderr()
    if e and e.write then e:write(s) end
end

local parents, verbose = false, false
local mode = nil
local rest = {}
local noMoreOpts = false
local i = 1
while i <= #args do
    local a = args[i]
    if noMoreOpts then
        rest[#rest + 1] = a
    elseif a == "--" then
        noMoreOpts = true
    elseif a == "--parents" then parents = true
    elseif a == "--verbose" then verbose = true
    elseif a:sub(1, 2) == "--" and (a == "--mode" or a:sub(1, 8) == "--mode=") then
        if a == "--mode" then i = i + 1; if not args[i] then stderr("mkdir: option requires an argument -- 'm'\n"); return end; mode = tonumber(args[i], 8) or nil
        else mode = tonumber(a:sub(8), 8) or nil end
    elseif a:sub(1, 1) == "-" and a ~= "-" then
        local hadM = false
        for k = 2, #a do
            local ch = a:sub(k, k)
            if ch == "p" then parents = true
            elseif ch == "v" then verbose = true
            elseif ch == "m" then
                local mstr = a:sub(k + 1)
                if mstr == "" then
                    i = i + 1
                    if not args[i] then stderr("mkdir: option requires an argument -- 'm'\n"); return end
                    mstr = args[i]
                end
                mode = tonumber(mstr, 8) or nil
                hadM = true
                break
            else
                stderr("mkdir: invalid option -- '" .. ch .. "'\n"); return
            end
        end
        if hadM then end
    else
        rest[#rest + 1] = a
    end
    i = i + 1
end
if #rest == 0 then
    stderr("mkdir: missing operand\n")
    return 1
end

local function applyMode(p)
    if mode and fs.chmod then
        pcall(fs.chmod, p, mode)
    end
end

local function mk(p)
    if fs.exists(p) then
        if not parents then stderr("mkdir: " .. p .. ": File exists\n") end
        return
    end
    if parents then
        local parts = {}
        local t = p
        while t and t ~= "/" and t ~= "" do
            parts[#parts + 1] = t
            local nt = t:match("^(.*)/[^/]+$")
            t = nt or "/"
        end
        for idx = #parts, 1, -1 do
            if not fs.exists(parts[idx]) then
                local ok, err = pcall(fs.makeDir, parts[idx])
                if not ok then stderr("mkdir: " .. parts[idx] .. ": " .. tostring(err) .. "\n"); return end
                applyMode(parts[idx])
                if verbose then io.write("mkdir: created directory '" .. parts[idx] .. "'\n") end
            end
        end
    else
        local ok, err = pcall(fs.makeDir, p)
        if not ok then stderr("mkdir: " .. p .. ": " .. tostring(err) .. "\n"); return end
        applyMode(p)
        if verbose then io.write("mkdir: created directory '" .. p .. "'\n") end
    end
end

for _, p in ipairs(rest) do mk(resolve(p)) end
