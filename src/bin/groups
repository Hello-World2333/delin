-- Delin groups: 打印用户所属的组名 (coreutils groups)。
--   用法: groups [USER]
--     无操作数 = 当前进程的 uid; 主组在前, 其余按 gid 升序, 空格分隔(与 coreutils 一致)。
--   数据源 = user.* syscalls(内核内存里的用户库)。
--   退出码: 0 正常; 1 用户不存在 / 有多余操作数。
local args = args or {}

local function stderr(s)
    local e = io.stderr()
    if e and e.write then e:write(s) end
end

if not (syscalls and syscalls["user.groupsOf"]) then
    stderr("groups: user syscalls not available\n")
    return 1
end

--- 打印一个用户: 给了操作数时 GNU 带 "名字 : " 前缀(与 ids 一致)。
local function show(name)
    local list = syscalls["user.groupsOf"](name)
    if not list then
        stderr("groups: '" .. tostring(name) .. "': no such user\n")
        return false
    end
    if #args > 0 then
        io.write(name .. " : " .. table.concat(list, " ") .. "\n")
    else
        io.write(table.concat(list, " ") .. "\n")
    end
    return true
end

if #args == 0 then
    local me = syscalls["user.byUid"] and syscalls["user.byUid"](uid)
    if not me then
        -- 没有 passwd 记录时 coreutils 打印 "cannot find name for user ID N" 并退出 1
        stderr("groups: cannot find name for user ID " .. tostring(uid) .. "\n")
        return 1
    end
    return show(me.name) and 0 or 1
end

local rc = 0
for _, a in ipairs(args) do
    if not show(a) then rc = 1 end
end
return rc
