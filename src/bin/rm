-- Delin rm: 删除文件/目录 (GNU 子集)。用法: rm [OPTION]... <path>...
-- 选项:
--   -r/-R, --recursive  递归删除目录
--   -f, --force         忽略不存在的文件/目录, 不询问、不报错
--   -i, --interactive   删除前逐个询问
--   -v, --verbose       打印每个 "removed 'x'"
-- 组合短选项(-rf)与 -- 结束选项亦支持。
local args = args or {}
local cwd = (type(cwd) == "string" and cwd) or "/"
local function resolve(p)
    p = p or ""
    if p == "" then return (cwd == "/") and "/" or cwd end
    if p:sub(1, 1) == "/" then
        if p == "/" then return "/" end
        return p:gsub("/+$", "")
    end
    local base = (cwd == "/") and "" or cwd
    return (base .. "/" .. p):gsub("/+", "/")
end
local function stderr(s)
    local e = io.stderr()
    if e and e.write then e:write(s) end
end

local recursive, force, interactive, verbose = false, false, false, false
local rest = {}
local noMoreOpts = false

local function setShort(ch)
    if ch == "r" or ch == "R" then recursive = true
    elseif ch == "f" then force = true
    elseif ch == "i" then interactive = true
    elseif ch == "v" then verbose = true
    else stderr("rm: invalid option -- '" .. ch .. "'\n"); return false end
    return true
end

for _, a in ipairs(args) do
    if noMoreOpts then
        rest[#rest + 1] = a
    elseif a == "--" then
        noMoreOpts = true
    elseif a == "--recursive" then recursive = true
    elseif a == "--force" then force = true
    elseif a == "--interactive" then interactive = true
    elseif a == "--verbose" then verbose = true
    elseif a:sub(1, 1) == "-" and a ~= "-" then
        for k = 2, #a do if not setShort(a:sub(k, k)) then return end end
    else
        rest[#rest + 1] = a
    end
end
if #rest == 0 then
    stderr("rm: missing operand\n")
    return 1
end

-- 删除前询问(仅在 -i 且非 -f 时)。
local function askRemove(p, isDir)
    io.write("rm: remove " .. (isDir and "directory " or "regular file ") .. "'" .. p .. "'? ")
    io.flush()
    local s = io.stdin()
    local line = s and s.readLine and s:readLine() or nil
    return line and line:match("^[yY]")
end

local function rmTree(p)
    local isDir = fs.isDir(p)
    if isDir then
        for _, n in ipairs(fs.list(p) or {}) do
            rmTree(fs.combine(p, n))
        end
    end
    if interactive and not force then
        if not askRemove(p, isDir) then return end
    end
    local ok, err = pcall(fs.delete, p)
    if not ok then
        stderr("rm: " .. p .. ": " .. tostring(err) .. "\n")
    elseif verbose then
        io.write("removed '" .. p .. "'\n")
    end
end

for _, p in ipairs(rest) do
    p = resolve(p)
    if not fs.exists(p) then
        if not force then stderr("rm: " .. p .. ": No such file or directory\n") end
    elseif fs.isDir(p) and not recursive then
        stderr("rm: " .. p .. ": Is a directory\n")
    else
        rmTree(p)
    end
end
