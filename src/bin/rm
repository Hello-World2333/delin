-- Delin rm: 删除文件/目录(GNU 子集)。用法: rm [-r|-R] [-f] <path>...
--   -r/-R  递归删除目录
--   -f     忽略不存在的文件/目录, 不报错
-- 组合选项如 -rf 亦可。
local args = args or {}
local cwd = (type(cwd) == "string" and cwd) or "/"
local function resolve(p)
    p = p or ""
    if p:sub(1, 1) == "/" then
        if p == "/" then return "/" end
        return p:gsub("/+$", "")
    end
    local base = (cwd == "/") and "" or cwd
    return (base .. "/" .. p):gsub("/+", "/")
end
local function stderr(s)
    local e = io.stderr()
    if e and e.write then e:write(s) end
end

local recursive, force = false, false
local rest = {}
local noMoreOpts = false
for _, a in ipairs(args) do
    if noMoreOpts then
        rest[#rest + 1] = a
    elseif a == "--" then
        noMoreOpts = true
    elseif a:sub(1, 1) == "-" and a ~= "-" then
        for k = 2, #a do
            local c = a:sub(k, k)
            if c == "r" or c == "R" then recursive = true
            elseif c == "f" then force = true
            else stderr("rm: invalid option -- " .. c .. "\n"); return end
        end
    else
        rest[#rest + 1] = a
    end
end
if #rest == 0 then
    stderr("rm: missing operand\n")
    return
end

local function rmTree(p)
    if fs.isDir(p) then
        for _, n in ipairs(fs.list(p) or {}) do
            rmTree(fs.combine(p, n))
        end
    end
    local ok, err = pcall(fs.delete, p)
    if not ok then stderr("rm: " .. p .. ": " .. tostring(err) .. "\n") end
end

for _, p in ipairs(rest) do
    p = resolve(p)
    if not fs.exists(p) then
        if not force then stderr("rm: " .. p .. ": No such file or directory\n") end
    elseif fs.isDir(p) and not recursive then
        stderr("rm: " .. p .. ": Is a directory\n")
    else
        rmTree(p)
    end
end
