-- Delin cp: 复制文件/目录。用法: cp [-r] <src>... <dst>
--   -r/-R/--recursive: 递归复制目录。单文件复制走流式 read/write (不经 fs.copy)。
local args = args or {}
local cwd = (type(cwd) == "string" and cwd) or "/"
local function resolve(p)
    p = p or ""
    if p:sub(1, 1) == "/" then
        if p == "/" then return "/" end
        return p:gsub("/+$", "")
    end
    local base = (cwd == "/") and "" or cwd
    return (base .. "/" .. p):gsub("/+", "/")
end
local function stderr(s)
    local e = io.stderr()
    if e and e.write then e:write(s) end
end

-- 解析选项: 收集 -r/-R/--recursive, 其余为源 + 末尾目标。
local recursive = false
local srcs = {}
-- args 形如 { "-r", "/a", "/b", "/dst" }
for _, a in ipairs(args) do
    if a:sub(1, 1) == "-" and a ~= "-" then
        if a == "-r" or a == "-R" or a == "--recursive" then
            recursive = true
        else
            stderr("cp: invalid option -- " .. a .. "\n")
            return
        end
    else
        srcs[#srcs + 1] = a
    end
end
if #srcs < 2 then
    stderr("cp: missing destination file operand\n")
    return
end
local destRaw = srcs[#srcs]
local destHintIsDir = destRaw:sub(-1) == "/"
local dest = resolve(destRaw)
local sources = {}
for j = 1, #srcs - 1 do sources[#sources + 1] = resolve(srcs[j]) end

local function basename(p)
    p = (type(p) == "string" and p) or ""
    p = p:gsub("/+$", "")
    return (p:match("([^/]+)$")) or p
end

local function join(a, b)
    return (a .. "/" .. b):gsub("/+", "/")
end

-- 流式复制单个文件: 读 src, 写 dst。
local function copyFile(src, dst)
    local inF, ierr = fs.open(src, "r")
    if not inF then return nil, (ierr or ("cannot open " .. src)) end
    local outF, oerr = fs.open(dst, "w")
    if not outF then inF.close(); return nil, (oerr or ("cannot write " .. dst)) end
    while true do
        local chunk = inF.read(4096)  -- 每次最多读 4096 字节
        if not chunk or chunk == "" then break end
        outF.write(chunk)
    end
    inF.close()
    outF.close()
    return true
end

-- 递归复制目录树。
local function copyTree(src, dst)
    if not fs.isDir(src) then
        return copyFile(src, dst)
    end
    if not fs.exists(dst) then
        local ok, err = pcall(fs.makeDir, dst)
        if not ok then return nil, "mkdir " .. dst .. " failed: " .. tostring(err) end
    end
    local names = fs.list(src) or {}
    for _, n in ipairs(names) do
        local ok, err = copyTree(join(src, n), join(dst, n))
        if not ok then return nil, err end
    end
    return true
end

for _, src in ipairs(sources) do
    if not fs.exists(src) then
        stderr("cp: " .. src .. ": No such file or directory\n")
        return
    end
    local target
    if fs.isDir(dest) or destHintIsDir then
        target = join(dest, basename(src))
    else
        target = dest
    end
    if fs.isDir(src) then
        if not recursive then
            stderr("cp: " .. src .. ": is a directory (use -r)\n")
            return
        end
        local ok, err = copyTree(src, target)
        if not ok then stderr("cp: " .. src .. ": " .. tostring(err) .. "\n"); return end
    else
        local ok, err = copyFile(src, target)
        if not ok then stderr("cp: " .. src .. ": " .. tostring(err) .. "\n"); return end
    end
end
