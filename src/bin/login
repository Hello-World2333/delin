-- Delin login: 提示用户名/密码, 验证后启动用户 shell, 退出后回到登录(循环)。
--   用法: login <ttyName>   (由 init 在每个 tty 上 spawn, argv[1] 为该 tty 名)
-- 运行在隔离进程环境(uid/gid/spawn/syscalls/args 由内核注入, 原始 API 直用)。
-- 进程以 root 启动; 验证成功后以用户 uid/gid spawn sh(同 tty stdio), proc.wait 等退出。

local ttyName = args[1]
local t = fs.open("/dev/" .. (ttyName or ""), "rw")
if not t then
    print("login: cannot open /dev/" .. tostring(ttyName))
    return
end
-- 绑定本进程 stdio 到该 tty(per-process stdio, 不与其他 tty 的 login 互扰)
syscalls["stdio.set"](t, t)
-- 创建会话: login 成为会话首进程, 把该 tty 设为控制终端, 前台进程组 = login 自身。
syscalls["job.setsid"]()
local loginPg = syscalls["job.group"]()
syscalls["job.tcsetpgrp"](ttyName, loginPg)
-- 忽略前台信号: ^C(SIGINT) / ^Z(SIGTSTP), 否则 login 会被前台信号杀死。
syscalls["signal.install"](2, function() end)
syscalls["signal.install"](20, function() end)
local stdin  = io.stdin()
local stdout = io.stdout()

local function outln(s)
    if stdout and stdout.write then stdout:write((s or "") .. "\n") end
end

-- 读 /bin/sh 源码(登录成功后启动用户 shell)。须可执行(仅能读不可执行的不算能启动)。
local function readBin(p)
    if not fs.exists(p) then return nil end
    if not fs.canExecute(p) then
        outln("login: " .. p .. ": Permission denied")
        return nil
    end
    local f = fs.open(p, "r")
    if not f then return nil end
    local s = f:readAll(); f:close()
    return s
end

local shSrc = readBin("/bin/sh")
if not shSrc then
    outln("login: /bin/sh not found")
    return
end

if not (syscalls and syscalls["user.verify"]) then
    outln("login: user.verify syscall not available")
    return
end

-- 显示本 tty 名与切到本控制台的键(Ctrl+Alt+<index+1>: tty0->1, tty1->2, ...)。
local idx = tonumber((ttyName or ""):match("^tty(%d+)$"))
local swkey = idx and (idx + 1) or nil
if not swkey then swkey = "?" end

--- 隐藏回显读取一行(密码)。tty 行规程 setEcho(false) -> 输入不显示, 回车仅换行。
local function readHidden(prompt)
    if stdout and stdout.write then stdout:write(prompt) end
    if stdin.setEcho then stdin:setEcho(false) end
    local line = stdin:readLine()
    if stdin.setEcho then stdin:setEcho(true) end
    return line
end

local function doLogin()
    while true do
        -- 清屏(agetty 语义): 显示登录提示前清空屏幕, 去掉引导日志/上次会话的残留。
        -- 用 ANSI(复位属性 + ED 2 清屏 + CUP 归位), 与 $TERM=linux 的终端语义一致。
        if stdout and stdout.write then stdout:write("\27[0m\27[2J\27[H") end
        outln("Delin OS " .. tostring(ttyName) .. " login:")
        outln("  switch to this console: Ctrl+Alt+" .. tostring(swkey))
        if stdout and stdout.write then stdout:write("login: ") end
        local name = stdin:readLine()
        if name == nil then return end -- tty 关闭/EOF
        name = name:gsub("^%s+", ""):gsub("%s+$", "")
        if name == "" then
            outln("")
        else
            local pw = readHidden("Password: ") or ""
            if syscalls["user.verify"](name, pw) then
                local u = syscalls["user.get"](name)
                outln("Welcome, " .. name .. "!")
                -- login(1) 语义: 按 passwd 设置登录环境, 再启动用户 shell。
                local env = {
                    USER = name, LOGNAME = name, PATH = "/bin", TERM = "linux",
                    HOME = (u and u.home) or "/",
                    SHELL = (u and u.shell) or "/bin/sh",
                }
                local child = spawn(shSrc, "sh", u and u.uid or 0, u and u.gid or 0,
                    { [0] = "/bin/sh" }, { env = env })
                if not child then
                    outln("login: failed to start shell for " .. name)
                else
                    syscalls["proc.wait"](child)
                    -- sh 退出, 前台收回归 login(会话首进程)。
                    syscalls["job.tcsetpgrp"](ttyName, loginPg)
                end
                outln("") -- sh 退出 -> 回到登录
            else
                outln("Login incorrect")
            end
        end
    end
end

doLogin()
