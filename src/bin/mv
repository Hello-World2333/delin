-- Delin mv: 移动/重命名文件或目录 (GNU 子集)。用法: mv [OPTION]... <src>... <dst>
-- 说明: ext2 根无原子 rename, 用"复制后删源"模拟; 目录递归复制再整树删除。
-- 选项:
--   -i, --interactive     覆盖前询问
--   -f, --force           覆盖(不询问)
--   -n, --no-clobber      不覆盖已存在文件(优先于 -i/-f)
--   -v, --verbose         打印每个 'src' -> 'dst'
-- 支持组合短选项(-iv)与 --。
local args = args or {}
local cwd = (type(cwd) == "string" and cwd) or "/"
local function resolve(p)
    p = p or ""
    if p == "" then return (cwd == "/") and "/" or cwd end
    if p:sub(1, 1) == "/" then
        if p == "/" then return "/" end
        return p:gsub("/+$", "")
    end
    local base = (cwd == "/") and "" or cwd
    return (base .. "/" .. p):gsub("/+", "/")
end
local function stderr(s)
    local e = io.stderr()
    if e and e.write then e:write(s) end
end

local interactive, force, noClobber, verbose = false, false, false, false
local srcs = {}
local noMoreOpts = false

local function setShort(ch)
    if ch == "i" then interactive = true
    elseif ch == "f" then force = true
    elseif ch == "n" then noClobber = true
    elseif ch == "v" then verbose = true
    else stderr("mv: invalid option -- '" .. ch .. "'\n"); return false end
    return true
end

for _, a in ipairs(args) do
    if noMoreOpts then
        srcs[#srcs + 1] = a
    elseif a == "--" then
        noMoreOpts = true
    elseif a == "--interactive" then interactive = true
    elseif a == "--force" then force = true
    elseif a == "--no-clobber" then noClobber = true
    elseif a == "--verbose" then verbose = true
    elseif a:sub(1, 2) == "--" then
        stderr("mv: unrecognized option '" .. a .. "'\n")
        return 1
    elseif a:sub(1, 1) == "-" and a ~= "-" then
        for k = 2, #a do if not setShort(a:sub(k, k)) then return 1 end end
    else
        srcs[#srcs + 1] = a
    end
end
if #srcs < 2 then
    stderr("mv: missing destination file operand\n")
    return 1
end
local destRaw = srcs[#srcs]
local destHintIsDir = destRaw:sub(-1) == "/"
local dest = resolve(destRaw)

local function join(a, b)
    return (a .. "/" .. b):gsub("/+", "/")
end
local function basename(p)
    p = (type(p) == "string" and p) or ""
    p = p:gsub("/+$", "")
    return (p:match("([^/]+)$")) or p
end

local function shouldOverwrite(dst)
    if noClobber then return false end
    if not fs.exists(dst) then return true end
    if force then return true end
    if interactive then
        io.write("mv: overwrite '" .. dst .. "'? ")
        io.flush()
        local s = io.stdin()
        local line = s and s.readLine and s:readLine() or nil
        if line and line:match("^[yY]") then return true end
        return false
    end
    return true
end

local function copyFile(src, dst)
    local inF, ierr = fs.open(src, "r")
    if not inF then return nil, (ierr or ("cannot open " .. src)) end
    local outF, oerr = fs.open(dst, "w")
    if not outF then inF:close(); return nil, (oerr or ("cannot write " .. dst)) end
    while true do
        local chunk = inF:read(4096)
        if not chunk or chunk == "" then break end
        outF:write(chunk)
        yieldCheck()
    end
    inF:close()
    outF:close()
    return true
end

-- 让出调度器: 同文件系统内走 rename(不搬数据), 但**跨文件系统**要回退到 copy+delete ——
-- 那时搬大文件必须按 50ms 时间片让出, 否则 CC 会以 "Too long without yielding" 直接杀掉进程。
local _msleep = os.msleep or function(ms) os.sleep(math.max((ms or 0) / 1000, 0.05)) end
-- 让出时间片(ms)。**默认 50**: 实测电脑 #3 上一次让出 `os.msleep(0)` 要 ~75ms(不是文档里
-- 说的 2ms —— 那块 HSE 外设的 waitNextTick 实际按游戏刻返回), 让出太勤会把命令拖到 ~1 行/拍。
-- 真·HSE 快让出(每次 ~2ms)的机器可以用环境变量把时间片调小(如 DELIN_YIELD_MS=2):
-- 那是"低延迟换吞吐"的取舍, 由使用者定。见 for-ai.md「os.msleep 与 HSE」。
local _sliceMs = (type(env) == "table" and tonumber(env.DELIN_YIELD_MS)) or 50
local _sliceAt = os.epoch("utc")
local function yieldCheck()
    local now = os.epoch("utc")
    if now - _sliceAt >= _sliceMs then
        _sliceAt = now
        _msleep(0)
    end
end

local function copyTree(src, dst)
    if not fs.isDir(src) then
        return copyFile(src, dst)
    end
    if not fs.exists(dst) then
        local ok, err = pcall(fs.makeDir, dst)
        if not ok then return nil, "mkdir '" .. dst .. "' failed: " .. tostring(err) end
    end
    local names = fs.list(src) or {}
    for _, n in ipairs(names) do
        if n ~= "." and n ~= ".." then
            yieldCheck()
            local ok, err = copyTree(join(src, n), join(dst, n))
            if not ok then return nil, err end
        end
    end
    return true
end

local function removeTree(p)
    if fs.isDir(p) then
        local names = fs.list(p) or {}
        for _, n in ipairs(names) do yieldCheck(); removeTree(join(p, n)) end
        fs.delete(p)
    else
        fs.delete(p)
    end
end

local function doMove(src, target)
    if not shouldOverwrite(target) then return true, "skip" end
    -- 1) 同文件系统: rename(2) —— 只改目录项, 不搬数据、不让出, 因此是**原子**的;
    --    inode 号不变, 权限/属主/时间戳/硬链接/符号链接/FIFO 全都原样保留。
    local mvOk, mvErr = fs.move(src, target)
    if mvOk then
        if verbose then io.write("'" .. src .. "' -> '" .. target .. "'\n") end
        return true
    end
    -- 2) 回退: 跨文件系统(POSIX 的 EXDEV)或后端不支持 move —— copy+delete。
    --    注意这时是**真的搬数据**, 所以拷贝循环里必须让出调度器。
    if mvErr ~= "cross-device link" and mvErr ~= "move not supported on this filesystem" then
        -- rename 因为别的原因失败(目标非空目录/类型不匹配/权限): 如实报错, 不要偷偷回退 ——
        -- 回退会把"目录非空"变成 copy+delete 的奇怪行为(rn 语义下应当直接失败)。
        if mvErr ~= nil then return nil, mvErr end
    end
    local ok, err
    if fs.isDir(src) then
        ok, err = copyTree(src, target)
    else
        ok, err = copyFile(src, target)
    end
    if not ok then return nil, err end
    local okDel, delErr = pcall(removeTree, src)
    if not okDel then return nil, delErr end
    if verbose then io.write("'" .. src .. "' -> '" .. target .. "'\n") end
    return true
end

for si = 1, #srcs - 1 do
    local src = resolve(srcs[si])
    if not fs.exists(src) then
        stderr("mv: " .. src .. ": No such file or directory\n")
        return 1
    end
    local target
    if fs.isDir(dest) or destHintIsDir then
        target = join(dest, basename(src))
    else
        if #srcs - 1 > 1 then
            stderr("mv: target '" .. destRaw .. "' is not a directory\n")
            return 1
        end
        target = dest
    end
    if src == target then
        stderr("mv: " .. srcs[si] .. " and " .. destRaw .. " are the same file\n")
        return 1
    end
    local ok, why = doMove(src, target)
    if not ok then
        stderr("mv: " .. src .. ": " .. tostring(why) .. "\n")
        return 1
    end
end
