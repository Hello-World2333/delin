-- Delin touch: 创建文件并更新时间戳 (GNU 子集)。用法: touch [OPTION]... FILE...
-- 说明: ext2 里 mtime 是持久化的, 但 Delin **还没有写时间戳的内核接口**(没有 utimes),
--       因此 -a/-m/-r/-t/-d/-h 一律 **fail-fast 退出 2**: 老版本"接受但什么都不做"会骗过脚本
--       (脚本以为时间戳改了, 实际一个字节都没动) —— 见 for-ai.md「选项约定」。
--       真正的可观察行为只有 `-c`/`--no-create`(不存在时不创建也不报错)与"建空文件"。
-- 选项:
--   -c, --no-create            文件不存在时不创建
local args = args or {}
local cwd = (type(cwd) == "string" and cwd) or "/"
local function resolve(p)
    p = p or ""
    if p == "" then return (cwd == "/") and "/" or cwd end
    if p:sub(1, 1) == "/" then
        if p == "/" then return "/" end
        return p:gsub("/+$", "")
    end
    local base = (cwd == "/") and "" or cwd
    return (base .. "/" .. p):gsub("/+", "/")
end
local function stderr(s)
    local e = io.stderr()
    if e and e.write then e:write(s) end
end

local noCreate = false
local rest = {}
local noMoreOpts = false
local i = 1
-- 需要带参数的短选项
local needsArg = { ["r"] = true, ["t"] = true, ["d"] = true }
while i <= #args do
    local a = args[i]
    if noMoreOpts then
        rest[#rest + 1] = a
    elseif a == "--" then
        noMoreOpts = true
    elseif a == "--no-create" then noCreate = true
    elseif a == "--reference" or a == "--date" or a == "--time" or a == "--no-dereference" then
        -- 这些开关都要真的改时间戳, 而 Delin 目前没有写时间戳的内核接口 —— "接受却什么都不做"
        -- 会骗过脚本(脚本以为时间戳改了), 所以一律 fail-fast(见 for-ai.md「选项约定」)。
        stderr("touch: option '" .. a .. "' is not supported\n")
        return 2
    elseif a:sub(1, 2) == "--" and a:find("=", 1, true) then
        stderr("touch: option '" .. a:match("^([^=]*)") .. "' is not supported\n")
        return 2
    elseif a:sub(1, 1) == "-" and a ~= "-" and #a > 1 then
        for k = 2, #a do
            local ch = a:sub(k, k)
            if ch == "c" then noCreate = true
            elseif ch == "a" or ch == "m" then
                stderr("touch: option '-" .. ch .. "' is not supported\n")
                return 2
            elseif ch == "h" then
                stderr("touch: option '-h' is not supported\n")
                return 2
            elseif needsArg[ch] then
                -- -t/-d/-r 同样要真的改时间戳: 未实现 -> fail-fast(不静默忽略)
                stderr("touch: option '-" .. ch .. "' is not supported\n")
                return 2
            else
                stderr("touch: invalid option -- '" .. ch .. "'\n"); return 1
            end
        end
    else
        rest[#rest + 1] = a
    end
    i = i + 1
end

if #rest == 0 then
    stderr("touch: missing file operand\n")
    return 1
end

for _, fp in ipairs(rest) do
    local p = resolve(fp)
    if not fs.exists(p) then
        if noCreate then
            -- -c: 不创建, 静默
        else
            local ok, err = pcall(function()
                local f = fs.open(p, "w")
                if f then f:close() end
            end)
            if not ok then
                stderr("touch: " .. fp .. ": " .. tostring(err) .. "\n")
            end
        end
    end
end
