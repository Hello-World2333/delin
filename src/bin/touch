-- Delin touch: 若文件不存在则创建空文件; 已存在则不动(CC fs 不支持设置 mtime)。
-- 用法: touch <path>...
local args = args or {}
local cwd = (type(cwd) == "string" and cwd) or "/"
local function resolve(p)
    p = p or ""
    if p:sub(1, 1) == "/" then
        if p == "/" then return "/" end
        return p:gsub("/+$", "")
    end
    local base = (cwd == "/") and "" or cwd
    return (base .. "/" .. p):gsub("/+", "/")
end
local function stderr(s)
    local e = io.stderr()
    if e and e.write then e:write(s) end
end

local function touchFile(fp)
    local p = resolve(fp)
    if not fs.exists(p) then
        local ok, err = pcall(function() local f = fs.open(p, "w"); f.close() end)
        if not ok then
            stderr("touch: " .. p .. ": " .. tostring(err) .. "\n")
        end
    end
end

local noMoreOpts = false
for _, a in ipairs(args) do
    if noMoreOpts then
        touchFile(a)
    elseif a == "--" then
        noMoreOpts = true
    elseif a:sub(1, 1) == "-" and a ~= "-" then
        stderr("touch: invalid option -- " .. a .. "\n")
        return
    else
        touchFile(a)
    end
end
