-- Delin pgrep: 按名字/命令行查找进程 (procps pgrep 子集)。
-- 数据源 = /proc。用法:
--   pgrep [-flnvoax] [-u USER] PATTERN
--   -f  匹配完整命令行(默认只匹配进程名 comm)
--   -x  整串精确匹配(把 PATTERN 锚定为 ^...$)
--   -v  反向选择(不匹配的)
--   -l  每行打印 "PID 进程名";  -a 每行打印 "PID 完整命令行"
--   -n  只取最新的一个(pid 最大);  -o 只取最老的一个(pid 最小)
--   -u USER  只看该用户的进程(用户名或 uid)
-- PATTERN 用 Lua pattern(grep/sed 的同一约定; 不是 POSIX ERE)。
-- 退出码: 0 = 有匹配; 1 = 无匹配; 2 = 用法/pattern 错误。pgrep 不匹配自己(Linux 语义)。
local args = args or {}

local function stderr(s)
    local e = io.stderr()
    if e and e.write then e:write(s) end
end

local function readFile(path)
    local h = fs.open(path, "r")
    if not h then return nil end
    local c = h.readAll()
    h.close()
    return c
end

--- /proc/<pid>/cmdline 是 NUL 分隔的 argv -> 空格分隔的可读命令行。
--- (Lua 5.1 的 pattern 不能含 NUL, 所以按字节转换, 不用 gsub。)
local function cmdOf(text)
    if not text or text == "" then return nil end
    local out, n = {}, 0
    for i = 1, #text do
        local b = text:byte(i)
        n = n + 1
        out[n] = (b == 0) and " " or text:sub(i, i)
    end
    local s = table.concat(out, ""):gsub("%s+$", "")
    if s == "" then return nil end
    return s
end

local function parseStatus(text)
    local t = {}
    for line in text:gmatch("[^\n]+") do
        local k, v = line:match("^(%w+):%s*(.*)$")
        if k then t[k] = v end
    end
    return t
end

--- 当前进程的 pid(/proc/self); 用于把自己排除在匹配之外。
local function selfPid()
    local st = readFile("/proc/self/stat")
    if not st then return nil end
    return tonumber(st:match("^(%d+)"))
end

--- 枚举 /proc 下的进程: { pid, comm, cmd }。
local function candidates()
    local out = {}
    for _, e in ipairs(fs.list("/proc") or {}) do
        local pid = tonumber(e)
        if pid then
            local comm = readFile("/proc/" .. pid .. "/comm")
            if comm then
                out[#out + 1] = {
                    pid = pid,
                    comm = (comm:gsub("\n$", "")),
                    cmd = cmdOf(readFile("/proc/" .. pid .. "/cmdline")),
                }
            end
        end
    end
    table.sort(out, function(a, b) return a.pid < b.pid end)
    return out
end

--- 用户的 uid(用户名或数字)。
local function resolveUser(spec)
    local n = tonumber(spec)
    if n then return n end
    local u = syscalls and syscalls["user.get"] and syscalls["user.get"](spec)
    if not u then return nil end
    return u.uid
end

local optF, optX, optV, optL, optA, optN, optO = false, false, false, false, false, false, false
local optUser = nil
local pattern = nil

local i = 1
while i <= #args do
    local a = args[i]
    if a == "--" then
        i = i + 1
        if not args[i] then stderr("pgrep: missing pattern\n"); return 2 end
        pattern = args[i]
    elseif a:sub(1, 2) == "--" then
        stderr("pgrep: unrecognized option '" .. a .. "'\n")
        return 2
    elseif a:sub(1, 1) == "-" and #a > 1 then
        local j = 2
        while j <= #a do
            local c = a:sub(j, j)
            if c == "f" then optF = true
            elseif c == "x" then optX = true
            elseif c == "v" then optV = true
            elseif c == "l" then optL = true
            elseif c == "a" then optA = true
            elseif c == "n" then optN = true
            elseif c == "o" then optO = true
            elseif c == "u" then
                local val = a:sub(j + 1)
                if val == "" then i = i + 1; val = args[i] end
                if not val then stderr("pgrep: option requires an argument -- 'u'\n"); return 2 end
                optUser = resolveUser(val)
                if optUser == nil then stderr("pgrep: user '" .. val .. "' does not exist\n"); return 2 end
                j = #a
            else
                stderr("pgrep: invalid option -- '" .. c .. "'\n")
                return 2
            end
            j = j + 1
        end
    else
        if pattern then stderr("pgrep: too many operands\n"); return 2 end
        pattern = a
    end
    i = i + 1
end

if not pattern then stderr("usage: pgrep [-flnvoax] [-u user] pattern\n"); return 2 end
if optN and optO then stderr("pgrep: -n and -o are mutually exclusive\n"); return 2 end

local self = selfPid()
local hits = {}
for _, p in ipairs(candidates()) do
    if p.pid ~= self then
        local uidOk = true
        if optUser ~= nil then
            local s = parseStatus(readFile("/proc/" .. p.pid .. "/status") or "")
            uidOk = (tonumber(s.Uid) or -1) == optUser
        end
        if uidOk then
            local text = optF and (p.cmd or p.comm) or p.comm
            local ok, from = pcall(string.find, text, optX and ("^" .. pattern .. "$") or pattern)
            if not ok then
                stderr("pgrep: invalid pattern: " .. tostring(from) .. "\n")
                return 2
            end
            local match = from ~= nil
            if match ~= optV then hits[#hits + 1] = p end
        end
    end
end

if optN and #hits > 0 then hits = { hits[#hits] } end
if optO and #hits > 0 then hits = { hits[1] } end

for _, p in ipairs(hits) do
    if optA then
        io.write(tostring(p.pid) .. " " .. (p.cmd or ("[" .. p.comm .. "]")) .. "\n")
    elseif optL then
        io.write(tostring(p.pid) .. " " .. p.comm .. "\n")
    else
        io.write(tostring(p.pid) .. "\n")
    end
end

if #hits == 0 then return 1 end
