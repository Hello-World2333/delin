-- Delin mount: 挂载文件系统到 VFS 目录 (POSIX 子集)。
-- 用法:
--   mount                          列出当前挂载
--   mount -a                       挂载 /etc/fstab 中除 noauto 外的全部条目
--   mount [-t fstype] device dir   挂载
-- device 可为:
--   /dev/sda      整盘: 盘上的 CC 原生文件系统 (fstype ccdisk)
--   /dev/sda1     分区: 盘上 /parts/manifest 列出的镜像 (fstype ext2)
--   /dev/ccdisk0  整盘 CC 原生 fs 的别名节点
--   UUID=<uuid>   按 UUID 挂载 (UUID 由磁盘 ID 模拟: 整盘 <id>, 分区 <id>-<n>)
--   其他路径      真实后端上的块设备镜像/CC fs 路径 (兼容旧式)
-- 省略 -t 时按设备条目自带的 fstype; 显式 -t 与设备类型不符即报错。
local args = args or {}

local function stderr(s)
    local e = io.stderr()
    if e and e.write then e:write(s) end
end

local fstype, operands, noMoreOpts, mountAll = nil, {}, false, false
local i = 1
while i <= #args do
    local a = args[i]
    if noMoreOpts then
        operands[#operands + 1] = a
    elseif a == "--" then
        noMoreOpts = true
    elseif a == "-a" or a == "--all" then
        mountAll = true
    elseif a == "-t" then
        if not args[i + 1] then stderr("mount: option requires an argument -- 't'\n"); return end
        fstype = args[i + 1]
        i = i + 1
    elseif a:match("^%-t.+") then
        fstype = a:sub(3)
    elseif a:match("^%-%-type=") then
        fstype = a:sub(8)
    elseif a:sub(1, 1) == "-" and a ~= "-" then
        for k = 2, #a do
            local ch = a:sub(k, k)
            if ch ~= "f" and ch ~= "v" then stderr("mount: invalid option -- '" .. ch .. "'\n"); return end
        end
    else
        operands[#operands + 1] = a
    end
    i = i + 1
end

local function listMounts()
    local m = syscalls and syscalls["fs.mounts"]
    if not m then stderr("mount: fs.mounts syscall not available\n"); return end
    local list = m() or {}
    local lines = {}
    for _, mt in ipairs(list) do
        local dev = mt.device or ((mt.root == "/") and "rootfs" or "-")
        local line = dev .. " on " .. mt.root .. " type " .. (mt.fstype or "?") .. " (rw)"
        if mt.uuid then line = line .. " uuid=" .. mt.uuid end
        lines[#lines + 1] = line
    end
    if #lines == 0 then lines[#lines + 1] = "(nothing mounted)" end
    io.write(table.concat(lines, "\n") .. "\n")
end

local function doMount(device, dir)
    if not fs.isDir(dir) then
        stderr("mount: " .. dir .. ": No such file or directory\n")
        return
    end
    if not (syscalls and syscalls["fs.mount"]) then
        stderr("mount: fs.mount syscall not available\n")
        return
    end
    local ok, info = syscalls["fs.mount"](device, dir, fstype)
    if not ok then
        stderr("mount: " .. tostring(info) .. "\n")
        return
    end
    info = info or {}
    io.write("mounted " .. (info.device or device) .. " on " .. dir
        .. " type " .. (info.fstype or fstype or "?") .. "\n")
end

--- mount -a: 按 /etc/fstab 挂载(跳过 noauto 与已挂载的挂载点)。
local function mountAllFromFstab()
    if not (syscalls and syscalls["fstab.entries"]) then
        stderr("mount: fstab.entries syscall not available\n")
        return 1
    end
    local entries, err = syscalls["fstab.entries"]()
    if not entries then
        stderr("mount: " .. tostring(err) .. "\n")
        return 1
    end
    local mounted = {}
    for _, mt in ipairs(syscalls["fs.mounts"]() or {}) do mounted[mt.root] = true end
    local rc = 0
    for _, e in ipairs(entries) do
        if e.opts.noauto then
            -- noauto: 只允许手动挂载
        elseif fstype and e.fstype ~= fstype then
            -- -t 过滤
        elseif mounted[e.mountpoint] then
            io.write(e.mountpoint .. ": already mounted\n")
        else
            if not fs.exists(e.mountpoint) then fs.makeDir(e.mountpoint) end
            local ok, info = syscalls["fs.mount"](e.device, e.mountpoint, e.fstype)
            if ok then
                info = info or {}
                io.write("mounted " .. (info.device or e.device) .. " on " .. e.mountpoint
                    .. " type " .. (info.fstype or e.fstype) .. "\n")
            else
                stderr("mount: " .. tostring(info) .. "\n")
                rc = 1
            end
        end
    end
    return rc
end

if mountAll then
    return mountAllFromFstab()
elseif #operands == 0 then
    listMounts()
elseif #operands == 1 then
    stderr("mount: " .. operands[1] .. ": missing mount point\n")
elseif #operands == 2 then
    doMount(operands[1], operands[2])
else
    stderr("mount: too many arguments\n")
end
