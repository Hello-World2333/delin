-- Delin sh: 极简 POSIX shell。
-- 交互模式(stdin 是 tty): 显示提示符, 读命令行, 执行, 循环。带作业控制(& jobs fg bg kill)。
-- 脚本模式(stdin 是文件): 逐行读 stdin, 执行, 到 EOF 为止。
-- 内建: cd pwd echo exit help jobs fg bg kill。外部命令: /bin 下的独立工具(当子进程 spawn, 传 argv, wait)。
-- 输出走 io.stdout(父进程把它指向控制台 tty 或文件), 绝不 print(kprint 走日志+term)。

local stdin  = io.stdin()
local stdout = io.stdout()
local interactive = stdin and stdin.isTTY

-- 当前用户(登录后由 login spawn; 依据 uid 查 /etc/passwd) -> 起始目录 + 提示符名。
local uname = "root"
local cwd = "/"
if syscalls and syscalls["user.byUid"] then
    local u = syscalls["user.byUid"](uid)
    if u then
        uname = u.name
        if u.home and fs.isDir(u.home) then cwd = u.home end
    end
end
local lastExit = 0

local function outln(s)
    if stdout and stdout.write then stdout:write((s or "") .. "\n") end
end
local function errln(s)
    local e = io.stderr()
    if e and e.write then e:write((s or "") .. "\n") end
end

-- 相对路径 -> 绝对(基于 cwd; 不展开 .. )。fail-fast: 不做多余回退。
local function resolve(p)
    p = p or ""
    if p:sub(1, 1) == "/" then
        if p == "" then return "/" end
        return p:gsub("/+$", "")
    end
    local base = (cwd == "/") and "" or cwd
    local joined = base .. "/" .. p
    -- 折叠重复斜杠
    return (joined:gsub("/+", "/")):gsub("/+$", "")
end

--- 拆一行为 { cmd, args... }。极简: 按空白切分, 不处理引号/宏/管道/重定向。
local function tokenize(line)
    local toks = {}
    for tok in line:gmatch("%S+") do toks[#toks + 1] = tok end
    return toks
end

-- ---------------------------------------------------------------
-- 作业控制(仅交互模式且 stdin 是 tty)
-- ---------------------------------------------------------------
local ttyName = (stdin and stdin.getDeviceName) and stdin:getDeviceName() or nil
local shPg = nil
local jobs = {}        -- { jid, pgid, pid, cmd, status }
local nextJid = 0
local sigintPending = false
local hasJobCtl = interactive and ttyName and syscalls and syscalls["job.setpgid"]

if hasJobCtl then
    -- 交互 sh 自建进程组(不与 login 同组, ^C 只打 sh 不打 login), 并把自己置为前台。
    syscalls["job.setpgid"](pid, 0)
    shPg = syscalls["job.group"]()
    syscalls["job.tcsetpgrp"](ttyName, shPg)
    -- ^Z(SIGTSTP): sh 不停止; ^C(SIGINT): 置标志以便回到提示符。
    syscalls["signal.install"](20, function() end)
    syscalls["signal.install"](2, function() sigintPending = true end)
end

--- 极简等待: 轮询 proc.info 状态; 返回 (reason, code) reason=exited|stopped|error。
local function pollWait(pidIn)
    while true do
        local p = syscalls["proc.info"](pidIn)
        if not p then return "exited", -1 end
        if p.status == "dead" then
            return "exited", (p.termSig and -p.termSig) or (p.exitCode or 0)
        elseif p.status == "error" then
            return "error", p.error
        elseif p.status == "stopped" then
            return "stopped", p
        end
        if os.sleep then os.sleep(0.05) end
    end
end

--- 按引用找作业: %N | N | pid | 缺省(最近一个)。
local function resolveJob(ref)
    if not ref then return jobs[#jobs] end
    if type(ref) == "number" then
        for _, j in ipairs(jobs) do if j.jid == ref then return j end end
    else
        local n = tonumber(tostring(ref):match("^%%(%d+)$"))
        if n then
            for _, j in ipairs(jobs) do if j.jid == n then return j end end
        elseif tonumber(ref) then
            local pn = tonumber(ref)
            for _, j in ipairs(jobs) do if j.pid == pn then return j end end
        end
    end
    return nil
end

--- 清理已结束的作业(dead/error), 返回是否还有作业。
local function pruneJobs()
    local keep = {}
    for _, j in ipairs(jobs) do
        local p = syscalls and syscalls["proc.info"] and syscalls["proc.info"](j.pid)
        if p and (p.status == "dead" or p.status == "error") then
            -- 作业已结束, 从列表移除(不做留痕)
        else
            keep[#keep + 1] = j
        end
    end
    jobs = keep
end

local builtins = {}

builtins.pwd = function(args)
    outln(cwd)
end

builtins.echo = function(args)
    outln(table.concat(args, " "))
end

builtins.cd = function(args)
    local target = resolve(args[1] or "/")
    if not fs.isDir(target) then
        errln("cd: " .. (args[1] or "") .. ": No such directory")
        lastExit = 1
    else
        cwd = target
        lastExit = 0
    end
end

builtins.jobs = function(args)
    if not hasJobCtl then return end
    pruneJobs()
    if #jobs == 0 then return end
    for _, j in ipairs(jobs) do
        outln(string.format("[%d]+ %-8s %s", j.jid, j.status, j.cmd))
    end
end

builtins.fg = function(args)
    if not hasJobCtl then errln("fg: not a job-control shell"); lastExit = 1; return end
    pruneJobs()
    local j = resolveJob(args[1])
    if not j then errln("fg: no such job"); lastExit = 1; return end
    syscalls["job.tcsetpgrp"](ttyName, j.pgid)
    if j.status == "stopped" then
        syscalls["signal.killpg"](j.pgid, 18) -- SIGCONT
        j.status = "running"
    end
    local reason, code = pollWait(j.pid)
    syscalls["job.tcsetpgrp"](ttyName, shPg)
    if reason == "stopped" then
        j.status = "stopped"
        outln("[" .. j.jid .. "]+ Stopped " .. j.cmd)
        return
    end
    for i, x in ipairs(jobs) do if x == j then table.remove(jobs, i); break end end
    lastExit = (reason == "exited") and (code or 0) or 1
    if lastExit > 0 then
        errln("sh: " .. j.cmd .. ": exit " .. tostring(lastExit))
    end
end

builtins.bg = function(args)
    if not hasJobCtl then errln("bg: not a job-control shell"); lastExit = 1; return end
    pruneJobs()
    local j = resolveJob(args[1])
    if not j then errln("bg: no such job"); lastExit = 1; return end
    syscalls["signal.killpg"](j.pgid, 18) -- SIGCONT
    j.status = "running"
    outln("[" .. j.jid .. "] " .. j.cmd .. " &")
end

builtins.kill = function(args)
    -- kill [-SIG] pid|%job ...
    local sig = 15 -- SIGTERM
    local targets = {}
    for i = 1, #args do
        local a = args[i]
        if a == "-l" or a == "-L" then
            local nums = (syscalls and syscalls["signal.list"] and syscalls["signal.list"]()) or {}
            local t = {}
            for _, s in ipairs(nums) do t[#t + 1] = syscalls["signal.name"](s) end
            outln(table.concat(t, " "))
            return
        elseif a:match("^-%d+$") then
            sig = tonumber(a:sub(2))
        elseif a:match("^%-[A-Za-z]+$") then
            sig = (syscalls and syscalls["signal.number"] and syscalls["signal.number"](a)) or nil
            if not sig then errln("kill: unknown signal " .. a); lastExit = 1; return end
        else
            targets[#targets + 1] = a
        end
    end
    if #targets == 0 then errln("usage: kill [-SIG] pid|%job ..."); lastExit = 1; return end
    for _, tgt in ipairs(targets) do
        if tostring(tgt):match("^%%") then
            local j = resolveJob(tgt)
            if not j then
                errln("kill: no such job " .. tgt); lastExit = 1
            elseif syscalls and syscalls["signal.killpg"] then
                local ok, e = syscalls["signal.killpg"](j.pgid, sig)
                if not ok then errln("kill: " .. tgt .. ": " .. tostring(e)); lastExit = 1 end
            end
        else
            local ok, e = syscalls["signal.kill"](tonumber(tgt), sig)
            if not ok then errln("kill: " .. tostring(tgt) .. ": " .. tostring(e)); lastExit = 1 end
        end
    end
end

builtins.help = function(args)
    outln("Delin sh v0.0.1")
    outln("builtins : cd pwd echo exit help jobs fg bg kill")
    outln("external : ls cat rm mkdir cp mv touch head tail wc grep sed")
    outln("usage    : sh [script]  (no script => interactive on stdio)")
end

builtins.exit = function(args)
    lastExit = tonumber(args[1]) or 0
    return "EXIT"
end

--- 外部命令: 在 /bin 下找, 读源码, spawn 子进程(传 argv), wait 等退出。
local function runExternal(cmd, args, bg)
    local path
    if cmd:sub(1, 1) == "/" then
        path = cmd
    else
        path = "/bin/" .. cmd
    end
    -- 命令须存在(→127)且有执行权限(→126); 两者都过才读源码去 spawn。
    if not fs.exists(path) then
        errln("sh: " .. cmd .. ": command not found")
        lastExit = 127
        return
    end
    if not fs.canExecute(path) then
        errln("sh: " .. cmd .. ": Permission denied")
        lastExit = 126
        return
    end
    local f = fs.open(path, "r")
    if not f then
        errln("sh: " .. cmd .. ": Permission denied")
        lastExit = 126
        return
    end
    local src = f.readAll()
    f.close()

    -- 参数原样传给子进程(每个工具自行按 cwd 解析相对路径); shell 不再预解析。
    -- 预解析会误伤 grep 的模式、head/tail 的 "-n 5" 里的 "5" 这类非路径参数。
    -- 子进程的 cwd 由 opts.cwd 注入, 工具据此把相对路径解析成绝对。
    local argv = { [0] = path }
    for i = 1, #args do argv[i] = args[i] end

    local child, cerr = spawn(src, cmd, nil, nil, argv, { cwd = cwd })
    if not child then
        errln("sh: " .. cmd .. ": " .. tostring(cerr))
        lastExit = 126
        return
    end

    if hasJobCtl then
        -- 新进程组(作业) & 控制终端前台组交给它(前台作业)。
        syscalls["job.setpgid"](child, 0)
        local cmdline = cmd .. ((#args > 0) and (" " .. table.concat(args, " ")) or "")
        if bg then
            nextJid = nextJid + 1
            jobs[#jobs + 1] = { jid = nextJid, pgid = child, pid = child, cmd = cmdline, status = "running" }
            outln("[" .. nextJid .. "] " .. tostring(child) .. " " .. cmdline)
            return
        end
        syscalls["job.tcsetpgrp"](ttyName, child)
        local reason, code = pollWait(child)
        syscalls["job.tcsetpgrp"](ttyName, shPg)
        if reason == "stopped" then
            nextJid = nextJid + 1
            jobs[#jobs + 1] = { jid = nextJid, pgid = child, pid = child, cmd = cmdline, status = "stopped" }
            outln("[" .. nextJid .. "]+ Stopped " .. cmdline)
            return
        elseif reason == "error" then
            lastExit = 1
            errln("sh: " .. cmd .. ": " .. tostring(code))
            return
        end
        lastExit = code or 0
        if lastExit > 0 then
            errln("sh: " .. cmd .. ": exit " .. tostring(lastExit))
        end
    else
        local code = syscalls["proc.wait"](child)
        lastExit = code or 0
        if lastExit > 0 then
            errln("sh: " .. cmd .. ": exit " .. tostring(lastExit))
        end
    end
end

--- 执行一行命令。内建优先; 否则外部。返回 "EXIT" 表示退出 shell。
local function execLine(line)
    if not line then return end
    line = line:match("^%s*(.-)%s*$")
    if line == "" then return end
    local toks = tokenize(line)
    if #toks == 0 then return end
    local cmd = toks[1]
    local args = {}
    for i = 2, #toks do args[#args + 1] = toks[i] end
    -- 行尾单个 "&" => 后台作业(仅作业控制 shell; 脚本模式忽略)。
    local bg = false
    if #args > 0 and args[#args] == "&" then
        bg = hasJobCtl
        table.remove(args)
    elseif cmd == "&" then
        return
    end
    if builtins[cmd] then
        return builtins[cmd](args)
    end
    runExternal(cmd, args, bg)
end

if interactive then
    while true do
        local prompt = uname .. "@delin:" .. (cwd == "/" and "/" or cwd) .. "# "
        if stdout and stdout.write then stdout:write(prompt) end
        sigintPending = false
        local line = stdin:readLine()
        if line == nil then break end -- EOF(^D)
        local r = execLine(line)
        if r == "EXIT" then break end
    end
else
    -- 脚本模式: 逐行读 stdin 直到 EOF(结果写到 stdout)。整行以 # 开头视为注释。
    while true do
        local line = stdin:readLine()
        if line == nil then break end
        local trimmed = (line or ""):match("^%s*(.-)%s*$")
        if trimmed ~= "" and trimmed:sub(1, 1) ~= "#" then
            local r = execLine(trimmed)
            if r == "EXIT" then break end
        end
    end
end

return "sh done"
