-- Delin tr: 翻译/删除/压缩字符 (POSIX + GNU 子集)。用法: tr [-c|-C] [-d] [-s] [-t] SET1 [SET2]
-- 选项:
--   -c, -C, --complement   取 SET1 的补集(0..255 中不在 SET1 里的字节)
--   -d, --delete           删除 SET1 中的字符
--   -s, --squeeze-repeats  压缩连续重复字符(给了 SET2 时按 SET2 压缩, 否则按 SET1)
--   -t, --truncate-set1    把 SET1 截断到 SET2 的长度
-- SET 记法:
--   范围 a-z; 转义 \\ \a \b \f \n \r \t \v \ooo(1..3 位八进制); \xHH;
--   [=c=] 等价类(取字符 c); [:class:] 字符类(alpha alnum digit space upper lower punct
--   cntrl print graph xdigit blank); [c*n] 重复 n 次, [c*] 在 SET2 里补足到 SET1 的长度。
-- 已知偏离:
--   - 字符一律按**字节**处理(0..255), 无 locale 多字节概念; 字符类按 C locale 定义。
--   - SET1 比 SET2 长且未给 -t 时, SET2 用最后一个字符补齐(POSIX 语义)。
--   - 只接受 GNU 的 [x*] / [x*n] 记法; 不支持 [x*0] 之类未定义形式。
local args = args or {}
local cwd = (type(cwd) == "string" and cwd) or "/"
local function stderr(s)
    local e = io.stderr()
    if e and e.write then e:write(s) end
end
local function ioeMsg(err)
    if err and (err:find("permission") or err:find("denied")) then return "Permission denied" end
    -- 必须先判 ENOENT: "No such file or directory" 里本来就含 "directory" 这个词,
    -- 先匹 "directory" 会把"文件不存在"误报成 "Is a directory"(老模板的 bug)。
    if err and err:lower():find("no such file") then return "No such file or directory" end
    if err and err:find("directory") then return "Is a directory" end
    return "No such file or directory"
end

local complement, delMode, squeezeMode, truncMode = false, false, false, false
local operands = {}
local sawOperand = false

for _, a in ipairs(args) do
    if sawOperand then
        operands[#operands + 1] = a
    elseif a == "--" then
        sawOperand = true
    elseif a == "-c" or a == "-C" or a == "--complement" then complement = true
    elseif a == "-d" or a == "--delete" then delMode = true
    elseif a == "-s" or a == "--squeeze-repeats" then squeezeMode = true
    elseif a == "-t" or a == "--truncate-set1" then truncMode = true
    elseif a:sub(1, 1) == "-" and a ~= "-" and a:sub(1, 2) ~= "--" then
        for k = 2, #a do
            local ch = a:sub(k, k)
            if ch == "c" or ch == "C" then complement = true
            elseif ch == "d" then delMode = true
            elseif ch == "s" then squeezeMode = true
            elseif ch == "t" then truncMode = true
            else stderr("tr: invalid option -- '" .. ch .. "'\n"); return 1 end
        end
    elseif a:sub(1, 2) == "--" then
        stderr("tr: unrecognized option '" .. a .. "'\n")
        return 1
    else
        sawOperand = true
        operands[#operands + 1] = a
    end
end

if #operands < 1 then
    stderr("tr: missing operand\n")
    return 1
end
if #operands > 2 then
    stderr("tr: extra operand '" .. operands[3] .. "'\n")
    return 1
end
if #operands == 1 and not (delMode or squeezeMode) then
    stderr("tr: missing operand\n")
    return 1
end

-- 字符类(C locale)。
local CLASSES = {}
do
    local function expand(ranges)
        local t = {}
        for _, r in ipairs(ranges) do
            for b = r[1], r[2] do t[#t + 1] = b end
        end
        return t
    end
    CLASSES.alpha = expand { { 65, 90 }, { 97, 122 } }
    CLASSES.digit = expand { { 48, 57 } }
    CLASSES.alnum = expand { { 48, 57 }, { 65, 90 }, { 97, 122 } }
    CLASSES.space = { 32, 9, 10, 11, 12, 13 }
    CLASSES.upper = expand { { 65, 90 } }
    CLASSES.lower = expand { { 97, 122 } }
    CLASSES.punct = expand { { 33, 47 }, { 58, 64 }, { 91, 96 }, { 123, 126 } }
    CLASSES.cntrl = expand { { 0, 31 }, { 127, 127 } }
    CLASSES.print = expand { { 32, 126 } }
    CLASSES.graph = expand { { 33, 126 } }
    CLASSES.xdigit = expand { { 48, 57 }, { 65, 70 }, { 97, 102 } }
    CLASSES.blank = { 32, 9 }
end

-- 解析一个转义, 返回字节值与新位置。
local function parseEscape(s, i)
    local c = s:sub(i + 1, i + 1)
    if c == "" then return nil, nil end
    if c == "\\" then return 92, i + 2 end
    if c == "a" then return 7, i + 2 end
    if c == "b" then return 8, i + 2 end
    if c == "f" then return 12, i + 2 end
    if c == "n" then return 10, i + 2 end
    if c == "r" then return 13, i + 2 end
    if c == "t" then return 9, i + 2 end
    if c == "v" then return 11, i + 2 end
    if c == "x" then
        local hex = s:match("^(%x%x?)", i + 2)
        if hex then return tonumber(hex, 16), i + 2 + #hex end
        return nil, nil
    end
    if c:match("%d") then
        local oct = s:match("^(%d%d?%d?)", i + 1)
        local v = tonumber(oct, 8)
        if v > 255 then v = v % 256 end
        return v, i + 1 + #oct
    end
    return c:byte(), i + 2
end

-- 解析一个元素(单字节), 返回字节值与新位置。
local function parseElem(s, i)
    local c = s:sub(i, i)
    if c == "\\" then return parseEscape(s, i) end
    if c == "" then return nil, nil end
    return c:byte(), i + 1
end

-- 解析整个 SET: 返回 {bytes=..., fill=索引或nil}
local function parseSet(spec)
    local bytes = {}
    local fillIdx = nil
    local i = 1
    while i <= #spec do
        local c = spec:sub(i, i)
        if c == "[" then
            local cls = spec:match("^%[:([%a]+):%]", i)
            if cls then
                local set = CLASSES[cls]
                if not set then stderr("tr: invalid character class '" .. cls .. "'\n"); return nil end
                for _, b in ipairs(set) do bytes[#bytes + 1] = b end
                i = i + #cls + 4
            else
                local eq = spec:match("^%[=(.-)=%]", i)
                if eq and #eq >= 1 then
                    local b = parseElem(eq, 1)
                    if b == nil then stderr("tr: invalid equivalence class\n"); return nil end
                    bytes[#bytes + 1] = b
                    i = i + #eq + 4
                else
                    local rep = spec:match("^%[(.-)%*(%d*)%]", i)
                    if rep then
                        local rb = parseElem(rep, 1)
                        if rb == nil then stderr("tr: invalid repeat count\n"); return nil end
                        local whole = spec:match("^%[.-%*%d*%]", i)
                        local cnt = spec:match("^%[.-%*(%d*)%]", i)
                        i = i + #whole
                        if cnt == "" then
                            if fillIdx then stderr("tr: only one [c*] repeat construct may appear in string2\n"); return nil end
                            bytes[#bytes + 1] = rb
                            fillIdx = #bytes
                        else
                            for _ = 1, tonumber(cnt) do bytes[#bytes + 1] = rb end
                        end
                    else
                        -- 不当成特殊记法: 按普通字符处理
                        bytes[#bytes + 1] = c:byte()
                        i = i + 1
                    end
                end
            end
        else
            local b, ni = parseElem(spec, i)
            if b == nil then break end
            -- 范围?
            if spec:sub(ni, ni) == "-" and ni < #spec and spec:sub(ni + 1, ni + 1) ~= "]" then
                local b2, ni2 = parseElem(spec, ni + 1)
                if b2 == nil then stderr("tr: invalid range\n"); return nil end
                if b2 < b then
                    stderr("tr: range-endpoints of '" .. spec:sub(i, ni2 - 1) .. "' are in reverse collating sequence order\n")
                    return nil
                end
                for x = b, b2 do bytes[#bytes + 1] = x end
                i = ni2
            else
                bytes[#bytes + 1] = b
                i = ni
            end
        end
    end
    return { bytes = bytes, fill = fillIdx }
end

local set1 = parseSet(operands[1])
if not set1 then return 1 end
local set2 = nil
if operands[2] ~= nil then
    set2 = parseSet(operands[2])
    if not set2 then return 1 end
end

if set2 and set2.fill then
    -- [c*]: 补足到 SET1 的长度。
    local need = #set1.bytes - #set2.bytes
    local b = set2.bytes[set2.fill]
    for _ = 1, need do table.insert(set2.bytes, set2.fill, b) end
    set2.fill = nil
end

-- 成员表与映射表。
local member1 = {}
for _, b in ipairs(set1.bytes) do member1[b] = true end
local idx1 = {}
do
    local n = 0
    for _, b in ipairs(set1.bytes) do
        n = n + 1
        if idx1[b] == nil then idx1[b] = n end
    end
    if complement then
        -- 补集: 按字节升序, 成员表与映射表都重建。
        local comp = {}
        for b = 0, 255 do if not member1[b] then comp[#comp + 1] = b end end
        member1 = {}
        idx1 = {}
        local n2 = 0
        for _, b in ipairs(comp) do
            n2 = n2 + 1
            idx1[b] = n2
            member1[b] = true
        end
        -- -c 之后"当前集合"就是补集: -d/-s(只给 SET1)与映射都以它为准。
        set1.bytes = comp
    end
end

local sqSet = nil   -- 压缩时判定用的成员表
if squeezeMode then
    sqSet = {}
    local src = (set2 and set2.bytes) or set1.bytes
    for _, b in ipairs(src) do sqSet[b] = true end
end

-- SET2 补齐/截断规则。
local function mapByte(ix, orig)
    if not set2 then return orig end
    local n = #set2.bytes
    if n == 0 then return orig end
    if ix <= n then return set2.bytes[ix] end
    if truncMode then return orig end
    return set2.bytes[n]
end

-- 输入读取: 分块; 无 read 的句柄(宿主测试台 stdin)退化为逐行 + 换行。
local function makeReader(h)
    local useChunks = true
    local function readChunk()
        if useChunks then
            local c = h:read(4096)
            if type(c) == "string" then
                if c == "" then return nil end
                return c
            end
            useChunks = false
        end
        local l = h:readLine()
        if l == nil then return nil end
        return l .. "\n"
    end
    return readChunk
end

local h
if #operands >= 1 then
    h = io.stdin()
    if not h then stderr("tr: 无法读取 stdin\n"); return 1 end
end
local rd = makeReader(h)
local out = {}
local pending = nil
while true do
    local chunk = rd()
    if chunk == nil then break end
    for i = 1, #chunk do
        local b = chunk:byte(i)
        local ob
        if delMode then
            if member1[b] then ob = nil else ob = b end
        else
            local ix = idx1[b]
            ob = ix and mapByte(ix, b) or b
        end
        if ob ~= nil then
            if sqSet and sqSet[ob] and pending == ob then
                -- 压缩掉
            else
                out[#out + 1] = string.char(ob)
                pending = ob
            end
        end
    end
    if #out >= 512 then io.write(table.concat(out)); out = {} end
end
if #out > 0 then io.write(table.concat(out)) end
