--@name ccprinter
--@version 0.1.0
--@description CC:Tweaked printer 驱动: /dev/lpN 字符设备(流式写, 满页自动翻页, close 打印末页)
--@deps
local a={}local d=0 local b=nil local c=nil local function g(j)if not j.page then return end j.page=nil if not j.dev.endPage()then if c then c("ccprinter: "..j.node..": endPage failed (output tray full?)")end error("ccprinter: "..j.node..": endPage failed (output tray full?)")end end local function e(j)if j.page then return end if not j.dev.newPage()then error("ccprinter: "..j.node..": cannot start a page (out of paper or ink, or output tray full)")end local l,k=j.dev.getPageSize()j.page={w=l,h=k,row=1,col=1}j.size=l.."x"..k j.dev.setPageTitle(j.title)end local function h(j)e(j)j.page.row=j.page.row+1 j.page.col=1 if j.page.row>j.page.h then g(j)end end local function i(o,m)local k=m while#k>0 do e(o)local j=o.page local n=j.w-j.col+1 local l=k:sub(1,n)o.dev.setCursorPos(j.col,j.row)o.dev.write(l)j.col=j.col+#l k=k:sub(#l+1)if j.col>j.w and#k>0 then j.col=1 h(o)end end end local function f(o,m)m=tostring(m)local k=1 local n=#m while k<=n do local l=m:find("\n",k,true)local j if l then j=m:sub(k,l-1)k=l+1 else j=m:sub(k)k=n+1 end if j:sub(-1)=="\r"then j=j:sub(1,-2)end i(o,j)if l then h(o)end end end return{init=function(j,m)local l=m local o=peripheral.wrap(l)local k="lp"..d d=d+1 local n={node=k,side=l,dev=o,page=nil,size=nil,title=""}a[k]=n j.registerDevice(k,{writable=true,open=function(p)if not(p and(p:find("w")or p:find("a")))then return nil,"write-only device: /dev/"..k end return{write=function(r,q)f(n,q)return#tostring(q)end,writeLine=function(r,q)f(n,tostring(q).."\n")return#tostring(q)+1 end,flush=function()return true end,close=function()g(n)return true end,read=function()return nil end,readLine=function()return nil end,}end,})j.registerSysfsClass("printer",{list=function()local p={}for q in pairs(a)do p[#p+1]=q end table.sort(p)return p end,attrs=function(p)if not a[p]then return nil end return{"name","type","size","paper","ink","title"}end,writable=function(q,p)return p=="title"end,get=function(q,p)local r=a[q]if not r then return nil end if p=="name"then return r.side end if p=="type"then return"printer"end if p=="size"then return r.size or""end if p=="paper"then return tostring(r.dev.getPaperLevel())end if p=="ink"then return tostring(r.dev.getInkLevel())end if p=="title"then return r.title end return nil end,set=function(p,r,q)local s=a[p]if not s then return nil,"no such printer: "..p end if r~="title"then return nil,"read-only attribute: "..r end s.title=q if s.page then s.dev.setPageTitle(q)end return true end,})b,c=j,j.log j.log("ccprinter: /dev/"..k.." registered (side "..l..")")end,exit=function()if not b then return end for j in pairs(a)do b.unregisterDevice(j)a[j]=nil end b.unregisterSysfsClass("printer")b,c=nil,nil end,}