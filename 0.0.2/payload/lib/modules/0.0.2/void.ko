--@name void
--@version 0.1.0
--@description Void PowerMod hologram display driver (0-based; unified ARGB -> 8bit index translation).
--@deps
local function a(b)b=b or 0 local c={0,90,180,255}local function d(m)local i,j=0,0 for k=1,4 do local l=math.abs(m-c[k])if k==1 or l<i then i,j=l,k-1 end end return j end local h=d(math.floor(b/65536)%256)local g=d(math.floor(b/256)%256)local f=d(b%256)local e=d(math.floor(b/16777216)%256)return h*64+g*16+f*4+e end return{init=function(d,g)local e=g local c=peripheral.wrap(e)local k,i=256,192 local j,f=pcall(c.allocateFrameBuffer,k,i)if not j or not f then d.log("void: allocateFrameBuffer failed ("..tostring(f)..")")return end pcall(c.activateFrameBuffer,f)pcall(c.setScale,1)pcall(c.setRotation,0,0,0)pcall(c.setColorMapping,0,90,180,255)d.log("void: hologram fb="..tostring(f).." "..k.."x"..i)local b={offset={x=0,y=0,z=0},rotation={yaw=0,pitch=0,roll=0},scale=1}local h={id="void:"..e,type="hologram",mode="pixel",cellW=6,cellH=8,name=e,device=c,fb=f,width=k,height=i,getSize=function()return k,i end,blit=function(o,p,l,m,n)pcall(c.drawText,o,p,l,a(m or 0xFFFFFF),1)end,text=function(o,p,n,l,m)pcall(c.drawText,o,p,n,a(l or 0xFFFFFF),1)end,fill=function(l)pcall(c.fill,0,0,k,i,a(l or 0),0)end,setPixel=function(m,n,l)pcall(c.drawPixel,m,n,a(l or 0))end,rect=function(o,p,n,m,l)if n>0 and m>0 then pcall(c.fill,o,p,n,m,a(l or 0),0)end end,listConfig=function()return{"offset","rotation","scale"}end,getConfig=function(l)if l=="offset"then return string.format("%s %s %s",b.offset.x,b.offset.y,b.offset.z)elseif l=="rotation"then return string.format("%s %s %s",b.rotation.yaw,b.rotation.pitch,b.rotation.roll)elseif l=="scale"then return tostring(b.scale)elseif l=="size"then return k.."x"..i end return nil end,setConfig=function(l,n)local r=(n or""):gsub("^%s*(.-)%s*$","%1")if l=="offset"then local s,t,u=r:match("^(%-?%d+%.?%d*)%s+(%-?%d+%.?%d*)%s+(%-?%d+%.?%d*)$")if not s then return nil,"bad offset (expected 'x y z')"end b.offset={x=tonumber(s),y=tonumber(t),z=tonumber(u)}pcall(c.setOffset,b.offset.x,b.offset.y,b.offset.z)return true elseif l=="rotation"then local o,m,p=r:match("^(%-?%d+%.?%d*)%s+(%-?%d+%.?%d*)%s+(%-?%d+%.?%d*)$")if not o then return nil,"bad rotation (expected 'yaw pitch roll')"end b.rotation={yaw=tonumber(o),pitch=tonumber(m),roll=tonumber(p)}pcall(c.setRotation,b.rotation.yaw,b.rotation.pitch,b.rotation.roll)return true elseif l=="scale"then local q=tonumber(r)if not q then return nil,"bad scale (expected number)"end b.scale=q pcall(c.setScale,q)return true end return nil,"read-only or unknown config: "..tostring(l)end,flush=(function()local l=0 return function()local m=os.clock()if m-l<0.05 then return end l=m pcall(c.sync)end end)(),release=function()pcall(c.releaseFrameBuffer,f)end,}d.registerDisplay(h)d.log("void: display '"..h.id.."' registered ("..k.."x"..i..")")end,}