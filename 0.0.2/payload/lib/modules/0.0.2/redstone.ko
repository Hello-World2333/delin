--@name redstone
--@version 0.2.0
--@description CC 红石驱动: /sys/class/redstone/<side>/{digital,analog,bundled}; 三个属性一律
--@deps
local f={"digital","analog","bundled"}local c=nil local function d()if not c then local i={}for k,j in ipairs(redstone.getSides())do i[#i+1]=j end table.sort(i)c=i end return c end local function e(i)for k,j in ipairs(d())do if j==i then return true end end return false end local function b(j,k,l)local i=tostring(j)local m=i:match("^%d+$")and tonumber(i)or nil if not m or m>k then return nil,"invalid "..l..": '"..i.."' (expected decimal integer 0.."..k..")"end return m end local function g(i,j)if j=="digital"then return redstone.getInput(i)and"1"or"0"end if j=="analog"then return tostring(redstone.getAnalogInput(i))end if j=="bundled"then return tostring(redstone.getBundledInput(i))end return nil end local function h(j,i,k)if i=="digital"then local p,m=b(k,1,"digital")if not p then return nil,m end redstone.setOutput(j,p==1)return true end if i=="analog"then local q,l=b(k,15,"analog")if not q then return nil,l end redstone.setAnalogOutput(j,q)return true end if i=="bundled"then local o,n=b(k,65535,"bundled")if not o then return nil,n end redstone.setBundledOutput(j,o)return true end return nil,"no such attribute: "..tostring(i)end local a=nil return{init=function(i)a=i i.registerSysfsClass("redstone",{list=function()return d()end,attrs=function(j)if not e(j)then return nil end return f end,get=g,set=h,})i.log("redstone: /sys/class/redstone registered ("..#d().." sides)")end,exit=function()if not a then return end a.unregisterSysfsClass("redstone")a=nil end,}