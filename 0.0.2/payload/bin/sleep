local g=args or{}local function e(m)local l=io.stderr()if l and l.write then l:write(m)end end if#g==0 then e("sleep: missing operand\n")return 1 end local d=0 for k,i in ipairs(g)do local h,f=i:match("^([%d%.]+)([smhdSMHD]?)$")local j=h and tonumber(h)if not j then e("sleep: invalid time interval '"..tostring(i).."'\n")return 1 end f=(f or""):lower()local c=1 if f=="m"then c=60 elseif f=="h"then c=3600 elseif f=="d"then c=86400 end d=d+j*c end local a=d*1000 while a>0 do local b=a>50 and 50 or a if os.msleep then os.msleep(b)else os.sleep(b/1000)end a=a-b end return 0