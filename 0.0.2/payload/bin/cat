local t=os.msleep or function(d1)os.sleep(math.max((d1 or 0)/1000,0.05))end local k=os.epoch("utc")local function o(e1)local d1=os.epoch("utc")if d1-k>=50 then k=d1 t(0)end end local d=false if syscalls and syscalls["signal.install"]then syscalls["signal.install"](2,function()d=true end)end local y=args or{}local s=(type(cwd)=="string"and cwd)or"/"local function v(e1)e1=e1 or""if e1==""then return(s=="/")and"/"or s end if e1:sub(1,1)=="/"then if e1=="/"then return"/"end return e1:gsub("/+$","")end local d1=(s=="/")and""or s return(d1.."/"..e1):gsub("/+","/")end local function p(e1)local d1=io.stderr()if d1 and d1.write then d1:write(e1)end end local l,h,g,b,c,j,a=false,false,false,false,false,false,false local f={}local i=false local function q(d1)if d1=="n"then l=true elseif d1=="b"then h=true elseif d1=="s"then g=true elseif d1=="E"then b=true elseif d1=="T"then c=true elseif d1=="A"then j=true;a=true;b=true;c=true elseif d1=="v"then a=true elseif d1=="e"then a=true;b=true elseif d1=="t"then a=true;c=true elseif d1=="u"then else p("cat: invalid option -- '"..d1.."'\n");return false end return true end for b1,r in ipairs(y)do if i then f[#f+1]=r elseif r=="--"then i=true elseif r=="--number"then l=true elseif r=="--number-nonblank"then h=true elseif r=="--squeeze-blank"then g=true elseif r=="--show-ends"then b=true elseif r=="--show-tabs"then c=true elseif r=="--show-all"then j,a,b,c=true,true,true,true elseif r=="--show-nonprinting"then a=true elseif r:sub(1,1)=="-"and r~="-"then for z=2,#r do if not q(r:sub(z,z))then return end end else f[#f+1]=r end end if#f==0 then f={"-"}end local function m(f1)if not(a or b or c)then return f1 end local d1={}for g1=1,#f1 do local e1=f1:byte(g1)if e1==9 then d1[#d1+1]=(c and"^I")or"\t"elseif e1<32 then d1[#d1+1]="^"..string.char(e1+64)elseif e1==127 then d1[#d1+1]="^?"elseif e1>=128 then d1[#d1+1]="M-"..m(string.char(e1-128))else d1[#d1+1]=f1:sub(g1,g1)end end return table.concat(d1)end local n,x,e=0,0,0 local function w(i1)while not d do local g1=i1.readLine()if g1==nil then break end n=n+1 local d1=(g1=="")if d1 then e=e+1 else e=0 x=x+1 end if g and d1 and e>1 then else local e1=""if l then e1=string.format("%6d\t",n)elseif h then if not d1 then e1=string.format("%6d\t",x)end end local f1=m(g1)if b then f1=f1.."$"end local h1=e1..f1.."\n"io.write(h1)o(#h1)end end end local function u(g1)if g1=="-"then local e1=io.stdin()if e1 then w(e1)else return true end return true end g1=v(g1)local h1,d1=fs.open(g1,"r")if not h1 then local f1="No such file or directory"if d1 and(d1:find("permission")or d1:find("denied"))then f1="Permission denied"elseif d1 and d1:find("directory")then f1="Is a directory"end p("cat: "..g1..": "..f1.."\n")return false end w(h1)h1.close()return true end for c1,a1 in ipairs(f)do if d or not u(a1)then return end end