local n=os.msleep or function(a1)os.sleep(math.max((a1 or 0)/1000,0.05))end local i=os.epoch("utc")local function j(b1)local a1=os.epoch("utc")if a1-i>=50 then i=a1 n(0)end end local a=false if syscalls and syscalls["signal.install"]then syscalls["signal.install"](2,function()a=true end)end local g=args or{}local m=(type(cwd)=="string"and cwd)or"/"local function f(b1)local a1=io.stderr()if a1 and a1.write then a1:write(b1)end end local function o(b1)if b1==""then return(m=="/")and"/"or m end if b1:sub(1,1)=="/"then if b1=="/"then return"/"end return b1:gsub("/+$","")end local a1=(m=="/")and""or m return(a1.."/"..b1):gsub("/+","/")end local b,h="/dev/lp0",nil local c={}local e=false local p=1 while p<=#g do local l=g[p]if e then c[#c+1]=l elseif l=="--"then e=true elseif l=="-d"and g[p+1]then p=p+1;b=g[p]elseif l:match("^%-%-destination=")then b=l:sub(15)elseif l=="-t"and g[p+1]then p=p+1;h=g[p]elseif l:match("^%-%-title=")then h=l:sub(9)elseif l=="--help"or l=="-h"then io.write("usage: lp [-d dest] [-t title] [file ...]\n")return 0 elseif l:sub(1,1)=="-"and l~="-"then f("lp: invalid option '"..l.."'\n")return 1 else c[#c+1]=l end p=p+1 end if#c==0 then c={"-"}end if b:sub(1,1)~="/"then b="/dev/"..b end if h then local s=b:match("([^/]+)$")local v,u=fs.open("/sys/class/printer/"..s.."/title","w")if not v then f("lp: "..b..": cannot set title: "..tostring(u).."\n")return 1 end v:writeLine(h)v:close()end local q,t=fs.open(b,"w")if not q then f("lp: "..b..": "..tostring(t).."\n")return 1 end local x=0 for z,y in ipairs(c)do if a then break end local d if y=="-"then d=io.stdin()else local w,r=fs.open(o(y),"r")if not w then f("lp: "..y..": "..tostring(r).."\n")x=1 break end d=w end while not a do local k=d.readLine()if k==nil then break end q:write(k.."\n")j(#k+1)end if y~="-"then d:close()end end q:close()if a then return 130 end return x