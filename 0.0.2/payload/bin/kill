local h=args or{}local function b(y)local x=io.stderr()if x and x.write then x:write(y)end end local f=15 local i=false local a={}local e=false local function g(x)return syscalls["signal.name"](x)end local function c(x)return syscalls["signal.number"](x)end local function d(y)local x=tostring(y)x=x:gsub("^%-","")if x:match("^%d+$")then return tonumber(x)end if x:match("^SIG")then x=x:sub(4)end return c(x)end local l=1 while l<=#h do local k=h[l]if e then a[#a+1]=k elseif k=="--"then e=true elseif k=="-l"or k=="-L"then i=true local j=h[l+1]if j and j:match("^%-?%d+$")then l=l+1 local o=g(tonumber(j))io.write((o or"?").."\n")return elseif j and not j:match("^%-")then l=l+1 local n=c(j:gsub("^SIG",""))io.write((n and tostring(n))or"?")io.write("\n")return end elseif k=="-s"or k=="--signal"then l=l+1 if not h[l]then b("kill: option requires an argument -- 's'\n");return end f=d(h[l])if not f then b("kill: unknown signal "..h[l].."\n");return end elseif k:match("^%-%-signal=")then f=d(k:sub(10))if not f then b("kill: unknown signal "..k:sub(10).."\n");return end elseif k:match("^%-%d+$")then f=tonumber(k:sub(2))elseif k:match("^%-[A-Za-z]+$")then f=d(k)if not f then b("kill: unknown signal "..k.."\n")return end else a[#a+1]=k end l=l+1 end if i then local p=syscalls["signal.list"]()local t={}for w,u in ipairs(p)do t[#t+1]=g(u)end io.write(table.concat(t," ").."\n")return end if#a==0 then b("usage: kill [-SIG] pid...\n")return end for v,m in ipairs(a)do local r=tonumber(m)if not r then b("kill: invalid pid "..tostring(m).."\n")else local q,s if r<0 then q,s=syscalls["signal.killpg"](-r,f)else q,s=syscalls["signal.kill"](r,f)end if not q then b("kill: ("..tostring(m)..") "..tostring(s).."\n")end end end