local e=args or{}local k=(type(cwd)=="string"and cwd)or"/"local function l(u)u=u or""if u==""then return(k=="/")and"/"or k end if u:sub(1,1)=="/"then if u=="/"then return"/"end return u:gsub("/+$","")end local t=(k=="/")and""or k return(t.."/"..u):gsub("/+","/")end local function a(u)local t=io.stderr()if t and t.write then t:write(u)end end local b,c=false,false local h=nil local f={}local d=false local m=1 while m<=#e do local i=e[m]if d then f[#f+1]=i elseif i=="--"then d=true elseif i=="--parents"then b=true elseif i=="--verbose"then c=true elseif i:sub(1,2)=="--"and(i=="--mode"or i:sub(1,8)=="--mode=")then if i=="--mode"then m=m+1;if not e[m]then a("mkdir: option requires an argument -- 'm'\n");return end;h=tonumber(e[m],8)or nil else h=tonumber(i:sub(8),8)or nil end elseif i:sub(1,1)=="-"and i~="-"then local n=false for p=2,#i do local o=i:sub(p,p)if o=="p"then b=true elseif o=="v"then c=true elseif o=="m"then local j=i:sub(p+1)if j==""then m=m+1 if not e[m]then a("mkdir: option requires an argument -- 'm'\n");return end j=e[m]end h=tonumber(j,8)or nil n=true break else a("mkdir: invalid option -- '"..o.."'\n");return end end if n then end else f[#f+1]=i end m=m+1 end if#f==0 then a("mkdir: missing operand\n")return end local function g(t)if h and fs.chmod then pcall(fs.chmod,t,h)end end local function q(v)if fs.exists(v)then if not b then a("mkdir: "..v..": File exists\n")end return end if b then local t={}local w=v while w and w~="/"and w~=""do t[#t+1]=w local z=w:match("^(.*)/[^/]+$")w=z or"/"end for u=#t,1,-1 do if not fs.exists(t[u])then local b1,x=pcall(fs.makeDir,t[u])if not b1 then a("mkdir: "..t[u]..": "..tostring(x).."\n");return end g(t[u])if c then io.write("mkdir: created directory '"..t[u].."'\n")end end end else local a1,y=pcall(fs.makeDir,v)if not a1 then a("mkdir: "..v..": "..tostring(y).."\n");return end g(v)if c then io.write("mkdir: created directory '"..v.."'\n")end end end for s,r in ipairs(f)do q(l(r))end