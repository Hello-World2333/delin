local x=args or{}local v=(type(cwd)=="string"and cwd)or"/"local function p(n1)n1=n1 or""if n1==""then return"/"end if n1:sub(1,1)=="/"then local l1=n1:gsub("/+","/")local g1={}for j1 in l1:gmatch("[^/]+")do if j1=="."then elseif j1==".."then g1[#g1]=nil else g1[#g1+1]=j1 end end return"/"..table.concat(g1,"/")end local k1=(v=="/")and""or v local m1=(k1.."/"..n1):gsub("/+","/")local h1={}for i1 in m1:gmatch("[^/]+")do if i1=="."then elseif i1==".."then h1[#h1]=nil else h1[#h1+1]=i1 end end return"/"..table.concat(h1,"/")end local function d(h1)local g1=io.stderr()if g1 and g1.write then g1:write(h1)end end local function m(i1,g1)i1=tostring(i1)if i1:match("^%d+$")then return tonumber(i1)end if g1 then local h1=g1(i1)if h1 then return h1.uid or h1.gid end end return nil end local f,j,i,a=false,false,false,false local c=nil local b,l={},false for f1,q in ipairs(x)do if l then b[#b+1]=q elseif q=="--"then l=true elseif q=="-R"or q=="-r"or q=="--recursive"then f=true elseif q=="-v"or q=="--verbose"then j=true elseif q=="-c"or q=="--changes"then i=true elseif q=="-f"or q=="--silent"or q=="--quiet"then a=true elseif q:match("^%-%-reference=")then c=p(q:sub(#"--reference="+1))elseif q:sub(1,1)=="-"and q~="-"then for a1=2,#q do local t=q:sub(a1,a1)if t=="R"or t=="r"then f=true elseif t=="v"then j=true elseif t=="c"then i=true elseif t=="f"then a=true else if not a then d("chown: invalid option -- '"..t.."'\n")end return end end else b[#b+1]=q end end if c and not fs.exists(c)then if not a then d("chown: "..c..": No such file or directory\n")end return end local n,e if c then n=nil e=b else n=b[1]e={}for d1=2,#b do e[#e+1]=b[d1]end end if(not c and not n)or#e==0 then if not a then d("usage: chown [OPTION]... [OWNER][:[GROUP]] FILE...\n")end return end local g,k if c then local y=fs.attributes(c)g=(y and y.uid)or 0 k=(y and y.gid)or 0 else local o,r=n:match("^([^:]*):(.*)$")if o then if o~=""then local b1=m(o,syscalls and syscalls["user.get"]and function(h1)local g1=syscalls["user.get"](h1);if g1 then return{uid=g1.uid}end end)if not b1 then if not a then d("chown: invalid owner: '"..o.."'\n")end return end g=b1 end if r~=""then local z=m(r,syscalls and syscalls["user.groupByName"]and function(h1)local g1=syscalls["user.groupByName"](h1);if g1 then return{gid=g1.gid}end end)if not z then if not a then d("chown: invalid group: '"..r.."'\n")end return end k=z end else local c1=m(n,syscalls and syscalls["user.get"]and function(h1)local g1=syscalls["user.get"](h1);if g1 then return{uid=g1.uid}end end)if not c1 then if not a then d("chown: invalid owner: '"..n.."'\n")end return end g=c1 end end local function h(h1)local g1=fs.attributes(h1)local j1,i1=fs.chown(h1,g,k)if not j1 then if not a then d("chown: "..h1..": "..tostring(i1).."\n")end return end if not a and(j or(i and g1 and((g1.uid or 0)~=(g or 0)or(g1.gid or 0)~=(k or 0))))then d("ownership of '"..h1.."' changed\n")end end local function u(g1)if fs.isDir(g1)then h(g1)local i1=fs.list(g1)or{}table.sort(i1)for k1,j1 in ipairs(i1)do local h1=(g1=="/")and("/"..j1)or(g1.."/"..j1)if fs.isDir(h1)then u(h1)else h(h1)end end else h(g1)end end for e1,w in ipairs(e)do local s=p(w)if not fs.exists(s)then if not a then d("chown: "..w..": No such file or directory\n")end elseif f then u(s)else h(s)end end