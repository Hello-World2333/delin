local e1=args or{}local c1=(type(cwd)=="string"and cwd)or"/"local function o(t1)t1=t1 or""if t1==""then return"/"end if t1:sub(1,1)=="/"then local r1=t1:gsub("/+","/")local m1={}for p1 in r1:gmatch("[^/]+")do if p1=="."then elseif p1==".."then m1[#m1]=nil else m1[#m1+1]=p1 end end return"/"..table.concat(m1,"/")end local q1=(c1=="/")and""or c1 local s1=(q1.."/"..t1):gsub("/+","/")local n1={}for o1 in s1:gmatch("[^/]+")do if o1=="."then elseif o1==".."then n1[#n1]=nil else n1[#n1+1]=o1 end end return"/"..table.concat(n1,"/")end local function g(n1)local m1=io.stderr()if m1 and m1.write then m1:write(n1)end end local function f1(o1,p1)local n1=0 for q1,m1 in ipairs({4,2,1})do if(o1%(m1*2))>=m1 or(p1%(m1*2))>=m1 then n1=n1+m1 end end return n1 end local function y(o1,p1)local n1=0 for q1,m1 in ipairs({4,2,1})do if(o1%(m1*2))>=m1 and not((p1%(m1*2))>=m1)then n1=n1+m1 end end return n1 end local q={u=2,g=1,o=0}local t={r=4,w=2,x=1,X=1}local function i1(m1)return tonumber(m1,8)end local m=i1("644")local function x(n1,m1)return math.floor(n1/(8^m1))%8 end local function w(o1,n1,p1)local m1=8^n1 return o1-x(o1,n1)*m1+p1*m1 end local function a1(t1,q1)local m1,u1,p1=q1:match("^([ugoa]*)([%+%-%=])([rwxX]*)$")if not m1 then u1,p1=q1:match("^([%+%-%=])([rwxX]*)$")m1=u1 and"a"or nil if not u1 then return nil end end if m1==""then m1="a"end local n1={}for y1 in m1:gmatch(".")do if y1=="a"then n1={"u","g","o"}else n1[#n1+1]=y1 end end local s1=t1-(t1%512)local r1=t1%512 local o1=0 for a2 in p1:gmatch(".")do o1=o1+(t[a2]or 0)end for b2,w1 in ipairs(n1)do local x1=q[w1]local z1=x(r1,x1)local v1 if u1=="="then v1=o1 elseif u1=="+"then v1=f1(z1,o1)else v1=y(z1,o1)end r1=w(r1,x1,v1)end return s1+r1 end local function n(s1,r1,m1)if m1 then return m1 end local q1=tostring(r1):gsub("^0[oO]","")if q1:match("^[0-7]+$")then return tonumber(q1,8)end local n1=m local u1=fs.attributes(s1)if u1 and u1.mode then n1=u1.mode%4096 end local p1=n1 for o1 in tostring(r1):gmatch("[^,]+")do local t1=a1(p1,o1)if not t1 then return nil end p1=t1 end return p1 end local s={r=true,w=true,x=true,X=true,s=true,t=true,u=true,g=true,o=true,a=true,[","]=true,["+"]=true,["-"]=true,["="]=true,}local function r(m1)if m1:sub(1,1)~="-"or m1=="-"or m1:sub(1,2)=="--"then return false end for n1=2,#m1 do if s[m1:sub(n1,n1)]then return true end end return false end local f,k,j,b=false,false,false,false local c=nil local h={}local a,l={},false for l1,p in ipairs(e1)do if l then a[#a+1]=p elseif p=="--"then l=true elseif p=="-R"or p=="--recursive"then f=true elseif p=="-v"or p=="--verbose"then k=true elseif p=="-c"or p=="--changes"then j=true elseif p=="-f"or p=="--silent"or p=="--quiet"then b=true elseif p:match("^%-%-reference=")then c=o(p:sub(#"--reference="+1))elseif r(p)then h[#h+1]=p elseif p:sub(1,1)=="-"then for h1=2,#p do local z=p:sub(h1,h1)if z=="R"then f=true elseif z=="v"then k=true elseif z=="c"then j=true elseif z=="f"then b=true else if not b then g("chmod: invalid option -- '"..z.."'\n")end return end end else a[#a+1]=p end end if c and not fs.exists(c)then if not b then g("chmod: "..c..": No such file or directory\n")end return end local e,d if c then e=nil d=a elseif#h>0 then e=table.concat(h,",")d=a else e=a[1]d={}for j1=2,#a do d[#d+1]=a[j1]end end if(not c and not e)or#d==0 then if not b then g("usage: chmod [OPTION]... MODE FILE...\n")end return end local u if c then local g1=fs.attributes(c)u=(g1 and g1.mode and(g1.mode%4096))or m end local function i(m1)local o1=n(m1,e,u)if not o1 then if not b then g("chmod: "..m1..": invalid mode '"..tostring(e or c).."'\n")end return end local n1=fs.attributes(m1)local q1,p1=fs.chmod(m1,o1)if not q1 then if not b then g("chmod: "..m1..": "..tostring(p1).."\n")end return end if not b and(k or(j and n1 and n1.mode and(n1.mode%512~=o1%512)))then g("mode of '"..m1.."' changed\n")end end local function b1(m1)if fs.isDir(m1)then i(m1)local o1=fs.list(m1)or{}table.sort(o1)for q1,p1 in ipairs(o1)do local n1=(m1=="/")and("/"..p1)or(m1.."/"..p1)if fs.isDir(n1)then b1(n1)else i(n1)end end else i(m1)end end for k1,d1 in ipairs(d)do local v=o(d1)if not fs.exists(v)then if not b then g("chmod: "..d1..": No such file or directory\n")end elseif f then b1(v)else i(v)end end