local e=args or{}local function a(l1)local k1=io.stderr()if k1 and k1.write then k1:write(l1)end end local function f(k1)local l1=fs.open(k1,"r")if not l1 then return nil end local m1=l1.readAll()l1.close()return m1 end local function h(l1)local n1={}for k1 in l1:gmatch("[^\n]+")do local m1,o1=k1:match("^(%w+):%s*(.*)$")if m1 then n1[m1]=o1 end end return n1 end local function s()local k1=f("/proc/self/stat")if not k1 then return nil end return tonumber(k1:match("^(%d+)"))end local function k()local k1={}for o1,n1 in ipairs(fs.list("/proc")or{})do local m1=tonumber(n1)if m1 then local l1=f("/proc/"..m1.."/comm")if l1 then k1[#k1+1]={pid=m1,comm=(l1:gsub("\n$",""))}end end end table.sort(k1,function(p1,q1)return p1.pid<q1.pid end)return k1 end local function i(k1)local l1=tonumber(k1)if l1 then return l1 end local m1=syscalls and syscalls["user.get"]and syscalls["user.get"](k1)if not m1 then return nil end return m1.uid end local function b(k1)local l1=tostring(k1):gsub("^%-","")if l1:match("^%d+$")then return tonumber(l1)end if l1:match("^SIG")then l1=l1:sub(4)end return syscalls["signal.number"](l1)end local g=15 local v,w,d=false,false,nil local c={}local q=1 while q<=#e do local o=e[q]if o=="--"then for e1=q+1,#e do c[#c+1]=e[e1]end break elseif o:sub(1,2)=="--"then local z,n=o:match("^%-%-([%w-]+)=?(.*)$")if z=="signal"then if n==""then q=q+1;n=e[q]end if not n then a("killall: option '--signal' requires an argument\n");return 2 end g=b(n)if not g then a("killall: unknown signal "..n.."\n");return 2 end else a("killall: unrecognized option '"..o.."'\n")return 2 end elseif o:sub(1,1)=="-"and#o>1 then local t=2 while t<=#o do local y=o:sub(t,t)if y=="e"then v=true elseif y=="q"then w=true elseif y=="l"then local d1={}for i1,f1 in ipairs(syscalls["signal.list"]())do d1[#d1+1]=syscalls["signal.name"](f1)end io.write(table.concat(d1," ").."\n")return 0 elseif y=="s"then local l=o:sub(t+1)if l==""then q=q+1;l=e[q]end if not l then a("killall: option requires an argument -- 's'\n");return 2 end g=b(l)if not g then a("killall: unknown signal "..l.."\n");return 2 end t=#o elseif y=="u"then local m=o:sub(t+1)if m==""then q=q+1;m=e[q]end if not m then a("killall: option requires an argument -- 'u'\n");return 2 end d=i(m)if d==nil then a("killall: user '"..m.."' does not exist\n");return 2 end t=#o elseif y:match("%d")or y:match("%u")then g=b(o:sub(t))if not g then a("killall: unknown signal "..o:sub(t).."\n");return 2 end t=#o else a("killall: invalid option -- '"..y.."'\n")return 2 end t=t+1 end else c[#c+1]=o end q=q+1 end if#c==0 then a("usage: killall [-SIGNAL] [-e] [-q] [-u user] name...\n");return 2 end local self=s()local x=k()local j=0 for j1,u in ipairs(c)do local p=0 for h1,a1 in ipairs(x)do if a1.pid~=self and a1.comm==u then local r=true if d~=nil then local g1=h(f("/proc/"..a1.pid.."/status")or"")r=(tonumber(g1.Uid)or-1)==d end if r then local c1,b1=syscalls["signal.kill"](a1.pid,g)if c1 then p=p+1 if v then io.write(a1.comm.." killed (pid "..a1.pid..")\n")end else a("killall: "..a1.pid..": "..tostring(b1).."\n")end end end end if p==0 then if not w then a("killall: "..u..": no process found\n")end j=1 end end return j