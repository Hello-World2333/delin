local g=args or{}local function b(o)local n=io.stderr()if n and n.write then n:write(o)end end local c,a,e,f=nil,{},false,false local k=1 while k<=#g do local i=g[k]if e then a[#a+1]=i elseif i=="--"then e=true elseif i=="-a"or i=="--all"then f=true elseif i=="-t"then if not g[k+1]then b("mount: option requires an argument -- 't'\n");return end c=g[k+1]k=k+1 elseif i:match("^%-t.+")then c=i:sub(3)elseif i:match("^%-%-type=")then c=i:sub(8)elseif i:sub(1,1)=="-"and i~="-"then for m=2,#i do local l=i:sub(m,m)if l~="f"and l~="v"then b("mount: invalid option -- '"..l.."'\n");return end end else a[#a+1]=i end k=k+1 end local function h()local s=syscalls and syscalls["fs.mounts"]if not s then b("mount: fs.mounts syscall not available\n");return end local q=s()or{}local n={}for t,p in ipairs(q)do local r=p.device or((p.root=="/")and"rootfs"or"-")local o=r.." on "..p.root.." type "..(p.fstype or"?")..(p.ro and" (ro)"or" (rw)")if p.uuid then o=o.." uuid="..p.uuid end n[#n+1]=o end if#n==0 then n[#n+1]="(nothing mounted)"end io.write(table.concat(n,"\n").."\n")end local function j(o,p)if not fs.isDir(p)then b("mount: "..p..": No such file or directory\n")return end if not(syscalls and syscalls["fs.mount"])then b("mount: fs.mount syscall not available\n")return end local q,n=syscalls["fs.mount"](o,p,c)if not q then b("mount: "..tostring(n).."\n")return end n=n or{}io.write("mounted "..(n.device or o).." on "..p.." type "..(n.fstype or c or"?").."\n")end local function d()if not(syscalls and syscalls["fstab.entries"])then b("mount: fstab.entries syscall not available\n")return 1 end local o,r=syscalls["fstab.entries"]()if not o then b("mount: "..tostring(r).."\n")return 1 end local p={}for v,t in ipairs(syscalls["fs.mounts"]()or{})do p[t.root]=true end local s=0 for w,q in ipairs(o)do if q.opts.noauto then elseif c and q.fstype~=c then elseif p[q.mountpoint]then io.write(q.mountpoint..": already mounted\n")else if not fs.exists(q.mountpoint)then fs.makeDir(q.mountpoint)end local u,n=syscalls["fs.mount"](q.device,q.mountpoint,q.fstype)if u then n=n or{}io.write("mounted "..(n.device or q.device).." on "..q.mountpoint.." type "..(n.fstype or q.fstype).."\n")else b("mount: "..tostring(n).."\n")s=1 end end end return s end if f then return d()elseif#a==0 then h()elseif#a==1 then b("mount: "..a[1]..": missing mount point\n")elseif#a==2 then j(a[1],a[2])else b("mount: too many arguments\n")end