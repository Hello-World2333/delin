local e=args or{}local o=(type(cwd)=="string"and cwd)or"/"local function q(e1)e1=e1 or""if e1==""then return(o=="/")and"/"or o end if e1:sub(1,1)=="/"then if e1=="/"then return"/"end return e1:gsub("/+$","")end local d1=(o=="/")and""or o return(d1.."/"..e1):gsub("/+","/")end local function d(e1)local d1=io.stderr()if d1 and d1.write then d1:write(e1)end end local function t(d1)if d1 and(d1:find("permission")or d1:find("denied"))then return"Permission denied"end if d1 and d1:find("directory")then return"Is a directory"end return"No such file or directory"end local z,u=10,"lines"local b={}local i,f=false,false local c=false local function a(d1,f1)local e1=tonumber((d1:match("%s*%-?(%d+)"))or d1)if e1 and e1>=0 then z=e1;u=f1 end end local r=1 while r<=#e do local h=e[r]if c then b[#b+1]=h elseif h=="--"then c=true elseif h=="--quiet"or h=="--silent"then i=true elseif h=="--verbose"then f=true elseif h=="-q"then i=true elseif h=="-v"then f=true elseif h:sub(1,2)=="--"and h:match("^%-%-lines=")then a(h:sub(9),"lines")elseif h:sub(1,2)=="--"and h:match("^%-%-bytes=")then a(h:sub(9),"bytes")elseif h:sub(1,1)=="-"and h~="-"then local v=h:match("^%-n(.*)$")local n=h:match("^%-c(.*)$")local g=h:match("^%-(%d+)$")if v then if v==""then r=r+1 if not e[r]then d("head: option requires an argument -- 'n'\n");return end a(e[r],"lines")else a(v,"lines")end elseif n then if n==""then r=r+1 if not e[r]then d("head: option requires an argument -- 'c'\n");return end a(e[r],"bytes")else a(n,"bytes")end elseif g then a(g,"lines")else d("head: invalid option -- '"..h.."'\n")return end else b[#b+1]=h end r=r+1 end if#b==0 then b={"-"}end local x=#b local j=(not i)and(x>1 or f)local function m(d1)if not j then return end local e1=(d1=="-")and"standard input"or d1 io.write("==> "..e1.." <==\n")end local function l(f1)local e1=0 while e1<z do local d1=f1.readLine()if d1==nil then break end io.write(d1.."\n")e1=e1+1 end end local function k(i1)local d1=z if i1 and i1.read then local f1=false while d1>0 do local e1=i1.read(d1)if not e1 or e1==""then break end f1=true io.write(e1)d1=d1-#e1 end if f1 then return end end local g1={}while true do local h1=i1.readLine()if h1==nil then break end g1[#g1+1]=h1 end local j1=table.concat(g1,"\n")io.write(j1:sub(1,z))end local function s(d1)if u=="bytes"then k(d1)else l(d1)end end for b1,w in ipairs(b)do if w=="-"then m("-")local p=io.stdin()if p then s(p)end else local c1=q(w)local a1,y=fs.open(c1,"r")if not a1 then d("head: "..c1..": "..t(y).."\n")return end m(w)s(a1)a1.close()end end