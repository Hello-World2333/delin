local g=args or{}local function c(p)local o=io.stderr()if o and o.write then o:write(p)end end local a,b={},false for n,i in ipairs(g)do if b then a[#a+1]=i elseif i=="--"then b=true elseif i:sub(1,1)=="-"and i~="-"then c("blkid: invalid option -- '"..i:sub(2,2).."'\n")return else a[#a+1]=i end end local d=syscalls and syscalls["blkdev.list"]and syscalls["blkdev.list"]()if not d then c("blkid: blkdev.list syscall not available\n")return end local function h(o)local p=o:gsub("^/dev/","")for r,q in ipairs(d)do if q.name==p then return q end end return nil end local function e(p)local o={}if p.uuid then o[#o+1]='UUID="'..p.uuid..'"'end if p.fstype then o[#o+1]='TYPE="'..p.fstype..'"'end if p.label then o[#o+1]='LABEL="'..p.label..'"'end io.write(p.node..": "..table.concat(o," ").."\n")end if#a==0 then for l,k in ipairs(d)do e(k)end else for m,f in ipairs(a)do local j=h(f)if j then e(j)else c("blkid: "..f..": not a block device\n")end end end