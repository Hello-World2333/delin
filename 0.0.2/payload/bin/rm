local n=args or{}local k=(type(cwd)=="string"and cwd)or"/"local function l(t)t=t or""if t==""then return(k=="/")and"/"or k end if t:sub(1,1)=="/"then if t=="/"then return"/"end return t:gsub("/+$","")end local s=(k=="/")and""or k return(s.."/"..t):gsub("/+","/")end local function c(t)local s=io.stderr()if s and s.write then s:write(t)end end local b,g,a,f=false,false,false,false local e={}local d=false local function j(s)if s=="r"or s=="R"then b=true elseif s=="f"then g=true elseif s=="i"then a=true elseif s=="v"then f=true else c("rm: invalid option -- '"..s.."'\n");return false end return true end for r,m in ipairs(n)do if d then e[#e+1]=m elseif m=="--"then d=true elseif m=="--recursive"then b=true elseif m=="--force"then g=true elseif m=="--interactive"then a=true elseif m=="--verbose"then f=true elseif m:sub(1,1)=="-"and m~="-"then for p=2,#m do if not j(m:sub(p,p))then return end end else e[#e+1]=m end end if#e==0 then c("rm: missing operand\n")return end local function h(v,t)io.write("rm: remove "..(t and"directory "or"regular file ").."'"..v.."'? ")io.flush()local u=io.stdin()local s=u and u.readLine and u:readLine()or nil return s and s:match("^[yY]")end local function i(t)local s=fs.isDir(t)if s then for x,w in ipairs(fs.list(t)or{})do i(fs.combine(t,w))end end if a and not g then if not h(t,s)then return end end local v,u=pcall(fs.delete,t)if not v then c("rm: "..t..": "..tostring(u).."\n")elseif f then io.write("removed '"..t.."'\n")end end for q,o in ipairs(e)do o=l(o)if not fs.exists(o)then if not g then c("rm: "..o..": No such file or directory\n")end elseif fs.isDir(o)and not b then c("rm: "..o..": Is a directory\n")else i(o)end end