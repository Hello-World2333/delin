local r=args or{}local function u(a3)local z2=io.stderr()if z2 and z2.write then z2:write(a3)end end local function c(z2)local a3=fs.open(z2,"r")if not a3 then return nil end local b3=a3.readAll()a3.close()return b3 end local function r1(z2)if not z2 or z2==""then return nil end local a3,c3={},0 for b3=1,#z2 do local e3=z2:byte(b3)c3=c3+1 a3[c3]=(e3==0)and" "or z2:sub(b3,b3)end local d3=table.concat(a3,""):gsub("%s+$","")if d3==""then return nil end return d3 end local function l(a3)local c3={}for z2 in a3:gmatch("[^\n]+")do local b3,d3=z2:match("^(%w+):%s*(.*)$")if b3 then c3[b3]=d3 end end return c3 end local function s(f3)local a3,b3,h3,d3,c3,e3,g3,z2=f3:match("^(%d+) %((.*)%) (%a+) (%d+) (%d+) (%d+) (%S+) (%-?%d+)")if not a3 then return nil end return{pid=tonumber(a3),comm=b3,state=h3,ppid=tonumber(d3),pgrp=tonumber(c3),sess=tonumber(e3),tty=g3,tpgid=tonumber(z2),}end local function i1(z2)if z2=="?"then return"0"end local a3=z2:match("^/dev/(.+)$")or z2 if a3:match("^%d+$")then return"tty"..a3 end return a3 end local function f1(a3)local z2=syscalls and syscalls["user.byUid"]local b3=z2 and z2(a3)return(b3 and b3.name)or tostring(a3)end local function c1(a3)local z2=syscalls and syscalls["user.groupByGid"]local b3=z2 and z2(a3)return(b3 and b3.name)or tostring(a3)end local i={selAll=false,selA=false,selX=false,posixA=false,format=nil,fields={},pids={},ttys={},users={},noHeaders=false,}local function a(z2,a3)for b3 in tostring(a3):gmatch("[^,%s]+")do z2[#z2+1]=b3 end end local function w(z2)for a3 in tostring(z2):gmatch("[^,%s]+")do i.fields[#i.fields+1]=a3 end end local function b(z2)u("ps: "..z2.."\n")end local k1=1 while k1<=#r do local m1=r[k1]if m1=="--"then if r[k1+1]then b("unexpected operand: "..r[k1+1]);return 2 end break elseif m1:sub(1,2)=="--"then local j,y=m1:match("^%-%-([%w%-]+)=?(.*)$")if j=="no-headers"then i.noHeaders=true elseif j=="pid"or j=="tty"or j=="user"then if y==""then k1=k1+1;y=r[k1]end if not y then b("option '--"..j.."' requires an argument");return 2 end if j=="pid"then a(i.pids,y)elseif j=="tty"then a(i.ttys,y)else a(i.users,y)end else b("unrecognized option '--"..tostring(j).."'");return 2 end elseif m1:sub(1,1)=="-"and#m1>1 then local v1=2 while v1<=#m1 do local b1=m1:sub(v1,v1)if b1=="e"or b1=="A"then i.selAll=true elseif b1=="a"then i.selA=true;i.posixA=true elseif b1=="x"then i.selX=true elseif b1=="f"then i.format="full"elseif b1=="l"then i.format="long"elseif b1=="h"then i.noHeaders=true elseif b1=="p"or b1=="t"or b1=="u"or b1=="U"or b1=="o"then local v=m1:sub(v1+1)if v==""then k1=k1+1;v=r[k1]end if not v then b("option requires an argument -- '"..b1.."'");return 2 end if b1=="p"then a(i.pids,v)elseif b1=="t"then a(i.ttys,v)elseif b1=="o"then w(v)else a(i.users,v)end v1=#m1 else b("invalid option -- '"..b1.."'");return 2 end v1=v1+1 end else for e2=1,#m1 do local u1=m1:sub(e2,e2)if u1=="a"then i.selA=true elseif u1=="x"then i.selX=true elseif u1=="u"then i.format="user"elseif u1=="e"then i.selAll=true elseif u1=="f"then i.format="full"elseif u1=="l"then i.format="long"else b("invalid option -- '"..u1.."'");return 2 end end end k1=k1+1 end local m if i.selAll or(i.selA and i.selX)or#i.pids>0 or#i.ttys>0 or#i.users>0 then m="all"elseif i.selA then m="alltty"elseif i.selX then m="anytty"else m="default"end local t=c("/proc/self/stat")local p=c("/proc/self/status")if not t or not p then u("ps: cannot read /proc/self\n")return 1 end local self=s(t)if not self then u("ps: malformed /proc/self/stat\n")return 1 end local x=tonumber(l(p).Uid)or 0 local a1={}for t2,j2 in ipairs(fs.list("/proc")or{})do local t1=tonumber(j2)if t1 then a1[#a1+1]=t1 end end table.sort(a1)local d1={}for y2,h1 in ipairs(a1)do local a2=c("/proc/"..h1.."/stat")local n=a2 and s(a2)if n then local h2=l(c("/proc/"..h1.."/status")or"")d1[#d1+1]={pid=h1,comm=n.comm,state=n.state,ppid=n.ppid,pgrp=n.pgrp,sess=n.sess,tty=n.tty,uid=tonumber(h2.Uid)or 0,gid=tonumber(h2.Gid)or 0,cmd=r1(c("/proc/"..h1.."/cmdline")),}end end local f,g,h if#i.pids>0 then f={}for q2,g2 in ipairs(i.pids)do local f2=tonumber(g2)if not f2 then b("invalid process id: "..g2);return 2 end f[f2]=true end end if#i.ttys>0 then g={}for w2,p2 in ipairs(i.ttys)do g[i1(p2)]=true end end if#i.users>0 then h={}for u2,d2 in ipairs(i.users)do local c2=tonumber(d2)if not c2 then local i2=syscalls and syscalls["user.get"]and syscalls["user.get"](d2)if not i2 then b("user '"..d2.."' does not exist");return 2 end c2=i2.uid end h[c2]=true end end local j1=self.tty local e1={}for r2,q1 in ipairs(d1)do local e if m=="all"then e=true elseif m=="alltty"then e=q1.tty~="0"and not(i.posixA and q1.pid==q1.sess)elseif m=="anytty"then e=q1.uid==x else e=q1.uid==x and q1.tty==j1 end if e and f and not f[q1.pid]then e=false end if e and g and not g[q1.tty]then e=false end if e and h and not h[q1.uid]then e=false end if e then e1[#e1+1]=q1 end end local l1={pid={header="PID",get=function(z2)return tostring(z2.pid)end},ppid={header="PPID",get=function(z2)return tostring(z2.ppid)end},pgrp={header="PGRP",get=function(z2)return tostring(z2.pgrp)end},pgid={header="PGID",get=function(z2)return tostring(z2.pgrp)end},sess={header="SESS",get=function(z2)return tostring(z2.sess)end},session={header="SESS",get=function(z2)return tostring(z2.sess)end},uid={header="UID",get=function(z2)return tostring(z2.uid)end},user={header="USER",get=function(z2)return f1(z2.uid)end},gid={header="GID",get=function(z2)return tostring(z2.gid)end},group={header="GROUP",get=function(z2)return c1(z2.gid)end},stat={header="STAT",get=function(z2)return z2.state end},state={header="STAT",get=function(z2)return z2.state end},tty={header="TTY",get=function(z2)return z2.tty=="0"and"?"or z2.tty end},comm={header="COMMAND",get=function(z2)return z2.comm end},cmd={header="COMMAND",get=function(z2)return z2.cmd or("["..z2.comm.."]")end},args={header="COMMAND",get=function(z2)return z2.cmd or("["..z2.comm.."]")end},cwd={header="CWD",get=function(a3)local z2=c("/proc/"..a3.pid.."/cwd")if not z2 then return"?"end return(z2:gsub("\n$",""))end},}local k if#i.fields>0 then k=i.fields elseif i.format=="long"then k={"stat","uid","pid","ppid","pgrp","sess","tty","cmd"}elseif i.format=="full"then k={"uid","pid","ppid","stat","tty","cmd"}elseif i.format=="user"then k={"user","pid","ppid","stat","tty","cmd"}else k={"pid","tty","stat","cmd"}end local z={}for n2,o1 in ipairs(k)do local n1=l1[o1]if not n1 then b("unknown column: "..o1);return 2 end z[n2]={header=n1.header,get=n1.get}end local d={}for v2,o2 in ipairs(e1)do local p1={}for l2,y1 in ipairs(z)do p1[l2]=y1.get(o2)end d[#d+1]=p1 end local q={}for m2,x1 in ipairs(z)do q[m2]=#x1.header end for x2,g1 in ipairs(d)do for b2=1,#g1 do if#g1[b2]>q[b2]then q[b2]=#g1[b2]end end end local function o(a3)local z2={}for b3,c3 in ipairs(a3)do if b3==#a3 then z2[b3]=c3 else z2[b3]=c3..string.rep(" ",q[b3]-#c3)end end io.write(table.concat(z2," ").."\n")end if not i.noHeaders then local s1={}for k2,z1 in ipairs(z)do s1[k2]=z1.header end o(s1)end for s2,w1 in ipairs(d)do o(w1)end if#d==0 then return 1 end