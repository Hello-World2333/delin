local a1=args or{}local r=(type(cwd)=="string"and cwd)or"/"local function v(k1)k1=k1 or""if k1==""then return(r=="/")and"/"or r end if k1:sub(1,1)=="/"then if k1=="/"then return"/"end return k1:gsub("/+$","")end local j1=(r=="/")and""or r return(j1.."/"..k1):gsub("/+","/")end local function p(k1)local j1=io.stderr()if j1 and j1.write then j1:write(k1)end end local function x(j1)if j1 and(j1:find("permission")or j1:find("denied"))then return"Permission denied"end if j1 and j1:find("directory")then return"Is a directory"end return"No such file or directory"end local m,n,l,s,e=false,false,false,false,false local b={}local f=false local function q(j1)if j1=="l"then m=true elseif j1=="w"then n=true elseif j1=="c"then l=true elseif j1=="m"then s=true elseif j1=="L"then e=true else p("wc: invalid option -- '"..j1.."'\n");return false end return true end for i1,w in ipairs(a1)do if f then b[#b+1]=w elseif w=="--"then f=true elseif w=="--lines"then m=true elseif w=="--words"then n=true elseif w=="--bytes"then l=true elseif w=="--chars"then s=true elseif w=="--max-line-length"then e=true elseif w:sub(1,1)=="-"and w~="-"then for f1=2,#w do if not q(w:sub(f1,f1))then return end end else b[#b+1]=w end end if not(m or n or l or s or e)then m,n,l=true,true,true end local function d(k1)local j1=0;for l1 in k1:gmatch("%S+")do j1=j1+1 end;return j1 end local function i(m1)local l1,j1=0,1 while j1<=#m1 do l1=l1+1 local k1=m1:byte(j1)if k1<0xC0 then j1=j1+1 elseif k1<0xE0 then j1=j1+2 elseif k1<0xF0 then j1=j1+3 elseif k1<0xF8 then j1=j1+4 elseif k1<0xFC then j1=j1+5 else j1=j1+6 end end return l1 end local function o(k1,l1)local j1={}if m then j1[#j1+1]=tostring(l1.l)end if n then j1[#j1+1]=tostring(l1.w)end if l then j1[#j1+1]=tostring(l1.c)end if s then j1[#j1+1]=tostring(l1.m)end if e then j1[#j1+1]=tostring(l1.lmax)end if k1 then j1[#j1+1]=k1 end io.write(table.concat(j1," ").."\n")end local function c(j1)local m1=0 for n1 in j1:gmatch("\n")do m1=m1+1 end local k1=0 for l1 in(j1.."\n"):gmatch("(.-)\n")do if#l1>k1 then k1=#l1 end end return{l=m1,w=d(j1),c=#j1,m=i(j1),lmax=k1}end local function k(k1)local o1,m1,l1=0,0,table.concat(k1,"\n")for p1,n1 in ipairs(k1)do o1=o1+d(n1)if#n1>m1 then m1=#n1 end end local j1=math.max(0,#k1-1)return{l=#k1,w=o1,c=#l1+j1,m=i(l1)+j1,lmax=m1}end if#b==0 then b={"-"}end local a={l=0,w=0,c=0,m=0,lmax=0}local b1=#b>1 for h1,d1 in ipairs(b)do local z=d1 local h if d1=="-"then local g=io.stdin()if not g then return end if g.readAll then local t=g.readAll()or""h=c(t)else local j={}while true do local y=g.readLine()if y==nil then break end j[#j+1]=y end h=k(j)end z=nil else local g1=v(d1)local e1,c1=fs.open(g1,"r")if not e1 then p("wc: "..g1..": "..x(c1).."\n")return end local u=e1.readAll()or""e1.close()h=c(u)end o(z,h)a.l=a.l+h.l a.w=a.w+h.w a.c=a.c+h.c a.m=a.m+h.m if h.lmax>a.lmax then a.lmax=h.lmax end end if b1 then o("total",a)end