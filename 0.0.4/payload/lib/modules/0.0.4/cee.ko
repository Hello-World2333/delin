--@name cee
--@version 0.1.0
--@description CEE:CC (CEECC) platform driver: /sys/class/power/supply (the machine's own feed) and
--@deps
local e=require("kernel.platform")local b="supply"local i={"present","voltage","current","power","max_power","headroom","state","reset"}local l={"data","ports","powered","peripheral","peripheral_type"}local j={"analog_in","analog_out","digital_out"}local a=nil local function f()return e.cee end local function c(n)return n and"1"or"0"end local function g(o,p,q)local n=tostring(o)local r=n:match("^%d+$")and tonumber(n)or nil if not r or r>p then return nil,"invalid "..q..": '"..n.."' (expected decimal integer 0.."..p..")"end return r end local function h(n)return tonumber(n:match("^pin(%d+)$"))end local function d(n)if not n then return nil end local o=f().getSignalCount()if n<1 or n>o then return nil end return n end local k={list=function()return{b}end,attrs=function(n)if n~=b then return nil end return i end,get=function(p,n)local o=f()if n=="present"then return c(o.hasPower())end if n=="voltage"then return tostring(o.getPowerVoltage())end if n=="current"then return tostring(o.getSupplyCurrent())end if n=="power"then return tostring(o.getDeliveredPower())end if n=="max_power"then return tostring(o.getMaxPower())end if n=="headroom"then return tostring(o.getPowerHeadroom())end if n=="state"then return tostring(o.getSupplyState())end if n=="reset"then return""end return nil end,writable=function(n,o)if n~=b then return false end return o=="reset"end,set=function(p,o,n)if o~="reset"then return nil,"no such attribute: "..tostring(o)end if n~="1"then return nil,"invalid reset: '"..n.."' (write 1 to clear a tripped supply)"end f().resetSupply()return true end,}local m={list=function()local n={}for o=1,f().getSignalCount()do n[#n+1]="pin"..o end return n end,attrs=function(o)local p=d(h(o))if not p then return nil end local n={}for t,q in ipairs(l)do n[#n+1]=q end if f().getPortCount(p)>0 then for s,r in ipairs(j)do n[#n+1]=r end end return n end,get=function(p,n)local o=d(h(p))if not o then return nil end local q=f()if n=="data"then return c(q.isDataPin(o))end if n=="ports"then return tostring(q.getPortCount(o))end if n=="powered"then return c(q.isPortPowered(o))end if n=="peripheral"then return c(q.hasPeripheral(o))end if n=="peripheral_type"then return tostring(q.getPeripheralType(o)or"")end if n=="analog_in"then return tostring(q.getAnalog(o))end if n=="analog_out"then return tostring(q.getAnalogOutput(o))end if n=="digital_out"then return c(q.getOutput(o))end return nil end,writable=function(n,o)if not d(h(n))then return false end return(o=="analog_out"or o=="digital_out")and f().getPortCount(h(n))>0 end,set=function(p,o,q)local n=d(h(p))if not n then return nil,"no such pin: "..tostring(p)end if f().getPortCount(n)==0 then return nil,"no signal port on pin "..n end if o=="analog_out"then local t,s=g(q,15,"analog_out")if not t then return nil,s end f().setAnalog(n,t)return true end if o=="digital_out"then local u,r=g(q,1,"digital_out")if not u then return nil,r end f().setOutput(n,u==1)return true end return nil,"no such attribute: "..tostring(o)end,}return{init=function(p)if e.detect()~="cee"then p.log("cee: not a CEE:CC computer (platform="..tostring(e.kind).."), nothing registered")return end a=p p.registerSysfsClass("power",k)p.registerSysfsClass("pin",m)local q,o,n=e.pins(),0,0 for s,r in ipairs(q)do if r.ports>0 then o=o+1 end if r.has then n=n+1 end end p.log("cee: /sys/class/power/supply + /sys/class/pin registered ("..#q.." pins, "..o.." with ports, "..n.." with a peripheral)")end,exit=function()if not a then return end a.unregisterSysfsClass("power")a.unregisterSysfsClass("pin")a=nil end,}