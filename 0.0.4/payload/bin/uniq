local b1=args or{}local l1=(type(cwd)=="string"and cwd)or"/"local function g1(c2)c2=c2 or""if c2==""then return(l1=="/")and"/"or l1 end if c2:sub(1,1)=="/"then if c2=="/"then return"/"end return c2:gsub("/+$","")end local b2=(l1=="/")and""or l1 return(b2.."/"..c2):gsub("/+","/")end local function a(c2)local b2=io.stderr()if b2 and b2.write then b2:write(c2)end end local function i1(b2)if b2 and(b2:find("permission")or b2:find("denied"))then return"Permission denied"end if b2 and b2:lower():find("no such file")then return"No such file or directory"end if b2 and b2:find("directory")then return"Is a directory"end return"No such file or directory"end local l,x,t=true,true,false local e,s,f=false,false,false local g,h,d=0,0,nil local p,r=false,false local b={}local a1=false local function n(b2,c2)local d2=tonumber(b2)if not d2 or d2<0 or d2~=math.floor(d2)then a("uniq: invalid number of "..c2..": '"..tostring(b2).."'\n")return nil end return d2 end local n1=1 while n1<=#b1 do local o=b1[n1]if a1 then b[#b+1]=o elseif o=="--"then a1=true elseif o=="-c"or o=="--count"then t=true elseif o=="-D"or o=="--all-repeated"or(o:match("^%-%-all%-repeated=")~=nil)then e=true local x1=o:match("^%-%-all%-repeated=(.*)$")if x1 and x1~="none"then a("uniq: option '--all-repeated' only supports 'none' in Delin\n")return 2 end elseif o=="--group"or(o:match("^%-%-group=")~=nil)then local t1=o:match("^%-%-group=(.*)$")or"separate"if t1=="append"then f=true elseif t1=="separate"or t1=="both"or t1=="prepend"then s=true else a("uniq: invalid argument '"..t1.."' for '--group'\n");return 2 end elseif o=="-d"or o=="--repeated"then l=false elseif o=="-u"or o=="--unique"then x=false elseif o=="-i"or o=="--ignore-case"then p=true elseif o=="-z"or o=="--zero-terminated"then r=true elseif o=="--skip-fields"or o=="--skip-chars"or o=="--check-chars"then local d1=o:sub(3)n1=n1+1 if not b1[n1]then a("uniq: option '--"..d1.."' requires an argument\n");return 1 end local u1=n(b1[n1],d1)if u1==nil then return 1 end if d1=="skip-fields"then g=u1 elseif d1=="skip-chars"then h=u1 else d=u1 end elseif o:match("^%-%-skip%-fields=")then local z1=n(o:sub(15),"fields");if z1==nil then return 1 end;g=z1 elseif o:match("^%-%-skip%-chars=")then local a2=n(o:sub(14),"chars");if a2==nil then return 1 end;h=a2 elseif o:match("^%-%-check%-chars=")then local y1=n(o:sub(15),"chars");if y1==nil then return 1 end;d=y1 elseif o:sub(1,1)=="-"and o~="-"and o:sub(1,2)~="--"then local j1=2 while j1<=#o do local z=o:sub(j1,j1)if z=="c"then t=true;j1=j1+1 elseif z=="D"then e=true;j1=j1+1 elseif z=="d"then l=false;j1=j1+1 elseif z=="u"then x=false;j1=j1+1 elseif z=="i"then p=true;j1=j1+1 elseif z=="z"then r=true;j1=j1+1 elseif z=="f"or z=="s"or z=="w"then local q1=o:sub(j1+1)if q1==""then n1=n1+1 if not b1[n1]then a("uniq: option requires an argument -- '"..z.."'\n");return 1 end q1=b1[n1]end local v1=n(q1,z)if v1==nil then return 1 end if z=="f"then g=v1 elseif z=="s"then h=v1 else d=v1 end j1=#o+1 else a("uniq: invalid option -- '"..z.."'\n")return 1 end end elseif o:sub(1,2)=="--"then a("uniq: unrecognized option '"..o.."'\n")return 1 else b[#b+1]=o end n1=n1+1 end if#b>2 then a("uniq: extra operand '"..b[3].."'\n")return 1 end local function h1(b2)return function()return b2:readLine()end end local function k1(d2)if not d2.readAll then a("uniq: -z requires a readAll handle (host testbed stdin does not support it)\n")return nil end local b2=d2:readAll()or""local c2,e2=1,#b2 return function()if c2>e2 then return nil end local f2=b2:find("\0",c2,true)if not f2 then local g2=b2:sub(c2);c2=e2+1;return g2 end local h2=b2:sub(c2,f2-1)c2=f2+1 return h2 end end local function m1(c2)if g>0 then local b2=1 for f2=1,g do local d2=c2:find("[^ \t]",b2)if not d2 then b2=#c2+1;break end local e2=c2:find("[ \t]",d2)b2=e2 or(#c2+1)end c2=c2:sub(b2)end if h>0 then c2=c2:sub(h+1)end if d~=nil then c2=c2:sub(1,d)end if p then c2=c2:lower()end return c2 end local m,c1=b[1],b[2]local f1 if m==nil or m=="-"then f1=io.stdin()if not f1 then a("uniq: cannot read stdin\n");return 1 end else local s1 f1,s1=fs.open(g1(m),"r")if not f1 then a("uniq: "..m..": "..i1(s1).."\n")return 1 end end local j if r then j=k1(f1)if not j then return 1 end else j=h1(f1)end local w,e1=io.stdout(),false if c1 then local r1 w,r1=fs.open(g1(c1),"w")if not w then a("uniq: "..c1..": "..i1(r1).."\n")return 1 end e1=true end local p1=r and"\0"or"\n"local i=true local k,q,u=nil,nil,0 local c={}local function y(c2,d2,b2)if b2 and t then w:write(string.format("%7d ",d2))end w:write(c2..p1)end local function o1(f2,d2,e2,b2)if f2==nil then return end local c2=e2>1 if e then if not c2 then i=false;return end for j2,h2 in ipairs(b2)do y(h2,e2,false)end return end if s or f then if not i then if s then w:write(p1)end end for i2,g2 in ipairs(b2)do y(g2,e2,true)end if f and not i then w:write(p1)end i=false return end if c2 and not x then return end if(not c2)and not l then return end y(d2,e2,true)end while true do local v=j()if v==nil then break end local w1=m1(v)if k==nil then k,q,u=w1,v,1 c={v}elseif w1==k then u=u+1 c[#c+1]=v else o1(k,q,u,c)k,q,u=w1,v,1 c={v}end end o1(k,q,u,c)if e1 then w:close()end if m~=nil and m~="-"then f1:close()end