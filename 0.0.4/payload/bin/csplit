local f1=args or{}local o1=(type(cwd)=="string"and cwd)or"/"local function e1(y1)y1=y1 or""if y1==""then return(o1=="/")and"/"or o1 end if y1:sub(1,1)=="/"then if y1=="/"then return"/"end return y1:gsub("/+$","")end local x1=(o1=="/")and""or o1 return(x1.."/"..y1):gsub("/+","/")end local function b(y1)local x1=io.stderr()if x1 and x1.write then x1:write(y1)end end local function k1(x1)if x1 and(x1:find("permission")or x1:find("denied"))then return"Permission denied"end if x1 and x1:lower():find("no such file")then return"No such file or directory"end if x1 and x1:find("directory")then return"Is a directory"end return"No such file or directory"end local b1="xx"local g=2 local n1,c1,h1=false,false,false local a={}local p=false local s1=1 while s1<=#f1 do local w=f1[s1]if p then a[#a+1]=w elseif w=="--"then p=true elseif w=="-k"or w=="--keep-files"then n1=true elseif w=="-s"or w=="-q"or w=="--quiet"or w=="--silent"then c1=true elseif w=="-z"or w=="--elide-empty-files"then h1=true elseif w:match("^%-%-prefix=")then b1=w:sub(10)elseif w:match("^%-%-digits=")then g=tonumber(w:sub(10))if not g or g<1 then b("csplit: invalid number: '"..w:sub(10).."'\n");return 1 end elseif w:sub(1,1)=="-"and w~="-"and w:sub(1,2)~="--"then local p1=2 while p1<=#w do local g1=w:sub(p1,p1)if g1=="k"then n1=true;p1=p1+1 elseif g1=="s"or g1=="q"then c1=true;p1=p1+1 elseif g1=="z"then h1=true;p1=p1+1 elseif g1=="f"or g1=="n"then local m1=w:sub(p1+1)if m1==""then s1=s1+1 if not f1[s1]then b("csplit: option requires an argument -- '"..g1.."'\n");return 1 end m1=f1[s1]end if g1=="f"then b1=m1 else g=tonumber(m1)if not g or g<1 then b("csplit: invalid number: '"..m1.."'\n");return 1 end end p1=#w+1 else b("csplit: invalid option -- '"..g1.."'\n")return 1 end end elseif w:sub(1,2)=="--"then b("csplit: unrecognized option '"..w.."'\n")return 1 else a[#a+1]=w end s1=s1+1 end if#a<1 then b("csplit: missing operand\n")return 1 end local m=a[1]if#a<2 then b("csplit: missing operand after '"..m.."'\n")return 1 end local r1 if m=="-"then r1=io.stdin()if not r1 then b("csplit: cannot read stdin\n");return 1 end else local q1 r1,q1=fs.open(e1(m),"r")if not r1 then b("csplit: cannot open '"..m.."' for reading: "..k1(q1).."\n")return 1 end end local i=""do local y={}if r1.readAll then y[1]=r1:readAll()or""else while true do local u1=r1:readLine()if u1==nil then break end y[#y+1]=u1.."\n"end end i=table.concat(y)end if m~="-"then r1:close()end local j={}do local l1=1 while l1<=#i do local t1=i:find("\n",l1,true)if not t1 then j[#j+1]=i:sub(l1);break end j[#j+1]=i:sub(l1,t1)l1=t1+1 end end local s={}local o=0 local function d1()if n1 then return end for y1,x1 in ipairs(s)do fs.delete(x1)end end local function i1(x1)d1()b(x1)return 1 end local function e(b2,d2)local x1={}for e2=b2,d2 do x1[#x1+1]=j[e2]end local z1=table.concat(x1)if#z1==0 and h1 then return true end local y1=b1..string.format("%0"..g.."d",o)o=o+1 local a2,c2=fs.open(e1(y1),"w")if not a2 then d1()b("csplit: "..y1..": "..k1(c2).."\n")return false end a2:write(z1)a2:close()s[#s+1]=y1 if not c1 then io.write(#z1.."\n")end return true end local l=syscalls and syscalls["regex.compile"]local function u(x1)if not l then b("csplit: regex syscall not available\n");return nil end local z1,y1=l(x1,"bre")if not z1 then b("csplit: invalid regular expression ("..tostring(y1).."): "..x1.."\n")return nil end return z1 end local function a1(arg)local a2=arg:match("^/(.*)/$")if a2 then local y1=u(a2)if not y1 then return nil end return{kind="re",pat=a2,re=y1,offset=0}end local z1,b2=arg:match("^/(.*)/([%+%-]%d+)$")if z1 then local x1=u(z1)if not x1 then return nil end return{kind="re",pat=z1,re=x1,offset=tonumber(b2)}end if arg:match("^/")then b("csplit: '"..arg.."': integer expected after delimiter\n")return nil end local c2=tonumber(arg)if c2 then if c2<0 then b("csplit: "..arg..": line number must be greater than zero\n");return nil end if c2==0 then b("csplit: "..arg..": line number must be greater than zero\n");return nil end return{kind="line",num=c2}end b("csplit: '"..arg.."': invalid pattern\n")return nil end local n=1 local k=#j local f=2 while f<=#a do local v=a1(a[f])if not v then return i1("")end local h,t=false,0 local d=f+1 if d<=#a then local w1=a[d]:match("^{(%d+)}$")if a[d]=="{*}"then h=true;d=d+1 elseif w1 then t=tonumber(w1);d=d+1 end end local r=n local z=1 if h then z=math.huge elseif t>0 then z=t+1 end for q=1,z do local c if v.kind=="line"then if q==1 then c=v.num else c=n+v.num end else local x=nil for v1=r,k do local j1=j[v1]if j1:sub(-1)=="\n"then j1=j1:sub(1,-2)end if v.re:find(j1)then x=v1;break end end if not x then if h and q>1 then break end if h then break end if q>1 then return i1("csplit: '"..a[f].."': match not found on repetition "..(q-1).."\n")end return i1("csplit: '"..a[f].."': match not found\n")end r=x+1 c=x+v.offset if c<n then c=n end end if v.kind=="line"and c>k then if not e(n,k)then return 1 end return i1("csplit: '"..a[f].."': line number out of range\n")end if c>k then if not e(n,k)then return 1 end n=k+1 break end if not e(n,c-1)then return 1 end n=c if v.kind=="line"and q==z then break end end f=d end if not e(n,k)then return 1 end