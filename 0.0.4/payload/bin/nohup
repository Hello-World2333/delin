local f=args or{}local h=(type(cwd)=="string"and cwd)or"/"local function g(f1)f1=f1 or""if f1==""then return(h=="/")and"/"or h end if f1:sub(1,1)=="/"then if f1=="/"then return"/"end return f1:gsub("/+$","")end local e1=(h=="/")and""or h return(e1.."/"..f1):gsub("/+","/")end local function c(f1)local e1=io.stderr()if e1 and e1.write then e1:write(f1)end end local a={}local t=1 while t<=#f do local u=f[t]if u=="--"then t=t+1 for b1=t,#f do a[#a+1]=f[b1]end break elseif u:sub(1,1)=="-"and u~="-"and#u>1 then c("nohup: invalid option -- '"..u:sub(2,2).."'\n")return 125 else for d1=t,#f do a[#a+1]=f[d1]end break end end if#a==0 then c("nohup: missing operand\n")return 125 end local p=a[1]local j={}for c1=2,#a do j[#j+1]=a[c1]end local i=io.stdout()local l=io.stdin()local e=nil local b=nil if i and i.isTTY==true then local n="nohup.out"local y,x=pcall(fs.open,g("nohup.out"),"a")if not y or not x then local s=getenv("HOME")or"/root"local z=g(s).."/nohup.out"local a1,w=fs.open(z,"a")if not a1 then c("nohup: failed to open '"..z.."': "..tostring(w).."\n")return 125 end n,x=z,a1 end b=x e={output=x}c("nohup: ignoring input and appending output to '"..n.."'\n")end if l and l.isTTY==true then local q=fs.open("/dev/null","r")if not q then c("nohup: cannot open '/dev/null'\n")return 125 end e=e or{}e.input=q end local o={cwd=h,env=env,sigIgnore={[1]=true}}if e then o.stdio=e end local r,v=syscalls["proc.exec"](p,j,o)if not r then local m=126 local d=tostring(v)if d:find("command not found")then m=127 d="No such file or directory"elseif d:find("permission denied")then d="Permission denied"end c("nohup: failed to run command '"..p.."': "..d.."\n")return m end local k=syscalls["proc.wait"](r)if b and b.flush then b:flush()end if k<0 then return 128+(-k)end return k