local y=args or{}local c1=(type(cwd)=="string"and cwd)or"/"local function d(p1)p1=p1 or""if p1==""then return(c1=="/")and"/"or c1 end if p1:sub(1,1)=="/"then if p1=="/"then return"/"end return p1:gsub("/+$","")end local o1=(c1=="/")and""or c1 return(o1.."/"..p1):gsub("/+","/")end local function c(p1)local o1=io.stderr()if o1 and o1.write then o1:write(p1)end end local function q(p1)local o1=fs.lstat(p1)if not o1 then return nil end if o1.kind=="symlink"then return o1 end if fs.exists(p1)then return o1 end return nil end local function j(o1)o1=(type(o1)=="string"and o1)or""o1=o1:gsub("/+$","")return(o1:match("([^/]+)$"))or o1 end local o,t,r,l,s=false,false,false,false,false local a={}local u=false local n,g=false,false local f=false local b=nil local function b1(o1)if o1=="s"then o=true elseif o1=="f"then t=true elseif o1=="n"then r=true elseif o1=="T"then l=true elseif o1=="v"then s=true elseif o1=="r"then n=true elseif o1=="i"then g=true elseif o1=="L"then f=true elseif o1=="P"then f=false elseif o1=="t"then return true else c("ln: invalid option -- '"..o1.."'\n");return false end return true end local z=0 while z<#y do z=z+1 local v=y[z]if u then a[#a+1]=v elseif v=="--"then u=true elseif v=="--symbolic"then o=true elseif v=="--force"then t=true elseif v=="--no-dereference"then r=true elseif v=="--no-target-directory"then l=true elseif v=="--verbose"then s=true elseif v=="--relative"then n=true elseif v=="--interactive"then g=true elseif v=="--logical"then f=true elseif v=="--physical"then f=false elseif v=="-t"or v=="--target-directory"then z=z+1 b=y[z]if not b then c("ln: option '"..v.."' requires an argument\n");return 2 end elseif v:match("^%-%-target%-directory=")then b=v:sub(20)elseif v:match("^%-t.")then b=v:sub(3)elseif v=="--backup"or v:match("^%-%-suffix")then c("ln: option '"..v.."' is not supported\n")return 2 elseif v:sub(1,2)=="--"then c("ln: unrecognized option '"..v.."'\n")return 1 elseif v:sub(1,1)=="-"and v~="-"then for i1=2,#v do if not b1(v:sub(i1,i1))then return 1 end end else a[#a+1]=v end end if#a==0 then c("ln: missing file operand\n")return 1 end local k={}local function e(o1,p1)o1=o1:gsub("/+$","")if o1==""then return"/"..p1 end return o1.."/"..p1 end local h=false local p=nil if b then h,p=true,b for k1=1,#a do local g1=a[k1]k[#k+1]={target=g1,link=d(e(b,j(g1))),display=e(b,j(g1))}end elseif#a==1 then h=true p="."k[1]={target=a[1],link=d(j(a[1])),display=e(".",j(a[1]))}else local m=a[#a]if not l then if r then local f1=q(d(m))h=(f1~=nil)and(f1.isDir==true)and(f1.kind~="symlink")else h=fs.isDir(d(m))and true or false end end if h then p=m for l1=1,#a-1 do local j1=a[l1]local h1=j(j1)k[#k+1]={target=j1,link=d(e(m,h1)),display=e(m,h1)}end else if#a>2 then local m1=d(m)if fs.exists(m1)then c("ln: target '"..m.."' is not a directory\n")else c("ln: target '"..m.."': No such file or directory\n")end return 1 end k[1]={target=a[1],link=d(m),display=m}end end local function i(p1,o1)if o then return"ln: failed to create symbolic link '"..o1.."': "end return"ln: failed to create hard link '"..o1.."' => '"..p1.."': "end local function w(q1,s1)local y1=d(q1)local r1=d(s1)local p1=r1:match("^(.*)/[^/]*$")or"/"if p1==""then p1="/"end local t1={}for x1 in y1:gmatch("[^/]+")do t1[#t1+1]=x1 end local u1={}for w1 in p1:gmatch("[^/]+")do u1[#u1+1]=w1 end local v1=1 while v1<=#t1 and v1<=#u1 and t1[v1]==u1[v1]do v1=v1+1 end local o1={}for a2=v1,#u1 do o1[#o1+1]=".."end for z1=v1,#t1 do o1[#o1+1]=t1[z1]end if#o1==0 then return"."end return table.concat(o1,"/")end local function a1(q1,r1)local o1,p1=q(q1),q(r1)if o1 and p1 and o1.ino and p1.ino then return o1.ino==p1.ino end return q1==r1 end local function x(u1)local o1,p1=u1.target,u1.display local q1,s1=d(o1),u1.link if not o then if not(fs.exists(q1)or q(q1))then c("ln: failed to access '"..o1.."': No such file or directory\n")return false end local c2=q(q1)if c2 and c2.isDir then c("ln: "..o1..": hard link not allowed for directory\n")return false end end local z1=q(s1)if z1 then if not o and a1(q1,s1)then c("ln: '"..o1.."' and '"..p1.."' are the same file\n")return false end if not t then if g then io.write("ln: replace '"..p1.."'? ")io.flush()local w1=io.stdin()local v1=w1 and w1.readLine and w1:readLine()or nil if not(v1 and v1:match("^[yY]"))then return true end else c(i(o1,p1).."File exists\n")return false end end if z1.isDir and z1.kind~="symlink"then c("ln: cannot overwrite directory '"..p1.."' with non-directory\n")return false end local b2,y1=fs.delete(s1)if not b2 then c("ln: cannot remove '"..p1.."': "..tostring(y1).."\n")return false end end local r1=s1:match("^(.*)/[^/]*$")or"/"if r1==""then r1="/"end local d2=q(r1)if not d2 then c(i(o1,p1).."No such file or directory\n")return false end if not fs.isDir(r1)then c(i(o1,p1).."Not a directory\n")return false end local a2,t1 if o then local x1=o1 if n then x1=w(o1,p1)end a2,t1=fs.symlink(x1,s1)else if f then q1=d(o1)end a2,t1=fs.link(q1,s1)end if not a2 then c(i(o1,p1)..tostring(t1).."\n")return false end if s then io.write("'"..p1.."' -> '"..o1.."'\n")end return true end local e1=0 for n1,d1 in ipairs(k)do if not x(d1)then e1=1 end end return e1