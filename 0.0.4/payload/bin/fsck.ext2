local k=args or{}local function c(p)local o=io.stderr()if o and o.write then o:write(p)end end local function f()c("Usage: fsck.ext2 [-a|-p|-n|-y] [-f] [-v] device\n")end local d,b,e=nil,{},false for n,h in ipairs(k)do if e then b[#b+1]=h elseif h=="--"then e=true elseif h=="-n"then if d and d~="check"then c("fsck.ext2: -n conflicts with an earlier option\n")return 16 end d="check"elseif h=="-y"or h=="-p"or h=="-a"then if d and d~="fix"then c("fsck.ext2: "..h.." conflicts with an earlier option\n")return 16 end d="fix"elseif h=="-f"or h=="-v"or h=="-V"then elseif h:sub(1,1)=="-"and h~="-"then c("fsck.ext2: invalid option -- '"..h:sub(2,2).."'\n")f()return 16 else b[#b+1]=h end end if#b==0 then c("fsck.ext2: no device specified\n")f()return 16 elseif#b>1 then c("fsck.ext2: too many arguments\n")f()return 16 end local g=b[1]if not(syscalls and syscalls["blkdev.fsck"])then c("fsck.ext2: blkdev.fsck syscall not available\n")return 8 end local j if d==nil or d=="ask"then local i=io.stdin()j=function(p)io.write(p)local o=i and i:readLine()or nil if not o then return false end local q=o:sub(1,1)return q=="y"or q=="Y"end end local a,l=syscalls["blkdev.fsck"](g,{mode=d or"ask",ask=j,emit=function(o)io.write(o.."\n")end,})if not a then c("fsck.ext2: "..tostring(l).."\n")return 8 end if a.files and a.blocks then local m=a.files.used>0 and(100*(a.nonContiguous or 0)/a.files.used)or 0 io.write(string.format("%s: %d/%d files (%.1f%% non-contiguous), %d/%d blocks\n",a.device or g,a.files.used,a.files.total,m,a.blocks.used,a.blocks.total))end return a.code