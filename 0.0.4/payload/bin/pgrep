local c=args or{}local function a(v2)local u2=io.stderr()if u2 and u2.write then u2:write(v2)end end local function b(u2)local v2=fs.open(u2,"r")if not v2 then return nil end local w2=v2:readAll()v2:close()return w2 end local function d2(u2)if not u2 or u2==""then return nil end local v2,x2={},0 for w2=1,#u2 do local z2=u2:byte(w2)x2=x2+1 v2[x2]=(z2==0)and" "or u2:sub(w2,w2)end local y2=table.concat(v2,""):gsub("%s+$","")if y2==""then return nil end return y2 end local function f1(v2)local x2={}for u2 in v2:gmatch("[^\n]+")do local w2,y2=u2:match("^(%w+):%s*(.*)$")if w2 then x2[w2]=y2 end end return x2 end local function s1()local u2=b("/proc/self/stat")if not u2 then return nil end return tonumber(u2:match("^(%d+)"))end local function h1()local u2={}for y2,x2 in ipairs(fs.list("/proc")or{})do local v2=tonumber(x2)if v2 then local w2=b("/proc/"..v2.."/comm")if w2 then u2[#u2+1]={pid=v2,comm=(w2:gsub("\n$","")),cmd=d2(b("/proc/"..v2.."/cmdline")),}end end end table.sort(u2,function(z2,a3)return z2.pid<a3.pid end)return u2 end local function y(a3)local v2,w2,c3,y2,x2,z2,b3,u2=a3:match("^(%d+) %((.*)%) (%a+) (%d+) (%d+) (%d+) (%S+) (%-?%d+)")if not v2 then return nil end return{pid=tonumber(v2),comm=w2,state=c3,ppid=tonumber(y2),pgrp=tonumber(x2),sess=tonumber(z2),tty=b3,tpgid=tonumber(u2)}end local function t(u2)local v2=tonumber(u2)if v2 then return v2 end local w2=syscalls and syscalls["user.get"]and syscalls["user.get"](u2)if not w2 then return nil end return w2.uid end local u1,x1,w1,v1,t1,k1,l1=false,false,false,false,false,false,false local s=nil local a1,b1,c1=false,"\n",false local j,r,p,q,l,g=nil,nil,nil,nil,nil,nil local f,i,e=nil,false,nil local k=nil local function v(x2)local u2={}for w2 in(tostring(x2 or"")..","):gmatch("([^,]*),")do if w2~=""then local v2=tonumber(w2)if not v2 then return nil end u2[v2]=true end end return u2 end local m=1 while m<=#c do local w=c[m]if w=="--"then m=m+1 if not c[m]then a("pgrep: missing pattern\n");return 2 end k=c[m]elseif w:sub(1,2)=="--"then a("pgrep: unrecognized option '"..w.."'\n")return 2 elseif w:sub(1,1)=="-"and#w>1 then local z=2 while z<=#w do local e1=w:sub(z,z)if e1=="f"then u1=true elseif e1=="x"then x1=true elseif e1=="v"then w1=true elseif e1=="l"then v1=true elseif e1=="a"then t1=true elseif e1=="n"then k1=true elseif e1=="o"then l1=true elseif e1=="c"then a1=true elseif e1=="i"then c1=true elseif e1=="d"then local q1=w:sub(z+1)if q1==""then m=m+1;q1=c[m]end if not q1 then a("pgrep: option requires an argument -- 'd'\n");return 2 end b1=q1 z=#w elseif e1=="P"then local b2=w:sub(z+1)if b2==""then m=m+1;b2=c[m]end j=v(b2)if not j then a("pgrep: invalid parent pid list\n");return 2 end z=#w elseif e1=="t"then local r1=w:sub(z+1)if r1==""then m=m+1;r1=c[m]end if not r1 then a("pgrep: option requires an argument -- 't'\n");return 2 end r={}for p2 in(r1..","):gmatch("([^,]*),")do if p2~=""then local n2=p2:match("^/dev/(.*)$")or p2 if n2:match("^%d+$")then n2="tty"..n2 end r[n2]=true end end z=#w elseif e1=="g"then local c2=w:sub(z+1)if c2==""then m=m+1;c2=c[m]end p=v(c2)if not p then a("pgrep: invalid process group list\n");return 2 end z=#w elseif e1=="s"then local a2=w:sub(z+1)if a2==""then m=m+1;a2=c[m]end q=v(a2)if not q then a("pgrep: invalid session id list\n");return 2 end z=#w elseif e1=="G"then local z1=w:sub(z+1)if z1==""then m=m+1;z1=c[m]end l=v(z1)if not l then a("pgrep: invalid group list\n");return 2 end z=#w elseif e1=="U"then local p1=w:sub(z+1)if p1==""then m=m+1;p1=c[m]end g=t(p1)if g==nil then a("pgrep: user '"..p1.."' does not exist\n");return 2 end z=#w elseif e1=="F"then local o1=w:sub(z+1)if o1==""then m=m+1;o1=c[m]end if not o1 then a("pgrep: option requires an argument -- 'F'\n");return 2 end f=o1 z=#w elseif e1=="A"then i=true elseif e1=="r"then local n1=w:sub(z+1)if n1==""then m=m+1;n1=c[m]end if not n1 then a("pgrep: option requires an argument -- 'r'\n");return 2 end e={}for r2 in(n1..","):gmatch("([^,]*),")do if r2~=""then e[r2]=true end end z=#w elseif e1=="O"then a("pgrep: option '-O' is not supported (no process start time)\n")return 2 elseif e1=="u"then local j1=w:sub(z+1)if j1==""then m=m+1;j1=c[m]end if not j1 then a("pgrep: option requires an argument -- 'u'\n");return 2 end s=t(j1)if s==nil then a("pgrep: user '"..j1.."' does not exist\n");return 2 end z=#w else a("pgrep: invalid option -- '"..e1.."'\n")return 2 end z=z+1 end else if k then a("pgrep: too many operands\n");return 2 end k=w end m=m+1 end if not k then a("usage: pgrep [-flnvoaxcd] [-u user] [-P ppid] [-t tty] [-g pgrp] [-s sid] [-G gid] [-U uid] [-F pidfile] [-A] [-r state] pattern\n");return 2 end if k1 and l1 then a("pgrep: -n and -o are mutually exclusive\n");return 2 end local o=syscalls and syscalls["regex.compile"]if not o then a("pgrep: regex syscall not available\n");return 2 end local k2,h2=o(k,"ere",{line=x1,icase=c1})if not k2 then a("pgrep: invalid pattern: "..tostring(h2).."\n")return 2 end local self=s1()local x={}if i then local i1=self while i1 and i1~=0 do x[i1]=true local l2=y(b("/proc/"..i1.."/stat")or"")i1=l2 and l2.ppid or nil end end local h=nil if f then local y1=b(f)if not y1 then a("pgrep: cannot open pid file: "..tostring(f).."\n")return 2 end h={}for m2 in y1:gmatch("%S+")do local q2=tonumber(m2)if q2 then h[q2]=true end end end local d={}for t2,f2 in ipairs(h1())do if f2.pid~=self and not(i and x[f2.pid])then local g1=y(b("/proc/"..f2.pid.."/stat")or"")local d1=nil local function u()if not d1 then d1=f1(b("/proc/"..f2.pid.."/status")or"")end return d1 end local n=true if s~=nil then n=(tonumber(u().Uid)or-1)==s end if n and g~=nil then n=(tonumber(u().Uid)or-1)==g end if n and l~=nil then n=l[tonumber(u().Gid)or-1]==true end if n and j then n=g1~=nil and j[g1.ppid]==true end if n and p then n=g1~=nil and p[g1.pgrp]==true end if n and q then n=g1~=nil and q[g1.sess]==true end if n and r then local o2=(g1 and g1.tty)or"0"if o2=="0"then o2="?"end n=r[o2]==true end if n and e then local g2=(g1 and g1.state)or"?"n=e[g2]==true end if n and h then n=h[f2.pid]==true end if n then local i2=u1 and(f2.cmd or f2.comm)or f2.comm local e2=k2:find(i2)~=nil if e2~=w1 then d[#d+1]=f2 end end end end if k1 and#d>0 then d={d[#d]}end if l1 and#d>0 then d={d[1]}end if a1 then io.write(tostring(#d).."\n")if#d==0 then return 1 end return 0 end local m1=true for s2,j2 in ipairs(d)do if not m1 then io.write(b1)end m1=false if t1 then io.write(tostring(j2.pid).." "..(j2.cmd or("["..j2.comm.."]")))elseif v1 then io.write(tostring(j2.pid).." "..j2.comm)else io.write(tostring(j2.pid))end end if#d>0 then io.write("\n")end if#d==0 then return 1 end