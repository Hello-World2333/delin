local a1=args or{}local w=(type(cwd)=="string"and cwd)or"/"local function x(g1)g1=g1 or""if g1==""then return(w=="/")and"/"or w end if g1:sub(1,1)=="/"then if g1=="/"then return"/"end return g1:gsub("/+$","")end local f1=(w=="/")and""or w return(f1.."/"..g1):gsub("/+","/")end local function c(g1)local f1=io.stderr()if f1 and f1.write then f1:write(g1)end end local d,g,h,f,b=false,false,false,false,false local a,l={},false for e1,r in ipairs(a1)do if l then a[#a+1]=r elseif r=="--"then l=true elseif r=="-R"or r=="-r"or r=="--recursive"then d=true elseif r=="-h"or r=="--no-dereference"then g=true elseif r=="-v"or r=="--verbose"then h=true elseif r=="-c"or r=="--changes"then f=true elseif r=="-f"or r=="--silent"or r=="--quiet"then b=true elseif r:sub(1,1)=="-"and r~="-"then for b1=2,#r do local u=r:sub(b1,b1)if u=="R"or u=="r"then d=true elseif u=="h"then g=true elseif u=="v"then h=true elseif u=="c"then f=true elseif u=="f"then b=true else c("chgrp: invalid option -- '"..u.."'\n");return 1 end end else a[#a+1]=r end end local o=a[1]if not o then c("chgrp: missing operand\n")return 1 end local q={}for c1=2,#a do q[#q+1]=a[c1]end if#q==0 then c("chgrp: missing operand after '"..o.."'\n")return 1 end local k if syscalls and syscalls["user.groupByName"]then local z=syscalls["user.groupByName"](o)if z then k=z.gid end end if not k and o:match("^%d+$")then k=tonumber(o)end if not k then c("chgrp: invalid group: '"..o.."'\n")return 1 end local function m(g1)if syscalls and syscalls["user.groupByGid"]then local f1=syscalls["user.groupByGid"](g1)if f1 then return f1.name end end return tostring(g1)end local j=0 local function t(i1,h1,g1,f1)if h or(f and f1)then if f1 then io.write("changed group of '"..h1.."' from "..m(g1).." to "..m(k).."\n")else io.write("group of '"..h1.."' retained as "..m(k).."\n")end end end local function e(g1,h1)local f1=fs.attributes(g1)local j1,i1=fs.chown(g1,nil,k)if not j1 then if not b then c("chgrp: "..h1..": "..tostring(i1).."\n")end j=1 return end t(g1,h1,f1 and(f1.gid or 0)or 0,f1~=nil and(f1.gid or 0)~=k)end local function p(h1,i1)local f1=fs.lstat(h1)local g1=fs.lchown if not g1 then c("chgrp: "..i1..": cannot change the group of a symbolic link: ".."fs.lchown is not supported by this kernel\n")j=1 return end local k1,j1=g1(h1,nil,k)if not k1 then if not b then c("chgrp: "..i1..": "..tostring(j1).."\n")end j=1 return end t(h1,i1,f1 and(f1.gid or 0)or 0,f1~=nil and(f1.gid or 0)~=k)end local function i(f1)local g1=fs.lstat(f1)return g1~=nil and g1.kind=="symlink"end local function v(f1,g1)return(f1:sub(-1)=="/")and(f1..g1)or(f1.."/"..g1)end local function y(j1,g1)if fs.isDir(g1)then e(g1,j1)local i1=fs.list(g1)or{}table.sort(i1)for l1,k1 in ipairs(i1)do local f1=(g1=="/")and("/"..k1)or(g1.."/"..k1)local h1=v(j1,k1)if i(f1)then p(f1,h1)elseif fs.isDir(f1)then y(h1,f1)else e(f1,h1)end end else e(g1,j1)end end for d1,s in ipairs(q)do local n=x(s)if not fs.exists(n)and not i(n)then if not b then c("chgrp: "..s..": No such file or directory\n")end j=1 elseif i(n)and g then p(n,s)elseif d then y(s,n)else e(n,s)end end return j