local i=args or{}local function f(o)local n=io.stderr()if n and n.write then n:write(o)end end if#i==0 then f("sleep: missing operand\n")return 1 end local h=4294967295 local e=0 for m,k in ipairs(i)do local b if k=="--"then b=0 elseif k=="infinity"then b=h else local j,g=k:match("^([%d%.]+)([smhdSMHD]?)$")local l=j and tonumber(j)if not l then f("sleep: invalid time interval '"..tostring(k).."'\n")return 1 end g=(g or""):lower()local d=1 if g=="m"then d=60 elseif g=="h"then d=3600 elseif g=="d"then d=86400 end b=l*d end e=e+b end local a=e*1000 while a>0 do local c=a>50 and 50 or a if os.msleep then os.msleep(c)else os.sleep(c/1000)end a=a-c end return 0