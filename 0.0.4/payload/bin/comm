local u=args or{}local x=(type(cwd)=="string"and cwd)or"/"local function a1(k1)k1=k1 or""if k1==""then return(x=="/")and"/"or x end if k1:sub(1,1)=="/"then if k1=="/"then return"/"end return k1:gsub("/+$","")end local j1=(x=="/")and""or x return(j1.."/"..k1):gsub("/+","/")end local function a(k1)local j1=io.stderr()if j1 and j1.write then j1:write(k1)end end local function b1(j1)if j1 and(j1:find("permission")or j1:find("denied"))then return"Permission denied"end if j1 and j1:lower():find("no such file")then return"No such file or directory"end if j1 and j1:find("directory")then return"Is a directory"end return"No such file or directory"end local o,p,y=false,false,false local c=true local n=false local f="\t"local q=false local d={}local l=false for i1,s in ipairs(u)do if l then d[#d+1]=s elseif s=="--"then l=true elseif s=="--check-order"then c=true elseif s=="--nocheck-order"then c=false elseif s=="--total"then n=true;c=false elseif s=="-z"or s=="--zero-terminated"then q=true elseif s=="--output-delimiter"then i=i+1 if not u[i]then a("comm: option '--output-delimiter' requires an argument\n");return 2 end f=u[i]elseif s:match("^%-%-output%-delimiter=")then f=s:sub(20)elseif s:sub(1,1)=="-"and s~="-"and s:sub(1,2)~="--"then for f1=2,#s do local e1=s:sub(f1,f1)if e1=="1"then o=true elseif e1=="2"then p=true elseif e1=="3"then y=true else a("comm: invalid option -- '"..e1.."'\n");return 1 end end elseif s:sub(1,2)=="--"then a("comm: unrecognized option '"..s.."'\n")return 1 else d[#d+1]=s end end if#d<2 then a("comm: missing operand\n")return 1 end if#d>2 then a("comm: extra operand '"..d[3].."'\n")return 1 end local function t(j1)if j1=="-"then local m1=io.stdin()if not m1 then a("comm: cannot read stdin\n");return nil end return m1 end local l1,k1=fs.open(a1(j1),"r")if not l1 then a("comm: "..j1..": "..b1(k1).."\n")return nil end return l1 end local function k(k1)local n1=t(k1)if not n1 then return nil end local l1,m1=nil,false local j1=false return{name=k1,read=function()if m1 then return nil end local o1=n1:readLine()if o1==nil then m1=true;return nil end if l1 and o1<l1 then j1=true end l1=o1 return o1 end,close=function()if k1~="-"then n1:close()end end,disorder=function()return j1 end,}end local v=k(d[1])if not v then return 1 end local w=k(d[2])if not w then return 1 end local m=o and""or f local z=m..(p and""or f)local r=q and"\0"or"\n"local g={0,0,0}local b={}local function h()if#b>0 then io.write(table.concat(b));b={}end end local e=nil local function j(j1)if c then a("comm: file "..j1.." is not in sorted order\n")return 1 end e=e or j1 return nil end local c1,d1=v:read(),w:read()while c1~=nil and d1~=nil do if c1<d1 then if not o then b[#b+1]=c1..r end;g[1]=g[1]+1 c1=v:read()elseif c1>d1 then if not p then b[#b+1]=m..d1..r end;g[2]=g[2]+1 d1=w:read()else if not y then b[#b+1]=z..c1..r end g[3]=g[3]+1 c1=v:read()d1=w:read()end if#b>256 then h()end if v.disorder()then local h1=j(1);if h1 then h();return h1 end end if w.disorder()then local g1=j(2);if g1 then h();return g1 end end end while c1~=nil do if not o then b[#b+1]=c1..r end;g[1]=g[1]+1 c1=v:read()if#b>256 then h()end end while d1~=nil do if not p then b[#b+1]=m..d1..r end;g[2]=g[2]+1 d1=w:read()if#b>256 then h()end end if n then b[#b+1]=table.concat({g[1],g[2],g[3],"total"},f)..r end h()v:close()w:close()if e then a("comm: input is not in sorted order\n")return 1 end