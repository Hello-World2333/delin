local r=args or{}local n=(type(cwd)=="string"and cwd)or"/"local function o(e1)e1=e1 or""if e1==""then return(n=="/")and"/"or n end if e1:sub(1,1)=="/"then if e1=="/"then return"/"end return e1:gsub("/+$","")end local d1=(n=="/")and""or n return(d1.."/"..e1):gsub("/+","/")end local function g(e1)local d1=io.stderr()if d1 and d1.write then d1:write(e1)end end local d,b,e=false,false,false local a,f={},false for c1,p in ipairs(r)do if f then a[#a+1]=p elseif p=="--"then f=true elseif p=="-p"or p=="--parents"then d=true elseif p=="--ignore-fail-on-non-empty"then b=true elseif p=="-v"or p=="--verbose"then e=true elseif p:sub(1,1)=="-"and p~="-"then for x=2,#p do local s=p:sub(x,x)if s=="p"then d=true elseif s=="v"then e=true else g("rmdir: invalid option -- '"..s.."'\n")return 1 end end else a[#a+1]=p end end if#a==0 then g("rmdir: missing operand\n")return 1 end local function k(g1,e1)if not fs.exists(e1)then return false,"No such file or directory"end if not fs.isDir(e1)then return false,"Not a directory"end local d1=fs.list(e1)if d1 and#d1>0 then return false,"Directory not empty"end local h1,f1=fs.delete(e1)if not h1 then return false,tostring(f1 or"Operation not permitted")end if e then io.write("rmdir: removing directory, '"..g1.."'\n")end return true end local i=0 for b1,j in ipairs(a)do if j==""then g("rmdir: failed to remove '': No such file or directory\n")i=1 else local c={}if d then local h={}for q in j:gmatch("[^/]+")do if q~="."then h[#h+1]=q end end if#h==0 then c[1]=j else local t=(j:sub(1,1)=="/")and"/"or""for a1=#h,1,-1 do local z={}for w=1,a1 do z[w]=h[w]end c[#c+1]=t..table.concat(z,"/")end end else c[1]=j end local m=o(j)for y=1,#c do local l if m=="/"then l="Device or resource busy"else local v,u=k(c[y],m)if not v then l=u end end if l then if not(b and l=="Directory not empty")then g("rmdir: failed to remove '"..c[y].."': "..l.."\n")i=1 end break end m=fs.getDir(m)end end end return i