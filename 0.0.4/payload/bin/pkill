local c=args or{}local function a(d3)local c3=io.stderr()if c3 and c3.write then c3:write(d3)end end local function d(c3)local d3=fs.open(c3,"r")if not d3 then return nil end local e3=d3:readAll()d3:close()return e3 end local function i2(c3)if not c3 or c3==""then return nil end local d3,f3={},0 for e3=1,#c3 do local h3=c3:byte(e3)f3=f3+1 d3[f3]=(h3==0)and" "or c3:sub(e3,e3)end local g3=table.concat(d3,""):gsub("%s+$","")if g3==""then return nil end return g3 end local function i1(d3)local f3={}for c3 in d3:gmatch("[^\n]+")do local e3,g3=c3:match("^(%w+):%s*(.*)$")if e3 then f3[e3]=g3 end end return f3 end local function c1(i3)local d3,e3,k3,g3,f3,h3,j3,c3=i3:match("^(%d+) %((.*)%) (%a+) (%d+) (%d+) (%d+) (%S+) (%-?%d+)")if not d3 then return nil end return{pid=tonumber(d3),comm=e3,state=k3,ppid=tonumber(g3),pgrp=tonumber(f3),sess=tonumber(h3),tty=j3,tpgid=tonumber(c3)}end local function x1()local c3=d("/proc/self/stat")if not c3 then return nil end return tonumber(c3:match("^(%d+)"))end local function l1()local c3={}for g3,f3 in ipairs(fs.list("/proc")or{})do local d3=tonumber(f3)if d3 then local e3=d("/proc/"..d3.."/comm")if e3 then c3[#c3+1]={pid=d3,comm=(e3:gsub("\n$","")),cmd=i2(d("/proc/"..d3.."/cmdline")),}end end end table.sort(c3,function(h3,i3)return h3.pid<i3.pid end)return c3 end local function v(c3)local d3=tonumber(c3)if d3 then return d3 end local e3=syscalls and syscalls["user.get"]and syscalls["user.get"](c3)if not e3 then return nil end return e3.uid end local function b(c3)local d3=tostring(c3):gsub("^%-","")if d3:match("^%d+$")then return tonumber(d3)end if d3:match("^SIG")then d3=d3:sub(4)end return syscalls["signal.number"](d3)end local a2,c2,b2,q1,r1=false,false,false,false,false local t=nil local w=15 local m=nil local k1,f1,a1=false,false,false local k,s,q,r,n,h=nil,nil,nil,nil,nil,nil local g,j,f=nil,false,nil local function z(f3)local c3={}for e3 in(tostring(f3 or"")..","):gmatch("([^,]*),")do if e3~=""then local d3=tonumber(e3)if not d3 then return nil end c3[d3]=true end end return c3 end local l=1 while l<=#c do local u=c[l]if u=="--"then l=l+1 if not c[l]then a("pkill: missing pattern\n");return 2 end m=c[l]elseif u:sub(1,2)=="--"then local z1,d1=u:match("^%-%-([%w-]+)=?(.*)$")if z1=="session"then if d1==""then l=l+1;d1=c[l]end r=z(d1)if not r then a("pkill: invalid session id list\n");return 2 end elseif z1=="signal"then if d1==""then l=l+1;d1=c[l]end if not d1 then a("pkill: option '--signal' requires an argument\n");return 2 end w=b(d1)if not w then a("pkill: unknown signal "..d1.."\n");return 2 end else a("pkill: unrecognized option '"..u.."'\n")return 2 end elseif u:sub(1,1)=="-"and#u>1 then local y=2 while y<=#u do local h1=u:sub(y,y)if h1=="f"then a2=true elseif h1=="x"then c2=true elseif h1=="v"then b2=true elseif h1=="n"then q1=true elseif h1=="o"then r1=true elseif h1=="e"then k1=true elseif h1=="c"then f1=true elseif h1=="H"then a1=true elseif h1=="P"then local h2=u:sub(y+1)if h2==""then l=l+1;h2=c[l]end k=z(h2)if not k then a("pkill: invalid parent pid list\n");return 2 end y=#u elseif h1=="t"then local u1=u:sub(y+1)if u1==""then l=l+1;u1=c[l]end if not u1 then a("pkill: option requires an argument -- 't'\n");return 2 end s={}for w2 in(u1..","):gmatch("([^,]*),")do if w2~=""then local s2=w2:match("^/dev/(.*)$")or w2 if s2:match("^%d+$")then s2="tty"..s2 end s[s2]=true end end y=#u elseif h1=="g"then local f2=u:sub(y+1)if f2==""then l=l+1;f2=c[l]end q=z(f2)if not q then a("pkill: invalid process group list\n");return 2 end y=#u elseif h1=="G"then local g2=u:sub(y+1)if g2==""then l=l+1;g2=c[l]end n=z(g2)if not n then a("pkill: invalid group list\n");return 2 end y=#u elseif h1=="U"then local w1=u:sub(y+1)if w1==""then l=l+1;w1=c[l]end h=v(w1)if h==nil then a("pkill: user '"..w1.."' does not exist\n");return 2 end y=#u elseif h1=="F"then local v1=u:sub(y+1)if v1==""then l=l+1;v1=c[l]end if not v1 then a("pkill: option requires an argument -- 'F'\n");return 2 end g=v1 y=#u elseif h1=="A"then j=true elseif h1=="r"then local t1=u:sub(y+1)if t1==""then l=l+1;t1=c[l]end if not t1 then a("pkill: option requires an argument -- 'r'\n");return 2 end f={}for y2 in(t1..","):gmatch("([^,]*),")do if y2~=""then f[y2]=true end end y=#u elseif h1=="s"then local n1=u:sub(y+1)if n1==""then l=l+1;n1=c[l]end if not n1 then a("pkill: option requires an argument -- 's'\n");return 2 end w=b(n1)if not w then a("pkill: unknown signal "..n1.."\n");return 2 end y=#u elseif h1=="u"then local o1=u:sub(y+1)if o1==""then l=l+1;o1=c[l]end if not o1 then a("pkill: option requires an argument -- 'u'\n");return 2 end t=v(o1)if t==nil then a("pkill: user '"..o1.."' does not exist\n");return 2 end y=#u elseif h1:match("%d")then w=b(u:sub(y))if not w then a("pkill: unknown signal "..u:sub(y).."\n");return 2 end y=#u elseif h1:match("%u")then w=b(u:sub(y))if not w then a("pkill: unknown signal "..u:sub(y).."\n");return 2 end y=#u else a("pkill: invalid option -- '"..h1.."'\n")return 2 end y=y+1 end else if m then a("pkill: too many operands\n");return 2 end m=u end l=l+1 end if not m then a("usage: pkill [-SIGNAL] [-fxvnoecH] [-u user] [-P ppid] [-t tty] [-g pgrp] [--session sid] [-G gid] [-U uid] [-F pidfile] [-A] [-r state] pattern\n");return 2 end if q1 and r1 then a("pkill: -n and -o are mutually exclusive\n");return 2 end local p=syscalls and syscalls["regex.compile"]if not p then a("pkill: regex syscall not available\n");return 2 end local p2,l2=p(m,"ere",{line=c2})if not p2 then a("pkill: invalid pattern: "..tostring(l2).."\n")return 2 end local self=x1()local b1={}if j then local m1=self while m1 and m1~=0 do b1[m1]=true local q2=c1(d("/proc/"..m1.."/stat")or"")m1=q2 and q2.ppid or nil end end local i=nil if g then local e2=d(g)if not e2 then a("pkill: cannot open pid file: "..tostring(g).."\n")return 2 end i={}for r2 in e2:gmatch("%S+")do local o2=tonumber(r2)if o2 then i[o2]=true end end end local e={}for b3,k2 in ipairs(l1())do if k2.pid~=self and not(j and b1[k2.pid])then local j1=c1(d("/proc/"..k2.pid.."/stat")or"")local g1=nil local function x()if not g1 then g1=i1(d("/proc/"..k2.pid.."/status")or"")end return g1 end local o=true if t~=nil then o=(tonumber(x().Uid)or-1)==t end if o and h~=nil then o=(tonumber(x().Uid)or-1)==h end if o and n~=nil then o=n[tonumber(x().Gid)or-1]==true end if o and k then o=j1~=nil and k[j1.ppid]==true end if o and q then o=j1~=nil and q[j1.pgrp]==true end if o and r then o=j1~=nil and r[j1.sess]==true end if o and s then local v2=(j1 and j1.tty)or"0"if v2=="0"then v2="?"end o=s[v2]==true end if o and f then o=f[(j1 and j1.state)or"?"]==true end if o and i then o=i[k2.pid]==true end if o then local m2=a2 and(k2.cmd or k2.comm)or k2.comm local j2=p2:find(m2)~=nil if j2~=b2 then e[#e+1]=k2 end end end end if q1 and#e>0 then e={e[#e]}end if r1 and#e>0 then e={e[1]}end if f1 then io.write(tostring(#e).."\n")if#e==0 then return 1 end return 0 end if a1 then local p1={}local y1=syscalls and syscalls["proc.info"]for z2,x2 in ipairs(e)do local d2=y1 and y1(x2.pid)local e1=d2 and d2.sig and d2.sig.handlers if e1 and e1[w]then p1[#p1+1]=x2 end end e=p1 end local s1=0 for a3,u2 in ipairs(e)do local t2,n2=syscalls["signal.kill"](u2.pid,w)if t2 then s1=s1+1 if k1 then io.write("killed (pid "..u2.pid..")\n")end else a("pkill: "..u2.pid..": "..tostring(n2).."\n")end end if s1==0 then return 1 end