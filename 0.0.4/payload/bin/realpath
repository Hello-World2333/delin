local k=args or{}local q=(type(cwd)=="string"and cwd)or"/"local function c(b1)local a1=io.stderr()if a1 and a1.write then a1:write(b1)end end local j=40 local function b(b1)local a1={}for c1 in b1:gmatch("[^/]+")do a1[#a1+1]=c1 end return a1 end local function p(b1)local a1=fs.lstat(b1)if not a1 then return nil end if a1.kind=="symlink"then return a1 end if fs.exists(b1)then return a1 end return nil end local function l(c1)local a1={}for b1 in c1:gmatch("[^/]+")do if b1=="."then elseif b1==".."then if#a1>0 then a1[#a1]=nil end else a1[#a1+1]=b1 end end if#a1==0 then return"/"end return"/"..table.concat(a1,"/")end local function i(c1,h1,k1)if c1==""then return nil,"No such file or directory"end local e1 if c1:sub(1,1)=="/"then e1=c1 else local n1=(q=="/")and""or q e1=n1.."/"..c1 end if k1 then e1=l(e1)end local d1=b(e1)local b1={}local g1=0 local a1=nil local l1=1 while l1<=#d1 do local f1=d1[l1]if f1=="."then l1=l1+1 elseif f1==".."then if#b1>0 then b1[#b1]=nil end l1=l1+1 else local p1=(#b1==0)and"/"or("/"..table.concat(b1,"/").."/")local i1=p1..f1 local q1 if h1~="missing"then q1=p(i1)end if q1 and q1.kind=="symlink"then local m1,o1=fs.readlink(i1)if not m1 then return nil,"cannot read symbolic link '"..i1.."': "..tostring(o1)end g1=g1+1 if g1>j then return nil,"Too many levels of symbolic links"end if m1:sub(1,1)=="/"then b1={};a1=nil end local j1=b(m1)table.remove(d1,l1)for r1=#j1,1,-1 do table.insert(d1,l1,j1[r1])end elseif q1 then b1[#b1+1]=f1 l1=l1+1 else if not a1 then a1=#b1+1 end b1[#b1+1]=f1 l1=l1+1 end end end if h1~="missing"and a1 then if h1=="existing"or#b1>a1 then return nil,"No such file or directory"end end if#b1==0 then return"/"end return"/"..table.concat(b1,"/")end local function m(b1,e1)local c1,f1=b(b1),b(e1)local d1=0 while d1<#c1 and d1<#f1 and c1[d1+1]==f1[d1+1]do d1=d1+1 end local a1={}for h1=d1+1,#f1 do a1[#a1+1]=".."end for g1=d1+1,#c1 do a1[#a1+1]=c1[g1]end if#a1==0 then return"."end return table.concat(a1,"/")end local g="allbutlast"local a=false local f=nil local d={}local e=false local function n(a1)if a1=="e"then g="existing"elseif a1=="m"then g="missing"elseif a1=="L"then a=true elseif a1=="P"then a=false else c("realpath: invalid option -- '"..a1.."'\n");return false end return true end local r=1 while r<=#k do local o=k[r]if e then d[#d+1]=o elseif o=="--"then e=true elseif o=="--canonicalize-existing"then g="existing"elseif o=="--canonicalize-missing"then g="missing"elseif o=="--logical"then a=true elseif o=="--physical"then a=false elseif o=="--relative-to"then r=r+1 if not k[r]then c("realpath: option '--relative-to' requires an argument\n");return 1 end f=k[r]elseif o:sub(1,14)=="--relative-to="then f=o:sub(15)elseif o:sub(1,1)=="-"and o~="-"then for y=2,#o do if not n(o:sub(y,y))then return 1 end end else d[#d+1]=o end r=r+1 end if#d==0 then c("realpath: missing operand\n")return 1 end local h=nil if f~=nil then local w,s=i(f,g,a)if not w then c("realpath: "..f..": "..tostring(s).."\n")return 1 end h=w end local u=0 for z,x in ipairs(d)do local v,t=i(x,g,a)if not v then c("realpath: "..x..": "..tostring(t).."\n")u=1 else if h then v=m(v,h)end io.write(v.."\n")end end return u