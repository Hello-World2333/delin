local a1=args or{}local w=(type(cwd)=="string"and cwd)or"/"local function p(h1)h1=h1 or""if h1==""then return(w=="/")and"/"or w end if h1:sub(1,1)=="/"then if h1=="/"then return"/"end return h1:gsub("/+$","")end local g1=(w=="/")and""or w return(g1.."/"..h1):gsub("/+","/")end local function b(h1)local g1=io.stderr()if g1 and g1.write then g1:write(h1)end end local c,r,d,f=false,false,false,false local a={}local g=false local function v(g1)if g1=="i"then c=true elseif g1=="f"then r=true elseif g1=="n"then d=true elseif g1=="v"then f=true else b("mv: invalid option -- '"..g1.."'\n");return false end return true end for f1,y in ipairs(a1)do if g then a[#a+1]=y elseif y=="--"then g=true elseif y=="--interactive"then c=true elseif y=="--force"then r=true elseif y=="--no-clobber"then d=true elseif y=="--verbose"then f=true elseif y:sub(1,2)=="--"then b("mv: unrecognized option '"..y.."'\n")return 1 elseif y:sub(1,1)=="-"and y~="-"then for e1=2,#y do if not v(y:sub(e1,e1))then return 1 end end else a[#a+1]=y end end if#a<2 then b("mv: missing destination file operand\n")return 1 end local e=a[#a]local l=e:sub(-1)=="/"local u=p(e)local function s(g1,h1)return(g1.."/"..h1):gsub("/+","/")end local function t(g1)g1=(type(g1)=="string"and g1)or""g1=g1:gsub("/+$","")return(g1:match("([^/]+)$"))or g1 end local function i(h1)if d then return false end if not fs.exists(h1)then return true end if r then return true end if c then io.write("mv: overwrite '"..h1.."'? ")io.flush()local i1=io.stdin()local g1=i1 and i1.readLine and i1:readLine()or nil if g1 and g1:match("^[yY]")then return true end return false end return true end local function n(k1,j1)local i1,l1=fs.open(k1,"r")if not i1 then return nil,(l1 or("cannot open "..k1))end local h1,m1=fs.open(j1,"w")if not h1 then i1:close();return nil,(m1 or("cannot write "..j1))end while true do local g1=i1:read(4096)if not g1 or g1==""then break end h1:write(g1)yieldCheck()end i1:close()h1:close()return true end local x=os.msleep or function(g1)os.sleep(math.max((g1 or 0)/1000,0.05))end local m=os.epoch("utc")local function k()local g1=os.epoch("utc")if g1-m>=50 then m=g1 x(0)end end local function o(h1,g1)if not fs.isDir(h1)then return n(h1,g1)end if not fs.exists(g1)then local n1,j1=pcall(fs.makeDir,g1)if not n1 then return nil,"mkdir '"..g1.."' failed: "..tostring(j1)end end local i1=fs.list(h1)or{}for o1,l1 in ipairs(i1)do if l1~="."and l1~=".."then k()local m1,k1=o(s(h1,l1),s(g1,l1))if not m1 then return nil,k1 end end end return true end local function h(h1)if fs.isDir(h1)then local g1=fs.list(h1)or{}for j1,i1 in ipairs(g1)do k();h(s(h1,i1))end fs.delete(h1)else fs.delete(h1)end end local function z(i1,g1)if not i(g1)then return true,"skip"end local m1,h1=fs.move(i1,g1)if m1 then if f then io.write("'"..i1.."' -> '"..g1.."'\n")end return true end if h1~="cross-device link"and h1~="move not supported on this filesystem"then if h1~=nil then return nil,h1 end end local n1,k1 if fs.isDir(i1)then n1,k1=o(i1,g1)else n1,k1=n(i1,g1)end if not n1 then return nil,k1 end local l1,j1=pcall(h,i1)if not l1 then return nil,j1 end if f then io.write("'"..i1.."' -> '"..g1.."'\n")end return true end for b1=1,#a-1 do local q=p(a[b1])if not fs.exists(q)then b("mv: "..q..": No such file or directory\n")return 1 end local j if fs.isDir(u)or l then j=s(u,t(q))else if#a-1>1 then b("mv: target '"..e.."' is not a directory\n")return 1 end j=u end if q==j then b("mv: "..a[b1].." and "..e.." are the same file\n")return 1 end local d1,c1=z(q,j)if not d1 then b("mv: "..q..": "..tostring(c1).."\n")return 1 end end