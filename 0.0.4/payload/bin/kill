local e=args or{}local function a(e1)local d1=io.stderr()if d1 and d1.write then d1:write(e1)end end local h=15 local j=false local b={}local g=false local function c(d1)return syscalls["signal.name"](d1)end local function d(d1)return syscalls["signal.number"](d1)end local function f(e1)local d1=tostring(e1)d1=d1:gsub("^%-","")if d1:match("^%d+$")then return tonumber(d1)end if d1:match("^SIG")then d1=d1:sub(4)end return d(d1)end local n=1 while n<=#e do local i=e[n]if g then b[#b+1]=i elseif i=="--"then g=true elseif i=="-l"or i=="--list"then j=true local k={}for x=n+1,#e do k[#k+1]=e[x]end if#k>0 then local l={}for c1,u in ipairs(k)do if u:match("^%d+$")then l[#l+1]=c(tonumber(u))or"?"else local o=d(u:gsub("^SIG",""))l[#l+1]=o and tostring(o)or"?"end end io.write(table.concat(l,"\n").."\n")return 0 end elseif i=="-L"or i=="--table"then local p=syscalls["signal.list"]()for z,w in ipairs(p)do io.write(string.format("%2d %s\n",w,c(w)or"?"))end return 0 elseif i=="-h"or i=="--help"then io.write("usage: kill [-SIG|-s SIG] pid... | kill -l [SIG...] | kill -L\n")return 0 elseif i=="-V"or i=="--version"then io.write("kill (Delin OS)\n")return 0 elseif i=="-q"or i=="--queue"then a("kill: option '-q' is not supported (no sigqueue payload)\n")return 2 elseif i=="-s"or i=="--signal"then n=n+1 if not e[n]then a("kill: option requires an argument -- 's'\n");return end h=f(e[n])if not h then a("kill: unknown signal "..e[n].."\n");return end elseif i:match("^%-%-signal=")then h=f(i:sub(10))if not h then a("kill: unknown signal "..i:sub(10).."\n");return end elseif i:match("^%-%d+$")then h=tonumber(i:sub(2))elseif i:match("^%-[A-Za-z]+$")then h=f(i)if not h then a("kill: unknown signal "..i.."\n")return 1 end else b[#b+1]=i end n=n+1 end if j then local q=syscalls["signal.list"]()local v={}for b1,y in ipairs(q)do v[#v+1]=c(y)end io.write(table.concat(v," ").."\n")return end if#b==0 then a("usage: kill [-SIG] pid...\n")return 1 end for a1,m in ipairs(b)do local s=tonumber(m)if not s then a("kill: invalid pid "..tostring(m).."\n")else local r,t if s<0 then r,t=syscalls["signal.killpg"](-s,h)else r,t=syscalls["signal.kill"](s,h)end if not r then a("kill: ("..tostring(m)..") "..tostring(t).."\n")end end end