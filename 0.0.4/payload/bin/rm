local z=args or{}local r=(type(cwd)=="string"and cwd)or"/"local function u(f1)f1=f1 or""if f1==""then return(r=="/")and"/"or r end if f1:sub(1,1)=="/"then if f1=="/"then return"/"end return f1:gsub("/+$","")end local e1=(r=="/")and""or r return(e1.."/"..f1):gsub("/+","/")end local function b(f1)local e1=io.stderr()if e1 and e1.write then e1:write(f1)end end local a,g,d,k=false,false,false,false local j=false local e=false local c=false local f={}local h=false local function q(e1)if e1=="r"or e1=="R"then a=true elseif e1=="f"then g=true elseif e1=="i"then d=true elseif e1=="v"then k=true elseif e1=="d"then j=true elseif e1=="I"then e=true else b("rm: invalid option -- '"..e1.."'\n");return false end return true end for d1,m in ipairs(z)do if h then f[#f+1]=m elseif m=="--"then h=true elseif m=="--recursive"then a=true elseif m=="--force"then g=true elseif m=="--interactive"then d=true elseif m=="--verbose"then k=true elseif m=="--dir"then j=true elseif m=="--preserve-root"then c=false elseif m=="--no-preserve-root"then c=true elseif m=="--interactive=once"then e=true elseif m:match("^%-%-interactive=")then d=true elseif m:match("^%-%-one%-file%-system")then b("rm: option '"..m.."' is not supported\n")return 2 elseif m:sub(1,2)=="--"then b("rm: unrecognized option '"..m.."'\n")return 1 elseif m:sub(1,1)=="-"and m~="-"then for b1=2,#m do if not q(m:sub(b1,b1))then return 1 end end else f[#f+1]=m end end if#f==0 then b("rm: missing operand\n")return 1 end local function o(h1,f1)io.write("rm: remove "..(f1 and"directory "or"regular file ").."'"..h1.."'? ")io.flush()local g1=io.stdin()local e1=g1 and g1.readLine and g1:readLine()or nil return e1 and e1:match("^[yY]")end local s=os.msleep or function(e1)os.sleep(math.max((e1 or 0)/1000,0.05))end local l=os.epoch("utc")local function i()local e1=os.epoch("utc")if e1-l>=50 then l=e1 s(0)end end local function p(f1)local e1=fs.isDir(f1)if e1 and a then for j1,i1 in ipairs(fs.list(f1)or{})do i()p(fs.combine(f1,i1))end end if d and not g then if not o(f1,e1)then return true end end local h1,g1=pcall(fs.delete,f1)if not h1 then b("rm: cannot remove '"..f1.."': "..tostring(g1).."\n")return false end if k then io.write("removed '"..f1.."'\n")end return true end if e and not g and(#f>3 or a)then io.write("rm: remove "..#f.." argument"..(#f==1 and""or"s").."? ")io.flush()local y=io.stdin()local w=y and y.readLine and y:readLine()or nil if not(w and w:match("^[yY]"))then return 0 end end local t=0 for c1,x in ipairs(f)do i()local v=x:gsub("/+$","")local n=v:match("[^/]*$")or v if n=="."or n==".."then b("rm: refusing to remove '.' or '..' directory: skipping '"..x.."'\n")t=1 else local a1=u(x)if a1=="/"and a and not c then b("rm: it is dangerous to operate recursively on '/'\n".."rm: use --no-preserve-root to override this failsafe\n")t=1 elseif not fs.exists(a1)then if not g then b("rm: cannot remove '"..a1.."': No such file or directory\n")t=1 end elseif fs.isDir(a1)and not(a or j)then b("rm: cannot remove '"..a1.."': Is a directory\n")t=1 else if not p(a1)then t=1 end end end end return t