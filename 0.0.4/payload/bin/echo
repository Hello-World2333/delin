local e=args or{}local function h(s)local r=io.stderr()if r and r.write then r:write(s)end end local c={a="\a",b="\b",e="\27",E="\27",f="\f",n="\n",r="\r",t="\t",v="\v",["\\"]="\\",}local function d(w)local r,s,y={},1,#w while s<=y do local x=w:sub(s,s)if x~="\\"then r[#r+1]=x s=s+1 else local v=w:sub(s+1,s+1)if v==""then r[#r+1]="\\"s=s+1 elseif v=="c"then return table.concat(r),false elseif v=="0"then local u=w:match("^[0-7][0-7]?[0-7]?",s+2)or""r[#r+1]=string.char((tonumber(u,8)or 0)%256)s=s+2+#u elseif v=="x"then local t=w:match("^%x%x",s+2)if t then r[#r+1]=string.char(tonumber(t,16))s=s+4 else r[#r+1]="\\x"s=s+2 end elseif c[v]then r[#r+1]=c[v]s=s+2 else r[#r+1]="\\"..v s=s+2 end end end return table.concat(r),true end local j,a,b=1,true,false while j<=#e do local m=e[j]if m=="--"then j=j+1;break end if not m:match("^%-[neE]+$")then break end for p=2,#m do local k=m:sub(p,p)if k=="n"then a=false elseif k=="e"then b=true else b=false end end j=j+1 end local f={}for q=j,#e do f[#f+1]=e[q]end local n=table.concat(f," ")if b then local g n,g=d(n)a=a and g end local o=io.stdout()if o and o.write then local l,i=o:write(n..(a and"\n"or""))if l==nil and i~=nil then h("echo: write error: "..tostring(i).."\n")return 1 end end