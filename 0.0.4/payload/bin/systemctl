local n=args or{}local function b(n1)local m1=io.stderr()if m1 and m1.write then m1:write(n1)end end local function k1(m1)io.write(m1)end local function c(m1)io.write((m1 or"").."\n")end if not(syscalls and syscalls["init.list"])then b("systemctl: init control interface not available (init not running?)\n")return 1 end local r={".service",".target",".timer",".mount"}local function g(m1)if m1:match("%.[%a]+$")then return m1 end for o1,n1 in ipairs(r)do if syscalls["init.status"](m1..n1)then return m1..n1 end end return m1..".service"end local function t(m1)if not m1 then return"-"end return os.date("%Y-%m-%d %H:%M:%S",math.floor(m1/1000))end local function h(m1,n1)m1=tostring(m1 or"")if#m1>=n1 then return m1 end return m1..string.rep(" ",n1-#m1)end local function o(m1)local n1=m1.description or m1.name if m1.kind=="mount"then n1="Mount "..(m1.where or"?")end if m1.kind=="timer"and m1.unit then n1=(n1 or"").." -> "..m1.unit end return n1 end local function i(m1,p1)local n1=syscalls["init.list"]()or{}c(h("UNIT",28)..h("LOAD",8)..h("ACTIVE",10)..h("SUB",12).."DESCRIPTION")local q1=0 for r1,o1 in ipairs(n1)do if(not m1 or o1.kind==m1)and(p1 or o1.active~="inactive")then c(h(o1.name,28)..h("loaded",8)..h(o1.active,10)..h(o1.sub,12)..o(o1))q1=q1+1 end end if q1==0 then c("0 units listed.")else c("")c(q1.." units listed.")end end local function m(m1)local o1=syscalls["init.list"]()or{}c(h("UNIT FILE",32)..h("STATE",12).."TYPE")for q1,p1 in ipairs(o1)do if not m1 or p1.name:find(m1,1,true)then local n1=p1.enabled and"enabled"or"disabled"if#(p1.wantedBy or{})==0 and not p1.enabled then n1="static"end c(h(p1.name,32)..h(n1,12)..p1.kind)end end end local function x(o1)local s1=0 for t1,q1 in ipairs(o1)do local m1=syscalls["init.status"](g(q1))if not m1 then b("Unit "..q1.." could not be found.\n")s1=4 else local r1=(m1.active=="failed")and"x"or(m1.active=="inactive"and"o"or"*")c(r1.." "..m1.name.." - "..o(m1))local n1="loaded ("..(m1.path or"?").."; "..(m1.enabled and"enabled"or"disabled")..")"c("     Loaded: "..n1)local p1=(m1.active=="active"or m1.active=="activating")and(" since "..t(m1.startMs))or""c("     Active: "..m1.active.." ("..m1.sub..")"..p1)if m1.pid then c("   Main PID: "..m1.pid.." ("..m1.name:gsub("%..-$","")..")")end if m1.exec then c("    ExecStart: "..m1.exec)end if m1.exitCode~=nil or m1.termSig then c("     Exit: code="..tostring(m1.exitCode).." signal="..tostring(m1.termSig))end if m1.failReason then c("     Error: "..m1.failReason)end c("")if m1.active=="failed"then s1=3 end end end return s1 end local function l(n1,o1)local r1=0 for t1,q1 in ipairs(o1)do local m1=g(q1)local s1,p1=syscalls["init."..n1](m1)if not s1 then b("Failed to "..n1.." "..m1..": "..tostring(p1).."\n")r1=1 end end return r1 end local function v(n1)local p1=0 for r1,o1 in ipairs(n1)do local q1=syscalls["init.status"](g(o1))local m1=q1 and q1.active or"unknown"c(m1)if m1~="failed"then p1=3 end end return p1 end local function s(m1)local p1=0 for r1,n1 in ipairs(m1)do local q1=syscalls["init.status"](g(n1))if not q1 or not q1.path then b("No files found for "..n1..".\n")p1=1 else c("# "..q1.path)local o1=fs.open(q1.path,"r")if not o1 then b("Failed to read "..q1.path.."\n")p1=1 else io.write(o1:readAll()or"")o1:close()end end end return p1 end local function u(n1)local p1=0 for r1,o1 in ipairs(n1)do local q1=syscalls["init.status"](g(o1))local m1=q1 and q1.active or"unknown"c(m1)if m1~="active"then p1=3 end end return p1 end local function p(m1)local p1=0 for q1,o1 in ipairs(m1)do local n1=g(o1)if syscalls["init.isEnabled"](n1)then c("enabled")else c("disabled")p1=1 end end return p1 end local e,f,y,a=nil,nil,false,{}local q,w,b1,d=false,false,false,nil local z=1 while z<=#n do local k=n[z]if d and k:sub(1,1)~="-"then a[#a+1]=k elseif not e and k:sub(1,1)~="-"then e=k elseif k=="--all"or k=="-a"then y=true elseif k=="--now"then q=true elseif k=="--quiet"or k=="-q"then w=true elseif k=="--no-pager"or k=="--no-legend"or k=="--full"or k=="--value"or k=="--plain"or k=="--no-block"then elseif k=="--version"then c("systemctl (Delin OS)");return 0 elseif k=="-s"or k=="--signal"then d=n[z+1]if not d then b("systemctl: option '"..k.."' requires an argument\n");return 2 end z=z+1 elseif k:match("^%-%-signal=")then d=k:sub(10)elseif k:match("^%-%-type=")then f=k:sub(8)elseif k=="--type"and n[z+1]then f=n[z+1];z=z+1 elseif k=="--help"or k=="-h"then c("systemctl [list-units|list-unit-files|list-timers|status|start|stop|restart|enable|disable]\n".."          [is-active|is-failed|is-enabled|cat|kill|daemon-reload|shutdown] [UNIT...]")return 0 elseif k:sub(1,1)=="-"and k~="-"then b("systemctl: invalid option '"..k.."'\n")return 1 else a[#a+1]=k end z=z+1 end if not e then b("systemctl: missing command (see systemctl --help)\n")return 1 end if e=="kill"then if#a==0 then b("systemctl: kill: missing unit name\n");return 1 end local j=nil if d then j=syscalls["signal.number"]and syscalls["signal.number"](d)j=j or tonumber(d)if not j then b("systemctl: unknown signal '"..d.."'\n");return 1 end else j=15 end local d1=0 for l1,a1 in ipairs(a)do local j1=syscalls["init.status"](g(a1))if not j1 or not j1.pid then b("Failed to kill unit "..a1..": no main process\n")d1=1 else local i1,g1=syscalls["signal.kill"](j1.pid,j)if not i1 then b("Failed to kill unit "..a1..": "..tostring(g1).."\n");d1=1 end end end return d1 elseif e=="is-failed"then if#a==0 then b("systemctl: is-failed: missing unit name\n");return 1 end return v(a)elseif e=="cat"then if#a==0 then b("systemctl: cat: missing unit name\n");return 1 end return s(a)elseif e=="list-timers"then if f and f~="timer"then return 0 end return i("timer",y)elseif e=="list-units"then i(f,y)elseif e=="list-unit-files"then m(a[1])elseif e=="status"then if#a==0 then i(nil,true)else return x(a)end elseif e=="start"or e=="stop"or e=="restart"then if#a==0 then b("systemctl: "..e..": missing unit name\n")return 1 end return l(e,a)elseif e=="enable"or e=="disable"then if#a==0 then b("systemctl: "..e..": missing unit name\n")return 1 end local e1=l(e,a)if q and e1==0 then local c1=l(e=="enable"and"start"or"stop",a)if c1~=0 then e1=c1 end end return e1 elseif e=="is-active"then if#a==0 then b("systemctl: is-active: missing unit name\n")return 1 end return u(a)elseif e=="is-enabled"then if#a==0 then b("systemctl: is-enabled: missing unit name\n")return 1 end return p(a)elseif e=="daemon-reload"then local h1,f1=syscalls["init.reload"]()if not h1 then b("systemctl: daemon-reload: "..tostring(f1).."\n")return 1 end elseif e=="shutdown"then syscalls["init.shutdown"]()c("shutting down")else b("systemctl: unknown command '"..e.."'\n")return 1 end return 0