local b=args or{}local j="\n"local o=(type(cwd)=="string"and cwd)or"/"local function p(d1)d1=d1 or""if d1==""then return(o=="/")and"/"or o end if d1:sub(1,1)=="/"then if d1=="/"then return"/"end return d1:gsub("/+$","")end local c1=(o=="/")and""or o return(c1.."/"..d1):gsub("/+","/")end local function a(d1)local c1=io.stderr()if c1 and c1.write then c1:write(d1)end end local function q(c1)if c1 and(c1:find("permission")or c1:find("denied"))then return"Permission denied"end if c1 and c1:lower():find("no such file")then return"No such file or directory"end if c1 and c1:find("directory")then return"Is a directory"end return"No such file or directory"end local g=4 local i=nil local f=false local c={}local h=false local function e(c1)if c1=="d"or c1=="o"or c1=="x"then i=c1;return true end a("strings: invalid radix: '"..c1.."'\n")return false end local k=1 while k<=#b do local d=b[k]if h then c[#c+1]=d elseif d=="--"then h=true elseif d=="-a"or d=="-all"or d=="--all"then elseif d=="-f"or d=="--print-file-name"then f=true elseif d=="-o"then i="o"elseif d=="-s"or d=="--output-separator"then k=k+1 local a1=b[k]if not a1 then a("strings: option '"..d.."' requires an argument\n");return 2 end j=a1 elseif d:match("^%-%-output%-separator=")then j=d:sub(21)elseif d:match("^%-%-bytes=")then local y=tonumber(d:sub(9))if not y or y<1 then a("strings: invalid integer argument '"..d:sub(9).."'\n");return 1 end g=y elseif d:match("^%-%-radix=")then if not e(d:sub(9))then return 1 end elseif d=="-n"or d=="--bytes"then k=k+1 if not b[k]then a("strings: option requires an argument -- 'n'\n");return 1 end local x=tonumber(b[k])if not x or x<1 then a("strings: invalid integer argument '"..b[k].."'\n");return 1 end g=x elseif d=="-t"or d=="--radix"then k=k+1 if not b[k]then a("strings: option requires an argument -- 't'\n");return 1 end if not e(b[k])then return 1 end elseif d:sub(1,1)=="-"and d~="-"and d:sub(1,2)~="--"then local s=2 while s<=#d do local n=d:sub(s,s)if n=="a"then s=s+1 elseif n=="f"then f=true;s=s+1 elseif n=="n"or n=="t"then local m=d:sub(s+1)if m==""then k=k+1 if not b[k]then a("strings: option requires an argument -- '"..n.."'\n");return 1 end m=b[k]end if n=="n"then local w=tonumber(m)if not w or w<1 then a("strings: invalid integer argument '"..m.."'\n");return 1 end g=w else if not e(m)then return 1 end end s=#d+1 else a("strings: invalid option -- '"..n.."'\n")return 1 end end elseif d:sub(1,2)=="--"then a("strings: unrecognized option '"..d.."'\n")return 1 else c[#c+1]=d end k=k+1 end if#c==0 then c={"-"}end local function l(c1)return(c1>=0x20 and c1<=0x7E)or c1==0x09 end local function r(l1,k1)local e1={}local function i1()if#e1>0 then io.write(table.concat(e1));e1={}end end local g1=0 local c1=nil local h1={}local function f1()if c1 and#h1>=g then if f then e1[#e1+1]=k1..": "end if i then local o1=(i=="d"and"%7d")or(i=="o"and"%7o")or"%7x"e1[#e1+1]=string.format(o1,c1).." "end e1[#e1+1]=table.concat(h1)..j if#e1>=256 then i1()end end c1=nil h1={}end while true do local d1 if l1.read then d1=l1:read(65536)end if type(d1)~="string"or d1==""then local m1=l1:readLine()if m1==nil then break end d1=m1.."\n"end for j1=1,#d1 do local n1=d1:byte(j1)if l(n1)then if not c1 then c1=g1 end h1[#h1+1]=d1:sub(j1,j1)else f1()end g1=g1+1 end end f1()i1()end for b1,u in ipairs(c)do if u=="-"then local z=io.stdin()if not z then a("strings: cannot read stdin\n");return 1 end r(z,"-")else local v,t=fs.open(p(u),"r")if not v then a("strings: "..u..": "..q(t).."\n")return 1 end r(v,u)v:close()end end