local e=args or{}local m=(type(cwd)=="string"and cwd)or"/"local function n(z)z=z or""if z==""then return(m=="/")and"/"or m end if z:sub(1,1)=="/"then if z=="/"then return"/"end return z:gsub("/+$","")end local y=(m=="/")and""or m return(y.."/"..z):gsub("/+","/")end local function b(z)local y=io.stderr()if y and y.write then y:write(z)end end local function i(z)if not z:match("^[0-7]+$")then return nil end local y=tonumber(z,8)if not y or y>tonumber("7777",8)then return nil end return y end local function j(z,y)return math.floor(z/(2^y))%2==1 end local function k(z,a1,b1)local y=2^a1 if b1 then return j(z,a1)and z or(z+y)end return j(z,a1)and(z-y)or z end local function g(f1,g1)local c1=f1%512 for e1 in g1:gmatch("[^,]+")do local a1,i1,b1=e1:match("^([ugoa]*)([-+=])([rwxXstugo]*)$")if not a1 or b1==""then return nil end if a1==""then a1="a"end local z={}for j1=1,#b1 do local h1=b1:sub(j1,j1)if h1=="r"then z[#z+1]=2 elseif h1=="w"then z[#z+1]=1 elseif h1=="x"or h1=="X"then z[#z+1]=0 elseif h1=="s"or h1=="t"then else return nil end end local y={}if a1:find("u")then y[#y+1]=6 end if a1:find("g")then y[#y+1]=3 end if a1:find("o")then y[#y+1]=0 end if#y==0 then return nil end for m1,d1 in ipairs(y)do if i1=="="then for n1,l1 in ipairs({2,1,0})do c1=k(c1,d1+l1,false)end end for o1,k1 in ipairs(z)do c1=k(c1,d1+k1,i1~="-")end end end return c1 end local a=nil local c={}local o=1 local d=false while o<=#e do local l=e[o]if d then c[#c+1]=l elseif l=="--"then d=true elseif l=="--mode"then o=o+1 if not e[o]then b("mkfifo: option '--mode' requires an argument\n");return 1 end a=e[o]elseif l:sub(1,8)=="--mode="then a=l:sub(9)elseif l:sub(1,1)=="-"and l~="-"and#l>1 then local q=2 while q<=#l do local s=l:sub(q,q)if s=="m"then if q<#l then a=l:sub(q+1)q=#l else o=o+1 if not e[o]then b("mkfifo: option requires an argument -- 'm'\n");return 1 end a=e[o]end else b("mkfifo: invalid option -- '"..s.."'\n")return 1 end q=q+1 end else c[#c+1]=l end o=o+1 end if#c==0 then b("mkfifo: missing operand\n")return 1 end local f=nil if a~=nil then f=i(a)if f==nil then f=g(tonumber("666",8),a)if f==nil then b("mkfifo: invalid mode: '"..a.."'\n")return 1 end end end local p=0 for x,h in ipairs(c)do local w=n(h)if fs.exists(w)then b("mkfifo: cannot create fifo '"..h.."': File exists\n")p=1 else local v,u=fs.mkfifo(w)if not v then b("mkfifo: cannot create fifo '"..h.."': "..tostring(u).."\n")p=1 elseif f~=nil then local t,r=fs.chmod(w,f)if not t then b("mkfifo: cannot set mode of '"..h.."': "..tostring(r).."\n")p=1 end end end end return p