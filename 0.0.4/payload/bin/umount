local j=args or{}local function b(r)local q=io.stderr()if q and q.write then q:write(r)end end local a,d,g={},false,false for n,f in ipairs(j)do if d then a[#a+1]=f elseif f=="--"then d=true elseif f=="-v"or f=="--verbose"then g=true elseif f=="-l"or f=="--lazy"or f=="-f"or f=="--force"then b("umount: option '"..f.."' is not supported\n")return 2 elseif f:sub(1,2)=="--"then b("umount: unrecognized option '"..f.."'\n")return 1 elseif f:sub(1,1)=="-"and f~="-"then b("umount: invalid option -- '"..f:sub(2,2).."'\n")return 1 else a[#a+1]=f end end if#a==0 then b("umount: missing operand\n")return 1 elseif#a>1 then b("umount: too many arguments\n")return 1 end local e=a[1]local h=(syscalls and syscalls["fs.mounts"]and syscalls["fs.mounts"]())or{}local c for p,l in ipairs(h)do if l.root==e then c=l.root;break end end if not c then for o,i in ipairs(h)do if i.device and(i.device==e or i.device=="/dev/"..e)then c=i.root;break end end end if not c then b("umount: "..e..": not mounted\n")return 1 end local m,k=syscalls["fs.umount"](c)if not m then b("umount: "..tostring(k).."\n")return 1 end io.write("unmounted "..c.."\n")