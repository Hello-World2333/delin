local l=args or{}local function a(c2)local b2=io.stderr()if b2 and b2.write then b2:write(c2)end end local function m(b2)local c2=fs.open(b2,"r")if not c2 then return nil end local d2=c2:readAll()c2:close()return d2 end local function s(c2)local e2={}for b2 in c2:gmatch("[^\n]+")do local d2,f2=b2:match("^(%w+):%s*(.*)$")if d2 then e2[d2]=f2 end end return e2 end local function f1()local b2=m("/proc/self/stat")if not b2 then return nil end return tonumber(b2:match("^(%d+)"))end local function v()local b2={}for f2,e2 in ipairs(fs.list("/proc")or{})do local d2=tonumber(e2)if d2 then local c2=m("/proc/"..d2.."/comm")if c2 then b2[#b2+1]={pid=d2,comm=(c2:gsub("\n$",""))}end end end table.sort(b2,function(g2,h2)return g2.pid<h2.pid end)return b2 end local function t(b2)local c2=tonumber(b2)if c2 then return c2 end local d2=syscalls and syscalls["user.get"]and syscalls["user.get"](b2)if not d2 then return nil end return d2.uid end local function c(b2)local c2=tostring(b2):gsub("^%-","")if c2:match("^%d+$")then return tonumber(c2)end if c2:match("^SIG")then c2=c2:sub(4)end return syscalls["signal.number"](c2)end local n=15 local l1,m1,k=false,false,nil local j={}local g,b,o,f=false,false,false,false local i,h=false,false local q=false local d1=1 while d1<=#l do local a1=l[d1]if a1=="--"then for t1=d1+1,#l do j[#j+1]=l[t1]end break elseif a1:sub(1,2)=="--"then local e,z=a1:match("^%-%-([%w-]+)=?(.*)$")if e=="verbose"then g=true elseif e=="interactive"then b=true elseif e=="wait"then o=true elseif e=="ignore-case"then f=true elseif e=="regexp"then i=true elseif e=="exact"then q=true elseif e=="process-group"then h=true elseif e=="older-than"or e=="younger-than"then a("killall: option '--"..e.."' is not supported (no process start time)\n")return 2 elseif e=="signal"then if z==""then d1=d1+1;z=l[d1]end if not z then a("killall: option '--signal' requires an argument\n");return 2 end n=c(z)if not n then a("killall: unknown signal "..z.."\n");return 2 end else a("killall: unrecognized option '"..a1.."'\n")return 2 end elseif a1:sub(1,1)=="-"and#a1>1 then local g1=2 while g1<=#a1 do local c1=a1:sub(g1,g1)if c1=="e"then l1,q=true,true elseif c1=="v"then g=true elseif c1=="i"then b=true elseif c1=="w"then o=true elseif c1=="I"then f=true elseif c1=="r"then i=true elseif c1=="g"then h=true elseif c1=="q"then m1=true elseif c1=="l"then local s1={}for x1,u1 in ipairs(syscalls["signal.list"]())do s1[#s1+1]=syscalls["signal.name"](u1)end io.write(table.concat(s1," ").."\n")return 0 elseif c1=="s"then local y=a1:sub(g1+1)if y==""then d1=d1+1;y=l[d1]end if not y then a("killall: option requires an argument -- 's'\n");return 2 end n=c(y)if not n then a("killall: unknown signal "..y.."\n");return 2 end g1=#a1 elseif c1=="u"then local x=a1:sub(g1+1)if x==""then d1=d1+1;x=l[d1]end if not x then a("killall: option requires an argument -- 'u'\n");return 2 end k=t(x)if k==nil then a("killall: user '"..x.."' does not exist\n");return 2 end g1=#a1 elseif c1:match("%d")or c1:match("%u")then n=c(a1:sub(g1))if not n then a("killall: unknown signal "..a1:sub(g1).."\n");return 2 end g1=#a1 else a("killall: invalid option -- '"..c1.."'\n")return 2 end g1=g1+1 end else j[#j+1]=a1 end d1=d1+1 end if#j==0 then a("usage: killall [-SIGNAL] [-v] [-i] [-w] [-I] [-r] [-g] [-q] [-u user] name...\n");return 2 end local self=f1()local p1=v()local p=0 local d={}local function r(c2,b2)if i then local d2=syscalls["regex.compile"](b2,"ere",{icase=f})if not d2 then a("killall: invalid regular expression: "..tostring(b2).."\n")p=2 return false end return d2:find(c2)~=nil end if f then return c2:lower()==b2:lower()end return c2==b2 end for z1,k1 in ipairs(j)do local n1,w=0,0 for a2,h1 in ipairs(p1)do if h1.pid~=self and r(h1.comm,k1)then local e1=true if k~=nil then local v1=s(m("/proc/"..h1.pid.."/status")or"")e1=(tonumber(v1.Uid)or-1)==k end if e1 then w=w+1 local u=true if b then io.write("Kill "..h1.comm.."("..h1.pid..") ? ")io.flush()local o1=io.stdin()local j1=o1 and o1.readLine and o1:readLine()or nil u=(j1~=nil)and(j1:match("^[yY]")~=nil)end if u then local q1,i1 if h then q1,i1=syscalls["signal.killpg"](h1.pgrp or h1.pid,n)else q1,i1=syscalls["signal.kill"](h1.pid,n)end if q1 then n1=n1+1 d[#d+1]=h1.pid if g or l1 then io.write("Killed "..h1.comm.."("..h1.pid..") with signal "..tostring(n).."\n")end else a("killall: "..h1.pid..": "..tostring(i1).."\n")end end end end end if w==0 then if not m1 then a("killall: "..k1..": no process found\n")end p=1 end end if o and#d>0 then for y1=1,600 do local b1=false for w1,r1 in ipairs(d)do if fs.exists("/proc/"..r1)then b1=true end end if not b1 then break end if os.msleep then os.msleep(50)else os.sleep(0.05)end end end return p