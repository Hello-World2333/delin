local h=args or{}local function c(p)local o=io.stderr()if o and o.write then o:write(p)end end local function g(q)q=q or""local p=q:gsub("/+$","")if p==""then return(q~="")and"/"or"."end local o=p:match("^(.*)/[^/]*$")if not o then return"."end o=o:gsub("/+$","")if o==""then return"/"end return o end local d=false local a,b={},false for n,f in ipairs(h)do if b then a[#a+1]=f elseif f=="--"then b=true elseif f=="-z"or f=="--zero"then d=true elseif f:sub(1,1)=="-"and f~="-"then for k=2,#f do local i=f:sub(k,k)if i=="z"then d=true else c("dirname: invalid option -- '"..i.."'\n")return 1 end end else a[#a+1]=f end end if#a==0 then c("dirname: missing operand\n")return 1 end local j=d and"\0"or"\n"local e={}for m,l in ipairs(a)do e[#e+1]=g(l)..j end io.write(table.concat(e))