local d=args or{}local function b(d1)local c1=io.stderr()if c1 and c1.write then c1:write(d1)end end local s,t="user.notice","logger"local c={}local k,h,l,p,i=false,false,false,false,false local a,e=nil,nil local m=1 while m<=#d do local f=d[m]if f=="-p"and d[m+1]then s=d[m+1];m=m+1 elseif f:match("^%-%-priority=")then s=f:sub(12)elseif f=="-t"and d[m+1]then t=d[m+1];m=m+1 elseif f:match("^%-%-tag=")then t=f:sub(7)elseif f=="-i"or f=="--id"then k=true elseif f=="-s"or f=="--stderr"then h=true elseif f=="-e"or f=="--skip-empty"then l=true elseif f=="--no-act"then p=true elseif f=="--prio-prefix"then i=true elseif f=="-u"or f=="--socket"then if d[m+1]and d[m+1]~="/dev/log"then b("logger: option '-u' only supports /dev/log\n")return 2 end m=m+1 elseif f=="-f"or f=="--file"then a=d[m+1]if not a then b("logger: option '-f' requires an argument\n");return 2 end m=m+1 elseif f:match("^%-S")or f=="--size"then e=tonumber(f:match("^%-S(%d+)$")or d[m+1])if not e then b("logger: option '-S' requires a numeric argument\n");return 2 end if f=="--size"then m=m+1 end elseif f=="-n"or f=="--server"or f=="-P"or f=="--port"or f=="-d"or f=="--udp"or f=="-T"or f=="--tcp"or f=="--rfc3164"or f:match("^%-%-rfc5424")then b("logger: option '"..f.."' is not supported\n")return 2 elseif f=="--"then for b1=m+1,#d do c[#c+1]=d[b1]end break elseif f=="--help"or f=="-h"then io.write("usage: logger [-p facility.severity] [-t tag] [message ...]\n")return 0 elseif f:sub(1,1)=="-"and f~="-"then b("logger: invalid option '"..f.."'\n")return 1 else c[#c+1]=f end m=m+1 end local g,j=s:match("^([%w]+)%.([%w]+)$")if not g then g,j=s,"notice"end local y=syscalls["syslog.facility"](g)local z=syscalls["syslog.severity"](j)if not y then b("logger: unknown facility '"..g.."'\n")return 1 end if not z then b("logger: unknown severity '"..j.."'\n")return 1 end local a1=y*8+z local r=fs.open("/dev/log","w")if not r then b("logger: /dev/log: cannot open\n")return 1 end local q=t if k then q=t.."["..tostring(pid or 0).."]"end local function x(d1,e1)if e and#d1>e then d1=d1:sub(1,e)end local g1=e1 or a1 local c1="<"..g1..">"..q..": "..d1 if p then io.write(c1.."\n")else r:writeLine(c1)end if h then local f1=io.stderr()if f1 and f1.write then f1:write(c1.."\n")end end end local function n(c1)if l and c1:match("^%s*$")then return end local f1 if i then local e1,d1=c1:match("^<(%-?%d+)>(.*)$")if e1 then f1,c1=tonumber(e1),d1 end end x(c1,f1)end if a then local u if a=="-"then u=io.stdin()else u=fs.open(a,"r")end if not u then b("logger: "..a..": cannot open\n");return 1 end while true do local v=u.readLine and u:readLine()if v==nil then break end n(v)end if a~="-"then u:close()end elseif#c>0 then x(table.concat(c," "))else local o=io.stdin()while true do local w=o and o.readLine and o:readLine()if w==nil then break end n(w)end end r:flush()r:close()return 0