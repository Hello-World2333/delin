local p=args or{}local function c(x)local w=io.stderr()if w and w.write then w:write(x)end end local function k()c("Usage: mkfs.ext2 [-b block-size] [-N number-of-inodes] [-L volume-label]\n".."                 [-m reserved-percentage] [-n] [-q] [-F] [-v] device [blocks]\n")end local d,e,g,a,o local i,r,q,n=false,false,false,false local b,j={},false local t=1 while t<=#p do local h=p[t]local function l(w)local x=p[t+1]if not x then c("mkfs.ext2: option requires an argument -- '"..w.."'\n")return nil end t=t+1 return x end if j then b[#b+1]=h elseif h=="--"then j=true elseif h=="-n"then i=true elseif h=="-q"then r=true elseif h=="-F"then q=true elseif h=="-v"then n=true elseif h=="-b"or h:match("^%-b.+")then d=(h=="-b")and l("b")or h:sub(3)if d==nil then return 1 end elseif h=="-N"or h:match("^%-N.+")then e=(h=="-N")and l("N")or h:sub(3)if e==nil then return 1 end elseif h=="-L"or h:match("^%-L.+")then g=(h=="-L")and l("L")or h:sub(3)if g==nil then return 1 end elseif h=="-m"or h:match("^%-m.+")then a=(h=="-m")and l("m")or h:sub(3)if a==nil then return 1 end elseif h=="-t"or h:match("^%-t.+")then local v=(h=="-t")and l("t")or h:sub(3)if v==nil then return 1 end if v~="ext2"then c("mkfs.ext2: unsupported filesystem type '"..v.."'\n")k()return 1 end elseif h:sub(1,1)=="-"and h~="-"then c("mkfs.ext2: invalid option -- '"..h:sub(2,2).."'\n")k()return 1 else b[#b+1]=h end t=t+1 end if#b==0 then c("mkfs.ext2: no device specified\n")k()return 1 elseif#b>2 then c("mkfs.ext2: too many arguments\n")k()return 1 end local s=b[1]if b[2]then if not b[2]:match("^%d+$")then c("mkfs.ext2: invalid block count '"..b[2].."'\n")return 1 end o=tonumber(b[2])end local function m(a1,w,y,x)if a1==nil then return nil end if not a1:match("^%d+$")then c("mkfs.ext2: invalid "..w.." '"..a1.."'\n")return false end local z=tonumber(a1)if z<y or z>x then c(string.format("mkfs.ext2: %s %d is out of range (%d..%d)\n",w,z,y,x))return false end return z end if d then d=m(d,"block size",1024,4096)if d==false then return 1 end end if e then e=m(e,"inode count",1,1000000)if e==false then return 1 end end if a then a=m(a,"reserved percentage",0,99)if a==false then return 1 end end if g and#g>15 then c("mkfs.ext2: volume label '"..g.."' is longer than 15 bytes\n")return 1 end if not(syscalls and syscalls["blkdev.mkfs"])then c("mkfs.ext2: blkdev.mkfs syscall not available\n")return 1 end local f,u=syscalls["blkdev.mkfs"](s,{blocks=o,blockSize=d,inodes=e,label=g,reservedPercent=a,force=q,dryRun=i,})if not f then c("mkfs.ext2: "..tostring(u).."\n")return 1 end if not r then io.write(string.format("%sCreating filesystem with %d %dk blocks and %d inodes\n",i and"(dry run) "or"",f.blocks,f.blockSize/1024,f.inodes))io.write("Filesystem label="..tostring(f.label).."\n")io.write(string.format("Reserved block count=%d (%d%%)\n",f.rBlocks,f.reservedPercent or 0))if n then io.write(string.format("Free blocks=%d, free inodes=%d, data starts at block %d\n",f.freeBlocks,f.freeInodes,f.dataStart))end if i then io.write("Nothing written (dry run)\n")else io.write("Allocating group tables: done\n")io.write("Writing inode tables: done\n")io.write("Writing superblocks and filesystem accounting information: done\n")end end