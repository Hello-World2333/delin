local b1=args or{}local n1=(type(cwd)=="string"and cwd)or"/"local function u1(a3)a3=a3 or""if a3==""then return(n1=="/")and"/"or n1 end if a3:sub(1,1)=="/"then if a3=="/"then return"/"end return a3:gsub("/+$","")end local z2=(n1=="/")and""or n1 return(z2.."/"..a3):gsub("/+","/")end local function e(a3)local z2=io.stderr()if z2 and z2.write then z2:write(a3)end end local function h2(z2)if z2 and(z2:find("permission")or z2:find("denied"))then return"Permission denied"end if z2 and(z2:find("[Nn]o such")or z2:find("not found"))then return"No such file or directory"end if z2 and z2:lower():find("no such file")then return"No such file or directory"end if z2 and z2:find("directory")then return"Is a directory"end return"No such file or directory"end local c,d,z,m,b=512,false,false,false,false local l=false local r=false local a1=false local g,f=nil,nil local j,w={},false local v={k=1024,K=1024,KB=1000,M=1048576,MB=1000000,G=1073741824,GB=1000000000,T=1099511627776,TB=1000000000000}local function k(d3)d3=tostring(d3 or""):gsub("^%s+",""):gsub("%s+$","")local b3,a3=d3:match("^(%d+%.?%d*)(%a*)$")if not b3 then return nil end local c3=tonumber(b3)if c3<=0 then return nil end if a3~=""then local z2=v[a3]or v[a3:upper()]if not z2 then return nil end c3=c3*z2 end return math.floor(c3)end local function h(b3)local z2={}for a3 in(tostring(b3 or"")..","):gmatch("([^,]*),")do a3=a3:gsub("%s","")if a3~=""then z2[#z2+1]=a3 end end return z2 end local function f1(z2)z2=z2 or""if g then local a3=false for e3,b3 in ipairs(g)do if b3==z2 then a3=true end end if not a3 then return false end end if f then for d3,c3 in ipairs(f)do if c3==z2 then return false end end end return true end local function l1(z2)if z2=="k"then c,d=1024,false elseif z2=="h"then d=true elseif z2=="P"then b=true elseif z2=="a"then z=true elseif z2=="T"then m=true elseif z2=="i"then l=true elseif z2=="H"then d,r=true,true elseif z2=="B"or z2=="t"or z2=="x"then return true else e("df: invalid option -- '"..z2.."'\n");return false end return true end local y=1 while y<=#b1 do local p=b1[y]if w then j[#j+1]=p elseif p=="--"then w=true elseif p=="--kilobytes"then c,d=1024,false elseif p=="--human-readable"then d=true elseif p=="--si"then d,r=true,true elseif p=="--portability"then b=true elseif p=="--all"then z=true elseif p=="--print-type"then m=true elseif p=="--inodes"then l=true elseif p=="--total"then a1=true elseif p=="-B"or p=="--block-size"then y=y+1 local m2=b1[y]if not m2 then e("df: option '"..p.."' requires an argument\n");return 2 end c=k(m2)if not c then e("df: invalid --block-size argument '"..m2.."'\n");return 2 end elseif p:match("^%-%-block%-size=")then c=k(p:sub(14))if not c then e("df: invalid --block-size argument '"..p:sub(14).."'\n");return 2 end elseif p:match("^%-B.")then c=k(p:sub(3))if not c then e("df: invalid --block-size argument '"..p:sub(3).."'\n");return 2 end elseif p=="-t"or p=="--type"then y=y+1 local r2=b1[y]if not r2 then e("df: option '"..p.."' requires an argument\n");return 2 end g=h(r2)elseif p:match("^%-%-type=")then g=h(p:sub(8))elseif p:match("^%-t.")then g=h(p:sub(3))elseif p=="-x"or p=="--exclude-type"then y=y+1 local q2=b1[y]if not q2 then e("df: option '"..p.."' requires an argument\n");return 2 end f=h(q2)elseif p:match("^%-%-exclude%-type=")then f=h(p:sub(16))elseif p:match("^%-x.")then f=h(p:sub(3))elseif p:sub(1,2)=="--"then e("df: unrecognized option '"..p.."'\n")return 2 elseif p:sub(1,1)=="-"and p~="-"then for o2=2,#p do if not l1(p:sub(o2,o2))then return 2 end end else j[#j+1]=p end y=y+1 end local d1=syscalls and syscalls["fs.mounts"]if not d1 then e("df: fs.mounts syscall not available\n")return 1 end local h1=d1()or{}local function d2(f3)local b3=r and 1000 or 1024 if f3<b3 then return string.format("%d",f3)end local a3={r and"k"or"K","M","G","T","P","E"}local z2,e3=1,f3/b3 while e3>=b3 and z2<#a3 do e3=e3/b3;z2=z2+1 end if e3<10 then local c3=math.ceil(e3*10)/10 if c3<10 then return string.format("%.1f",c3)..a3[z2]end end lo