if m then a[#a+1]={head="Type",right=false,min=0,vals={}}end if l then a[#a+1]={head="Inodes",right=true,min=b and 10 or 0,vals={}}a[#a+1]={head="IUsed",right=true,min=b and 10 or 0,vals={}}a[#a+1]={head="IFree",right=true,min=b and 10 or 0,vals={}}a[#a+1]={head="IUse%",right=true,min=b and 5 or 0,vals={}}else local m1=d and"Size"or(c==1024 and"1024-blocks"or"512-blocks")a[#a+1]={head=m1,right=true,min=b and 10 or 0,vals={}}a[#a+1]={head="Used",right=true,min=b and 10 or 0,vals={}}a[#a+1]={head=d and"Avail"or"Available",right=true,min=b and 10 or 0,vals={}}a[#a+1]={head="Capacity",right=true,min=b and 5 or 0,vals={}}end a[#a+1]={head="Mounted on",right=false,min=0,vals={}}for w2,s in ipairs(n)do local o=1 a[o].vals[#a[o].vals+1]=s.dev;o=o+1 if m then a[o].vals[#a[o].vals+1]=s.fstype;o=o+1 end if l then local s1,r1,w1=c1(s)local o1=s.files a[o].vals[#a[o].vals+1]=o1 and tostring(o1)or"-";o=o+1 a[o].vals[#a[o].vals+1]=s1 and tostring(s1)or"-";o=o+1 a[o].vals[#a[o].vals+1]=r1 and tostring(r1)or"-";o=o+1 a[o].vals[#a[o].vals+1]=w1 and(w1.."%")or"-";o=o+1 else a[o].vals[#a[o].vals+1]=x(s.cap);o=o+1 a[o].vals[#a[o].vals+1]=x(s.used);o=o+1 a[o].vals[#a[o].vals+1]=x(s.free);o=o+1 a[o].vals[#a[o].vals+1]=s.pct and(s.pct.."%")or"-";o=o+1 end a[o].vals[#a[o].vals+1]=s.root end local g1={}for l2,v1 in ipairs(a)do local n2=math.max(#v1.head,v1.min)for t2,p2 in ipairs(v1.vals)do if#p2>n2 then n2=#p2 end end g1[l2]=n2 end local j2=b and" "or"  "local function i1(z2)local a3={}for b3,c3 in ipairs(a)do a3[b3]=c3.right and string.format("%"..g1[b3].."s",z2[b3])or string.format("%-"..g1[b3].."s",z2[b3])end return(table.concat(a3,j2):gsub("%s+$",""))end local p1={}for k2,g2 in ipairs(a)do p1[k2]=g2.head end io.write(i1(p1).."\n")for s2,q in ipairs(n)do local i={}local u=1 i[u]=q.dev;u=u+1 if m then i[u]=q.fstype;u=u+1 end if l then local t1,q1,x1=c1(q)i[u]=q.files and tostring(q.files)or"-";u=u+1 i[u]=t1 and tostring(t1)or"-";u=u+1 i[u]=q1 and tostring(q1)or"-";u=u+1 i[u]=x1 and(x1.."%