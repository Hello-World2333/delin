local i=args or{}local function b(q)local p=io.stderr()if p and p.write then p:write(q)end end local c,a,e,h=nil,{},false,false local g,f=false,false local m=1 while m<=#i do local k=i[m]if e then a[#a+1]=k elseif k=="--"then e=true elseif k=="-a"or k=="--all"then h=true elseif k=="-t"then if not i[m+1]then b("mount: option requires an argument -- 't'\n");return end c=i[m+1]m=m+1 elseif k:match("^%-t.+")then c=k:sub(3)elseif k:match("^%-%-type=")then c=k:sub(8)elseif k:sub(1,2)=="--"then b("mount: unrecognized option '"..k.."'\n")return 1 elseif k:sub(1,1)=="-"and k~="-"then for o=2,#k do local n=k:sub(o,o)if n=="f"then g=true elseif n=="v"then f=true else b("mount: invalid option -- '"..n.."'\n");return 1 end end else a[#a+1]=k end m=m+1 end local function j()local u=syscalls and syscalls["fs.mounts"]if not u then b("mount: fs.mounts syscall not available\n");return end local s=u()or{}local p={}for v,r in ipairs(s)do local t=r.device or((r.root=="/")and"rootfs"or"-")local q=t.." on "..r.root.." type "..(r.fstype or"?")..(r.ro and" (ro)"or" (rw)")if r.uuid then q=q.." uuid="..r.uuid end p[#p+1]=q end if#p==0 then p[#p+1]="(nothing mounted)"end io.write(table.concat(p,"\n").."\n")end local function l(p,r)if not fs.isDir(r)then b("mount: "..r..": No such file or directory\n")return 1 end if not(syscalls and syscalls["fs.mount"])then b("mount: fs.mount syscall not available\n")return 1 end if g then if f then io.write("mount: would mount "..p.." on "..r.."\n")end return 0 end local s,q=syscalls["fs.mount"](p,r,c)if not s then b("mount: "..tostring(q).."\n")return 1 end q=q or{}io.write("mounted "..(q.device or p).." on "..r.." type "..(q.fstype or c or"?").."\n")end local function d()if not(syscalls and syscalls["fstab.entries"])then b("mount: fstab.entries syscall not available\n")return 1 end local q,t=syscalls["fstab.entries"]()if not q then b("mount: "..tostring(t).."\n")return 1 end local r={}for x,v in ipairs(syscalls["fs.mounts"]()or{})do r[v.root]=true end local u=0 for y,s in ipairs(q)do if s.opts.noauto then elseif c and s.fstype~=c then elseif r[s.mountpoint]then io.write(s.mountpoint..": already mounted\n")else if not fs.exists(s.mountpoint)then fs.makeDir(s.mountpoint)end if g then if f then io.write("mount: would mount "..s.device.." on "..s.mountpoint.."\n")end else local w,p=syscalls["fs.mount"](s.device,s.mountpoint,s.fstype)if w then p=p or{}io.write("mounted "..(p.device or s.device).." on "..s.mountpoint.." type "..(p.fstype or s.fstype).."\n")else b("mount: "..tostring(p).."\n")u=1 end end end end return u end if h then return d()elseif#a==0 then j()elseif#a==1 then b("mount: "..a[1]..": missing mount point\n")return 1 elseif#a==2 then return l(a[1],a[2])else b("mount: too many arguments\n")return 1 end