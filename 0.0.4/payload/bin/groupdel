local f=args or{}local function b(k)local j=io.stderr()if j and j.write then j:write(k)end end local function c(j)if j then b("groupdel: "..j.."\n")end b("usage: groupdel name\n")return 2 end if not(syscalls and syscalls["user.delGroup"])then b("groupdel: user syscalls not available\n")return 1 end local a,d=nil,false for i,e in ipairs(f)do if d then if a then return c("extra operand '"..e.."'")end a=e elseif e=="--"then d=true elseif e:sub(1,1)=="-"and e~="-"then return c("invalid option -- '"..e:sub(2,2).."'")else if a then return c("extra operand '"..e.."'")end a=e end end if not a then return c("no group name given")end local h,g=syscalls["user.delGroup"](a)if not h then b("groupdel: "..tostring(g).."\n")return 1 end return 0