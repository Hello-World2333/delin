local e=args or{}local s=(type(cwd)=="string"and cwd)or"/"local function u(i1)i1=i1 or""if i1==""then return(s=="/")and"/"or s end if i1:sub(1,1)=="/"then if i1=="/"then return"/"end return i1:gsub("/+$","")end local h1=(s=="/")and""or s return(h1.."/"..i1):gsub("/+","/")end local function a(i1)local h1=io.stderr()if h1 and h1.write then h1:write(i1)end end local function w(h1)if h1 and(h1:find("permission")or h1:find("denied"))then return"Permission denied"end if h1 and h1:lower():find("no such file")then return"No such file or directory"end if h1 and h1:find("directory")then return"Is a directory"end return"No such file or directory"end local c1,x=10,"lines"local f=false local h=false local c={}local g,d=false,false local i=false local function b(i1,l1)i1=tostring(i1 or"")local j1,h1=i1:match("^%s*([+%-]?)(%d+)")if not h1 then return false end local k1=tonumber(h1)if k1<0 then return false end c1,x=k1,l1 f=(j1=="-")return true end local r=1 while r<=#e do local j=e[r]if i then c[#c+1]=j elseif j=="--"then i=true elseif j=="--quiet"or j=="--silent"then g,d,g=true,false,false elseif j=="--verbose"then d,g=true,false elseif j=="--zero-terminated"then h=true elseif j:match("^%-%-lines=")then if not b(j:sub(9),"lines")then a("head: invalid number of lines: '"..j:sub(9).."'\n");return 1 end elseif j:match("^%-%-bytes=")then if not b(j:sub(9),"bytes")then a("head: invalid number of bytes: '"..j:sub(9).."'\n");return 1 end elseif j=="-n"or j=="--lines"then r=r+1 if not e[r]then a("head: option requires an argument -- 'n'\n");return 1 end if not b(e[r],"lines")then a("head: invalid number of lines: '"..e[r].."'\n");return 1 end elseif j=="-c"or j=="--bytes"then r=r+1 if not e[r]then a("head: option requires an argument -- 'c'\n");return 1 end if not b(e[r],"bytes")then a("head: invalid number of bytes: '"..e[r].."'\n");return 1 end elseif j:sub(1,2)=="--"then a("head: unrecognized option '"..j.."'\n")return 1 elseif j:sub(1,1)=="-"and j~="-"then if j:match("^%-(%d+)$")then b(j:sub(2),"lines")else local b1=2 while b1<=#j do local n=j:sub(b1,b1)if n=="n"or n=="c"then local k=j:sub(b1+1)if k==""then r=r+1 k=e[r]if not k then a("head: option requires an argument -- '"..n.."'\n");return 1 end end local z=(n=="n")and"lines"or"bytes"if not b(k,z)then a("head: invalid number of "..z..": '"..k.."'\n");return 1 end b1=#j+1 else if n=="q"then g,d,g=true,false,false elseif n=="v"then d,g=true,false elseif n=="z"then h=true else a("head: invalid option -- '"..n.."'\n");return 1 end b1=b1+1 end end end else c[#c+1]=j end r=r+1 end if#c==0 then c={"-"}end local a1=#c local l=(not g)and(a1>1 or d)local function q(h1)if not l then return end local i1=(h1=="-")and"standard input"or h1 io.write("==> "..i1.." <==\n")end local function m(j1)if j1.readAll then return j1:readAll()or""end local h1={}while true do local i1=j1:readLine()if i1==nil then break end h1[#h1+1]=i1 end return table.concat(h1,"\n")end local function p(m1)if f or h then local function h1(t1,s1)local p1,q1={},1 while true do local r1=t1:find(s1,q1,true)if not r1 then if q1<=#t1 then p1[#p1+1]=t1:sub(q1)end return p1 end p1[#p1+1]=t1:sub(q1,r1-1)q1=r1+1 end end local k1=h and"\0"or"\n"local i1=h1(m(m1),k1)local l1=f and math.max(0,#i1-c1)or math.min(c1,#i1)for o1=1,l1 do io.write(i1[o1]..k1)end return end local n1=0 while n1<c1 do local j1=m1:readLine()if j1==nil then break end io.write(j1.."\n")n1=n1+1 end end local function o(k1)if f then local l1=m(k1)io.write(l1:sub(1,math.max(0,#l1-c1)))return end local h1=c1 if k1 and k1.read then local j1=false while h1>0 do local i1=k1:read(h1)if not i1 or i1==""then break end j1=true io.write(i1)h1=h1-#i1 end if j1 then return end end local m1=m(k1)io.write(m1:sub(1,c1))end local function v(h1)if x=="bytes"then o(h1)else p(h1)end end for g1,y in ipairs(c)do if y=="-"then q("-")local t=io.stdin()if t then v(t)end else local f1=u(y)local e1,d1=fs.open(f1,"r")if not e1 then a("head: "..f1..": "..w(d1).."\n")return 1 end q(y)v(e1)e1:close()end end return 0