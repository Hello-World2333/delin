h1==""then a1=a1+1;h1=o[a1]end if not h1 then d("option requires an argument -- '"..s.."'");return 2 end if s=="p"then a(c.pids,h1)elseif s=="t"then a(c.ttys,h1)elseif s=="o"then i1(h1)else a(c.users,h1)end i2=#x1 else d("invalid option -- '"..s.."'");return 2 end i2=i2+1 end else for g3=1,#x1 do local t2=x1:sub(g3,g3)if t2=="a"then c.selA=true elseif t2=="x"then c.selX=true elseif t2=="u"then c.format="user"elseif t2=="e"then c.selAll=true elseif t2=="f"then c.format="full"elseif t2=="l"then c.format="long"else d("invalid option -- '"..t2.."'");return 2 end end end a1=a1+1 end local r if c.selAll or(c.selA and c.selX)or#c.pids>0 or#c.ttys>0 or#c.users>0 then r="all"elseif c.selA then r="alltty"elseif c.selX then r="anytty"else r="default"end local f1=i("/proc/self/stat")local x=i("/proc/self/status")if not f1 or not x then g1("ps: cannot read /proc/self\n")return 1 end local self=b1(f1)if not self then g1("ps: malformed /proc/self/stat\n")return 1 end local j1=tonumber(q(x).Uid)or 0 local m1={}for e4,r3 in ipairs(fs.list("/proc")or{})do local o2=tonumber(r3)if o2 then m1[#m1+1]=o2 end end table.sort(m1)local s1={}for f4,v1 in ipairs(m1)do local z2=i("/proc/"..v1.."/stat")local u=z2 and b1(z2)if u then local j3=q(i("/proc/"..v1.."/status")or"")s1[#s1+1]={pid=v1,comm=u.comm,state=u.state,ppid=u.ppid,pgrp=u.pgrp,sess=u.sess,tty=u.tty,uid=tonumber(j3.Uid)or 0,gid=tonumber(j3.Gid)or 0,cmd=h2(i("/proc/"..v1.."/cmdline")),}end end local l,m,n if#c.pids>0 then l={}for r4,k3 in ipairs(c.pids)do local i3=tonumber(k3)if not i3 then d("invalid process id: "..k3);return 2 end l[i3]=true end end if#c.ttys>0 then m={}for u4,x3 in ipairs(c.ttys)do m[y1(x3)]=true end end if#c.users>0 then n={}for q4,d3 in ipairs(c.users)do local b3=tonumber(d3)if not b3 then local p3=syscalls and syscalls["user.get"]and syscalls["user.get"](d3)if not p3 then d("user '"..d3.."' does not exist");return 2 end b3=p3.uid end n[b3]=true end end local z1=self.tty local e1={}for p4,r1 in ipairs(s1)do local e if r=="all"then e=true elseif r=="alltty"then e=r1.tty~="0"and not(c.posixA and r1.pid==r1.sess)elseif r=="anytty"then e=r1.uid==j1 else e=r1.uid==j1 and r1.tty==z1 end if e and l and not l[r1.pid]then e=false end if e and m and not m[r1.tty]then e=false end if e and n and not n[r1.uid]then e=false end if e and c.ppidFilter and not c.ppidFilter[r1.ppid]then e=false end if e and c.commFilter and not c.commFilter[r1.comm]then e=false end if e and c.pgrpFilter and not c.pgrpFilter[r1.pgrp]then e=false end if e and c.gidFilter and not c.gidFilter[r1.gid]then e=false end if e and c.sessFilter and not c.sessFilter[r1.sess]then e=false end if c.deselect then e=not e end if e then e1[#e1+1]=r1 end end if c.ppids then c.ppidFilter={}for k4,q3 in ipairs(c.ppids)do local y2=tonumber(q3)if not y2 then d("invalid parent pid: "..q3);return 2 end c.ppidFilter[y2]=true end end if c.commFilter then local s2={}for l4,c4 in ipairs(c.commFilter)do s2[c4]=true end c.commFilter=s2 end if c.pgrpFilter then local p2={}for w4,a4 in ipairs(c.pgrpFilter)do p2[tonumber(a4)or-1]=true end c.pgrpFilter=p2 end if c.gidFilter then local r2={}for m4,e3 in ipairs(c.gidFilter)do local j2=tonumber(e3)if not j2 then local f3=syscalls and syscalls["user.groupByName"]and syscalls["user.groupByName"](e3)j2=f3 and f3.gid end if not j2 then d("group '"..e3.."' does not exist");return 2 end r2[j2]=true end c.gidFilter=r2 end if c.sessFilter then local q2={}for h4,b4 in ipairs(c.sessFilter)do q2[tonumber(b4)or-1]=true end c.sessFilter=q2 end local o1={pid={header="PID",get=function(x4)return tostring(x4.pid)end},ppid={header="PPID",get=function(x4)return tostring(x4.ppid)end},pgrp={header="PGRP",get=function(x4)return tostring(x4.pgrp)end},pgid={header="PGID",get=function(x4)return tostring(x4.pgrp)end},sess={header="SESS",get=function(x4)return tostring(x4.sess)end},session={header="SESS",get=function(x4)return tostring(x4.sess)end},uid={header="UID",get=function(x4)return tostring(x4.uid)end},user={header