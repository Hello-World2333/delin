local o=args or{}local function g1(y4)local x4=io.stderr()if x4 and x4.write then x4:write(y4)end end local function i(x4)local y4=fs.open(x4,"r")if not y4 then return nil end local z4=y4:readAll()y4:close()return z4 end local function h2(x4)if not x4 or x4==""then return nil end local y4,a5={},0 for z4=1,#x4 do local c5=x4:byte(z4)a5=a5+1 y4[a5]=(c5==0)and" "or x4:sub(z4,z4)end local b5=table.concat(y4,""):gsub("%s+$","")if b5==""then return nil end return b5 end local function q(y4)local a5={}for x4 in y4:gmatch("[^\n]+")do local z4,b5=x4:match("^(%w+):%s*(.*)$")if z4 then a5[z4]=b5 end end return a5 end local function b1(d5)local y4,z4,f5,b5,a5,c5,e5,x4=d5:match("^(%d+) %((.*)%) (%a+) (%d+) (%d+) (%d+) (%S+) (%-?%d+)")if not y4 then return nil end return{pid=tonumber(y4),comm=z4,state=f5,ppid=tonumber(b5),pgrp=tonumber(a5),sess=tonumber(c5),tty=e5,tpgid=tonumber(x4),}end local function y1(x4)if x4=="?"then return"0"end local y4=x4:match("^/dev/(.+)$")or x4 if y4:match("^%d+$")then return"tty"..y4 end return y4 end local function t1(y4)local x4=syscalls and syscalls["user.byUid"]local z4=x4 and x4(y4)return(z4 and z4.name)or tostring(y4)end local function q1(y4)local x4=syscalls and syscalls["user.groupByGid"]local z4=x4 and x4(y4)return(z4 and z4.name)or tostring(y4)end local c={selAll=false,selA=false,selX=false,posixA=false,format=nil,fields={},pids={},ttys={},users={},ppids=nil,sort=nil,deselect=false,forest=false,commFilter=nil,pgrpFilter=nil,gidFilter=nil,sessFilter=nil,}local function a(x4,y4)for z4 in tostring(y4):gmatch("[^,%s]+")do x4[#x4+1]=z4 end end local function i1(x4)for y4 in tostring(x4):gmatch("[^,%s]+")do c.fields[#c.fields+1]=y4 end end local function d(x4)g1("ps: "..x4.."\n")end local a1=1 while a1<=#o do local x1=o[a1]if x1=="--"then if o[a1+1]then d("unexpected operand: "..o[a1+1]);return 2 end break elseif x1:sub(1,2)=="--"then local f,g=x1:match("^%-%-([%w%-]+)=?(.*)$")if f=="no-headers"then c.noHeaders=true elseif f=="headers"then c.noHe