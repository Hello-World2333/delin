local t=args or{}local function e(d1)local c1=io.stderr()if c1 and c1.write then c1:write(d1)end end local function f(c1)if c1 then e("id: "..c1.."\n")end e("usage: id [-u] [-g] [-G] [-n] [-r] [USER]\n")return 2 end local d,l,a,p=nil,false,nil,false local o=false for a1,s in ipairs(t)do if p then if a then return f("extra operand '"..s.."'")end a=s elseif s=="--"then p=true elseif s:sub(1,1)=="-"and s~="-"then for y=2,#s do local i=s:sub(y,y)if i=="u"or i=="g"or i=="G"then if d and d~=i then return f("cannot print \"only\" of more than one choice")end d=i elseif i=="n"then l=true elseif i=="r"then elseif i=="z"then o=true elseif i=="a"then else return f("invalid option -- '"..i.."'")end end else if a then return f("extra operand '"..s.."'")end a=s end end if l and not d then return f("cannot print only names in default format")end if o and not d then e("id: option --zero not permitted in default format\n")return 1 end if not(syscalls and syscalls["user.byUid"]and syscalls["user.groupByName"])then e("id: user syscalls not available\n")return 1 end local b,n if a then b=syscalls["user.get"](a)if not b then e("id: '"..a.."': no such user\n")return 1 end n=b.uid else n=uid b=syscalls["user.byUid"](uid)end local c=b and b.gid if c==nil then c=gid end local function g()local d1={}local c1=syscalls["user.groupByGid"]and syscalls["user.groupByGid"](c)d1[#d1+1]={gid=c,name=c1 and c1.name or nil}if b and syscalls["user.groupsOf"]then for g1,e1 in ipairs(syscalls["user.groupsOf"](b.name)or{})do local f1=syscalls["user.groupByName"](e1)if f1 and f1.gid~=c then d1[#d1+1]={gid=f1.gid,name=e1}end end end return d1 end local function r(d1,c1)return c1 and(d1.."("..c1..")")or tostring(d1)end local function k(d1,c1)if l then return tostring(c1 or d1)end return tostring(d1)end local v=o and"\0"or" "local q=o and"\0"or"\n"if d=="u"then io.write(k(n,b and b.name)..q)elseif d=="g"then local j=syscalls["user.groupByGid"]and syscalls["user.groupByGid"](c)io.write(k(c,j and j.name)..q)elseif d=="G"then local m={}for z,x in ipairs(g())do m[#m+1]=k(x.gid,x.name)end io.write(table.concat(m,v)..q)else local h=g()local u={}for b1,w in ipairs(h)do u[#u+1]=r(w.gid,w.name)end io.write("uid="..r(n,b and b.name).." gid="..r(c,h[1]and h[1].name).." groups="..table.concat(u,",").."\n")end return 0