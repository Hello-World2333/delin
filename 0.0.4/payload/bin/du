local g=args or{}local k1=(type(cwd)=="string"and cwd)or"/"local function m1(d2)d2=d2 or""if d2==""then return(k1=="/")and"/"or k1 end if d2:sub(1,1)=="/"then if d2=="/"then return"/"end return d2:gsub("/+$","")end local c2=(k1=="/")and""or k1 return(c2.."/"..d2):gsub("/+","/")end local function d(d2)local c2=io.stderr()if c2 and c2.write then c2:write(d2)end end local function r1(c2)if c2 and(c2:find("permission")or c2:find("denied"))then return"Permission denied"end if c2 and(c2:find("[Nn]o such")or c2:find("not found"))then return"No such file or directory"end if c2 and c2:lower():find("no such file")then return"No such file or directory"end if c2 and c2:find("directory")then return"Is a directory"end return"No such file or directory"end local u,j,y,o=false,false,false,false local b,c=512,false local n,e,s=math.huge,{},false local k=false local q=false local a=nil local h={}local r=nil local p={k=1024,K=1024,KB=1000,M=1048576,MB=1000000,G=1073741824,GB=1000000000,b=512}local function f(g2)g2=tostring(g2 or""):gsub("^%s+",""):gsub("%s+$","")local e2,d2=g2:match("^(%d+%.?%d*)(%a*)$")if not e2 then return nil end local f2=tonumber(e2)if f2<0 then return nil end if d2~=""then local c2=p[d2]or p[d2:upper()]if not c2 then return nil end f2=f2*c2 end return math.floor(f2)end local function f1(d2,c2)local e2="^"..d2:gsub("[%^%$%(%)%%%.%[%]%+%-%?%*]",function(f2)if f2=="*"then return".*"end if f2=="?"then return"."end return"%"..f2 end).."$"return c2:match(e2)~=nil end local function j1(c2)if c2=="a"then u=true elseif c2=="s"then j=true elseif c2=="k"then b,c=1024,false elseif c2=="b"then b,c=1,false elseif c2=="h"then b,c=1,true elseif c2=="c"then o=true elseif c2=="x"then y=true elseif c2=="m"then b,c=1048576,false elseif c2=="H"then b,c,k=1,true,true elseif c2=="l"then q=true elseif c2=="L"then r=true elseif c2=="P"then r=false elseif c2=="B"or c2=="t"then return true else d("du: invalid option -- '"..c2.."'\n");return false end return true end local function l(d2)local c2=tonumber(d2)if not c2 or c2<0 or c2~=math.floor(c2)then d("du: invalid maximum depth '"..tostring(d2).."'\n")return false end n=c2 return true end local e1=1 while e1<=#g do local i=g[e1]if s then e[#e+1]=i elseif i=="--"then s=true elseif i=="--all"then u=true elseif i=="--summarize"then j=true elseif i=="--bytes"then b,c=1,false elseif i=="--human-readable"then b,c=1,true elseif i=="--total"then o=true elseif i=="--one-file-system"then y=true elseif i=="--si"then c,k=true,true elseif i=="--count-links"then q=true elseif i=="--dereference"then r=true elseif i=="--no-dereference"then r=false elseif i=="--apparent-size"or i=="--inodes"or i=="--files0-from"or i:match("^%-%-time")then d("du: option '"..i.."' is not supported\n")return 2 elseif i:match("^%-%-exclude=")then h[#h+1]=i:sub(11)elseif i=="--exclude"then if not g[e1+1]then d("du: option '--exclude' requires an argument\n");return 2 end h[#h+1]=g[e1+1];e1=e1+1 elseif i=="--threshold"or i=="-t"then if not g[e1+1]then d("du: option '"..i.."' requires an argument\n");return 2 end local t1=g[e1+1]local q1=t1:sub(1,1)=="-"a=f(q1 and t1:sub(2)or t1)if not a then d("du: invalid --threshold argument '"..t1.."'\n");return 2 end if q1 then a=-a end e1=e1+1 elseif i:match("^%-%-threshold=")then local u1=i:sub(13)local o1=u1:sub(1,1)=="-"a=f(o1 and u1:sub(2)or u1)if not a then d("du: invalid --threshold argument '"..u1.."'\n");return 2 end if o1 then a=-a end elseif i=="--block-size"or i=="-B"then if not g[e1+1]then d("du: option '"..i.."' requires an argument\n");return 2 end local x1=f(g[e1+1])if not x1 or x1<1 then d("du: invalid block size '"..g[e1+1].."'\n");return 2 end b,c=x1,false e1=e1+1 elseif i:match("^%-B.")then local y1=f(i:sub(3))if not y1 or y1<1 then d("du: invalid block size '"..i:sub(3).."'\n");return 2 end b,c=y1,false elseif i:match("^%-t.")then local v1=i:sub(3)local p1=v1:sub(1,1)=="-"a=f(p1 and v1:sub(2)or v1)if not a then d("du: invalid --threshold argument '"..v1.."'\n");return 2 end if p1 then a=-a end elseif i=="--max-depth"then if not g[e1+1]then d("du: option '--max-depth' requires an argument\n");return 1 end if not l(g[e1+1])then return 1 end e1=e1+1 elseif i:match("^%-%-max%-depth=")then if not l(i:sub(13))then return 1 end elseif i:match("^%-%-block%-size=")then local s1=i:sub(14)local w1=f(s1)if not w1 or w1<1 then d("du: invalid block size '"..s1.."'\n")return 2 end b,c=w1,false elseif i:sub(1,1)=="-"and i~="-"then for z1=2,#i do if not j1(i:sub(z1,z1))then return 1 end end else e[#e+1]=i end e1=e1+1 end if j then n=0 end local function l1(i2)local e2=k and 1000 or 1024 if i2<e2 then return string.format("%d",i2)end local d2={k and"k"or"K","M","G","T","P","E"}local c2,h2=1,i2/e2 while h2>=e2 and c2<#d2 do h2=h2/e2;c2=c2+1 end if h2<10 then local f2=math.ceil(h2*10)/10 if f2<10 then return string.format("%.1f",f2)..d2[c2]end end local g2=math.ceil(h2)if g2>=1024 and c2<#d2 then g2,c2=1,c2+1 end return string.format("%d",g2)..d2[c2]end local function v(c2)if fs.attributes then local d2=fs.attributes(c2)if d2 and d2.blocks then return d2.blocks*512 end end return fs.getSize(c2)or 0 end local function t(c2)return math.ceil(c2/b)*b end local function h1(c2,e2,d2)if d2>n then return end if a then if a>=0 and c2<a then return end if a<0 and c2>-a then return end end local f2=c and l1(c2)or string.format("%d",c2/b)io.write(f2.."\t"..e2.."\n")end local function i1(c2)for e2,d2 in ipairs(h)do if f1(d2,c2)then return true end end return false end local function g1(c2)return c2=="/dev"or c2=="/proc"or c2=="/sys"or c2:sub(1,5)=="/dev/"or c2:sub(1,6)=="/proc/"or c2:sub(1,5)=="/sys/"end local function a1(d2)local c2=fs.attributes(d2)return c2~=nil and c2.kind=="device"end local function b1(d2,c2)if d2=="/"then return"/"..c2 end return d2.."/"..c2 end local function n1(m2,i2,h2,f2,k2)local l2=fs.list(m2)or{}table.sort(l2)local c2=0 for p2,o2 in ipairs(l2)do if o2~="."and o2~=".."and not i1(o2)then local d2=b1(m2,o2)local e2=b1(h2,o2)local g2=false if r==false