local p=args or{}local function c(l1)local k1=io.stderr()if k1 and k1.write then k1:write(l1)end end local e,j={},false local g,b=nil,"full"local a=nil local d,o=false,false local function h(m1,l1)local k1=p[m1+1]if not k1 then c("blkid: option '"..l1.."' requires an argument\n")end return k1 end local function n(k1)k1=(k1 or""):upper()if k1~="UUID"and k1~="TYPE"and k1~="LABEL"then c("blkid: unknown tag '"..k1.."'\n")return false end g=g or{}g[#g+1]=k1 return true end local m=1 while m<=#p do local f=p[m]if j then e[#e+1]=f elseif f=="--"then j=true elseif f=="-s"or f=="--match-tag"then local c1=h(m,f);if not c1 then return 2 end if not n(c1)then return 2 end m=m+1 elseif f:match("^%-%-match%-tag=")then if not n(f:sub(13))then return 2 end elseif f=="-o"or f=="--output"then local b1=h(m,f);if not b1 then return 2 end b=b1;m=m+1 elseif f:match("^%-%-output=")then b=f:sub(10)elseif f=="-U"or f=="--uuid"then local e1=h(m,f);if not e1 then return 2 end a={key="UUID",value=e1};b="device";d=true;m=m+1 elseif f:match("^%-%-uuid=")then a={key="UUID",value=f:sub(8)};b="device";d=true elseif f=="-L"or f=="--label"then local d1=h(m,f);if not d1 then return 2 end a={key="LABEL",value=d1};b="device";d=true;m=m+1 elseif f:match("^%-%-label=")then a={key="LABEL",value=f:sub(9)};b="device";d=true elseif f=="-t"or f=="--match-token"then local x=h(m,f);if not x then return 2 end local a1,w=x:match("^([%a]+)=(.*)$")if not a1 then c("blkid: invalid token '"..x.."'\n");return 2 end a={key=a1:upper(),value=w};m=m+1 elseif f:match("^%-%-match%-token=")then local z,v=f:sub(15):match("^([%a]+)=(.*)$")if not z then c("blkid: invalid token '"..f:sub(15).."'\n");return 2 end a={key=z:upper(),value=v}elseif f=="-k"or f=="--list-filesystems"then o=true elseif f=="-l"or f=="--list-one"then d=true elseif f=="-h"or f=="--help"then io.write("usage: blkid [-s TAG] [-o FORMAT] [-U UUID] [-L LABEL] [-t NAME=value] [device...]\n")return 0 elseif f=="-V"or f=="--version"then io.write("blkid (Delin OS)\n")return 0 elseif f=="-p"or f=="--probe"or f=="-c"or f=="-w"or f=="-i"or f=="-u"or f=="-n"or f=="-S"or f=="-g"or f=="-H"or f=="-d"or f=="-D"or f=="-O"then c("blkid: option '"..f.."' is not supported\n")return 2 elseif f:sub(1,1)=="-"and f~="-"then c("blkid: invalid option -- '"..f:sub(2,2).."'\n")return 1 else e[#e+1]=f end m=m+1 end if b~="full"and b~="value"and b~="device"and b~="export"and b~="list"then c("blkid: unsupported output format '"..b.."'\n")return 2 end local q=syscalls and syscalls["blkdev.list"]and syscalls["blkdev.list"]()if not q then c("blkid: blkdev.list syscall not available\n")return 1 end local function u(k1)local l1=k1:gsub("^/dev/","")for n1,m1 in ipairs(q)do if m1.name==l1 then return m1 end end return nil end local function l(l1,k1)if k1=="UUID"then return l1.uuid end if k1=="TYPE"then return l1.fstype end if k1=="LABEL"then return l1.label end end local function k(l1)if not a then return true end local k1=l(l1,a.key)if not k1 then return false end if a.key=="UUID"or a.key=="LABEL"then return k1:lower()==a.value:lower()end return k1==a.value end local function r(l1)if not k(l1)then return false end if b=="device"then io.write(l1.node.."\n")return true end if b=="list"then io.write(l1.node..":")if l1.uuid then io.write(" UUID=\""..l1.uuid.."\"")end if l1.fstype then io.write(" TYPE=\""..l1.fstype.."\"")end if l1.label then io.write(" LABEL=\""..l1.label.."\"")end io.write("\n")return true end local m1=g or{"UUID","TYPE","LABEL"}local k1={}for s1,n1 in ipairs(m1)do local p1=l(l1,n1)if p1 then k1[#k1+1]=n1..'="'..p1..'"'end end if b=="value"then for r1,o1 in ipairs(k1)do io.write((o1:match('"(.*)"$')or o1).."\n")end elseif b=="export"then for t1,q1 in ipairs(k1)do io.write(q1.."\n")end else io.write(l1.node..": "..table.concat(k1," ").."\n")end return true end if o then local t=syscalls["fs.fstypes"]and syscalls["fs.fstypes"]()or{}for i1,g1 in ipairs(t)do io.write(g1.."\n")end return 0 end local i=false if#e==0 then for j1,f1 in ipairs(q)do if r(f1)then i=true if d then break end end end else for h1,s in ipairs(e)do local y=u(s)if y then if r(y)then i=true end else if not d then c("blkid: "..s..": not a block device\n")end end end end if a and not i then return 2 end return 0