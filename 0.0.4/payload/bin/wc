local y=args or{}local a1=(type(cwd)=="string"and cwd)or"/"local function q(w1)w1=w1 or""if w1==""then return(a1=="/")and"/"or a1 end if w1:sub(1,1)=="/"then if w1=="/"then return"/"end return w1:gsub("/+$","")end local v1=(a1=="/")and""or a1 return(v1.."/"..w1):gsub("/+","/")end local function e(w1)local v1=io.stderr()if v1 and v1.write then v1:write(w1)end end local function e1(v1)if v1 and(v1:find("permission")or v1:find("denied"))then return"Permission denied"end if v1 and v1:lower():find("no such file")then return"No such file or directory"end if v1 and v1:find("directory")then return"Is a directory"end return"No such file or directory"end local w,x,v,b1,j=false,false,false,false,false local c,a=nil,"auto"local d={}local k=false local function z(v1)if v1=="l"then w=true elseif v1=="w"then x=true elseif v1=="c"then v=true elseif v1=="m"then b1=true elseif v1=="L"then j=true else e("wc: invalid option -- '"..v1.."'\n");return false end return true end for t1,o in ipairs(y)do if k then d[#d+1]=o elseif o=="--"then k=true elseif o=="--lines"then w=true elseif o=="--words"then x=true elseif o=="--bytes"then v=true elseif o=="--chars"then b1=true elseif o=="--max-line-length"then j=true elseif o=="--files0-from"then i=i+1 local s1=y[i]if not s1 then e("wc: option '--files0-from' requires an argument\n");return 2 end c=s1 elseif o:match("^%-%-files0%-from=")then c=o:sub(15)elseif o=="--total"then i=i+1 local k1=y[i]if not k1 then e("wc: option '--total' requires an argument\n");return 2 end if k1=="always"then a="always"elseif k1=="only"then a="only"elseif k1=="never"then a="never"elseif k1=="auto"then a="auto"else e("wc: invalid argument '"..k1.."' for '--total'\n");return 2 end elseif o:match("^%-%-total=")then local n1=o:sub(9)if n1=="always"then a="always"elseif n1=="only"then a="only"elseif n1=="never"then a="never"elseif n1=="auto"then a="auto"else e("wc: invalid argument '"..n1.."' for '--total'\n");return 2 end elseif o:sub(1,2)=="--"then e("wc: unrecognized option '"..o.."'\n")return 1 elseif o:sub(1,1)=="-"and o~="-"then for q1=2,#o do if not z(o:sub(q1,q1))then return 1 end end else d[#d+1]=o end end if not(w or x or v or b1 or j)then w,x,v=true,true,true end local function h(w1)local v1=0;for x1 in w1:gmatch("%S+")do v1=v1+1 end;return v1 end local function r(y1)local x1,v1=0,1 while v1<=#y1 do x1=x1+1 local w1=y1:byte(v1)if w1<0xC0 then v1=v1+1 elseif w1<0xE0 then v1=v1+2 elseif w1<0xF0 then v1=v1+3 elseif w1<0xF8 then v1=v1+4 elseif w1<0xFC then v1=v1+5 else v1=v1+6 end end return x1 end local function l(w1,x1)local v1={}if w then v1[#v1+1]=tostring(x1.l)end if x then v1[#v1+1]=tostring(x1.w)end if v then v1[#v1+1]=tostring(x1.c)end if b1 then v1[#v1+1]=tostring(x1.m)end if j then v1[#v1+1]=tostring(x1.lmax)end if w1 then v1[#v1+1]=w1 end io.write(table.concat(v1," ").."\n")end local function g(v1)local y1=0 for z1 in v1:gmatch("\n")do y1=y1+1 end local w1=0 for x1 in(v1.."\n"):gmatch("(.-)\n")do if#x1>w1 then w1=#x1 end end return{l=y1,w=h(v1),c=#v1,m=r(v1),lmax=w1}end local function u(w1)local a2,y1,x1=0,0,table.concat(w1,"\n")for b2,z1 in ipairs(w1)do a2=a2+h(z1)if#z1>y1 then y1=#z1 end end local v1=math.max(0,#w1-1)return{l=#w1,w=a2,c=#x1+v1,m=r(x1)+v1,lmax=y1}end if#d==0 and not c then d={"-"}end if c then local m1 local i1 if c=="-"then m1=io.stdin()else m1,i1=fs.open(q(c),"r")end if not m1 then e("wc: "..c..": cannot open\n")return 1 end local f=m1:readAll()or""if c~="-"then m1:close()end local p=1 while p<=#f do local h1=f:find("\0",p,true)local t if h1 then t=f:sub(p,h1-1);p=h1+1 else t=f:sub(p);p=#f+1 end if t~=""then d[#d+1]=t end end end local b={l=0,w=0,c=0,m=0,lmax=0}local j1=#d>1 for u1,o1 in ipairs(d)do local g1=o1 local n if o1=="-"then local m=io.stdin()if not m then return end if m.readAll then local c1=m:readAll()or""n=g(c1)else local s={}while true do local f1=m:readLine()if f1==nil then break end s[#s+1]=f1 end n=u(s)end g1=nil else local r1=q(o1)local p1,l1=fs.open(r1,"r")if not p1 then e("wc: "..r1..": "..e1(l1).."\n")return 1 end local d1=p1:readAll()or""p1:close()n=g(d1)end l(g1,n)b.l=b.l+n.l b.w=b.w+n.w b.c=b.c+n.c b.m=b.m+n.m if n.lmax>b.lmax then b.lmax=n.lmax end end if a=="only"then l("total",b)elseif a=="always"then l("total",b)elseif a=="never"then elseif j1 then l("total",b)end