local n=args or{}local function i(f1)local e1=io.stderr()if e1 and e1.write then e1:write(f1)end end local d,a,c=false,{},false for y,m in ipairs(n)do if c then a[#a+1]=m elseif m=="--"then c=true elseif m=="-n"or m=="--noheadings"then d=true elseif m:sub(1,1)=="-"and m~="-"then i("lsblk: invalid option -- '"..m:sub(2,2).."'\n")return 1 else a[#a+1]=m end end local j=syscalls and syscalls["blkdev.list"]and syscalls["blkdev.list"]()if not j then i("lsblk: blkdev.list syscall not available\n")return 1 end local function l(f1)if not f1 or f1==0 then return"-"end local e1={"B","K","M","G","T"}local g1=1 while f1>=1024 and g1<#e1 do f1=f1/1024 g1=g1+1 end if g1==1 then return f1.."B"end return(string.format("%.1f",f1):gsub("%.0$",""))..e1[g1]end local e={}for b1,r in ipairs(j)do local o=(r.type=="part")and("  "..r.name)or r.name local t=table.concat(r.mounted or{},",")e[#e+1]={name=o,size=l(r.size),type=r.type,mp=t}end if#a>0 then local k={}for c1,p in ipairs(a)do local q=p:gsub("^/dev/","")for a1,v in ipairs(j)do if v.name==q then k[v.name]=true end end end local b={}for z,w in ipairs(e)do if k[w.name:gsub("^%s+","")]then b[#b+1]=w end end e=b end local f,g,h=#"NAME",#"SIZE",#"TYPE"for x,u in ipairs(e)do f=math.max(f,#u.name)g=math.max(g,#u.size)h=math.max(h,#u.type)end if not d then io.write((string.format("%-"..f.."s %-"..g.."s %-"..h.."s %s\n","NAME","SIZE","TYPE","MOUNTPOINT"):gsub("%s+\n$","\n")))end for d1,s in ipairs(e)do io.write((string.format("%-"..f.."s %-"..g.."s %-"..h.."s %s\n",s.name,s.size,s.type,s.mp):gsub("%s+\n$","\n")))end