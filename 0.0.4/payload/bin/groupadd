local f=args or{}local function d(t)local s=io.stderr()if s and s.write then s:write(t)end end local function c(s)if s then d("groupadd: "..s.."\n")end d("usage: groupadd [-g GID] name\n")return 2 end if not(syscalls and syscalls["user.addGroup"])then d("groupadd: user syscalls not available\n")return 1 end local b,a,j=nil,nil,false local g,k,h=false,false,nil local l=1 while l<=#f do local i=f[l]if j then if a then return c("extra operand '"..i.."'")end a=i elseif i=="--"then j=true elseif i:sub(1,1)=="-"and i~="-"then if i=="-r"or i=="--system"then g=true elseif i=="-f"or i=="--force"then k=true elseif i=="-U"or i=="--users"then h=f[l+1]if not h then return c("option requires an argument -- 'U'")end l=l+1 elseif i=="-g"or i=="--gid"then b=tonumber(f[l+1]or"")if not b then return c("option requires an argument -- 'g'")end l=l+1 elseif i:sub(1,2)~="-g"then return c("invalid option -- '"..i:sub(2,2).."'")end local e=i:sub(3)if e==""then l=l+1 e=f[l]end if e==nil then return c("option requires an argument -- 'g'")end if not e:match("^%d+$")then return c("invalid group ID '"..e.."'")end b=tonumber(e)else if a then return c("extra operand '"..i.."'")end a=i end l=l+1 end if not a then return c("no group name given")end if h then d("groupadd: option '-U' is not supported\n")return 2 end if k and syscalls["user.groupByName"](a)then return 0 end if g and not b then local n={}for r,q in ipairs(syscalls["user.groups"]()or{})do n[q.gid]=true end for m=999,1,-1 do if not n[m]then b=m;break end end if not b then d("groupadd: no free system GID available\n")return 1 end end local p,o=syscalls["user.addGroup"](a,b)if not p then d("groupadd: "..tostring(o).."\n")return 1 end return 0