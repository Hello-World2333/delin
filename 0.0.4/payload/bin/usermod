local j=args or{}local function e(u)local t=io.stderr()if t and t.write then t:write(u)end end local function d(t)if t then e("usermod: "..t.."\n")end e("usage: usermod [-u UID] [-g GROUP] [-G GROUPLIST [-a]] [-d HOME] [-s SHELL] [-c COMMENT] [-l NEWNAME] [-L|-U] name\n")return 2 end if not(syscalls and syscalls["user.modUser"])then e("usermod: user syscalls not available\n")return 1 end local a,c,i={},nil,false local o=1 while o<=#j do local n=j[o]if i then if c then return d("extra operand '"..n.."'")end c=n elseif n=="--"then i=true elseif n:sub(1,1)=="-"and n~="-"then local m=2 while m<=#n do local g=n:sub(m,m)if g=="a"then a.a=true;m=m+1 elseif g=="r"then a.r=true;m=m+1 elseif g=="L"then a.lock=true;m=m+1 elseif g=="U"then a.unlock=true;m=m+1 elseif g=="m"then return d("moving the home directory (-m) is not supported")elseif g=="u"or g=="g"or g=="G"or g=="d"or g=="s"or g=="c"or g=="l"then local f=n:sub(m+1)if f==""then o=o+1 f=j[o]end if f==nil then return d("option requires an argument -- '"..g.."'")end if g=="u"then if not f:match("^%d+$")then return d("invalid user ID '"..f.."'")end a.u=tonumber(f)elseif g=="g"then a.g=f elseif g=="G"then a.G=f elseif g=="d"then a.d=f elseif g=="s"then a.s=f elseif g=="c"then a.c=f else a.l=f end m=#n+1 else return d("invalid option -- '"..g.."'")end end else if c then return d("extra operand '"..n.."'")end c=n end o=o+1 end if not c then return d("no user name given")end if not syscalls["user.get"](c)then e("usermod: user '"..c.."' does not exist\n")return 1 end if a.a and not a.G then return d("-a may only be used together with -G")end if a.r and not a.G then return d("-r may only be used together with -G")end if a.a and a.r then return d("the options -a and -r are mutually exclusive")end if a.lock and a.unlock then return d("the options -L and -U are mutually exclusive")end if not(a.u or a.g or a.G or a.d or a.s or a.c or a.l or a.lock or a.unlock)then e("usermod: no changes\n")return 0 end local b={}if a.u then b.uid=a.u end if a.d then b.home=a.d end if a.s then b.shell=a.s end if a.c then b.full=a.c end if a.l then b.name=a.l end if a.lock then b.locked=true end if a.unlock then b.locked=false end if a.g then if a.g:match("^%d+$")then b.gid=tonumber(a.g)else local r=syscalls["user.groupByName"](a.g)if not r then e("usermod: group '"..a.g.."' does not exist\n");return 1 end b.gid=r.gid end end if a.G then local h={}for k in(a.G..","):gmatch("([^,]*),")do if k~=""then h[#h+1]=k end end for s,l in ipairs(h)do if not syscalls["user.groupByName"](l)then e("usermod: group '"..l.."' does not exist\n")return 1 end end if a.a then b.groupsAdd=h elseif a.r then b.groupsDel=h else b.groups=h end end local q,p=syscalls["user.modUser"](c,b)if not q then e("usermod: "..tostring(p).."\n")return 1 end return 0