local p=args or{}local u=(type(cwd)=="string"and cwd)or"/"local function o(n1)n1=n1 or""if n1==""then return(u=="/")and"/"or u end if n1:sub(1,1)=="/"then if n1=="/"then return"/"end return n1:gsub("/+$","")end local m1=(u=="/")and""or u return(m1.."/"..n1):gsub("/+","/")end local function c(n1)local m1=io.stderr()if m1 and m1.write then m1:write(n1)end end local function n(t1,s1,u1)local q1=(s1<=2)and(t1-1)or t1 local n1=math.floor(q1/400)local m1=q1-n1*400 local r1=(s1+9)%12 local p1=math.floor((153*r1+2)/5)+u1-1 local o1=m1*365+math.floor(m1/4)-math.floor(m1/100)+p1 return n1*146097+o1-719468 end local function r(r1,n1,o1,p1,m1,q1)return n(r1,n1,o1)*86400+p1*3600+m1*60+q1 end local function i()return math.floor(os.epoch("utc")/1000)end local function f(m1)m1=(m1 or""):gsub("^%s+",""):gsub("%s+$","")local x1=m1:match("^@(%d+)$")if x1 then return tonumber(x1)end local v1,r1,w1,y1,s1,z1=m1:match("^(%d%d%d%d)%-(%d%d)%-(%d%d)[T ](%d%d):(%d%d):(%d%d)$")if not v1 then v1,r1,w1=m1:match("^(%d%d%d%d)%-(%d%d)%-(%d%d)$")y1,s1,z1=0,0,0 end if not v1 then local t1,u1,a2=m1:match("^(%d%d):(%d%d):(%d%d)$")if t1 then local p1=i()local n1=p1-(p1%86400)return n1+tonumber(t1)*3600+tonumber(u1)*60+tonumber(a2)end t1,u1=m1:match("^(%d%d):(%d%d)$")if t1 then local q1=i()local o1=q1-(q1%86400)return o1+tonumber(t1)*3600+tonumber(u1)*60 end end if not v1 then return nil end v1,r1,w1,y1,s1,z1=tonumber(v1),tonumber(r1),tonumber(w1),tonumber(y1),tonumber(s1),tonumber(z1)if r1<1 or r1>12 or w1<1 or w1>31 or y1>23 or s1>59 or z1>60 then return nil end return r(v1,r1,w1,y1,s1,z1)end local function q(p1)p1=(p1 or""):gsub("^%s+",""):gsub("%s+$","")local m1,r1=p1:match("^(%d+)%.(%d%d)$")if not m1 then m1,r1=p1,nil end local t1,n1,q1,s1,o1 if#m1==12 then t1,n1,q1,s1,o1=m1:sub(1,4),m1:sub(5,6),m1:sub(7,8),m1:sub(9,10),m1:sub(11,12)elseif#m1==10 then local u1=m1:sub(1,2)t1=(tonumber(u1)>=69)and("19"..u1)or("20"..u1)n1,q1,s1,o1=m1:sub(3,4),m1:sub(5,6),m1:sub(7,8),m1:sub(9,10)elseif#m1==8 then t1=tostring(os.date("%Y",i()))n1,q1,s1,o1=m1:sub(1,2),m1:sub(3,4),m1:sub(5,6),m1:sub(7,8)else return nil end t1,n1,q1,s1,o1=tonumber(t1),tonumber(n1),tonumber(q1),tonumber(s1),tonumber(o1)if not t1 or n1<1 or n1>12 or q1<1 or q1>31 or s1>23 or o1>59 then return nil end return r(t1,n1,q1,s1,o1,tonumber(r1 or 0))end local g=false local d,e=false,false local a,b=nil,nil local l={}local h=false local s=1 local function k(n1,m1)local o1=p[n1+1]if not o1 then c("touch: option '"..m1.."' requires an argument\n")end return o1 end while s<=#p do local j=p[s]if h then l[#l+1]=j elseif j=="--"then h=true elseif j=="--no-create"then g=true elseif j=="--date"then local j1=k(s,j);if not j1 then return 2 end a=f(j1)if not a then c("touch: invalid date format '"..j1.."'\n");return 2 end s=s+1 elseif j:match("^%-%-date=")then a=f(j:sub(8))if not a then c("touch: invalid date format '"..j:sub(8).."'\n");return 2 end elseif j=="--reference"then local k1=k(s,j);if not k1 then return 2 end b=k1;s=s+1 elseif j:match("^%-%-reference=")then b=j:sub(13)elseif j=="--no-dereference"then c("touch: option '--no-dereference' is not supported\n")return 2 elseif j=="--time"or j:match("^%-%-time=")then local b1=(j=="--time")and k(s,j)or j:sub(8)if not b1 then return 2 end if j=="--time"then s=s+1 end if b1=="atime"or b1=="access"or b1=="use"then d=true elseif b1=="mtime"or b1=="modify"then e=true else c("touch: invalid argument '"..b1.."' for '--time'\n");return 2 end elseif j:sub(1,1)=="-"and j~="-"and#j>1 then local w=2 while w<=#j do local m=j:sub(w,w)if m=="c"then g=true;w=w+1 elseif m=="a"then d=true;w=w+1 elseif m=="m"then e=true;w=w+1 elseif m=="f"then w=w+1 elseif m=="h"then c("touch: option '-h' is not supported\n")return 2 elseif m=="d"or m=="t"or m=="r"then local y=j:sub(w+1)if y==""then s=s+1 y=p[s]if not y then c("touch: option requires an argument -- '"..m.."'\n");return 2 end end if m=="d"then a=f(y)if not a then c("touch: invalid date format '"..y.."'\n");return 2 end elseif m=="t"then a=q(y)if not a then c("touch: invalid date format '"..y.."'\n");return 2 end else b=y end w=#j+1 else c("touch: invalid option -- '"..m.."'\n")return 1 end end else l[#l+1]=j end s=s+1 end if#l==0 then c("touch: missing file operand\n")return 1 end if not d and not e then d,e=true,true end if b then local i1=o(b)local f1=fs.attributes(i1)if not f1 then c("touch: failed to get attributes of '"..b.."': No such file or directory\n")return 1 end a=f1.mtime or f1.modificationTime if not a then c("touch: '"..b.."': no timestamp available\n")return 1 end end local a1=0 for l1,z in ipairs(l)do local e1=o(z)if not fs.exists(e1)then if g then else local g1,c1=pcall(function()local m1=fs.open(e1,"w")if m1 then m1:close()end end)if not g1 then c("touch: cannot touch '"..z.."': "..tostring(c1).."\n")a1=1 end end end if fs.exists(e1)then local t,v local x=a or i()if d then t=x end if e then v=x end local h1,d1=fs.setTimes(e1,t,v)if not h1 then c("touch: setting times of '"..z.."': "..tostring(d1).."\n")a1=1 end end end return a1