tion r(k3)if not t[k3]then local m3,l3=fs.open(e(k3),"a")if not m3 then a("sed: couldn't open file "..k3..": "..tostring(l3).."\n")return nil end t[k3]=m3 end return t[k3]end local function q1(p3,m3)local l3={}for s3=1,#p3 do local q3=p3:sub(s3,s3)local r3=p3:byte(s3)if q3=="\\"then l3[#l3+1]="\\\\"elseif q3=="\n"then l3[#l3+1]="\\n"elseif q3=="\t"then l3[#l3+1]="\\t"elseif q3=="\r"then l3[#l3+1]="\\r"elseif r3<32 or r3==127 then l3[#l3+1]=string.format("\\%03o",r3)else l3[#l3+1]=q3 end end local o3=table.concat(l3)if m3 and m3>0 then local k3={}local n3=1 while n3<=#o3 do k3[#k3+1]=o3:sub(n3,n3+m3-1).."\\"n3=n3+m3 end if#k3==0 then return"$"end k3[#k3]=k3[#k3]:sub(1,-2)return table.concat(k3,"\n").."$"end return o3.."$"end local function w(x3,a4)local j4=#x3 local r3=false local o3=0 local u3=""local z3=1 while z3<=j4 and not r3 do local k3=x3[z3]local s3=false local m3=false local p3=false local n3={}local w3=1 while w3<=#s do local l3=s[w3]local t3=l1(l3,z3,k3,j4)if l3.neg then t3=not t3 end local v3=l3.type local q3=false if v3==":"then elseif v3=="{"then if not t3 then w3=v[w3]or w3 end elseif v3=="}"then elseif t3 then if v3=="s"then local i4,y3=c2(k3,l3)k3=i4 if y3 then p3=true if l3.print then g(k3)end if l3.wfile then local l4=r(l3.wfile)if l4 then l4:write(k3.."\n")end end end elseif v3=="d"then s3=true;m3=true elseif v3=="p"then g(k3)elseif v3=="="then g(tostring(z3))elseif v3=="F"then g(a4 or"-")elseif v3=="z"then k3=""elseif v3=="h"then u3=k3 elseif v3=="H"then u3=u3.."\n"..k3 elseif v3=="g"then k3=u3 elseif v3=="G"then k3=k3.."\n"..u3 elseif v3=="x"then k3,u3=u3,k3 elseif v3=="l"then g(q1(k3,l3.wrap))elseif v3=="q"then if not h1 then g(k3)end r3=true;o3=l3.code or 0;m3=true elseif v3=="Q"then r3=true;o3=l3.code or 0;m3=true elseif v3=="y"then k3=t1(k3,l3)elseif v3=="a"then n3[#n3+1]=l3.text elseif v3=="i"then g(l3.text)elseif v3=="c"then if l3.addr and l3.addr.kind=="range"then s3=true;m3=true if l3.atEnd then g(l3.text)end else g(l3.text);s3=true;m3=t