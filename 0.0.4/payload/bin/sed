local x1=os.msleep or function(k3)os.sleep(math.max((k3 or 0)/1000,0.05))end local b1=os.epoch("utc")local function j1(l3)local k3=os.epoch("utc")if k3-b1>=50 then b1=k3 x1(0)end end local p=args or{}local e2=(type(cwd)=="string"and cwd)or"/"local function e(l3)l3=l3 or""if l3:sub(1,1)=="/"then if l3=="/"then return"/"end return l3:gsub("/+$","")end local k3=(e2=="/")and""or e2 return(k3.."/"..l3):gsub("/+","/")end local function a(l3)local k3=io.stderr()if k3 and k3.write then k3:write(l3)end end local function n(k3)if k3 and(k3:find("permission")or k3:find("denied"))then return"Permission denied"end if k3 and k3:lower():find("no such file")then return"No such file or directory"end if k3 and k3:find("directory")then return"Is a directory"end return"No such file or directory"end local n1="bre"local q=syscalls and syscalls["regex.compile"]local function x(l3,k3)if not q then a("sed: regex syscall not available\n")return nil end local n3,m3=q(l3,n1,{icase=k3})if not n3 then a("sed: invalid regular expression ("..tostring(m3).."): "..l3.."\n")return nil end return n3 end local h1,j,l,g1=false,false,nil,false local b={}local h={}local c=false local k1=1 while k1<=#p do local u=p[k1]if u=="-n"or u=="--quiet"or u=="--silent"then h1=true elseif u=="-s"or u=="--separate"then g1=true elseif u=="-E"or u=="-r"or u=="--regexp-extended"then n1="ere"elseif u=="-e"or u=="--expression"then k1=k1+1 if not p[k1]then a("sed: option requires an argument -- e\n");return end b[#b+1]=p[k1]c=true elseif u:match("^%-%-expression=(.*)$")then b[#b+1]=u:match("^%-%-expression=(.*)$")c=true elseif u=="-f"or u=="--file"then k1=k1+1 if not p[k1]then a("sed: option requires an argument -- f\n");return end local o2=e(p[k1])local h2,f2=fs.open(o2,"r")if not h2 then a("sed: can't read "..o2..": "..n(f2).."\n");return end b[#b+1]=h2:readAll()h2:close()c=true elseif u:match("^%-%-file=(.*)$")then local p2=e(u:match("^%-%-file=(.*)$"))local i2,g2=fs.open(p2,"r")if not i2 then a("sed: can't read "..p2.."