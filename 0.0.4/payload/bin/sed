al d2=e(z2)local j2,v2=fs.open(d2,"r")if not j2 then a("sed: "..i(d2)..": "..n(v2).."\n");return end for d3,w2 in ipairs(f(j2))do z1[#z1+1]=w2 end j2:close()end m=nil w(z1,nil)end end