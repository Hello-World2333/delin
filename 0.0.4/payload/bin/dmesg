local v=args or{}local function d(s1)local r1=io.stderr()if r1 and r1.write then r1:write(s1)end end local g1="usage: dmesg [options]\n".."  -w, --follow            follow new messages\n".."  -W, --follow-new        wait and print only new messages\n".."  -T, --ctime             human readable timestamps\n".."  -t, --notime            don't print timestamps\n".."  -d, --show-delta        show time delta between messages\n".."  -e, --reltime           show only time delta\n".."      --time-format=FMT   delta|reltime|ctime|notime|iso|raw\n".."  -x, --decode            decode facility and level to printable names\n".."  -l, --level LIST        restrict to levels\n".."  -f, --facility LIST     restrict to facilities\n".."  -k                      print kernel messages only\n".."  -u                      print userspace messages only\n".."  -c, --read-clear        read and clear the buffer\n".."  -C, --clear             clear the buffer\n".."  -n, --console-level L   set level of messages printed to console\n".."  -D, --console-off       disable printing messages to console\n".."  -E, --console-on        enable printing messages to console\n".."  -V, --version           display version\n".."  -h, --help              display this help\n"local function t(r1)d("dmesg: option '"..r1.."' is not supported\n")return 2 end local a="raw"local y=false local r,q=false,false local k,p=false,false local h,e=nil,nil local n,u=false,false local c,i,j=nil,false,false local function g(v1,s1)local u1={}local t1=(s1=="level")and syscalls["syslog.severity"]or syscalls["syslog.facility"]for r1 in(v1..","):gmatch("([^,]*),")do r1=r1:gsub("^%s+",""):gsub("%s+$","")if r1~=""then local w1=t1(r1)if not w1 and r1:match("^%d+$")then w1=tonumber(r1)end if not w1 then d("dmesg: unknown "..s1.." '"..r1.."'\n")return nil end u1[w1]=true end end return u1 end local function o(s1,r1)local t1=v[s1+1]if not t1 then d("dmesg: option '"..r1.."' requires an argument\n")end return t1 end local function s(s1)local r1=syscalls["syslog.severity"](s1)if not r1 and s1:match("^%d+$")then r1=tonumber(s1)end if not r1 or r1<0 or r1>7 then return nil end return r1 end local a1=1 while a1<=#v do local b=v[a1]if b=="--"then if v[a1+1]then d("dmesg: too many arguments\n");return 2 end elseif b=="-h"or b=="--help"then io.write(g1)return 0 elseif b=="-V"or b=="--version"then io.write("dmesg (Delin OS)\n")return 0 elseif b=="-w"or b=="--follow"then r=true elseif b=="-W"or b=="--follow-new"then r,q=true,true elseif b=="-T"or b=="--ctime"or b=="-H"or b=="--human"then a="ctime"elseif b=="-t"or b=="--notime"then a="notime"elseif b=="-d"or b=="--show-delta"then a="delta"elseif b=="-e"or b=="--reltime"then a="reltime"elseif b:match("^%-%-time%-format=")then local i1=b:sub(15)if i1~="delta"and i1~="reltime"and i1~="ctime"and i1~="notime"and i1~="iso"and i1~="raw"then d("dmesg: unknown time format '"..i1.."'\n")return 2 end a=i1 elseif b=="-x"or b=="--decode"then y=true elseif b=="-k"then n=true elseif b=="-u"then u=true elseif b=="-c"or b=="--read-clear"then k=true elseif b=="-C"or b=="--clear"then p=true elseif b=="-D"or b=="--console-off"then i=true elseif b=="-E"or b=="--console-on"then j=true elseif b=="-l"or b=="--level"then local q1=o(a1,b);if not q1 then return 2 end h=g(q1,"level");if not h then return 2 end a1=a1+1 elseif b:match("^%-%-level=")then h=g(b:sub(9),"level");if not h then return 2 end elseif b=="-f"or b=="--facility"then local p1=o(a1,b);if not p1 then return 2 end e=g(p1,"facility");if not e then return 2 end a1=a1+1 elseif b:match("^%-%-facility=")then e=g(b:sub(12),"facility");if not e then return 2 end elseif b=="-n"or b=="--console-level"then local l1=o(a1,b);if not l1 then return 2 end local n1=s(l1)if not n1 then d("dmesg: unknown level '"..l1.."'\n");return 2 end c=n1 a1=a1+1 elseif b:match("^%-%-console%-level=")then local o1=b:sub(17)local m1=s(o1)if not m1 then d("dmesg: unknown level '"..o1.."'\n");return 2 end c=m1 elseif b=="-s"or b=="--buffer-size"or b=="-S"or b=="--syslog"or b=="--since"or b=="--until"or b=="-F"or b=="--file"or b=="-K"or b=="--kmsg-file"or b=="-r"or b=="--raw"or b=="-p"or b=="--force-prefix"or b=="-J"or b=="--json"or b=="-L"or b=="--color"or b=="--noescape"or b=="-P"or b=="--nopager"then return t(b)elseif b:sub(1,1)=="-"and b~="-"then d("dmesg: invalid option -- '"..b:sub(2,2).."'\n")return 1 else d("dmesg: too many arguments\n")return 2 end a1=a1+1 end if i then syscalls["klog.setConsoleLevel"](-1)end if j then syscalls["klog.setConsoleLevel"](7)end if c then syscalls["klog.setConsoleLevel"](c)end if c or i or j then return 0 end local l=false if syscalls and syscalls["signal.install"]then syscalls["signal.install"](2,function()l=true end)end local b1=syscalls["klog.stats"]()local x=b1.boot or 0 local f=nil local function h1(r1)if a=="notime"then return""end local s1=math.floor(r1/1000000)local t1=r1%1000000 if a=="raw"then return string.format("[%5d.%06d] ",s1,t1)elseif a=="delta"then local u1=f and(r1-f)or 0 return string.format("[%5d.%06d < %5d.%06d>] ",s1,t1,math.floor(u1/1000000),u1%1000000)elseif a=="reltime"then local v1=f and(r1-f)or 0 return string.format("[  +%5d.%06d] ",math.floor(v1/1000000),v1%1000000)elseif a=="ctime"then return"["..os.date("%a %b %e %H:%M:%S %Y",math.floor((x+r1/1000)/1000)).."] "elseif a=="iso"then local w1=math.floor((x+r1/1000)/1000)return os.date("%Y-%m-%dT%H:%M:%S",w1)..string.format(",%06d",t1).." "end return""end local function e1(v1)local t1,s1,x1=v1:match("^(%d+),%d+,(%d+),%-?%d*;(.*)$")if not t1 then return v1.."\n"end t1,s1=tonumber(t1),tonumber(s1)local u1,w1=math.floor(t1/8),t1%8 if h and not h[w1]then return nil end if e and not e[u1]then return nil end if n and u1~=0 then return nil end if u and u1==0 then return nil end local r1=h1(s1)f=s1 if y then r1=string.format("%-6s:%-6s: ",syscalls["syslog.facilityName"](u1),syscalls["syslog.severityName"](w1))..r1 end return r1..x1.."\n"end local function w(r1)for s1 in r1:gmatch("[^\n]+")do local t1=e1(s1)if t1 then io.write(t1)end end end if p then syscalls["klog.clear"]()return 0 end local f1=fs.open("/dev/kmsg","r")if not f1 then d("dmesg: /dev/kmsg: cannot open\n")return 1 end if q then local k1,j1=f1:seek(b1.next)if not k1 then d("dmesg: /dev/kmsg: "..tostring(j1).."\n")f1:close()return 1 end end local d1=os.msleep or function(r1)os.sleep(math.max((r1 or 0)/1000,0.05))end if r then local m=f1:readAvailable()if m and m~=""then w(m)end while not l do local c1=f1.readLine and f1:readLine()if c1~=nil then w(c1.."\n")else m=f1:readAvailable()if m and m~=""then w(m)else d1(50)end end end f1:close()if k then syscalls["klog.clear"]()end return 130 end while true do local z=f1:readAvailable()if not z or z==""then break end w(z)end f1:close()if k then syscalls["klog.clear"]()end return 0