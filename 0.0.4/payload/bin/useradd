local j=args or{}local function b(f1)local e1=io.stderr()if e1 and e1.write then e1:write(f1)end end local function g(e1)if e1 then b("useradd: "..e1.."\n")end b("usage: useradd [-u UID] [-g GROUP] [-G GROUPLIST] [-d HOME] [-s SHELL] [-c COMMENT] [-m] name\n")return 2 end if not(syscalls and syscalls["user.addUser"])then b("useradd: user syscalls not available\n")return 1 end local a={m=false}local d,i=nil,false local u=1 while u<=#j do local p=j[u]if i then if d then return g("extra operand '"..p.."'")end d=p elseif p=="--"then i=true elseif p:sub(1,1)=="-"and p~="-"then local k=2 while k<=#p do local f=p:sub(k,k)if f=="m"then a.m=true;k=k+1 elseif f=="M"then a.m=false;k=k+1 elseif f=="r"then a.r=true;k=k+1 elseif f=="N"or f=="U"then if f=="N"then b("useradd: option '-N' is not supported (a private group is always created)\n")return 2 end k=k+1 elseif f=="l"then k=k+1 elseif f=="u"or f=="g"or f=="G"or f=="d"or f=="s"or f=="c"then local e=p:sub(k+1)if e==""then u=u+1 e=j[u]end if e==nil then return g("option requires an argument -- '"..f.."'")end if f=="u"then if not e:match("^%d+$")then return g("invalid user ID '"..e.."'")end a.u=tonumber(e)elseif f=="g"then a.g=e elseif f=="G"then a.G=e elseif f=="d"then a.d=e elseif f=="s"then a.s=e else a.c=e end k=#p+1 else return g("invalid option -- '"..f.."'")end end else if d then return g("extra operand '"..p.."'")end d=p end u=u+1 end if not d then return g("no user name given")end local w=d local c={name=w}if a.r then local s={}for d1,b1 in ipairs(syscalls["user.list"]()or{})do s[b1.uid]=true end local l for q=999,1,-1 do if not s[q]then l=q;break end end if not l then b("useradd: no free system UID available\n");return 1 end c.uid=l end if a.u then c.uid=a.u end if a.d then c.home=a.d end if a.s then c.shell=a.s end if a.c then c.full=a.c end if a.g then if a.g:match("^%d+$")then c.gid=tonumber(a.g)else local a1=syscalls["user.groupByName"](a.g)if not a1 then b("useradd: group '"..a.g.."' does not exist\n");return 1 end c.gid=a1.gid end end if a.G then c.groups={}for n in(a.G..","):gmatch("([^,]*),")do if n~=""then c.groups[#c.groups+1]=n end end for c1,m in ipairs(c.groups)do if not syscalls["user.groupByName"](m)then b("useradd: group '"..m.."' does not exist\n")return 1 end end end local o,x=syscalls["user.addUser"](c)if not o then b("useradd: "..tostring(x).."\n")return 1 end if a.m then local h=o.home local function r(g1)local e1=""for h1 in g1:gmatch("[^/]+")do e1=e1.."/"..h1 if not fs.exists(e1)then local i1,f1=fs.makeDir(e1)if not i1 and not fs.exists(e1)then return nil,tostring(f1 or"mkdir failed")end end end return true end if not fs.exists(h)then local z,v=r(h)if not z then b("useradd: cannot create home directory '"..h.."': "..tostring(v).."\n")return 1 end end local y,t=fs.chown(h,o.uid,o.gid)if not y then b("useradd: cannot chown home directory '"..h.."': "..tostring(t).."\n")return 1 end end return 0