local v=os.msleep or function(o1)os.sleep(math.max((o1 or 0)/1000,0.05))end local l=os.epoch("utc")local function o(p1)local o1=os.epoch("utc")if o1-l>=50 then l=o1 v(0)end end local d1=args or{}local a=false local t=(type(cwd)=="string"and cwd)or"/"local function z(p1)p1=p1 or""if p1==""then return(t=="/")and"/"or t end if p1:sub(1,1)=="/"then if p1=="/"then return"/"end return p1:gsub("/+$","")end local o1=(t=="/")and""or t return(o1.."/"..p1):gsub("/+","/")end local function d(p1)local o1=io.stderr()if o1 and o1.write then o1:write(p1)end end local function y(p1,o1)local r1,s1,q1=pcall(fs.open,p1,o1)if not r1 then return nil,tostring(s1)end return s1,q1 end local function x(p1)local q1=tostring(p1 or"cannot open")q1=q1:gsub("^.-:%d+: ","")local o1=q1:match(": ([^:]+)$")if o1 and not o1:find("/",1,true)then return o1 end return q1 end local e,c=false,false local g,h={},false for m1,s in ipairs(d1)do if h then g[#g+1]=s elseif s=="--"then h=true elseif s=="-a"or s=="--append"then e=true elseif s=="-i"or s=="--ignore-interrupts"then c=true elseif s=="-p"then a=true elseif s:match("^%-%-output%-error")then local i1=s:match("^%-%-output%-error=(.*)$")or"warn-nopipe"if i1=="warn-nopipe"then a=true else d("tee: option '--output-error="..i1.."' is not supported\n")return 2 end elseif s:sub(1,1)=="-"and s~="-"then for h1=2,#s do local b1=s:sub(h1,h1)if b1=="a"then e=true elseif b1=="i"then c=true elseif b1=="p"then a=true else d("tee: invalid option -- '"..b1.."'\n");return 1 end end else g[#g+1]=s end end if c then local m=syscalls and syscalls["signal.install"]if not m then d("tee: -i: signal.install syscall not available\n")return 1 end m(2,function()end)end local i=0 local u=io.stdout()local k=io.stdin()if not k then d("tee: standard input: not available\n")return 1 end local q=e and"a"or"w"local b={}for n1,n in ipairs(g)do if n=="-"then else local k1=z(n)local g1,e1=y(k1,q)if not g1 then d("tee: "..n..": "..x(e1).."\n")i=1 else b[#b+1]={name=n,h=g1}end end end local function r(o1)local q1=1 while q1<=#b do local s1=b[q1]local r1,p1=s1.h:write(o1)if not r1 then d("tee: "..s1.name..": "..tostring(p1 or"write failed").."\n")i=1 s1.h:close()table.remove(b,q1)else q1=q1+1 end end end local j=(u==nil)local w=k.readAll~=nil while true do local f if w then f=k:read(4096)else local a1=k:readLine()if a1~=nil then f=a1.."\n"end end if f==nil then break end if not j then local f1,c1=u:write(f)if not f1 then local p=tostring(c1 or""):find("broken pipe")~=nil if not(a and p)then d("tee: standard output: "..tostring(c1 or"write failed").."\n")i=1 end j=true end end r(f)o(#f)end for l1,j1 in ipairs(b)do j1.h:flush()j1.h:close()end if u then u:flush()end return i