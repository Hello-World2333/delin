local h=args or{}local z=(type(cwd)=="string"and cwd)or"/"local function a1(o1)o1=o1 or""if o1==""then return(z=="/")and"/"or z end if o1:sub(1,1)=="/"then if o1=="/"then return"/"end return o1:gsub("/+$","")end local n1=(z=="/")and""or z return(n1.."/"..o1):gsub("/+","/")end local function a(o1)local n1=io.stderr()if n1 and n1.write then n1:write(o1)end end local function h1(n1)return(n1:match("([^/]*)$"))or n1 end local q,f,x=false,false,false local k,g=nil,false local b,l={},false local function c(o1,n1)k=o1 g=n1 and true or false end local y=1 while y<=#h do local n=h[y]if l then b[#b+1]=n elseif n=="--"then l=true elseif n=="-L"or n=="--dereference"then q=true elseif n=="-f"or n=="--file-system"then f=true elseif n=="-t"or n=="--terse"then x=true elseif n=="-c"then y=y+1 if not h[y]then a("stat: option '-c' requires an argument\n");return 2 end c(h[y],false)elseif n:match("^%-%-format=")then c(n:sub(10),false)elseif n=="--format"then y=y+1 if not h[y]then a("stat: option '--format' requires an argument\n");return 2 end c(h[y],false)elseif n=="--printf"then y=y+1 if not h[y]then a("stat: option '--printf' requires an argument\n");return 2 end c(h[y],true)elseif n:match("^%-%-printf=")then c(n:sub(10),true)elseif n=="--help"or n=="-h"then io.write("usage: stat [-L] [-f] [-t] [-c FORMAT|--printf=FORMAT] FILE...\n")return 0 elseif n=="-cL"then q=true elseif n:sub(1,2)=="--"then a("stat: unrecognized option '"..n.."'\n")return 1 elseif n:sub(1,1)=="-"and n~="-"then for l1=2,#n do local e1=n:sub(l1,l1)if e1=="L"then q=true elseif e1=="f"then f=true elseif e1=="t"then x=true else a("stat: invalid option -- '"..e1.."'\n");return 1 end end else b[#b+1]=n end y=y+1 end if#b==0 then a("stat: missing operand\n")return 1 end local function c1(n1)return((math.floor(n1/4)%2==1)and"r"or"-")..((math.floor(n1/2)%2==1)and"w"or"-")..((n1%2==1)and"x"or"-")end local function i(o1)local q1=math.floor(o1/0x1000)*0x1000 local p1=(q1==0x8000 and"-")or(q1==0x4000 and"d")or(q1==0xA000 and"l")or(q1==0x1000 and"p")or(q1==0x2000 and"c")or(q1==0x6000 and"b")or(q1==0xC000 and"s")or"?"local n1=o1%512 local t1=c1(math.floor(n1/64)%8)local r1=c1(math.floor(n1/8)%8)local s1=c1(n1%8)local u1=o1%0x1000 if math.floor(u1/2048)%2==1 then t1=t1:sub(1,2)..(t1:sub(3)=="x"and"s"or"S")end if math.floor(u1/1024)%2==1 then r1=r1:sub(1,2)..(r1:sub(3)=="x"and"s"or"S")end if math.floor(u1/512)%2==1 then s1=s1:sub(1,2)..(s1:sub(3)=="x"and"t"or"T")end return p1..t1..r1..s1 end local function s(o1)local n1=o1.kind if n1=="symlink"then return"symbolic link"end if n1=="fifo"then return"fifo"end if n1=="socket"then return"socket"end if n1=="device"then local p1=math.floor((o1.mode or 0)/0x1000)*0x1000 return(p1==0x2000)and"character special file"or"block special file"end if o1.isDir then return"directory"end return"regular file"end local function d(n1)if not n1 or n1==0 then return"-"end return os.date("%Y-%m-%d %H:%M:%S.000000000 +0000",n1)end local function u(n1)local o1=syscalls and syscalls["user.byUid"]and syscalls["user.byUid"](n1)return(o1 and o1.name)or tostring(n1)end local function m(n1)local o1=syscalls and syscalls["user.groupByGid"]and syscalls["user.groupByGid"](n1)return(o1 and o1.name)or tostring(n1)end local function v(n1)if q then return fs.attributes(n1)end return(fs.lstat and fs.lstat(n1))or fs.attributes(n1)end local r={n=function(o1,p1,n1)return n1 end,N=function(o1,p1,n1)return"'"..n1.."'"end,s=function(n1)return n1.size or 0 end,b=function(n1)return n1.blocks or math.ceil((n1.size or 0)/512)end,B=function()return 512 end,o=function(n1)return 1024 end,f=function(n1)return string.format("%x",n1.mode or 0)end,F=function(n1)return s(n1)end,a=function(n1)return string.format("%o",(n1.mode or 0)%0x1000)end,A=function(n1)return i(n1.mode or 0)end,u=function(n1)return n1.uid or 0 end,U=function(n1)return u(n1.uid or 0)end,g=function(n1)return n1.gid or 0 end,G=function(n1)return m(n1.gid or 0)end,h=function(n1)return n1.links or 1 end,i=function(n1)return n1.ino or 0 end,d=function()return 0 end,t=function(n1)return string.format("%x",math.floor((n1.mode or 0)/0x1000))end,T=function(n1)return string.format("%d",math.floor((n1.mode or 0)/0x1000))end,X=function(n1)return n1.atime or 0 end,Y=function(n1)return n1.mtime or 0 end,Z=function(n1)return n1.ctime or 0 end,x=function(n1)return d(n1.atime)end,y=function(n1)return d(n1.mtime)end,z=function(n1)return d(n1.ctime)end,}local b1={n=function(o1,p1,n1)return n1 end,s=function(n1)return n1.blockSize or 1024 end,S=function(n1)return n1.blockSize or 1024 end,b=function(n1)return n1.blocks or 0 end,f=function(n1)return n1.bfree or 0 end,a=function(n1)return n1.bavail or 0 end,c=function(n1)return n1.files or 0 end,d=function(n1)return n1.ffree or 0 end,t=function()return"ef53"end,T=function()return"ext2"end,}local e={C=true,m=true,w=true,W=true}local function p(p1)local n1={}local o1=1 while o1<=#p1 do local s1=p1:sub(o1,o1)if s1=="\\"then local r1=p1:sub(o1+1,o1+1)local q1={n="\n",t="\t",r="\r",a="\a",b="\b",f="\f",v="\v",["\\"]="\\"}if q1[r1]then n1[#n1+1]=q1[r1];o1=o1+2 else n1[#n1+1]="\\"..r1;o1=o1+2 end else n1[#n1+1]=s1 o1=o1+1 end end return table.concat(n1)end local function w(r1,q1,p1)local v1 if f then v1=nil else v1=v(q1)if not v1 then return nil,"cannot statx '"..p1.."': No such file or directory"end end local t1 if f then t1=fs.statvfs and fs.statvfs(q1)if not t1 then return nil,"cannot read file system information for '"..p1.."'"end end local o1={}local s1=1 while s1<=#r1 do local w1=r1:sub(s1,s1)if w1~="%"then o1[#o1+1]=w1 s1=s1+1 else local n1=r1:sub(s1+1,s1+1)if n1=="%"then o1[#o1+1]="%"elseif n1==""then o1[#o1+1]="%"elseif f then if e[n1]then return nil,"unsupported format specifier '%"..n1.."'"end local u1=b1[n1]if not u1 then return nil,"invalid format character '%"..n1.."'"end o1[#o1+1]=tostring(u1(t1,q1,p1))elseif e[n1]then return nil,"unsupported format specifier '%"..n1.."'"elseif r[n1]then o1[#o1+1]=tostring(r[n1](v1,q1,p1))else return nil,"invalid format character '%"..n1.."'"end s1=s1+2 end end return table.concat(o1)end local function j(p1,o1)local n1={}n1[#n1+1]="  File: "..o1 n1[#n1+1]="  Size: "..tostring(p1.size or 0).."\tBlocks: "..tostring(p1.blocks or math.ceil((p1.size or 0)/512)).."\tIO Block: 1024  "..s(p1)n1[#n1+1]="Device: 0\tInode: "..tostring(p1.ino or 0).."\tLinks: "..tostring(p1.links or 1)if p1.kind=="symlink"and fs.readlink then n1[#n1+1]="  Link: "..(fs.readlink(o1)or"?")end n1[#n1+1]="Access: ("..string.format("%04o",p1.mode or 0).."/"..i(p1.mode or 0)..")  Uid: ("..tostring(p1.uid or 0).."/"..u(p1.uid or 0)..")   Gid: ("..tostring(p1.gid or 0).."/"..m(p1.gid or 0)..")"n1[#n1+1]="Access: "..d(p1.atime)n1[#n1+1]="Modify: "..d(p1.mtime)n1[#n1+1]="Change: "..d(p1.ctime)return table.concat(n1,"\n").."\n"end local function o(o1,r1)local q1=o1.files or 0 local t1=q1-(o1.ffree or 0)local p1=o1.blocks or 0 local s1=p1-(o1.bfree or 0)local n1={}n1[#n1+1]="  File: \""..r1.."\""n1[#n1+1]="    ID: 0        Namelen: 255     Type: ext2"n1[#n1+1]="Block size: "..tostring(o1.blockSize or 1024).."        Fundamental block size: "..tostring(o1.blockSize or 1024)n1[#n1+1]="Blocks: Total: "..tostring(p1).."        Free: "..tostring(o1.bfree or 0).."        Available: "..tostring(o1.bavail or 0)n1[#n1+1]="Inodes: Total: "..tostring(q1).."        Free: "..tostring(o1.ffree or 0)return table.concat(n1,"\n").."\n"end local f1=0 for m1,t in ipairs(b)do local k1=a1(t)if k then local d1,i1=w(g and p(k)or k,k1,t)if not d1 then a("stat: "..tostring(i1).."\n")f1=1 else io.write(d1)if g then end end elseif f then local j1=fs.statvfs and fs.statvfs(k1)if not j1 then a("stat: cannot read file system information for '"..t.."'\n")f1=1 else io.write(o(j1,t))end else local g1=v(k1)if not g1 then a("stat: cannot statx '"..t.."': No such file or directory\n")f1=1 elseif x then io.write(t.." "..tostring(g1.size or 0).." "..tostring(g1.blocks or 0).." "..string.format("%x",g1.mode or 0).." "..tostring(g1.uid or 0).." "..tostring(g1.g