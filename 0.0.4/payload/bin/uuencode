local b1=args or{}local v=(type(cwd)=="string"and cwd)or"/"local function x(m1)m1=m1 or""if m1==""then return(v=="/")and"/"or v end if m1:sub(1,1)=="/"then if m1=="/"then return"/"end return m1:gsub("/+$","")end local l1=(v=="/")and""or v return(l1.."/"..m1):gsub("/+","/")end local function b(m1)local l1=io.stderr()if l1 and l1.write then l1:write(m1)end end local function z(l1)if l1 and(l1:find("permission")or l1:find("denied"))then return"Permission denied"end if l1 and(l1:find("[Nn]o such")or l1:find("not found"))then return"No such file or directory"end if l1 and l1:lower():find("no such file")then return"No such file or directory"end if l1 and l1:find("directory")then return"Is a directory"end return"No such file or directory"end local m="Usage: uuencode [-m] [FILE] REMOTEFILE\n"local c=false local g={}local i=false for k1,y in ipairs(b1)do if i then g[#g+1]=y elseif y=="--"then i=true elseif y=="-m"or y=="--base64"then c=true elseif y:sub(1,2)=="--"then b("uuencode: unrecognized option '"..y.."'\n"..m)return 1 elseif y:sub(1,1)=="-"and y~="-"then for j1=2,#y do local e1=y:sub(j1,j1)if e1=="m"then c=true else b("uuencode: invalid option -- '"..e1.."'\n"..m)return 1 end end else g[#g+1]=y end end if#g==0 then b("uuencode: missing operand\n"..m)return 1 end if#g>2 then b("uuencode: extra operand '"..g[3].."'\n"..m)return 1 end local n,e if#g==1 then e=g[1]else n=g[1]e=g[2]end local o,u,d if n and n~="-"then local c1=x(n)if fs.isDir(c1)then b("uuencode: "..c1..": Is a directory\n")return 1 end local h1,f1=fs.open(c1,"r")if not h1 then b("uuencode: "..c1..": "..z(f1).."\n")return 1 end local g1=fs.attributes(c1)if not g1 or not g1.mode then h1:close()b("uuencode: "..c1..": cannot stat\n")return 1 end o,d,u=h1,true,string.format("%o",g1.mode%0x1000)else o,d=io.stdin(),false if not o then b("uuencode: cannot read stdin\n")return 1 end u="644"end local function l(r1)local o1=r1.read and r1:read(1)or nil if o1 and o1~=""then local l1=o1 return function()if l1 then local s1=l1;l1=nil;return s1 end return r1:read(45)end end local q1=r1.readLine and r1:readLine()or nil if q1==nil then return function()return nil end end local p1,n1,m1=q1,1,true return function()while true do if n1<=#p1 then local t1=p1:sub(n1,n1+44)n1=n1+45 return t1 end local s1=r1:readLine()if s1==nil then return nil end p1,n1=(m1 and("\n"..s1)or s1),1 m1=true end end end local r if d then r=function()return o:read(45)end else r=l(o)end local function j(l1)if l1==0 then return"`"end return string.char(0x20+l1)end local function t(q1)local l1={string.char(0x20+#q1)}local m1=1 while m1<=#q1 do local n1=q1:byte(m1)local o1=q1:byte(m1+1)or 0 local p1=q1:byte(m1+2)or 0 l1[#l1+1]=j(math.floor(n1/4))l1[#l1+1]=j((n1%4)*16+math.floor(o1/16))l1[#l1+1]=j((o1%16)*4+math.floor(p1/64))l1[#l1+1]=j(p1%64)m1=m1+3 end return table.concat(l1).."\n"end local d1="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"local function a(l1)return d1:sub(l1+1,l1+1)end local function s(p1)local l1={}for q1=1,#p1,3 do local m1,n1,o1=p1:byte(q1),p1:byte(q1+1),p1:byte(q1+2)l1[#l1+1]=a(math.floor(m1/4))l1[#l1+1]=a((m1%4)*16+math.floor(n1/16))l1[#l1+1]=a((n1%16)*4+math.floor(o1/64))l1[#l1+1]=a(o1%64)end return table.concat(l1)end local function w(n1)local l1=n1:byte(1)local m1=n1:byte(2)if not m1 then return a(math.floor(l1/4))..a((l1%4)*16).."=="end return a(math.floor(l1/4))..a((l1%4)*16+math.floor(m1/16))..a((m1%16)*4).."="end io.write("begin "..u.." "..e.."\n")if c then local h,f="",""local function a1(l1)f=f..l1 while#f>=76 do io.write(f:sub(1,76).."\n")f=f:sub(77)end end while true do local q=r()if q==nil then break end if q~=""then h=h..q local i1=#h-(#h%3)if i1>0 then a1(s(h:sub(1,i1)))h=h:sub(i1+1)end end end if#h>0 then a1(w(h))end if#f>0 then io.write(f.."\n")end else local k=""while true do local p=r()if p==nil then break end if p~=""then k=k..p while#k>=45 do io.write(t(k:sub(1,45)))k=k:sub(46)end end end if#k>0 then io.write(t(k))end io.write("`\n")end io.write("end\n")if d then o:close()end