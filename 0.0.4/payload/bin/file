end end m2=m2+k2 end end return true end local function h1(q2,l2)local k2,m2=0,1 while true do local p2=q2:find("\n",m2,true)if not p2 then break end local n2=p2-m2 if n2>k2 then k2=n2 end m2=p2+1 end if not l2 then local o2=#q2-m2+1 if o2>k2 then k2=o2 end end return k2 end local function y(n2,l2)if l2 and n2:sub(-1)=="\r"then n2=n2:sub(1,-2)end local m2=0 for o2 in n2:gmatch("\n")do m2=m2+1 end if m2==0 then if n2:find("\r",1,true)then return"with CR line terminators"end return"with no line terminators"end local k2=0 for p2 in n2:gmatch("\r\n")do k2=k2+1 end if k2==0 then return nil end if k2==m2 then return"with CRLF line terminators"end return"with CRLF, LF line terminators"end local function j(u2,k2)local t2,r2,q2,p2=false,0,0,false for w2=1,#u2 do local v2=u2:byte(w2)if v2==0 then t2=true;break end if v2>=128 then q2=q2+1 if v2<160 then p2=true end elseif not p(v2)then r2=r2+1 end end if t2 then return{binary=true}end if r2*10>#u2*3 then return{binary=true}end local m2,n2 if q2==0 then m2,n2="ASCII text","us-ascii"elseif w1(u2,k2)then n2="utf-8"if u2:sub(1,3)=="\239\187\191"then m2="Unicode text, UTF-8 (with BOM) text"else m2="Unicode text, UTF-8 text"end elseif p2 then m2,n2="Non-ISO extended-ASCII text","unknown-8bit"else m2,n2="ISO-8859 text","iso-8859-1"end local l2={}local o2=h1(u2,k2)if o2>300 then l2[#l2+1]="with very long lines ("..o2..")"end local s2=y(u2,k2)if s2 then l2[#l2+1]=s2 end return{binary=false,base=m2,enc=n2,notes=(#l2>0)and(", "..table.concat(l2,", "))or"",}end local t1={{match="sh",dirs={["/bin"]=true},desc="POSIX shell script",mime="text/x-shellscript"},{match="ksh",dirs={["/bin"]=true},desc="Korn shell script",mime="text/x-shellscript"},{match="dash",dirs={["/bin"]=true,["/usr/bin"]=true},desc="Dash shell script",mime="text/x-shellscript"},{match="bash",dirs={["/bin"]=true,["/usr/bin"]=true,["/usr/local/bin"]=true},env=true,desc="Bourne-Again shell script",mime="text/x-shellscript"},{match="zsh",dirs={["/bin"]=true,["/usr/bin"]=true,["