local b=args or{}local y=(type(cwd)=="string"and cwd)or"/"local function c1(r1)r1=r1 or""if r1==""then return(y=="/")and"/"or y end if r1:sub(1,1)=="/"then if r1=="/"then return"/"end return r1:gsub("/+$","")end local q1=(y=="/")and""or y return(q1.."/"..r1):gsub("/+","/")end local function a(r1)local q1=io.stderr()if q1 and q1.write then q1:write(r1)end end local function d1(q1)if q1 and(q1:find("permission")or q1:find("denied"))then return"Permission denied"end if q1 and q1:lower():find("no such file")then return"No such file or directory"end if q1 and q1:find("directory")then return"Is a directory"end return"No such file or directory"end local k1=2000000000 local n=nil local c={}local o="\t"local d,j=false,false local g=nil local f={}local k=false local function a1(q1)local r1,s1 local t1,u1=q1:match("^(%d+)%-(%d+)$")if t1 then r1,s1=tonumber(t1),tonumber(u1)if s1<r1 then a("cut: invalid decreasing range\n");return false end elseif q1:match("^%d+$")then r1,s1=tonumber(q1),tonumber(q1)elseif q1:match("^%d+%-$")then r1,s1=tonumber(q1:match("^(%d+)")),k1 elseif q1:match("^%-%d+$")then r1,s1=1,tonumber(q1:match("(%d+)$"))else a("cut: invalid range: '"..q1.."'\n")return false end if r1<1 then a("cut: fields are numbered from 1\n");return false end c[#c+1]={lo=r1,hi=s1}return true end local function v(q1)if q1==""then a("cut: invalid empty list\n");return false end for r1 in q1:gmatch("[^,%s]+")do if not a1(r1)then return false end end if#c==0 then a("cut: invalid empty list\n");return false end return true end local function u()table.sort(c,function(u1,v1)return u1.lo<v1.lo end)local r1={}for t1,s1 in ipairs(c)do local q1=r1[#r1]if q1 and s1.lo<=q1.hi+1 then if s1.hi>q1.hi then q1.hi=s1.hi end else r1[#r1+1]={lo=s1.lo,hi=s1.hi}end end c=r1 end local function e(q1,r1)if n and n~=r1 then a("cut: only one type of list may be specified\n")return false end n=r1 if not v(q1)then return false end return true end local function h(q1)if#q1~=1 then a("cut: the delimiter must be a single character\n")return false end o=q1 return true end local m=1 while m<=#b do local i=b[m]if k then f[#f+1]=i elseif i=="--"then k=true elseif i=="--complement"then j=true elseif i=="--only-delimited"then d=true elseif i=="-s"then d=true elseif i=="-n"then elseif i:match("^%-%-bytes=")then if not e(i:sub(9),"b")then return 1 end elseif i:match("^%-%-characters=")then if not e(i:sub(14),"c")then return 1 end elseif i:match("^%-%-fields=")then if not e(i:sub(10),"f")then return 1 end elseif i=="--bytes"or i=="--characters"or i=="--fields"then m=m+1 if not b[m]then a("cut: option '"..i.."' requires an argument\n");return 1 end if not e(b[m],i=="--bytes"and"b"or(i=="--characters"and"c"or"f"))then return 1 end elseif i:match("^%-%-delimiter=")then local n1=i:sub(13)if not h(n1)then return 1 end elseif i=="--delimiter"then m=m+1 if not b[m]then a("cut: option '--delimiter' requires an argument\n");return 1 end if not h(b[m])then return 1 end elseif i:match("^%-%-output%-delimiter=")then g=i:sub(20)elseif i=="--zero-terminated"then zeroTerm=true elseif i=="--output-delimiter"then m=m+1 if not b[m]then a("cut: option '--output-delimiter' requires an argument\n");return 1 end g=b[m]elseif i=="-d"then m=m+1 if not b[m]then a("cut: option requires an argument -- 'd'\n");return 1 end if not h(b[m])then return 1 end elseif i:sub(1,1)=="-"and i~="-"and i:sub(1,2)~="--"then local b1=2 while b1<=#i do local r=i:sub(b1,b1)if r=="s"then d=true;b1=b1+1 elseif r=="n"then b1=b1+1 elseif r=="z"then zeroTerm=true;b1=b1+1 elseif r=="b"or r=="c"or r=="f"then local f1=i:sub(b1+1)if f1==""then m=m+1 if not b[m]then a("cut: option requires an argument -- '"..r.."'\n");return 1 end f1=b[m]end if not e(f1,r)then return 1 end b1=#i+1 elseif r=="d"then local e1=i:sub(b1+1)if e1==""then m=m+1 if not b[m]then a("cut: option requires an argument -- 'd'\n");return 1 end e1=b[m]end if not h(e1)then return 1 end b1=#i+1 else a("cut: invalid option -- '"..r.."'\n")return 1 end end elseif i:sub(1,2)=="--"then a("cut: unrecognized option '"..i.."'\n")return 1 else f[#f+1]=i end m=m+1 end if not n then a("cut: you must specify a list of bytes, characters, or fields\n")return 1 end if#f==0 then f={"-"}end u()local function p(r1)local q1=false for t1,s1 in ipairs(c)do if r1>=s1.lo and r1<=s1.hi then q1=true;break end if s1.lo>r1 then break end end if j then return not q1 end return q1 end local l if g~=nil then l=g elseif n=="f"then l=o else l=""end local function x(q1)return table.concat(q1,l)end local function s(r1)if n=="f"then local v1=r1:find(o,1,true)~=nil if not v1 then if d then return nil end return r1 end local q1={}local w1=1 while true do local z1=r1:find(o,w1,true)if not z1 then q1[#q1+1]=r1:sub(w1);break end q1[#q1+1]=r1:sub(w1,z1-1)w1=z1+1 end local x1={}for y1=1,#q1 do if p(y1)then x1[#x1+1]=q1[y1]end end return x(x1)end local t1,s1={},nil for u1=1,#r1 do if p(u1)then if s1 then s1=s1..r1:sub(u1,u1)else s1=r1:sub(u1,u1)end elseif s1 then t1[#t1+1]=s1;s1=nil end end if s1 then t1[#t1+1]=s1 end return x(t1)end local q=false local l1=q and"\0"or"\n"local function w(v1)if not q then local t1={}while true do local w1=v1:readLine()if w1==nil then break end t1[#t1+1]=w1 end return t1 end local q1=v1:readAll()or""local r1={}local s1=1 while true do local u1=q1:find("\0",s1,true)if not u1 then if s1<=#q1 then r1[#r1+1]=q1:sub(s1)end break end r1[#r1+1]=q1:sub(s1,u1-1)s1=u1+1 end return r1 end local t={}local function z()if#t>0 then io.write(table.concat(t));t={}end end for o1,m1 in ipairs(f)do local j1 if m1=="-"then j1=io.stdin()if not j1 then a("cut: cannot read stdin\n");return 1 end else local g1 j1,g1=fs.open(c1(m1),"r")if not j1 then a("cut: "..m1..": "..d1(g1).."\n")return 1 end end for p1,i1 in ipairs(w(j1))do local h1=s(i1)if h1~=nil then t[#t+1]=h1..l1 end if#t>=512 then z()end end if m1~="-"then j1:close()end end z()