local d=args or{}local k1=(type(cwd)=="string"and cwd)or"/"local function z(r2)r2=r2 or""if r2==""then return(k1=="/")and"/"or k1 end if r2:sub(1,1)=="/"then if r2=="/"then return"/"end return r2:gsub("/+$","")end local q2=(k1=="/")and""or k1 return(q2.."/"..r2):gsub("/+","/")end local function a(r2)local q2=io.stderr()if q2 and q2.write then q2:write(r2)end end local function d1(q2)if q2 and(q2:find("permission")or q2:find("denied"))then return"Permission denied"end if q2 and q2:lower():find("no such file")then return"No such file or directory"end if q2 and q2:find("directory")then return"Is a directory"end return"No such file or directory"end local b={}local c={}local f=nil local l=nil local g=false local h={}local q=false local function i(u2)local t2={f1=1,c1=nil,o1={},f2=nil,c2=nil,o2={}}local s2,r2=u2:match("^([^,]*),(.*)$")if s2==nil then s2=u2 end local function q2(x2,z2)local c3,b3=x2:match("^(%d+)(.*)$")if not c3 then a("sort: invalid number at field start: '"..x2.."'\n")return false end local a3=tonumber(c3)if a3<1 then a("sort: field number is zero: '"..x2.."'\n")return false end local w2,v2=b3:match("^%.(%d+)(.*)$")local y2={}if w2 then if tonumber(w2)<1 then a("sort: character offset is zero: '"..x2.."'\n")return false end v2=v2 or""else v2=b3 end for d3 in(v2 or""):gmatch(".")do if d3:match("[bdfginrhVM]")then y2[d3]=true else a("sort: invalid field specification: '"..u2.."'\n")return false end end if z2 then t2.f1,t2.c1,t2.o1=a3,w2 and tonumber(w2)or nil,y2 else t2.f2,t2.c2,t2.o2=a3,w2 and tonumber(w2)or nil,y2 end return true end if not q2(s2,true)then return nil end if r2~=nil and r2~=""then if not q2(r2,false)then return nil end end return t2 end local r=1 while r<=#d do local e=d[r]if q then h[#h+1]=e elseif e=="--"then q=true elseif e:match("^%-%-key=")then local v1=i(e:sub(7))if not v1 then return 1 end c[#c+1]=v1 elseif e:match("^%-%-output=")then f=e:sub(10)elseif e:match("^%-%-field%-separator=")then local e2=e:sub(19)if#e2~=1 then a("sort: multi-character tab '"..e2.."'\n");return 1 end l=e2 elseif e:match("^%-%-check=")and e:sub(9)=="quiet"then g=true elseif e=="--check"or e=="-c"or e=="--quiet"then g=true elseif e=="--check=quiet"or e=="-C"then g=true;b.C=true elseif e=="--month-sort"then b.M=true elseif e=="--sort"then r=r+1 local p1=d[r]if not p1 then a("sort: option '--sort' requires an argument\n");return 2 end if p1=="general-numeric"then b.g=true elseif p1=="human-numeric"then b.h=true elseif p1=="month"then b.M=true elseif p1=="numeric"then b.n=true elseif p1=="version"then b.V=true elseif p1=="random"then a("sort: option '--sort=random' is not supported\n")return 2 else a("sort: unknown sort type '"..p1.."'\n")return 2 end elseif e:match("^%-%-sort=")then local s1=e:sub(8)if s1=="general-numeric"then b.g=true elseif s1=="human-numeric"then b.h=true elseif s1=="month"then b.M=true elseif s1=="numeric"then b.n=true elseif s1=="version"then b.V=true else a("sort: unknown sort type '"..s1.."'\n");return 2 end elseif e=="--debug"then b.debug=true elseif e=="--ignore-leading-blanks"then b.b=true elseif e=="--dictionary-order"then b.d=true elseif e=="--ignore-case"then b.f=true elseif e=="--general-numeric-sort"then b.g=true elseif e=="--human-numeric-sort"then b.h=true elseif e=="--ignore-nonprinting"then b.i=true elseif e=="--merge"then b.m=true elseif e=="--numeric-sort"then b.n=true elseif e=="--reverse"then b.r=true elseif e=="--stable"then b.s=true elseif e=="--unique"then b.u=true elseif e=="--version-sort"then b.V=true elseif e=="--zero-terminated"then b.z=true elseif e=="-k"or e=="--key"then r=r+1 if not d[r]then a("sort: option requires an argument -- 'k'\n");return 1 end local w1=i(d[r])if not w1 then return 1 end c[#c+1]=w1 elseif e=="-o"or e=="--output"then r=r+1 if not d[r]then a("sort: option requires an argument -- 'o'\n");return 1 end f=d[r]elseif e=="-t"or e=="--field-separator"then r=r+1 if not d[r]then a("sort: option requires an argument -- 't'\n");return 1 end if#d[r]~=1 then a("sort: multi-character tab '"..d[r].."'\n");return 1 end l=d[r]elseif e=="-S"then r=r+1 elseif e:match("^%-%-")then a("sort: unrecognized option '"..e.."'\n")return 2 elseif e:sub(1,1)=="-"and e~="-"then local q1=2 while q1<=#e do local t=e:sub(q1,q1)if t=="k"or t=="o"or t=="t"or t=="S"then local y=e:sub(q1+1)if y==""then r=r+1 if not d[r]then a("sort: option requires an argument -- '"..t.."'\n");return 1 end y=d[r]end if t=="k"then local x1=i(y)if not x1 then return 1 end c[#c+1]=x1 elseif t=="o"then f=y elseif t=="t"then if#y~=1 then a("sort: multi-character tab '"..y.."'\n");return 1 end l=y end q1=#e+1 elseif t:match("[bCdfgihmMnrsuVz]")then b[t]=true q1=q1+1 else a("sort: invalid option -- '"..t.."'\n")return 2 end end else h[#h+1]=e end r=r+1 end if b.n and b.g then a("sort: options '-g' and '-n' are incompatible\n");return 1 end if b.h and(b.n or b.g)then a("sort: options '-h' and '-n'/'-g' are incompatible\n");return 1 end if b.M and(b.n or b.g or b.h)then a("sort: options '-M' and '-n'/'-g'/'-h' are incompatible\n")return 2 end local function g1(r2)local t2={}if l then local s2=1 while true do local u2=r2:find(l,s2,true)if not u2 then t2[#t2+1]={s=s2,e=#r2};break end t2[#t2+1]={s=s2,e=u2-1}s2=u2+1 end else local q2,v2=1,#r2 while q2<=v2 do local w2=q2 while q2<=v2 and r2:sub(q2,q2):match("[ \t]")do q2=q2+1 end while q2<=v2 and not r2:sub(q2,q2):match("[ \t]")do q2=q2+1 end t2[#t2+1]={s=w2,e=q2-1}end end return t2 end local function a1(s2,t2,u2)local w2=t2[u2.f1]if not w2 then return""end local q2=w2.s if u2.o1.b or b.b then while q2<=#s2 and s2:sub(q2,q2):match("[ \t]")do q2=q2+1 end end if u2.c1 then q2=q2+(u2.c1-1)end local r2 if u2.f2 then local v2=t2[u2.f2]if not v2 then r2=0 elseif u2.c2 then r2=v2.s+(u2.c2-1)else r2=v2.e end else r2=#s2 end if q2>r2 or q2>#s2 then return""end if r2>#s2 then r2=#s2 end return s2:sub(q2,r2)end local function x(t2)t2=t2:gsub("^[ \t]+","")local w2=#t2 local q2=1 if t2:sub(q2,q2)=="+"or t2:sub(q2,q2)=="-"then q2=q2+1 end local r2=false while q2<=w2 and t2:sub(q2,q2):match("%d")do q2=q2+1;r2=true end if t2:sub(q2,q2)=="."then q2=q2+1 while q2<=w2 and t2:sub(q2,q2):match("%d")do q2=q2+1;r2=true end end if not r2 then return 0 end local u2=q2-1 if t2:sub(q2,q2)=="e"or t2:sub(q2,q2)=="E"then local s2=q2+1 if t2:sub(s2,s2)=="+"or t2:sub(s2,s2)=="-"then s2=s2+1 end local v2=s2 while s2<=w2 and t2:sub(s2,s2):match("%d")do s2=s2+1 end if s2>v2 then u2=s2-1 end end return tonumber(t2:sub(1,u2))or 0 end local function p(r2)local q2=r2:gsub("^[ \t]+",""):lower()if q2:match("^%-?inf")then return q2:sub(1,1)=="-"and-math.huge or math.huge end if q2:match("^%-?nan")then return 0/0 end return x(r2)end local y1={k=1024,m=1024,g=1024,t=1024,p=1024,e=1024,z=1024,y=1024}local function v(w2)local v2=w2:gsub("^[ \t]+","")local q2=v2:match("^[-+]?%d*%.?%d+")if not q2 then return 0 end local t2=tonumber(q2)or 0 local s2=v2:sub(#q2+1,#q2+1):lower()local r2={k=1,m=2,g=3,t=4,p=5,e=6,z=7,y=8}local u2=r2[s2]if u2 then for x2=1,u2 do t2=t2*1024 end end return t2 end local function f1(r2)if r2==""then return-1 end local q2=r2:byte()if q2>=48 and q2<=57 then return 0 end if(q2>=65 and q2<=90)or(q2>=97 and q2<=122)then return q2 end if r2=="~"then return-1 end return q2+256 end local function r1(e3,f3)local q2,r2=1,1 local y2,z2=#e3,#f3 while q2<=y2 or r2<=z2 do local g3,h3=q2,r2 while q2<=y2 and not e3:sub(q2,q2):match("%d")do q2=q2+1 end while r2<=z2 and not f3:sub(r2,r2):match("%d")do r2=r2+1 end local a3,b3=g3,h3 while a3<q2 or b3<r2 do local u2=(a3<q2)and e3:sub(a3,a3)or""local v2=(b3<r2)and f3:sub(b3,b3)or""a3,b3=a3+1,b3+1 if u2~=v2 then if u2=="~"then return-1 end if v2=="~"then return 1 end local c3,d3=f1(u2),f1(v2)if c3~=d3 then return c3<d3 and-1 or 1 end return(u2<v2)and-1 or 1 end end local s2,t2=e3:match("^%d+",q2),f3:match("^%d+",r2)if s2 or t2 then s2,t2=s2 or"",t2 or""local w2,x2=s2:gsub("^0+",""),t2:gsub("^0+","")if#w2~=#x2 then return#w2<#x2 and-1 or 1 end if w2~=x2 then return w2<x2 and-1 or 1 end q2,r2=q2+#s2,r2+#t2 end end if q2<=y2 then return 1 end if r2<=z2 then return-1 end return 0 end local function s(q2,x2)if x2.d then local s2={}for w2=1,#q2 do local v2=q2:sub(w2,w2)if v2:match("[ \t%w]")then s2[#s2+1]=v2 end end q2=table.concat(s2)end if x2.i then local t2={}for r2=1,#q2 do local u2=q2:byte(r2)if u2>=32 and u2<=126 then t2[#t2+1]=q2:sub(r2,r2)end end q2=table.concat(t2)end return q2 end local function o(r2,s2,u2)r2=s(r2,u2)s2=s(s2,u2)if u2.f then r2,s2=r2:lower(),s2:lower()end if u2.V then return r1(r2,s2)end if u2.n then local y2,a3=x(r2),x(s2)if y2~=a3 then return y2<a3 and-1 or 1 end return 0 end if u2.g then local v2,w2=p(r2),p(s2)if v2~=v2 and w2~=w2 then return 0 end if v2~=v2 then return-1 end if w2~=w2 then return 1 end if v2~=w2 then return v2<w2 and-1 or 1 end return 0 end if u2.h then local x2,b3=v(r2),v(s2)if x2~=b3 then return x2<b3 and-1 or 1 end return 0 end if u2.M then local t2={JAN=1,FEB=2,MAR=3,APR=4,MAY=5,JUN=6,JUL=7,AUG=8,SEP=9,OCT=10,NOV=11,DEC=12}local function q2(d3)if not u2.b then d3=d3:gsub("^[ \t]+","")end return t2[(d3:sub(1,3):upper())]or 0 end local z2,c3=q2(r2),q2(s2)if z2~=c3 then return z2<c3 and-1 or 1 end if r2==s2 then return 0 end return r2<s2 and-1 or 1 end if r2==s2 then return 0 end return r2<s2 and-1 or 1 end local function w(r2)local q2=nil local s2={}if#c==0 then local v2=r2 if b.b then v2=v2:gsub("^[ \t]+","")end s2[1]=v2 else for t2,u2 in ipairs(c)do if not q2 then q2=g1(r2)end s2[t2]=a1(r2,q2,u2)end end return s2 end local function e1(q2)local r2={}for t2,w2 in pairs(b)do r2[t2]=w2 end if#c>0 and q2<=#c then for u2,v2 in pairs(c[q2].o1)do r2[u2]=v2 end for s2,x2 in pairs(c[q2].o2)do r2[s2]=x2 end end return r2 end local function u(r2,s2)local t2,w2=w(r2),w(s2)local y2=#t2 for q2=1,y2 do local x2=e1(q2)local u2=o(t2[q2],w2[q2],x2)if x2.r then u2=-u2 end if u2~=0 then return u2 end end if not(b.s or b.u)and r2~=s2 then local v2=r2<s2 and-1 or 1 if b.r then v2=-v2 end return v2 end return 0 end local function k(s2)local u2 if s2=="-"then u2=io.stdin()if not u2 then a("sort: cannot read stdin\n");return nil end else local v2 u2,v2=fs.open(z(s2),"r")if not u2 then a("sort: "..s2..": "..d1(v2).."\n")return nil end end local r2={}if b.z then local q2 if u2.readAll then q2=u2:readAll()or""else local x2={}while true do local z2=u2:readLine();if z2==nil then break end;x2[#x2+1]=z2 end q2=table.concat(x2,"\n")end local t2,a3=1,#q2 while t2<=a3 do local w2=q2:find("\0",t2,true)if not w2 then r2[#r2+1]=q2:sub(t2);break end r2[#r2+1]=q2:sub(t2,w2-1)t2=w2+1 end else while true do local y2=u2:readLine()if y2==nil then break end r2[#r2+1]=y2 end end if s2~="-"then u2:close()end return r2 end if#h==0 then h={"-"}end local b1=(b.C==true)or(b.qcheck==true)if g then local h1,i1=nil,nil for p2,z1 in ipairs(h)do local l1=k(z1)if not l1 then return 1 end for j2,d2 in ipairs(l1)do if h1 then local f2=u(h1,d2)if f2>0 or(b.u and f2==0)then if not b1 then a("sort: "..z1..":"..j2..": disorder: "..d2.."\n")end return 1 end end h1,i1=d2,z1 end end return 0 end local m={}for l2,h2 in ipairs(h)do local m1=k(h2)if not m1 then return 1 end for o2,i2 in ipairs(m1)do m[#m+1]={line=i2,idx=#m+1}end end table.sort(m,function(r2,s2)local q2=u(r2.line,s2.line)if q2~=0 then return q2<0 end return r2.idx<s2.idx end)local j={}if b.u then local n=nil for m2,u1 in ipairs(m)do local c2=w(u1.line)local j1=false if n then j1=true for n1=1,#c2 do local k2=e1(n1)local g2=o(n[n1],c2[n1],k2)if g2~=0 then j1=false;break end end end if not j1 then j[#j+1]=u1.line;n=c2 end end else for n2,b2 in ipairs(m)do j[#j+1]=b2.line end end local o1=b.z and"\0"or"\n"local c1=table.concat(j,o1)if#j>0 then c1=c1..o1 end if f then local a2,t1=fs.open(z(f),"w")if not a2 then a("sort: "..f..": "..d1(t1).."\n")return 1 end a2:write(c1)a2:close()else io.write(c1)end