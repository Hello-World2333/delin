local b=args or{}local function a(i)local h=io.stderr()if h and h.write then h:write(i)end end if not(syscalls and syscalls["user.groupsOf"])then a("groups: user syscalls not available\n")return 1 end local function c(i)local h=syscalls["user.groupsOf"](i)if not h then a("groups: '"..tostring(i).."': no such user\n")return false end if#b>0 then io.write(i.." : "..table.concat(h," ").."\n")else io.write(table.concat(h," ").."\n")end return true end if#b==0 then local d=syscalls["user.byUid"]and syscalls["user.byUid"](uid)if not d then a("groups: cannot find name for user ID "..tostring(uid).."\n")return 1 end return c(d.name)and 0 or 1 end local e=0 for g,f in ipairs(b)do if not c(f)then e=1 end end return e