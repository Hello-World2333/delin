local v=args or{}local g,b=io.stdin(),io.stderr()local function q(e1)local d1=io.stdout()if d1 and d1.write then d1:write(e1)end end local function c(d1)if b and b.write then b:write(d1)end end local e,h,k,f=false,false,false,false local d,o=nil,false local function j(d1)if d1 then c("passwd: "..d1.."\n")end c("usage: passwd [-d] [-l] [-u] [-S] [name]\n")return 2 end for c1,u in ipairs(v)do if o then if d then return j("extra operand '"..u.."'")end d=u elseif u=="--"then o=true elseif u:sub(1,1)=="-"and u~="-"then for b1=2,#u do local s=u:sub(b1,b1)if s=="d"then e=true elseif s=="l"then h=true elseif s=="u"then k=true elseif s=="S"then f=true else return j("invalid option -- '"..s.."'")end end else if d then return j("extra operand '"..u.."'")end d=u end end local m=(e and 1 or 0)+(h and 1 or 0)+(k and 1 or 0)if m>1 then return j("the options -d, -l and -u are mutually exclusive")end if m>0 and f then return j("the options -S and -d/-l/-u are mutually exclusive")end if not(syscalls and syscalls["user.setPassword"])then c("passwd: user syscalls not available\n")return 1 end local a=d if not a then local w=syscalls["user.byUid"]and syscalls["user.byUid"](uid)if not w then c("passwd: cannot find name for user ID "..tostring(uid).."\n")return 1 end a=w.name end if not syscalls["user.get"](a)then c("passwd: user '"..a.."' does not exist\n")return 1 end if f then local z=syscalls["user.passwordStatus"](a)if not z then c("passwd: user '"..a.."' does not exist\n")return 1 end q(a.." "..z.."\n")return 0 end if m>0 then local i if e then local y y,i=syscalls["user.setPassword"](a,nil,nil)if not y then c("passwd: "..tostring(i).."\n");return 1 end q("passwd: password for '"..a.."' removed\n")else local x x,i=syscalls["user.setLocked"](a,h)if not x then c("passwd: "..tostring(i).."\n");return 1 end q("passwd: password for '"..a.."' "..(h and"locked"or"unlocked").."\n")end return 0 end local function r(f1)if b and b.write then b:write(f1)end local d1=false if g.setEcho then g:setEcho(false);d1=true end local e1=g:readLine()if g.setEcho then g:setEcho(true)end if e1==nil then if d1 then c("\n")end return nil end if d1 then c("\n")end return e1 end local n=nil if uid~=0 then n=r("Current password: ")if n==nil then return 1 end end local l=r("New password: ")if l==nil then return 1 end if l==""then c("passwd: you must choose a non-empty password (use -d to remove it)\n")return 1 end local p=r("Retype new password: ")if p==nil then return 1 end if l~=p then c("passwd: passwords do not match\n")return 1 end local a1,t=syscalls["user.setPassword"](a,n,l)if not a1 then c("passwd: "..tostring(t).."\n")return 1 end q("passwd: password updated successfully\n")return 0