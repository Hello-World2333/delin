local i=args or{}local function w(s1)local r1=io.stderr()if r1 and r1.write then r1:write(s1)end end local function b(r1)w("syslogd: "..r1.."\n")return 1 end local a,f="/etc/syslog.conf","/run/syslogd.pid"local z=1 while z<=#i do local b1=i[z]if b1=="-f"and i[z+1]then a=i[z+1];z=z+1 elseif b1:match("^%-%-conf=")then a=b1:sub(8)elseif b1=="-p"and i[z+1]then f=i[z+1];z=z+1 elseif b1:match("^%-%-pidfile=")then f=b1:sub(11)elseif b1=="-n"or b1=="--no-fork"then elseif b1=="--help"or b1=="-h"then io.write("usage: syslogd [-f conffile] [-p pidfile] [-n]\n")return 0 else return b("unknown option '"..b1.."'")end z=z+1 end local e1,a1={},{}for q1,n1 in ipairs(syscalls["syslog.facilities"]())do e1[n1]=syscalls["syslog.facility"](n1)end for p1,o1 in ipairs(syscalls["syslog.severities"]())do a1[o1]=syscalls["syslog.severity"](o1)end local function j(x1,v1)local s1={}for y1 in(x1..";"):gmatch("([^;]*);")do local t1={}for u1 in(y1..","):gmatch("([^,]*),")do u1=u1:gsub("%s+","")if u1~=""then local w1,r1=u1:match("^([%w%*]+)%.([%w%*]+)$")if not w1 then w1,r1=u1,nil end if w1~="*"and not e1[w1]then return nil,string.format("%s:%d: unknown facility '%s'",a,v1,w1)end if r1 and r1~="*"and r1~="none"and not a1[r1]then return nil,string.format("%s:%d: unknown severity '%s'",a,v1,r1)end t1[#t1+1]={facility=w1,severity=r1 and(r1=="*"and"*"or(r1=="none"and"none"or a1[r1]))or"*",}end end if#t1>0 then s1[#s1+1]=t1 end end if#s1==0 then return nil,string.format("%s:%d: empty selector",a,v1)end return s1 end local function y(v1)local b2=fs.open(v1,"r")if not b2 then return nil,v1..": cannot open"end local y1=b2.readAll()b2.close()local t1={}local s1=0 for a2 in(y1.."\n"):gmatch("([^\n]*)\n")do s1=s1+1 local w1=a2:gsub("#.*$",""):gsub("^%s+",""):gsub("%s+$","")if w1~=""then local x1,r1=w1:match("^(%S+)%s+(.+)$")if not x1 then return nil,string.format("%s:%d: expected 'selector action'",v1,s1)end r1=r1:gsub("%s+$","")if r1:sub(1,1)=="-"then r1=r1:sub(2)end local u1,z1=j(x1,s1)if not u1 then return nil,z1 end t1[#t1+1]={groups=u1,action=r1,line=s1}end end return t1 end local function k(s1,u1,w1)local r1=false for y1,t1 in ipairs(s1)do for x1,v1 in ipairs(t1)do if v1.facility=="*"or v1.facility==u1 then if v1.severity=="none"then r1=false elseif v1.severity=="*"then r1=true elseif w1<=v1.severity then r1=true else r1=false end end end end return r1 end local e={}local l={}local c=false local o=true local function t(r1)local s1=e[r1]if s1 then return s1 end s1=fs.open(r1,"a")if not s1 then return nil,r1..": cannot open for append"end e[r1]=s1 return s1 end local function d()for r1,s1 in pairs(e)do pcall(s1.flush)pcall(s1.close)e[r1]=nil end end local function m(t1,z1,x1)local w1,y1=syscalls["syslog.facilityName"](math.floor(t1/8)),t1%8 local s1=os.date("%b %d %H:%M:%S",math.floor(os.epoch("utc")/1000))local u1=s1.." "..z1..": "..x1 for b2,r1 in ipairs(l)do if k(r1.groups,w1,y1)then local a2,v1=t(r1.action)if not a2 then w("syslogd: "..v1.."\n")else a2:writeLine(u1)a2:flush()end end end end local function q(s1)local r1,t1=s1:match("^(%d+),%d+,%d+,%-?%d*;(.*)$")if not r1 then return end m(tonumber(r1),"kernel",t1)end local function r(t1)local s1,r1=t1:match("^<(%d+)>(.*)$")if not s1 then s1,r1=13,t1 else s1=tonumber(s1)end r1=r1:gsub("^%a%a%a +%d+ +%d%d:%d%d:%d%d +","")local u1,v1=r1:match("^([^:]+):%s*(.*)$")if not u1 then u1,v1="user",r1 end m(s1,u1,v1)end local v,l1=y(a)if not v then return b(l1)end l=v if#l==0 then return b(a..": no rules")end local s=fs.open("/dev/kmsg","r")if not s then return b("/dev/kmsg: cannot open")end local d1=fs.open("/dev/log","r")if not d1 then return b("/dev/log: cannot open")end local h="/run/syslogd.kmsg"local x=syscalls["klog.stats"]().boot do local f1=fs.open(h,"r")if f1 then local n,p=(f1.readLine()or""):match("^(%d+)%s*(%d*)")f1.close()n,p=tonumber(n),tonumber(p)local k1=syscalls["klog.stats"]()if n and p and p==k1.boot and n>=k1.first and n<=k1.next then local m1,j1=s:seek(n)if not m1 then return b("/dev/kmsg: "..tostring(j1))end print("syslogd: resumed /dev/kmsg at seq "..n)end end end local function u()local r1=fs.open(h,"w")if not r1 then return end r1:writeLine(s:cursor().." "..tostring(x))r1:close()end local i1=fs.open(f,"w")if not i1 then return b(f..": cannot write pid file")end i1:writeLine(tostring(pid))i1:close()syscalls["signal.install"](1,function()c=true end)syscalls["signal.install"](15,function()o=false end)print("syslogd: started pid="..pid.." conf="..a.." rules="..#l)while o do if c then c=false d()print("syslogd: SIGHUP - reopened log files")end local c1=false local g=s:readAvailable()if g and g~=""then c1=true for h1 in g:gmatch("[^\n]+")do q(h1)end u()end g=d1:readAvailable()if g and g~=""then c1=true for g1 in g:gmatch("[^\n]+")do r(g1)end end if not c1 then os.sleep(0.05)end end d()print("syslogd: stopped")return 0