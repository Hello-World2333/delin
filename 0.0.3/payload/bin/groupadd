local g=args or{}local function c(m)local l=io.stderr()if l and l.write then l:write(m)end end local function b(l)if l then c("groupadd: "..l.."\n")end c("usage: groupadd [-g GID] name\n")return 2 end if not(syscalls and syscalls["user.addGroup"])then c("groupadd: user syscalls not available\n")return 1 end local e,a,f=nil,nil,false local i=1 while i<=#g do local h=g[i]if f then if a then return b("extra operand '"..h.."'")end a=h elseif h=="--"then f=true elseif h:sub(1,1)=="-"and h~="-"then if h:sub(1,2)~="-g"then return b("invalid option -- '"..h:sub(2,2).."'")end local d=h:sub(3)if d==""then i=i+1 d=g[i]end if d==nil then return b("option requires an argument -- 'g'")end if not d:match("^%d+$")then return b("invalid group ID '"..d.."'")end e=tonumber(d)else if a then return b("extra operand '"..h.."'")end a=h end i=i+1 end if not a then return b("no group name given")end local k,j=syscalls["user.addGroup"](a,e)if not k then c("groupadd: "..tostring(j).."\n")return 1 end return 0