local v=args or{}local b1=(type(cwd)=="string"and cwd)or"/"local function u(l1)l1=l1 or""if l1==""then return(b1=="/")and"/"or b1 end if l1:sub(1,1)=="/"then if l1=="/"then return"/"end return l1:gsub("/+$","")end local k1=(b1=="/")and""or b1 return(k1.."/"..l1):gsub("/+","/")end local function a(l1)local k1=io.stderr()if k1 and k1.write then k1:write(l1)end end local function y(k1)if k1 and(k1:find("permission")or k1:find("denied"))then return"Permission denied"end if k1 and k1:lower():find("no such file")then return"No such file or directory"end if k1 and k1:find("directory")then return"Is a directory"end return"No such file or directory"end local b=2 local f=1000 local e=nil local j=false local i=0 local p=""local c={}local n=false local function q(n1)local m1,k1=n1:match("^(%d+)([KkMmGg]?)$")if not m1 then return nil end local l1=tonumber(m1)if k1=="K"then l1=l1*1024 elseif k1=="M"then l1=l1*1024*1024 elseif k1=="G"then l1=l1*1024*1024*1024 elseif k1=="k"then l1=l1*1000 elseif k1=="m"then l1=l1*1000*1000 elseif k1=="g"then l1=l1*1000*1000*1000 end return l1 end local g1=1 while g1<=#v do local o=v[g1]if n then c[#c+1]=o elseif o=="--"then n=true elseif o:match("^%-%-suffix%-length=")then b=tonumber(o:sub(17))if not b or b<1 then a("split: invalid suffix length: '"..o:sub(17).."'\n");return 1 end elseif o=="--numeric-suffixes"then j=true elseif o:match("^%-%-numeric%-suffixes=")then j=true i=tonumber(o:sub(20))if not i or i<0 then a("split: invalid number: '"..o:sub(20).."'\n");return 1 end elseif o:match("^%-%-additional%-suffix=")then p=o:sub(21)elseif o:match("^%-%-bytes=")then e=q(o:sub(9))if not e then a("split: invalid number of bytes: '"..o:sub(9).."'\n");return 1 end elseif o:match("^%-%-lines=")then f=tonumber(o:sub(9))if not f or f<1 then a("split: invalid number of lines: '"..o:sub(9).."'\n");return 1 end elseif o:match("^%-%-")then a("split: unrecognized option '"..o.."'\n")return 1 elseif o:sub(1,1)=="-"and o~="-"then local h1=2 while h1<=#o do local x=o:sub(h1,h1)if x=="d"then j=true;h1=h1+1 elseif x=="a"or x=="b"or x=="l"then local r=o:sub(h1+1)if r==""then g1=g1+1 if not v[g1]then a("split: option requires an argument -- '"..x.."'\n");return 1 end r=v[g1]end if x=="a"then b=tonumber(r)if not b or b<1 then a("split: invalid suffix length: '"..r.."'\n");return 1 end elseif x=="l"then f=tonumber(r)if not f or f<1 then a("split: invalid number of lines: '"..r.."'\n");return 1 end else e=q(r)if not e then a("split: invalid number of bytes: '"..r.."'\n");return 1 end end h1=#o+1 else a("split: invalid option -- '"..x.."'\n")return 1 end end elseif o:match("^%-%-")then a("split: unrecognized option '"..o.."'\n")return 1 else c[#c+1]=o end g1=g1+1 end if#c>2 then a("split: extra operand '"..c[3].."'\n")return 1 end local l=c[1]or"-"local d1=c[2]or"x"local function w(m1)if j then local n1=string.format("%0"..b.."d",i+m1)if#n1>b then return nil end return n1 end local l1=""local k1=m1 for o1=1,b do l1=string.char(97+k1%26)..l1 k1=math.floor(k1/26)end if k1>0 then return nil end return l1 end local e1 if l=="-"then e1=io.stdin()if not e1 then a("split: 无法读取 stdin\n");return 1 end else local f1 e1,f1=fs.open(u(l),"r")if not e1 then a("split: "..l..": "..y(f1).."\n")return 1 end end local k=0 local g=nil local function t()local l1=w(k)if not l1 then a("split: output file suffixes exhausted\n")return nil,true end k=k+1 local k1=d1..l1..p local n1,m1=fs.open(u(k1),"w")if not n1 then a("split: "..k1..": "..y(m1).."\n")return nil end return n1 end local function m(m1)local k1=""local l1=false return function()while true do local o1=k1:find("\n",1,true)if o1 then local q1=k1:sub(1,o1)k1=k1:sub(o1+1)return q1 end if l1 then if k1==""then return nil end local r1=k1;k1="";return r1 end local n1 if m1.read then n1=m1.read(65536)end if type(n1)~="string"or n1==""then if k1==""then local p1=m1.readLine()if p1==nil then l1=true;return nil end return p1.."\n"end l1=true else k1=k1..n1 end end end end if e then local d=e while true do local h if e1.read then h=e1.read(d)end if type(h)~="string"or h==""then local j1=e1.readLine()if j1==nil then break end h=j1.."\n"end while#h>0 do if not g then local i1 g,i1=t()if not g then return 1 end end local a1=(#h<d)and#h or d g:write(h:sub(1,a1))h=h:sub(a1+1)d=d-a1 if d==0 then g:close()g=nil d=e end end end else local z=m(e1)local s=0 while true do local c1=z()if c1==nil then break end if not g then g=t()if not g then return 1 end s=0 end g:write(c1)s=s+1 if s>=f then g:close()g=nil end end end if g then g:close()end if l~="-"then e1:close()end