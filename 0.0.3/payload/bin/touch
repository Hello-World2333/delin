local e=args or{}local h=(type(cwd)=="string"and cwd)or"/"local function j(s)s=s or""if s==""then return(h=="/")and"/"or h end if s:sub(1,1)=="/"then if s=="/"then return"/"end return s:gsub("/+$","")end local r=(h=="/")and""or h return(r.."/"..s):gsub("/+","/")end local function a(s)local r=io.stderr()if r and r.write then r:write(s)end end local b=false local d={}local c=false local k=1 local g={["r"]=true,["t"]=true,["d"]=true}while k<=#e do local f=e[k]if c then d[#d+1]=f elseif f=="--"then c=true elseif f=="--no-create"then b=true elseif f=="--reference"or f=="--date"or f=="--time"then k=k+1 if not e[k]then a("touch: option requires an argument -- '"..f.."'\n");return end elseif f:sub(1,2)=="--"and f:find("=",1,true)then elseif f:sub(1,1)=="-"and f~="-"and#f>1 then for n=2,#f do local i=f:sub(n,n)if i=="c"then b=true elseif i=="a"or i=="m"then elseif g[i]then if n<#f then break else k=k+1 if not e[k]then a("touch: option requires an argument -- '"..i.."'\n");return end break end else a("touch: invalid option -- '"..i.."'\n");return end end else d[#d+1]=f end k=k+1 end if#d==0 then a("touch: missing file operand\n")return 1 end for q,m in ipairs(d)do local p=j(m)if not fs.exists(p)then if b then else local o,l=pcall(function()local r=fs.open(p,"w")if r then r.close()end end)if not o then a("touch: "..m..": "..tostring(l).."\n")end end end end