local h=args or{}local function d(q)local p=io.stderr()if p and p.write then p:write(q)end end local a,c={},false for n,i in ipairs(h)do if c then a[#a+1]=i elseif i=="--"then c=true elseif i=="-l"or i=="-f"or i=="-v"then else a[#a+1]=i end end if#a==0 then d("umount: missing operand\n")return 1 elseif#a>1 then d("umount: too many arguments\n")return 1 end local e=a[1]local f=(syscalls and syscalls["fs.mounts"]and syscalls["fs.mounts"]())or{}local b for m,k in ipairs(f)do if k.root==e then b=k.root;break end end if not b then for o,g in ipairs(f)do if g.device and(g.device==e or g.device=="/dev/"..e)then b=g.root;break end end end if not b then d("umount: "..e..": not mounted\n")return 1 end local l,j=syscalls["fs.umount"](b)if not l then d("umount: "..tostring(j).."\n")return 1 end io.write("unmounted "..b.."\n")