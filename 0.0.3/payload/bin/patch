local t1=args or{}local w2=(type(cwd)=="string"and cwd)or"/"local r1=nil local function h(j3)j3=j3 or""local i3=r1 or w2 if j3==""then return(i3=="/")and"/"or i3 end if j3:sub(1,1)=="/"then if j3=="/"then return"/"end return j3:gsub("/+$","")end local k3=(i3=="/")and""or i3 return(k3.."/"..j3):gsub("/+","/")end local function a(j3)local i3=io.stderr()if i3 and i3.write then i3:write(j3)end end local function h1(i3)if i3 and(i3:find("permission")or i3:find("denied"))then return"Permission denied"end if i3 and(i3:find("[Nn]o such")or i3:find("not found"))then return"No such file or directory"end if i3 and i3:lower():find("no such file")then return"No such file or directory"end if i3 and i3:find("directory")then return"Is a directory"end return"No such file or directory"end local b={strip=nil,input=nil,output=nil,dir=nil,reverse=false,backup=false,force=false,forward=false,loose=false,dryrun=false,}local c={}local function l(k3,j3,i3)if j3>#t1 then a("patch: option requires an argument -- '"..i3.."'\n")return nil end return t1[j3]end local u1=1 local v=false while u1<=#t1 do local s1=t1[u1]if v then c[#c+1]=s1 elseif s1=="--"then v=true elseif s1=="-"then c[#c+1]=s1 elseif s1:sub(1,2)=="--"then local e,g=s1:match("^%-%-([^=]+)=(.*)$")if not e then e=s1:sub(3)end if e=="strip"then if not g then u1=u1+1;g=l(s1,u1,"strip")end if not g or not tonumber(g)then a("patch: invalid strip count\n");return 2 end b.strip=tonumber(g)elseif e=="input"then if not g then u1=u1+1;g=l(s1,u1,"input")end if not g then return 2 end b.input=g elseif e=="output"then if not g then u1=u1+1;g=l(s1,u1,"output")end if not g then return 2 end b.output=g elseif e=="directory"then if not g then u1=u1+1;g=l(s1,u1,"directory")end if not g then return 2 end b.dir=g elseif e=="reverse"then b.reverse=true elseif e=="backup"then b.backup=true elseif e=="force"then b.force=true elseif e=="forward"then b.forward=true elseif e=="ignore-whitespace"then b.loose=true elseif e=="dry-run"then b.dryrun=true elseif e=="posix"then else a("patch: unrecognized option '--"..e.."'\n")return 2 end elseif s1:sub(1,1)=="-"and#s1>1 then local l2=2 while l2<=#s1 do local q=s1:sub(l2,l2)if q=="p"or q=="i"or q=="o"or q=="d"then local y=s1:sub(l2+1)if y==""then u1=u1+1 y=l(s1,u1,q)if not y then return 2 end end if q=="p"then if not tonumber(y)then a("patch: invalid strip count '"..y.."'\n");return 2 end b.strip=tonumber(y)elseif q=="i"then b.input=y elseif q=="o"then b.output=y else b.dir=y end l2=#s1+1 elseif q=="R"then b.reverse=true;l2=l2+1 elseif q=="b"then b.backup=true;l2=l2+1 elseif q=="f"then b.force=true;l2=l2+1 elseif q=="N"then b.forward=true;l2=l2+1 elseif q=="l"then b.loose=true;l2=l2+1 elseif q=="r"then a("patch: -r (treat directories as files) is not supported\n")return 2 else a("patch: invalid option -- '"..q.."'\n")return 2 end end else c[#c+1]=s1 end u1=u1+1 end if b.dir then local x2=h(b.dir)if not fs.isDir(x2)then a("patch: "..b.dir..": "..(fs.exists(x2)and"Not a directory"or"No such file or directory").."\n")return 2 end r1=x2 end local f,c1 if b.input then if#c>1 then a("patch: extra operand '"..c[2].."'\n")return 2 end f=c[1]else if#c>2 then a("patch: extra operand '"..c[3].."'\n")return 2 end f,c1=c[1],c[2]end local function e2(i3)if i3==nil or i3=="-"then local l3=io.stdin()if not l3 then error("patch: standard input is not available")end return l3.readAll()or""end local m3=h(i3)local k3,j3=fs.open(m3,"r")if not k3 then a("patch: "..m3..": "..h1(j3).."\n")return nil end local n3=k3.readAll()or""k3.close()return n3 end local d1=e2(b.input or c1)if d1==nil then return 2 end local function x1(l3)local i3={}local j3=1 while true do local k3=l3:find("\n",j3,true)if not k3 then if j3<=#l3 then i3[#i3+1]=l3:sub(j3)end return i3 end i3[#i3+1]=l3:sub(j3,k3-1)j3=k3+1 end end local function k(i3)if not i3 then return nil end i3=i3:match("^([^\t]*)\t")or i3 i3=i3:gsub("%s+$","")if i3==""then return nil end return i3 end local function h2(i3,l3)if l3==nil then return i3 end local k3=i3 for m3=1,l3 do local j3=k3:match("^[^/]*/(.*)$")if not j3 then return nil end k3=j3 end return k3 end local function a1()return{ops={},raw={}}end local function s(o3,l3,i3)local k3,j3=i3.oldCount,i3.newCount while k3>0 or j3>0 do local m3=o3[l3]if m3==nil then a("patch: **** unexpected end of file in patch\n")return nil end local p3=m3:sub(1,1)if p3=="\\"then local n3=i3.ops[#i3.ops]if n3 then n3.noEol=true end i3.raw[#i3.raw+1]=m3 l3=l3+1 elseif p3=="-"then i3.ops[#i3.ops+1]={k="-",t=m3:sub(2)}i3.raw[#i3.raw+1]=m3 k3=k3-1 l3=l3+1 elseif p3=="+"then i3.ops[#i3.ops+1]={k="+",t=m3:sub(2)}i3.raw[#i3.raw+1]=m3 j3=j3-1 l3=l3+1 elseif p3==" "then i3.ops[#i3.ops+1]={k=" ",t=m3:sub(2)}i3.raw[#i3.raw+1]=m3 k3,j3=k3-1,j3-1 l3=l3+1 elseif m3==""then i3.ops[#i3.ops+1]={k=" ",t=""}i3.raw[#i3.raw+1]=m3 k3,j3=k3-1,j3-1 l3=l3+1 else a("patch: **** malformed patch at line "..l3..": "..m3.."\n")return nil end end return l3 end local function w1(j3)local n3={}local o3,e5=1,#j3 while o3<=e5 do local b5=j3[o3]if b5:match("^%-%-%- ")and j3[o3+1]and j3[o3+1]:match("^%+%+%+ ")then local v3={oldName=k(b5:sub(5)),newName=k(j3[o3+1]:sub(5)),hunks={}}o3=o3+2 while o3<=e5 and j3[o3]:match("^@@")do local t4,v4,f5,y4=j3[o3]:match("^@@ %-(%d+),?(%d*) %+(%d+),?(%d*) @@")if not t4 then a("patch: **** malformed unified hunk header: "..j3[o3].."\n")return nil end local p3=a1()p3.oldStart=tonumber(t4)p3.oldCount=(v4=="")and 1 or tonumber(v4)p3.newStart=tonumber(f5)p3.newCount=(y4=="")and 1 or tonumber(y4)p3.raw[#p3.raw+1]=j3[o3]o3=o3+1 local d5=s(j3,o3,p3)if not d5 then return nil end o3=d5 v3.hunks[#v3.hunks+1]=p3 end if#v3.hunks==0 then a("patch: **** no hunks found after header for "..tostring(v3.oldName).."\n")return nil end n3[#n3+1]=v3 elseif b5:match("^%*%*%* ")and j3[o3+1]and j3[o3+1]:match("^%-%-%- ")then local x3={oldName=k(b5:sub(5)),newName=k(j3[o3+1]:sub(5)),hunks={}}o3=o3+2 while o3<=e5 and j3[o3]:match("^%*%*%*%*%*%*%*%*%*%*%*%*%*%*%*")do o3=o3+1 local j4=j3[o3]local f4,n4 if j4 then f4,n4=j4:match("^%*%*%* (%d+),?(%d*) %*%*%*%*$")end if not f4 then a("patch: **** malformed context hunk header: "..tostring(j4).."\n")return nil end local i3=a1()i3.oldStart=tonumber(f4)local z3=(n4=="")and tonumber(f4)or tonumber(n4)i3.oldCount=(z3>=i3.oldStart)and(z3-i3.oldStart+1)or 0 i3.raw[#i3.raw+1]=j4 o3=o3+1 local l3={}local r3=false if j3[o3]and not j3[o3]:match("^%-%-%- %d")then r3=true for k5=1,i3.oldCount do local p4=j3[o3]if p4==nil then a("patch: **** unexpected end of context hunk\n");return nil end l3[#l3+1]=p4 i3.raw[#i3.raw+1]=p4 o3=o3+1 end end local k4=j3[o3]local g4,o4 if k4 then g4,o4=k4:match("^%-%-%- (%d+),?(%d*) %-%-%-%-$")end if not g4 then a("patch: **** malformed context hunk header: "..tostring(k4).."\n")return nil end i3.newStart=tonumber(g4)local b4=(o4=="")and tonumber(g4)or tonumber(o4)i3.newCount=(b4>=i3.newStart)and(b4-i3.newStart+1)or 0 i3.raw[#i3.raw+1]=k4 o3=o3+1 local m3={}local q3=false do local t3=j3[o3]if t3 and(t3:sub(1,2)=="  "or t3:sub(1,2)=="+ "or t3:sub(1,2)=="! "or t3=="")then q3=true for j5=1,i3.newCount do t3=j3[o3]if t3==nil then a("patch: **** unexpected end of context hunk\n");return nil end m3[#m3+1]=t3 i3.raw[#i3.raw+1]=t3 o3=o3+1 end end end if not r3 and not q3 then a("patch: **** context hunk has no body\n");return nil end if not r3 then for h5,z4 in ipairs(m3)do local r4,d4=z4:sub(1,2),z4:sub(3)if r4=="  "then i3.ops[#i3.ops+1]={k=" ",t=d4}else i3.ops[#i3.ops+1]={k="+",t=d4}end end elseif not q3 then for l5,a5 in ipairs(l3)do local q4,e4=a5:sub(1,2),a5:sub(3)if q4=="  "then i3.ops[#i3.ops+1]={k=" ",t=e4}else i3.ops[#i3.ops+1]={k="-",t=e4}end end else local s3,u3=1,1 while s3<=#l3 or u3<=#m3 do local l4=l3[s3]and l3[s3]:sub(1,2)local s4=m3[u3]and m3[u3]:sub(1,2)if l4=="  "and s4=="  "then i3.ops[#i3.ops+1]={k=" ",t=l3[s3]:sub(3)}s3,u3=s3+1,u3+1 elseif l4=="- "or l4=="! "then if l4=="! "then i3.ops[#i3.ops+1]={k="-",t=l3[s3]:sub(3)}s3=s3+1 else i3.ops[#i3.ops+1]={k="-",t=l3[s3]:sub(3)}s3=s3+1 end elseif s4=="+ "or s4=="! "then i3.ops[#i3.ops+1]={k="+",t=m3[u3]:sub(3)}u3=u3+1 else a("patch: **** malformed context hunk body\n")return nil end end end x3.hunks[#x3.hunks+1]=i3 end if#x3.hunks==0 then a("patch: **** no hunks found in context patch\n")return nil end n3[#n3+1]=x3 elseif b5:match("^%d+[,%d]*[acd]%d+")then local w3={oldName=nil,newName=nil,hunks={}}while o3<=e5 do local c5=j3[o3]local m4,u4,c4,w4,x4=c5:match("^(%d+),?(%d*)([acd])(%d+),?(%d*)$")if not m4 then break end local k3=a1()k3.raw[#k3.raw+1]=c5 local y3=(u4=="")and tonumber(m4)or tonumber(u4)local a4=(x4=="")and tonumber(w4)or tonumber(x4)k3.oldStart=tonumber(m4)k3.newStart=tonumber(w4)if c4=="a"then k3.oldCount=0 k3.newCount=a4-k3.newStart+1 elseif c4=="d"then k3.oldCount=y3-k3.oldStart+1 k3.newCount=0 else k3.oldCount=y3-k3.oldStart+1 k3.newCount=a4-k3.newStart+1 end o3=o3+1 for i5=1,k3.oldCount do local i4=j3[o3]if i4==nil or i4:sub(1,1)~="<"then a("patch: **** malformed normal diff (expected '<' line)\n")return nil end k3.ops[#k3.ops+1]={k="-",t=i4:sub(3)}k3.raw[#k3.raw+1]=i4 o3=o3+1 end if c4=="c"then if j3[o3]~="---"then a("patch: **** malformed normal diff (expected '---')\n")return nil end o3=o3+1 end for g5=1,k3.newCount do local h4=j3[o3]if h4==nil or h4:sub(1,1)~=">"then a("patch: **** malformed normal diff (expected '>' line)\n")return nil end k3.ops[#k3.ops+1]={k="+",t=h4:sub(3)}k3.raw[#k3.raw+1]=h4 o3=o3+1 end w3.hunks[#w3.hunks+1]=k3 end if#w3.hunks>0 then n3[#n3+1]=w3 end else o3=o3+1 end end return n3 end local j=w1(x1(d1))if not j then return 2 end if b.reverse then for f3,f2 in ipairs(j)do for d3,q2 in ipairs(f2.hunks)do for h3,s2 in ipairs(q2.ops)do if s2.k=="-"then s2.k="+"elseif s2.k=="+"then s2.k="-"end end q2.oldStart,q2.newStart=q2.newStart,q2.oldStart q2.oldCount,q2.newCount=q2.newCount,q2.oldCount end f2.oldName,f2.newName=f2.newName,f2.oldName end end if#j==0 then a("patch: **** Only garbage was found in the patch input.\n")return 2 end if b.output and#j>1 then a("patch: -o/--output only works with a single-file patch\n")return 2 end local g1=1 local function j1(i3)local j3={}local k3=1 while true do local l3=i3:find("\n",k3,true)if not l3 then if k3<=#i3 then j3[#j3+1]={t=i3:sub(k3),eol=false}end return j3 end j3[#j3+1]={t=i3:sub(k3,l3-1),eol=true}k3=l3+1 end end local function m1(j3)local l3,k3=fs.open(j3,"r")if not l3 then return nil,k3 end local i3=l3.readAll()or""l3.close()return j1(i3)end local function b1(i3)i3=i3:gsub("[ \t]+$","")i3=i3:gsub("[ \t]+"," ")return i3 end local function a2(i3,j3)if b.loose then return b1(i3)==b1(j3)end return i3==j3 end local function k1(k3,j3)if j3==0 then return k3 end local n3,m3,i3=1,#k3,0 while i3<j3 and n3<=m3 and k3[n3].k==" "do n3,i3=n3+1,i3+1 end if i3<j3 then return nil end i3=0 while i3<j3 and m3>=n3 and k3[m3].k==" "do m3,i3=m3-1,i3+1 end if i3<j3 then return nil end local l3={}for o3=n3,m3 do l3[#l3+1]=k3[o3]end return l3 end local function q1(l3)local i3,j3={},{}for m3,k3 in ipairs(l3)do if k3.k~="+"then i3[#i3+1]=k3 end if k3.k~="-"then j3[#j3+1]=k3 end end return i3,j3 end local function o1(k3,j3,i3)if j3<1 then return false end for l3=1,#i3 do local m3=k3[j3+l3-1]if not m3 then return false end if not a2(m3.t,i3[l3].t)then return false end end return true end local function b2(j3,k3,l3,i3)if i3>=k3 and o1(j3,i3,l3)then return i3 end for m3=k3,#j3-#l3+1 do if o1(j3,m3,l3)then return m3 end end return nil end local function j2(p3,n3,o3,i3)for j3=0,g1 do local k3=k1(o3.ops,j3)if k3 then local l3,q3=q1(k3)local m3=b2(p3,n3,l3,i3+j3)if m3 then return m3,j3,l3,q3 end end end return nil end local function e1(n3,l3,m3,i3)for j3=0,g1 do local k3=k1(m3.ops,j3)if k3 then local p3,o3=q1(k3)if b2(n3,l3,o3,i3+j3)then return true end end end return false end local function l1(i3,j3)local l3,k3=fs.open(i3,"w")if not l3 then a("patch: "..i3..": "..h1(k3).."\n")return false end for n3,m3 in ipairs(j3)do l3.write(m3.t..(m3.eol and"\n"or""))end l3.close()return true end local function m2(j3,i3,k3)local l3=fs.open(j3..".rej","w")if not l3 then a("patch: "..j3..".rej: cannot write rejects\n")return 1 end if i3.oldName then l3.write("--- "..i3.oldName.."\n")end if i3.newName then l3.write("+++ "..i3.newName.."\n")end for p3,n3 in ipairs(k3)do for o3,m3 in ipairs(i3.hunks[n3].raw)do l3.write(m3.."\n")end end l3.close()end local function i2(k3)if f then return f,h(f)end local j3=k3.oldName if j3==nil or j3=="/dev/null"then j3=k3.newName end if j3==nil then return nil end local i3=h2(j3,b.strip)if not i3 then return nil end return i3,h(i3)end local t=false for c3,x in ipairs(j)do local n,d=i2(x)if not d then a("patch: **** can't find file to patch (no file name in patch header and no ORIGFILE)\n")return 2 end if b.output then io.write((b.dryrun and"checking file "or"patching file ")..b.output.." (read from "..n..")\n")else io.write((b.dryrun and"checking file "or"patching file ")..n.."\n")end local z1=fs.exists(d)and fs.isFile(d)local n1=false local m if z1 then local t2 m,t2=m1(d)if not m then a("patch: "..d..": "..h1(t2).."\n")return 2 end else local y1=true for g3,z2 in ipairs(x.hunks)do if z2.oldCount>0 then y1=false break end end local v1=(x.oldName=="/dev/null")or y1 if not(v1 or f)then a("patch: **** can't find file to patch\n")return 1 end if fs.isDir(d)then a("patch: "..d..": Is a directory\n")return 2 end local p2=fs.getDir(d)if not fs.isDir(p2)then a("patch: "..d..": No such file or directory\n")return 2 end m={}n1=true end local i1={}local g2=1 local f1=0 local u,o={},{}for r2,z in ipairs(x.hunks)do local i=z.oldStart+f1 if z.oldCount==0 then i=z.oldStart+1+f1 end local p1,k2,u2,v2=j2(m,g2,z,i)if not p1 then if not b.force and e1(m,g2,z,i)then io.write("Reversed (or previously applied) patch detected!  Skipping patch.\n")o[#o+1]=r2 else io.write("Hunk #"..r2.." FAILED at "..z.oldStart..".\n")u[#u+1]=r2 end else for b3=g2,p1-1 do i1[#i1+1]=m[b3]end for e3,y2 in ipairs(v2)do i1[#i1+1]={t=y2.t,eol=not y2.noEol}end g2=p1+#u2 f1=f1+(#v2-#u2)if k2>0 or p1~=i then local o2=p1-i local c2="Hunk #"..r2.." succeeded at "..p1 if k2>0 then c2=c2.." with fuzz "..k2 end if o2~=0 then c2=c2.." (offset "..o2.." "..((math.abs(o2)==1)and"line"or"lines")..")"end io.write(c2..".\n")end end end for a3=g2,#m do i1[#i1+1]=m[a3]end local p,r=#u,#o local function d2(i3)return(i3==1)and"hunk"or"hunks"end if p>0 or r>0 then t=true local w=(b.output or n)..".rej"if not b.dryrun then m2(b.output and h(b.output)or d,x,(function()local i3={}for l3,j3 in ipairs(u)do i3[#i3+1]=j3 end for m3,k3 in ipairs(o)do i3[#i3+1]=k3 end table.sort(i3)return i3 end)())end if p>0 then io.write(p.." out of "..#x.hunks.." "..d2(#x.hunks).." FAILED"..(b.dryrun and"\n"or(" -- saving rejects to file "..w.."\n")))end if r>0 and p==0 then io.write(r.." out of "..#x.hunks.." "..d2(#x.hunks).." ignored"..(b.dryrun and"\n"or(" -- saving rejects to file "..w.."\n")))end end if b.dryrun then else local n2=b.output and h(b.output)or d if b.backup and z1 and not n1 then if not fs.copy(d,d..".orig")then a("patch: cannot create backup "..d..".orig\n")return 2 end end if not l1(n2,i1)then return 2 end end end if t then return 1 end return 0