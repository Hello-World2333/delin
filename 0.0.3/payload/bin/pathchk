local p=args or{}local function k(w)local v=io.stderr()if v and v.write then v:write(w)end end local j,e=false,false local f,i={},false for u,m in ipairs(p)do if i then f[#f+1]=m elseif m=="--"then i=true elseif m=="-p"or m=="--portability"then j=true elseif m=="-P"or m=="--portability-plus"then e=true elseif m:sub(1,1)=="-"and m~="-"then for r=2,#m do local q=m:sub(r,r)if q=="p"then j=true elseif q=="P"then e=true else k("pathchk: invalid option -- '"..q.."'\n")return 1 end end else f[#f+1]=m end end if#f==0 then k("pathchk: missing operand\n")return 1 end local a=14 local b=255 local g=255 local h=4095 local c=g local d=h if j then if a<c then c=a end if b<d then d=b end end local function n(w)if w==""then if j or e then return"empty file name"end return"No such file or directory"end local y=#w if y>d then return"length "..y.." exceeds limit "..d end for v in w:gmatch("[^/]+")do if e and v:sub(1,1)=="-"then return"component '"..v.."' starts with '-'"end if#v>c then return"component '"..v.."' length "..#v.." exceeds limit "..c end if j then local x=v:match("[^A-Za-z0-9._%-]")if x then return"non-portable character '"..x.."' in component '"..v.."'"end end end return nil end local l=0 for t,s in ipairs(f)do local o=n(s)if o then k("pathchk: '"..s.."': "..o.."\n")l=1 end end return l