local q=args or{}local l=(type(cwd)=="string"and cwd)or"/"local function b(b1)local a1=io.stderr()if a1 and a1.write then a1:write(b1)end end local h=40 local function g(b1)local a1={}for c1 in b1:gmatch("[^/]+")do a1[#a1+1]=c1 end return a1 end local function n(b1)local a1=fs.lstat(b1)if not a1 then return nil end if a1.kind=="symlink"then return a1 end if fs.exists(b1)then return a1 end return nil end local function i(c1,g1)if c1==""then return nil,"No such file or directory"end local k1 if c1:sub(1,1)=="/"then k1=c1 else local m1=(l=="/")and""or l k1=m1.."/"..c1 end local d1=g(k1)local b1={}local f1=0 local a1=nil local j1=1 while j1<=#d1 do local e1=d1[j1]if e1=="."then j1=j1+1 elseif e1==".."then if#b1>0 then b1[#b1]=nil end j1=j1+1 else local o1=(#b1==0)and"/"or("/"..table.concat(b1,"/").."/")local h1=o1..e1 local p1 if g1~="missing"then p1=n(h1)end if p1 and p1.kind=="symlink"then local l1,n1=fs.readlink(h1)if not l1 then return nil,"cannot read symbolic link '"..h1.."': "..tostring(n1)end f1=f1+1 if f1>h then return nil,"Too many levels of symbolic links"end if l1:sub(1,1)=="/"then b1={};a1=nil end local i1=g(l1)table.remove(d1,j1)for q1=#i1,1,-1 do table.insert(d1,j1,i1[q1])end elseif p1 then b1[#b1+1]=e1 j1=j1+1 else if not a1 then a1=#b1+1 end b1[#b1+1]=e1 j1=j1+1 end end end if g1~="missing"and a1 then if g1=="existing"or#b1>a1 then return nil,"No such file or directory"end end if#b1==0 then return"/"end return"/"..table.concat(b1,"/")end local d=nil local a,k,e=false,false,false local c={}local f=false local function j(a1)if a1=="f"then d="allbutlast"elseif a1=="e"then d="existing"elseif a1=="m"then d="missing"elseif a1=="n"then a=true elseif a1=="z"then k=true elseif a1=="v"then e=true else b("readlink: invalid option -- '"..a1.."'\n");return false end return true end for z,o in ipairs(q)do if f then c[#c+1]=o elseif o=="--"then f=true elseif o=="--canonicalize"then d="allbutlast"elseif o=="--canonicalize-existing"then d="existing"elseif o=="--canonicalize-missing"then d="missing"elseif o=="--no-newline"then a=true elseif o=="--zero"then k=true elseif o=="--verbose"then e=true elseif o:sub(1,1)=="-"and o~="-"then for v=2,#o do if not j(o:sub(v,v))then return 1 end end else c[#c+1]=o end end if#c==0 then b("readlink: missing operand\n")return 1 end if a and#c>1 then b("readlink: ignoring --no-newline with multiple arguments\n")a=false end local m=k and string.char(0)or(a and""or"\n")local s=0 for y,r in ipairs(c)do if d then local x,t=i(r,d)if not x then if e then b("readlink: "..r..": "..tostring(t).."\n")end s=1 else io.write(x..m)end else local w=(r:sub(1,1)=="/")and r:gsub("/+$","")or(((l=="/")and""or l).."/"..r):gsub("/+","/")local p,u=fs.readlink(w)if p then io.write(p..m)else if e then if n(w)then b("readlink: "..r..": Invalid argument\n")else b("readlink: "..r..": No such file or directory\n")end end s=1 end end end return s