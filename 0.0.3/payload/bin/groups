local c=args or{}local function a(h)local g=io.stderr()if g and g.write then g:write(h)end end if c[2]then a("groups: extra operand '"..tostring(c[2]).."'\n")return 1 end local d=c[1]if not(syscalls and syscalls["user.groupsOf"])then a("groups: user syscalls not available\n")return 1 end local b=d if not b then local f=syscalls["user.byUid"]and syscalls["user.byUid"](uid)if not f then a("groups: cannot find name for user ID "..tostring(uid).."\n")return 1 end b=f.name end local e=syscalls["user.groupsOf"](b)if not e then a("groups: '"..tostring(b).."': no such user\n")return 1 end io.write(table.concat(e," ").."\n")return 0