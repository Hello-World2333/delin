 c3="Permission denied"end if c3:sub(1,#d3[1]+2)==d3[1]..": "then c3=c3:sub(#d3[1]+3)end a("xargs: "..d3[1]..": "..c3.."\n")d1(g3)return false end local e3=syscalls["proc.wait"](h3)if e3<0 then a("xargs: "..d3[1]..": terminated by signal "..tostring(-e3).."\n")elseif e3==255 then a("xargs: "..d3[1]..": exited with status 255; aborting\n")end j1(e3)return not(e3==255)end local n=#z+1 for a3,u2 in ipairs(w)do n=n+#u2+1 end local function t(d3)local c3={z}for h3,e3 in ipairs(w)do c3[#c3+1]=e3 end for g3,f3 in ipairs(d3)do c3[#c3+1]=f3 end return c3 end local c1=false if b then for x2,g2 in ipairs(l)do local e1={}for z2,s2 in ipairs(t({}))do e1[#e1+1]=s2:gsub(b:gsub("%p","%%%0"),(g2.value:gsub("%%","%%%%")))end local r1=0 for b3,t2 in ipairs(e1)do r1=r1+#t2+1 end if r1>h then a("xargs: argument line too long\n")return 1 end if c and not q(e1)then elseif not g1(e1)then c1=true end if c1 then break end end else local w1=(m~=nil)or(d~=nil)local j,b1,u={},n,nil local function l1()if#j==0 then return true end local c3=t(j)j,b1,u={},n,nil if c and not q(c3)then return true end return g1(c3)end for y2,c2 in ipairs(l)do local y1=#c2.value+1 if#j>0 then local o1=(m~=nil and#j>=m)local s1=(d~=nil and(c2.line-u+1)>d)if o1 or s1 then if not l1()then c1=true;break end elseif b1+y1>h then if x and w1 then a("xargs: argument list too long\n")return 1 end if not l1()then c1=true;break end end end if#j==0 then u=c2.line;b1=n end if b1+y1>h and#j==0 then a(x and"xargs: argument list too long\n"or"xargs: argument line too long\n")return 1 end j[#j+1]=c2.value b1=b1+y1 end if not c1 then l1()end end if not c1 and#l==0 and not e and not b then local z1=t({})if not(c and not q(z1))then g1(z1)end end if f1 then return 1 end if k~=0 then return k end