local b2=table.unpack or unpack local s=args or{}local f2=(type(cwd)=="string"and cwd)or"/"local function a(d3)local c3=io.stderr()if c3 and c3.write then c3:write(d3)end end local p,g,x,c,e=false,false,false,false,false local o,b,m,d=nil,nil,nil,nil local h=4096 local z,w=nil,{}local a1=false local function v1(c3)a("xargs: warning: "..c3.."\n")end local function r(c3)if m or d then v1("options --replace and --max-args/--max-lines are mutually exclusive, ignoring previous value")end b=c3 m,d=nil,nil end local function i(c3,d3)if b then v1("options --replace and "..c3.." are mutually exclusive, ignoring previous --replace value")b=nil end if c3=="-n"then m=d3 else d=d3 end end local function f(d3,c3)if not c3 or not c3:match("^%d+$")then a("xargs: invalid number for "..d3.." option\n")return nil end c3=tonumber(c3)if c3<1 then a("xargs: value "..tostring(c3).." for "..d3.." option should be >= 1\n")return nil end return c3 end local k1=1 while k1<=#s do local v=s[k1]if a1 or z then if not z then z=v else w[#w+1]=v end elseif v=="--"then a1=true elseif v=="-"then z=v elseif v=="--null"then p=true elseif v=="--verbose"then g=true elseif v=="--exit"then x=true elseif v=="--interactive"then c=true;g=true elseif v=="--no-run-if-empty"then e=true elseif v=="--eof"then k1=k1+1 if not s[k1]then a("xargs: option '--eof' requires an argument\n");return 1 end o=s[k1]elseif v:sub(1,6)=="--eof="then o=v:sub(7)elseif v=="--replace"then r("{}")elseif v:sub(1,10)=="--replace="then r(v:sub(11))elseif v=="--max-args"then k1=k1+1 local p2=f("-n",s[k1]);if not p2 then return 1 end i("-n",p2)elseif v:sub(1,11)=="--max-args="then local o2=f("-n",v:sub(12));if not o2 then return 1 end i("-n",o2)elseif v=="--max-lines"then k1=k1+1 local m2=f("-L",s[k1]);if not m2 then return 1 end i("-L",m2)elseif v:sub(1,12)=="--max-lines="then local j2=f("-L",v:sub(13));if not j2 then return 1 end i("-L",j2)elseif v=="--max-chars"then k1=k1+1 local l2=f("-s",s[k1]);if not l2 then return 1 end h=l2 elseif v:sub(1,12)=="--max-chars="then local i2=f("-s",v:sub(13));if not i2 then return 1 end h=i2 elseif v:sub(1,2)=="--"then a("xargs: unrecognized option '"..v.."'\n")return 1 elseif v:sub(1,1)=="-"and#v>1 then local e2=2 while e2<=#v do local x1=v:sub(e2,e2)local d2=v:sub(e2+1)local function i1()if d2~=""then e2=#v;return d2 end k1=k1+1 return s[k1]end if x1=="0"then p=true elseif x1=="t"then g=true elseif x1=="x"then x=true elseif x1=="p"then c=true;g=true elseif x1=="r"then e=true elseif x1=="E"then local r2=i1()if r2==nil then a("xargs: option requires an argument -- 'E'\n");return 1 end o=r2 elseif x1=="I"then r(i1()or"{}")elseif x1=="L"or x1=="l"then local q2=f("-L",i1());if not q2 then return 1 end i("-L",q2)elseif x1=="n"then local k2=f("-n",i1());if not k2 then return 1 end i("-n",k2)elseif x1=="s"then local n2=f("-s",i1());if not n2 then return 1 end h=n2 else a("xargs: invalid option -- '"..x1.."'\n")return 1 end e2=e2+1 end else z=v end k1=k1+1 end if p and o then v1("the -E option has no effect if -0 or -d is used.\n")o=nil end z=z or"echo"local function p1()local d3=io.stdin()if not d3 then return""end if d3.readAll then return d3.readAll()or""end local c3={}while true do local e3=d3.readLine()if e3==nil then break end c3[#c3+1]=e3 end return table.concat(c3,p and""or"\n")end local u1=p1()local function h1(k3)local f3={}local e3,o3=1,#k3 local g3=1 local d3,c3={},false local function i3()f3[#f3+1]={value=table.concat(d3),line=g3}d3,c3={},false end while e3<=o3 do local j3=k3:sub(e3,e3)if j3=="'"then c3=true e3=e3+1 while true do local n3=k3:sub(e3,e3)if n3==""or n3=="\n"then return f3,"unmatched single quote"end if n3=="'"then e3=e3+1;break end d3[#d3+1]=n3 e3=e3+1 end elseif j3=='"'then c3=true e3=e3+1 while true do local m3=k3:sub(e3,e3)if m3==""or m3=="\n"then return f3,"unmatched double quote"end if m3=='"'then e3=e3+1;break end d3[#d3+1]=m3 e3=e3+1 end elseif j3=="\\"then local l3=k3:sub(e3+1,e3+1)if l3==""then c3=true d3[#d3+1]="\\"e3=e3+1 else c3=tr