local r=args or{}local i=(type(cwd)=="string"and cwd)or"/"local function k(k1)k1=k1 or""if k1==""then return(i=="/")and"/"or i end if k1:sub(1,1)=="/"then if k1=="/"then return"/"end return k1:gsub("/+$","")end local j1=(i=="/")and""or i return(j1.."/"..k1):gsub("/+","/")end local function d(k1)local j1=io.stderr()if j1 and j1.write then j1:write(k1)end end local function n(j1)if j1 and(j1:find("permission")or j1:find("denied"))then return"Permission denied"end if j1 and j1:lower():find("no such file")then return"No such file or directory"end if j1 and j1:find("directory")then return"Is a directory"end return"No such file or directory"end local g=4294967296 local q={}for b1=0,15 do q[b1]={}for d1=0,15 do local c1,m,z,a1=0,1,b1,d1 while z>0 or a1>0 do if z%2~=a1%2 then c1=c1+m end z=math.floor(z/2);a1=math.floor(a1/2);m=m*2 end q[b1][d1]=c1 end end local function f(k1,l1)local m1,j1=0,1 for n1=1,8 do m1=m1+q[k1%16][l1%16]*j1 k1=math.floor(k1/16);l1=math.floor(l1/16);j1=j1*16 end return m1 end local l do l={}for f1=0,255 do local o=f1*16777216%g for i1=1,8 do if o>=2147483648 then o=((o*2)%g)o=f(o,0x04C11DB7)else o=(o*2)%g end end l[f1]=o end end local function h(j1,k1)local l1=f(math.floor(j1/16777216),k1)%256 return f((j1*256)%g,l[l1])end local function j(l1)local j1=math.floor(l1/1000000)local k1=l1%1000000 if j1==0 then return string.format("%d",k1)end return string.format("%d%06d",j1,k1)end local function b(o1)local k1=0 local l1=0 local m1=nil while true do local j1 if o1.read then j1=o1.read(65536)end if type(j1)~="string"or j1==""then local p1=o1.readLine()if p1==nil then break end j1=p1.."\n"end for q1=1,#j1 do k1=h(k1,j1:byte(q1))l1=l1+1 end end local n1=l1 while n1>0 do k1=h(k1,n1%256)n1=math.floor(n1/256)end k1=g-1-k1 return k1,l1 end local a={}local c=false for g1,u in ipairs(r)do if c then a[#a+1]=u elseif u=="--"then c=true elseif u:sub(1,1)=="-"and u~="-"then d("cksum: invalid option -- '"..u:sub(2,2).."'\n")return 1 else a[#a+1]=u end end local e={}if#a==0 then local e1=io.stdin()if not e1 then d("cksum: 无法读取 stdin\n");return 1 end local x,s=b(e1)io.write(j(x).." "..s.."\n")return end for h1,y in ipairs(a)do local v if y=="-"then v=io.stdin()if not v then d("cksum: 无法读取 stdin\n");return 1 end else local p v,p=fs.open(k(y),"r")if not v then d("cksum: "..y..": "..n(p).."\n")return 1 end end local w,t=b(v)if y~="-"then v:close()end e[#e+1]=j(w).." "..t.." "..y.."\n"if#e>=128 then io.write(table.concat(e));e={}end end if#e>0 then io.write(table.concat(e))end