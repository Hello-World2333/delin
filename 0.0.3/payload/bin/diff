local t1=args or{}local x1=(type(cwd)=="string"and cwd)or"/"local function l1(z2)z2=z2 or""if z2==""then return(x1=="/")and"/"or x1 end if z2:sub(1,1)=="/"then if z2=="/"then return"/"end return z2:gsub("/+$","")end local y2=(x1=="/")and""or x1 return(y2.."/"..z2):gsub("/+","/")end local function p(z2)local y2=io.stderr()if y2 and y2.write then y2:write(z2)end end local function d2(y2)if y2 and(y2:find("permission")or y2:find("denied"))then return"Permission denied"end if y2 and(y2:find("[Nn]o such")or y2:find("not found"))then return"No such file or directory"end if y2 and y2:lower():find("no such file")then return"No such file or directory"end if y2 and y2:find("directory")then return"Is a directory"end return"No such file or directory"end local j={fmt="normal",ctx=3,recursive=false,brief=false,same=false,wsc=false,wall=false,icase=false,blank=false,trail=false,newfile=false,text=false,}local b,l={},{}local y=false local c1=0 local function h(y2)p("diff: "..y2.."\n")p("diff: Try 'diff --help' for more information.\n")return 2 end local function q1()io.write(table.concat({"用法: diff [选项]... 文件1 文件2","逐行比较两个文件(或目录)。","","  -c, -C 行数, --context[=行数]     context 格式(缺省 3 行上下文)","  -u, -U 行数, --unified[=行数]     unified 格式(缺省 3 行上下文)","  -e, --ed                          ed 脚本格式","  -r, --recursive                   递归比较目录","  -q, --brief                       只报告是否不同","  -s, --report-identical-files      相同也报告","  -b, --ignore-space-change         忽略空白量变化","  -w, --ignore-all-space            忽略所有空白","  -Z, --ignore-trailing-space       忽略行尾空白","  -i, --ignore-case                 忽略大小写","  -B, --ignore-blank-lines          忽略纯空行的变化","  -N, --new-file                    缺失文件当空文件","  -a, --text                        二进制也按文本比较","      --help                        显示本帮助","","退出码: 0 相同 / 1 有差异 / 2 出错。",},"\n").."\n")end local function w1(y2)if y2=="r"then j.recursive=true elseif y2=="q"then j.brief=true elseif y2=="s"then j.same=true elseif y2=="b"then j.wsc=true elseif y2=="w"then j.wall=true elseif y2=="i"then j.icase=true elseif y2=="Z"then j.trail=true elseif y2=="B"then j.blank=true elseif y2=="N"then j.newfile=true elseif y2=="a"then j.text=true elseif y2=="u"then j.fmt,j.ctx="unified",3 elseif y2=="c"then j.fmt,j.ctx="context",3 elseif y2=="e"then j.fmt="ed"else h("invalid option -- '"..y2.."'")return false end return true end local function c2(z2,a3)local y2=z2 if y2==""then a3=a3+1 y2=t1[a3]if not y2 then return nil,a3,"option requires an argument"end end local b3=tonumber(y2)if not b3 or b3<0 or b3~=math.floor(b3)then return nil,a3,"invalid context length '"..y2.."'"end return b3,a3 end local n2=1 while n2<=#t1 do local s1=t1[n2]if y then b[#b+1]=s1 elseif s1=="--"then y=true elseif s1=="-"then b[#b+1]=s1 c1=c1+1 elseif s1:sub(1,1)=="-"then if s1:sub(1,2)=="--"then local c,g2=s1:match("^%-%-([^=]+)=(.*)$")if not c then c=s1:sub(3)end if c=="recursive"then j.recursive=true elseif c=="brief"then j.brief=true elseif c=="report-identical-files"then j.same=true elseif c=="ignore-space-change"then j.wsc=true elseif c=="ignore-all-space"then j.wall=true elseif c=="ignore-case"then j.icase=true elseif c=="ignore-trailing-space"then j.trail=true elseif c=="ignore-blank-lines"then j.blank=true elseif c=="new-file"then j.newfile=true elseif c=="text"then j.text=true elseif c=="normal"then j.fmt="normal"elseif c=="ed"then j.fmt="ed"elseif c=="unified"or c=="context"then j.fmt=(c=="unified")and"unified"or"context"if g2 then local u2=tonumber(g2)if not u2 or u2<0 then return h("invalid context length '"..g2.."'")end j.ctx=u2 else j.ctx=3 end elseif c=="help"then q1()return 0 elseif c=="speed-large-files"or c=="minimal"then else return h("unrecognized option '--"..c.."'")end l[#l+1]=s1 else l[#l+1]=s1 local l2=2 while l2<=#s1 do local h2=s1:sub(l2,l2)if h2=="U"or h2=="C"then local x2,v2,r2=c2(s1:sub(l2+1),n2)if not x2 then return h(r2)end j.fmt=(h2=="U")and"unified"or"context"j.ctx=x2 n2=v2 l2=#s1+1 else if not w1(h2)then return 2 end l2=l2+1 end end end else b[#b+1]=s1 end n2=n2+1 end if#b~=2 then if#b<2 then return h("missing operand after '"..b[#b].."'")else return h("extra operand '"..b[3].."'")end return 2 end if c1>1 then return h("cannot compare standard input to itself")end local s2=table.unpack or unpack local function a1(y2)local z2={}local a3=1 while true do local b3=y2:find("\n",a3,true)if not b3 then if a3<=#y2 then z2[#z2+1]=y2:sub(a3)return z2,true end return z2,false end z2[#z2+1]=y2:sub(a3,b3-1)a3=b3+1 end end local function k(y2)return y2==" "or y2=="\t"or y2=="\r"or y2=="\v"or y2=="\f"end local function r(b3)local y2={}for a3=1,#b3 do local z2=b3:sub(a3,a3)if not k(z2)then y2[#y2+1]=z2 end end return table.concat(y2)end local function z(c3,d3)local y2,z2=1,1 local a3,b3=#c3,#d3 while y2<=a3 and z2<=b3 do local e3,f3=c3:sub(y2,y2),d3:sub(z2,z2)if k(e3)and k(f3)then while y2<=a3 and k(c3:sub(y2,y2))do y2=y2+1 end while z2<=b3 and k(d3:sub(z2,z2))do z2=z2+1 end elseif e3~=f3 then return false else y2,z2=y2+1,z2+1 end end while y2<=a3 and k(c3:sub(y2,y2))do y2=y2+1 end while z2<=b3 and k(d3:sub(z2,z2))do z2=z2+1 end return y2>a3 and z2>b3 end local function w(y2,z2)if j.icase then y2,z2=y2:lower(),z2:lower()end if j.trail then y2,z2=y2:gsub("[ \t\r\v\f]+$",""),z2:gsub("[ \t\r\v\f]+$","")end if j.wall then return r(y2)==r(z2)end if j.wsc then return z(y2,z2)end return y2==z2 end local r1=40000 local function j2(l3,e3,j3,m3,f3,k3,h3)local o3,n3=j3-e3,k3-f3 local a3={}for s3=0,o3 do local i3={}for t3=0,n3 do i3[t3]=0 end a3[s3]=i3 end for q3=1,o3 do local p3=l3[e3+q3]local z2,b3=a3[q3],a3[q3-1]for g3=1,n3 do if w(p3,m3[f3+g3])then z2[g3]=b3[g3-1]+1 elseif b3[g3]>=z2[g3-1]then z2[g3]=b3[g3]else z2[g3]=z2[g3-1]end end end local y2={}local c3,d3=o3,n3 while c3>0 or d3>0 do if d3>0 and a3[c3][d3-1]==a3[c3][d3]then y2[#y2+1]={"add",nil,f3+d3}d3=d3-1 elseif c3>0 and a3[c3-1][d3]==a3[c3][d3]then y2[#y2+1]={"del",e3+c3}c3=c3-1 else y2[#y2+1]={"keep",e3+c3,f3+d3}c3,d3=c3-1,d3-1 end end for r3=#y2,1,-1 do h3[#h3+1]=y2[r3]end end local function f1(f3,c3,d3,g3,b3,e3)local i3=e3-b3 local y2={}for k3=0,i3 do y2[k3]=0 end for j3=c3+1,d3 do local h3=f3[j3]local z2={[0]=0}for a3=1,i3 do if w(h3,g3[b3+a3])then z2[a3]=y2[a3-1]+1 elseif y2[a3]>=z2[a3-1]then z2[a3]=y2[a3]else z2[a3]=z2[a3-1]end end y2=z2 end return y2 end local function g1(f3,c3,d3,g3,e3,b3)local i3=b3-e3 local y2={}for j3=0,i3 do y2[j3]=0 end for k3=d3,c3+1,-1 do local h3=f3[k3]local z2={[0]=0}for a3=1,i3 do if w(h3,g3[b3-a3+1])then z2[a3]=y2[a3-1]+1 elseif y2[a3]>=z2[a3-1]then z2[a3]=y2[a3]else z2[a3]=z2[a3-1]end end y2=z2 end return y2 end local function v(g3,c3,e3,h3,a3,d3,y2)local m3,k3=e3-c3,d3-a3 if m3==0 then for p3=a3+1,d3 do y2[#y2+1]={"add",nil,p3}end return end if k3==0 then for o3=c3+1,e3 do y2[#y2+1]={"del",o3}end return end if m3*k3<=r1 then j2(g3,c3,e3,h3,a3,d3,y2)return end local b3=c3+math.floor(m3/2)local j3=f1(g3,c3,b3,h3,a3,d3)local i3=g1(g3,b3,e3,h3,a3,d3)local f3,z2=-1,0 for l3=0,k3 do local n3=j3[l3]+i3[k3-l3]if n3>f3 then f3,z2=n3,l3 end end v(g3,c3,b3,h3,a3,a3+z2,y2)v(g3,b3,e3,h3,a3+z2,d3,y2)end local function g(a3)local y2={}for z2,c3 in ipairs(a3)do if c3[1]~="keep"then local b3=y2[#y2]if b3 and b3.e==z2-1 then b3.e=z2 else y2[#y2+1]={s=z2,e=z2}end end end return y2 end local function m(d3,h3,i3)local b3,a3={},{}local y2,z2=0,0 for e3=1,h3-1 do local g3=d3[e3]if g3[1]~="add"then y2=y2+1 end if g3[1]~="del"then z2=z2+1 end end for f3=h3,i3 do local c3=d3[f3]if c3[1]=="del"then b3[#b3+1]=c3[2]elseif c3[1]=="add"then a3[#a3+1]=c3[3]end end return b3,a3,y2,z2 end local function j1(c3,b3)local a3=g(c3)local y2={}for i3,d3 in ipairs(a3)do local f3=y2[#y2]if f3 and(d3.s-f3.e-1)<=2*b3 then f3.e=d3.e else y2[#y2+1]={s=d3.s,e=d3.e}end end local z2={}for j3,e3 in ipairs(y2)do local h3=e3.s-math.min(b3,e3.s-1)local g3=e3.e+math.min(b3,#c3-e3.e)z2[#z2+1]={s=h3,e=g3}end return z2 end local function k1(e3,j3,k3)local a3,b3=0,0 local y2,z2=0,0 for f3=1,j3-1 do local i3=e3[f3]if i3[1]~="add"then y2=y2+1 end if i3[1]~="del"then z2=z2+1 end end for g3=j3,k3 do local h3=e3[g3]if h3[1]~="add"then a3=a3+1 end if h3[1]~="del"then b3=b3+1 end end local c3=(a3>0)and(y2+1)or y2 local d3=(b3>0)and(z2+1)or z2 return c3,a3,d3,b3 end local k2={"Sun","Mon","Tue","Wed","Thu","Fri","Sat"}local o2={"Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"}local function e1(y2)return os.date("%Y-%m-%d %H:%M:%S",y2)..".000000000 +0000"end local function x(a3)local y2=os.date("*t",a3)local z2=(y2.day<10)and(" "..y2.day)or tostring(y2.day)return string.format("%s %s %s %02d:%02d:%02d %d",k2[y2.wday]or"?",o2[y2.month]or"?",z2,y2.hour,y2.min,y2.sec,y2.year)end local t={}local function a(y2)t[#t+1]=y2 end local function u1()if#t>0 then io.write(table.concat(t))t={}end end local function e(y2,z2)if z2<=1 then return tostring(y2)end return y2..","..(y2+z2-1)end local function i1(y2,z2)if z2==1 then return tostring(y2)end if z2==0 then return y2..",0"end return y2..","..z2 end local function f(y2,a3,z2)a(y2..a3.."\n")if z2 then a("\\ No newline at end of file\n")end end local function p1(c3,g3,h3)for l3,i3 in ipairs(g(c3))do local y2,z2,a3,d3=m(c3,i3.s,i3.e)local b3 if#y2>0 and#z2>0 then b3=e(y2[1],#y2).."c"..e(z2[1],#z2)elseif#y2>0 then b3=e(y2[1],#y2).."d"..tostring(a3)else b3=tostring(a3).."a"..e(z2[1],#z2)end a(b3.."\n")for k3,e3 in ipairs(y2)do f("< ",g3.lines[e3],g3.noEol and e3==#g3.lines)end if#y2>0 and#z2>0 then a("---\n")end for j3,f3 in ipairs(z2)do f("> ",h3.lines[f3],h3.noEol and f3==#h3.lines)end end end local function n1(z2,g3,n3,e3,f3)a("--- "..e3.."\t"..e1(g3.mtime).."\n")a("+++ "..f3.."\t"..e1(n3.mtime).."\n")for q3,l3 in ipairs(j1(z2,j.ctx))do local b3,a3,d3,c3=k1(z2,l3.s,l3.e)a("@@ -"..i1(b3,a3).." +"..i1(d3,c3).." @@\n")local y2=l3.s while y2<=l3.e do local m3=z2[y2]if m3[1]=="keep"then local i3=m3[2]f(" ",g3.lines[i3],g3.noEol and i3==#g3.lines)y2=y2+1 else local h3=y2 while h3<=l3.e and z2[h3][1]~="keep"do h3=h3+1 end for p3=y2,h3-1 do if z2[