local t=os.msleep or function(e1)os.sleep(math.max((e1 or 0)/1000,0.05))end local k=os.epoch("utc")local function o(f1)local e1=os.epoch("utc")if e1-k>=50 then k=e1 t(0)end end local d=false if syscalls and syscalls["signal.install"]then syscalls["signal.install"](2,function()d=true end)end local y=args or{}local s=(type(cwd)=="string"and cwd)or"/"local function v(f1)f1=f1 or""if f1==""then return(s=="/")and"/"or s end if f1:sub(1,1)=="/"then if f1=="/"then return"/"end return f1:gsub("/+$","")end local e1=(s=="/")and""or s return(e1.."/"..f1):gsub("/+","/")end local function p(f1)local e1=io.stderr()if e1 and e1.write then e1:write(f1)end end local l,h,g,b,c,j,a=false,false,false,false,false,false,false local f={}local i=false local function q(e1)if e1=="n"then l=true elseif e1=="b"then h=true elseif e1=="s"then g=true elseif e1=="E"then b=true elseif e1=="T"then c=true elseif e1=="A"then j=true;a=true;b=true;c=true elseif e1=="v"then a=true elseif e1=="e"then a=true;b=true elseif e1=="t"then a=true;c=true elseif e1=="u"then else p("cat: invalid option -- '"..e1.."'\n");return false end return true end for c1,r in ipairs(y)do if i then f[#f+1]=r elseif r=="--"then i=true elseif r=="--number"then l=true elseif r=="--number-nonblank"then h=true elseif r=="--squeeze-blank"then g=true elseif r=="--show-ends"then b=true elseif r=="--show-tabs"then c=true elseif r=="--show-all"then j,a,b,c=true,true,true,true elseif r=="--show-nonprinting"then a=true elseif r:sub(1,1)=="-"and r~="-"then for a1=2,#r do if not q(r:sub(a1,a1))then return 1 end end else f[#f+1]=r end end if#f==0 then f={"-"}end local function m(g1)if not(a or b or c)then return g1 end local e1={}for h1=1,#g1 do local f1=g1:byte(h1)if f1==9 then e1[#e1+1]=(c and"^I")or"\t"elseif f1<32 then e1[#e1+1]="^"..string.char(f1+64)elseif f1==127 then e1[#e1+1]="^?"elseif f1>=128 then e1[#e1+1]="M-"..m(string.char(f1-128))else e1[#e1+1]=g1:sub(h1,h1)end end return table.concat(e1)end local n,x,e=0,0,0 local function w(j1)while not d do local h1=j1.readLine()if h1==nil then break end n=n+1 local e1=(h1=="")if e1 then e=e+1 else e=0 x=x+1 end if g and e1 and e>1 then else local f1=""if l then f1=string.format("%6d\t",n)elseif h then if not e1 then f1=string.format("%6d\t",x)end end local g1=m(h1)if b then g1=g1.."$"end local i1=f1..g1.."\n"io.write(i1)o(#i1)end end end local function u(h1)if h1=="-"then local g1=io.stdin()if g1 then w(g1)else return true end return true end h1=v(h1)local i1,e1=fs.open(h1,"r")if not i1 then local f1="No such file or directory"if e1 and(e1:find("permission")or e1:find("denied"))then f1="Permission denied"elseif e1 and e1:lower():find("no such file")then f1="No such file or directory"elseif e1 and e1:find("directory")then f1="Is a directory"end p("cat: "..h1..": "..f1.."\n")return false end w(i1)i1.close()return true end local z=0 for d1,b1 in ipairs(f)do if d then return 130 end if not u(b1)then z=1 end end return z