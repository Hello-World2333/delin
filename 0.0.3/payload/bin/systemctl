local l=args or{}local function c(y)local x=io.stderr()if x and x.write then x:write(y)end end local function w(x)io.write(x)end local function b(x)io.write((x or"").."\n")end if not(syscalls and syscalls["init.list"])then c("systemctl: init control interface not available (init not running?)\n")return 1 end local n={".service",".target",".timer",".mount"}local function g(x)if x:match("%.[%a]+$")then return x end for z,y in ipairs(n)do if syscalls["init.status"](x..y)then return x..y end end return x..".service"end local function o(x)if not x then return"-"end return os.date("%Y-%m-%d %H:%M:%S",math.floor(x/1000))end local function f(x,y)x=tostring(x or"")if#x>=y then return x end return x..string.rep(" ",y-#x)end local function j(x)local y=x.description or x.name if x.kind=="mount"then y="Mount "..(x.where or"?")end if x.kind=="timer"and x.unit then y=(y or"").." -> "..x.unit end return y end local function h(x,a1)local y=syscalls["init.list"]()or{}b(f("UNIT",28)..f("LOAD",8)..f("ACTIVE",10)..f("SUB",12).."DESCRIPTION")local b1=0 for c1,z in ipairs(y)do if(not x or z.kind==x)and(a1 or z.active~="inactive")then b(f(z.name,28)..f("loaded",8)..f(z.active,10)..f(z.sub,12)..j(z))b1=b1+1 end end if b1==0 then b("0 units listed.")else b("")b(b1.." units listed.")end end local function i(x)local z=syscalls["init.list"]()or{}b(f("UNIT FILE",32)..f("STATE",12).."TYPE")for b1,a1 in ipairs(z)do if not x or a1.name:find(x,1,true)then local y=a1.enabled and"enabled"or"disabled"if#(a1.wantedBy or{})==0 and not a1.enabled then y="static"end b(f(a1.name,32)..f(y,12)..a1.kind)end end end local function q(z)local d1=0 for e1,b1 in ipairs(z)do local x=syscalls["init.status"](g(b1))if not x then c("Unit "..b1.." could not be found.\n")d1=4 else local c1=(x.active=="failed")and"x"or(x.active=="inactive"and"o"or"*")b(c1.." "..x.name.." - "..j(x))local y="loaded ("..(x.path or"?").."; "..(x.enabled and"enabled"or"disabled")..")"b("     Loaded: "..y)local a1=(x.active=="active"or x.active=="activating")and(" since "..o(x.startMs))or""b("     Active: "..x.active.." ("..x.sub..")"..a1)if x.pid then b("   Main PID: "..x.pid.." ("..x.name:gsub("%..-$","")..")")end if x.exec then b("    ExecStart: "..x.exec)end if x.exitCode~=nil or x.termSig then b("     Exit: code="..tostring(x.exitCode).." signal="..tostring(x.termSig))end if x.failReason then b("     Error: "..x.failReason)end b("")if x.active=="failed"then d1=3 end end end return d1 end local function k(y,z)local c1=0 for e1,b1 in ipairs(z)do local x=g(b1)local d1,a1=syscalls["init."..y](x)if not d1 then c("Failed to "..y.." "..x..": "..tostring(a1).."\n")c1=1 end end return c1 end local function p(y)local a1=0 for c1,z in ipairs(y)do local b1=syscalls["init.status"](g(z))local x=b1 and b1.active or"unknown"b(x)if x~="active"then a1=3 end end return a1 end local function m(x)local a1=0 for b1,z in ipairs(x)do local y=g(z)if syscalls["init.isEnabled"](y)then b("enabled")else b("disabled")a1=1 end end return a1 end local d,e,s,a=nil,nil,false,{}local t=1 while t<=#l do local r=l[t]if not d and r:sub(1,1)~="-"then d=r elseif r=="--all"or r=="-a"then s=true elseif r:match("^%-%-type=")then e=r:sub(8)elseif r=="--type"and l[t+1]then e=l[t+1];t=t+1 elseif r=="--help"or r=="-h"then b("systemctl [list-units|list-unit-files|status|start|stop|restart|enable|disable|is-active|is-enabled|daemon-reload|shutdown] [UNIT...]")return 0 elseif r:sub(1,1)=="-"and r~="-"then c("systemctl: invalid option '"..r.."'\n")return 1 else a[#a+1]=r end t=t+1 end if not d then c("systemctl: missing command (see systemctl --help)\n")return 1 end if d=="list-units"then h(e,s)elseif d=="list-unit-files"then i(a[1])elseif d=="status"then if#a==0 then h(nil,true)else return q(a)end elseif d=="start"or d=="stop"or d=="restart"then if#a==0 then c("systemctl: "..d..": missing unit name\n")return 1 end return k(d,a)elseif d=="enable"or d=="disable"then if#a==0 then c("systemctl: "..d..": missing unit name\n")return 1 end return k(d,a)elseif d=="is-active"then if#a==0 then c("systemctl: is-active: missing unit name\n")return 1 end return p(a)elseif d=="is-enabled"then if#a==0 then c("systemctl: is-enabled: missing unit name\n")return 1 end return m(a)elseif d=="daemon-reload"then local v,u=syscalls["init.reload"]()if not v then c("systemctl: daemon-reload: "..tostring(u).."\n")return 1 end elseif d=="shutdown"then syscalls["init.shutdown"]()b("shutting down")else c("systemctl: unknown command '"..d.."'\n")return 1 end return 0