local h=args or{}local function d(v)local u=io.stderr()if u and u.write then u:write(v)end end local function j(u)local v=(u or""):gsub("/+$","")if v==""then return(u~="")and"/"or""end return v:match("[^/]*$")end local function e(v,u)if u and u~=""and v~=u and v:sub(-#u)==u then return v:sub(1,#v-#u)end return v end local b,k,c=false,false,nil local a,f={},false local m=1 while m<=#h do local i=h[m]if f then a[#a+1]=i elseif i=="--"then f=true elseif i=="-a"or i=="--multiple"then b=true elseif i=="-z"or i=="--zero"then k=true elseif i=="-s"or i=="--suffix"then m=m+1 if h[m]==nil then d("basename: option requires an argument -- 's'\n");return 1 end c,b=h[m],true elseif i:sub(1,9)=="--suffix="then c,b=i:sub(10),true elseif i:sub(1,1)=="-"and i~="-"then local o=2 while o<=#i do local n=i:sub(o,o)if n=="a"then b=true elseif n=="z"then k=true elseif n=="s"then if o<#i then c=i:sub(o+1)else m=m+1 c=h[m]if c==nil then d("basename: option requires an argument -- 's'\n");return 1 end end b=true o=#i else d("basename: invalid option -- '"..n.."'\n")return 1 end o=o+1 end else a[#a+1]=i end m=m+1 end if#a==0 then d("basename: missing operand\n")return 1 end local g={}if b then for t,r in ipairs(a)do g[#g+1]=e(j(r),c)end else if#a>2 then d("basename: extra operand '"..a[3].."'\n")return 1 end g[1]=e(j(a[1]),a[2]or c)end local p=k and"\0"or"\n"local l={}for s,q in ipairs(g)do l[#l+1]=q..p end io.write(table.concat(l))