local s=args or{}local f1=(type(cwd)=="string"and cwd)or"/"local function z(u1)u1=u1 or""if u1==""then return(f1=="/")and"/"or f1 end if u1:sub(1,1)=="/"then if u1=="/"then return"/"end return u1:gsub("/+$","")end local t1=(f1=="/")and""or f1 return(t1.."/"..u1):gsub("/+","/")end local function b(u1)local t1=io.stderr()if t1 and t1.write then t1:write(u1)end end local function c1(t1)if t1 and(t1:find("permission")or t1:find("denied"))then return"Permission denied"end if t1 and t1:lower():find("no such file")then return"No such file or directory"end if t1 and t1:find("directory")then return"Is a directory"end return"No such file or directory"end local h,q,n=true,true,false local d,e,c=0,0,nil local k,m=false,false local a={}local r=false local function j(t1,u1)local v1=tonumber(t1)if not v1 or v1<0 or v1~=math.floor(v1)then b("uniq: invalid number of "..u1..": '"..tostring(t1).."'\n")return nil end return v1 end local h1=1 while h1<=#s do local p=s[h1]if r then a[#a+1]=p elseif p=="--"then r=true elseif p=="-c"or p=="--count"then n=true elseif p=="-d"or p=="--repeated"then h=false elseif p=="-u"or p=="--unique"then q=false elseif p=="-i"or p=="--ignore-case"then k=true elseif p=="-z"or p=="--zero-terminated"then m=true elseif p=="--skip-fields"or p=="--skip-chars"or p=="--check-chars"then local v=p:sub(3)h1=h1+1 if not s[h1]then b("uniq: option '--"..v.."' requires an argument\n");return 1 end local o1=j(s[h1],v)if o1==nil then return 1 end if v=="skip-fields"then d=o1 elseif v=="skip-chars"then e=o1 else c=o1 end elseif p:match("^%-%-skip%-fields=")then local q1=j(p:sub(15),"fields");if q1==nil then return 1 end;d=q1 elseif p:match("^%-%-skip%-chars=")then local r1=j(p:sub(14),"chars");if r1==nil then return 1 end;e=r1 elseif p:match("^%-%-check%-chars=")then local s1=j(p:sub(15),"chars");if s1==nil then return 1 end;c=s1 elseif p:sub(1,1)=="-"and p~="-"and p:sub(1,2)~="--"then local e1=2 while e1<=#p do local t=p:sub(e1,e1)if t=="c"then n=true;e1=e1+1 elseif t=="d"then h=false;e1=e1+1 elseif t=="u"then q=false;e1=e1+1 elseif t=="i"then k=true;e1=e1+1 elseif t=="z"then m=true;e1=e1+1 elseif t=="f"or t=="s"or t=="w"then local j1=p:sub(e1+1)if j1==""then h1=h1+1 if not s[h1]then b("uniq: option requires an argument -- '"..t.."'\n");return 1 end j1=s[h1]end local n1=j(j1,t)if n1==nil then return 1 end if t=="f"then d=n1 elseif t=="s"then e=n1 else c=n1 end e1=#p+1 else b("uniq: invalid option -- '"..t.."'\n")return 1 end end elseif p:sub(1,2)=="--"then b("uniq: unrecognized option '"..p.."'\n")return 1 else a[#a+1]=p end h1=h1+1 end if#a>2 then b("uniq: extra operand '"..a[3].."'\n")return 1 end local function b1(t1)return function()return t1.readLine()end end local function d1(v1)if not v1.readAll then b("uniq: -z 需要 readAll 句柄(宿主测试台的 stdin 不支持)\n")return nil end local t1=v1.readAll()or""local u1,w1=1,#t1 return function()if u1>w1 then return nil end local x1=t1:find("\0",u1,true)if not x1 then local y1=t1:sub(u1);u1=w1+1;return y1 end local z1=t1:sub(u1,x1-1)u1=x1+1 return z1 end end local function g1(u1)if d>0 then local t1=1 for x1=1,d do local v1=u1:find("[^ \t]",t1)if not v1 then t1=#u1+1;break end local w1=u1:find("[ \t]",v1)t1=w1 or(#u1+1)end u1=u1:sub(t1)end if e>0 then u1=u1:sub(e+1)end if c~=nil then u1=u1:sub(1,c)end if k then u1=u1:lower()end return u1 end local i,u=a[1],a[2]local x if i==nil or i=="-"then x=io.stdin()if not x then b("uniq: 无法读取 stdin\n");return 1 end else local k1 x,k1=fs.open(z(i),"r")if not x then b("uniq: "..i..": "..c1(k1).."\n")return 1 end end local f if m then f=d1(x)if not f then return 1 end else f=b1(x)end local y,w=io.stdout(),false if u then local l1 y,l1=fs.open(z(u),"w")if not y then b("uniq: "..u..": "..c1(l1).."\n")return 1 end w=true end local m1=m and"\0"or"\n"local g,l,o=nil,nil,0 local function i1(w1,u1,v1)if w1==nil then return end local t1=v1>1 if t1 and not q then return end if(not t1)and not h then return end if n then y:write(string.format("%7d ",v1))end y:write(u1..m1)end while true do local a1=f()if a1==nil then break end local p1=g1(a1)if g==nil then g,l,o=p1,a1,1 elseif p1==g then o=o+1 else i1(g,l,o)g,l,o=p1,a1,1 end end i1(g,l,o)if w then y:close()end if i~=nil and i~="-"then x:close()end