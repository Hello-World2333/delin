local z=args or{}local y=(type(cwd)=="string"and cwd)or"/"local function q(j1)j1=j1 or""if j1==""then return(y=="/")and"/"or y end if j1:sub(1,1)=="/"then if j1=="/"then return"/"end return j1:gsub("/+$","")end local i1=(y=="/")and""or y return(i1.."/"..j1):gsub("/+","/")end local function c(j1)local i1=io.stderr()if i1 and i1.write then i1:write(j1)end end local b,d,s,f,m,a=false,false,false,false,false,false local e={}local h=false local function w(i1)if i1=="r"or i1=="R"then b=true elseif i1=="a"then b=true;a=true elseif i1=="i"then d=true elseif i1=="f"then s=true elseif i1=="n"then f=true elseif i1=="v"then m=true elseif i1=="p"then a=true elseif i1=="d"then a=true else c("cp: invalid option -- '"..i1.."'\n");return false end return true end for h1,x in ipairs(z)do if h then e[#e+1]=x elseif x=="--"then h=true elseif x=="--recursive"then b=true elseif x=="--interactive"then d=true elseif x=="--force"then s=true elseif x=="--no-clobber"then f=true elseif x=="--verbose"then m=true elseif x=="--preserve"then a=true elseif x=="--archive"then b=true;a=true elseif x:sub(1,1)=="-"and x~="-"then for e1=2,#x do if not w(x:sub(e1,e1))then return end end else e[#e+1]=x end end if#e<2 then c("cp: missing destination file operand\n")return 1 end local l=e[#e]local n=l:sub(-1)=="/"local u=q(l)local g={}for f1=1,#e-1 do g[#g+1]=q(e[f1])end local function t(i1)i1=(type(i1)=="string"and i1)or""i1=i1:gsub("/+$","")return(i1:match("([^/]+)$"))or i1 end local function v(i1,j1)return(i1.."/"..j1):gsub("/+","/")end local function i(j1)if f then return false end if not fs.exists(j1)then return true end if s then return true end if d then io.write("cp: overwrite '"..j1.."'? ")io.flush()local k1=io.stdin()local i1=k1 and k1.readLine and k1:readLine()or nil if i1 and i1:match("^[yY]")then return true end return false end return true end local function o(j1,i1)if j1==i1 then return nil,"`"..j1.."' and `"..i1.."' are the same file"end local l1,n1=fs.open(j1,"r")if not l1 then return nil,(n1 or("cannot open "..j1))end if not i(i1)then l1.close();return true end local m1,o1=fs.open(i1,"w")if not m1 then l1.close();return nil,(o1 or("cannot write "..i1))end while true do local k1=l1.read(4096)if not k1 or k1==""then break end m1.write(k1)end l1.close()m1.close()if a then local p1=attrsOrNil(j1)if p1 and p1.mode and fs.chmod then pcall(fs.chmod,i1,p1.mode)end end if m then io.write("'"..j1.."' -> '"..i1.."'\n")end return true end local function r(i1)if fs.attributes then return fs.attributes(i1)end return nil end local function p(j1,i1)if not fs.isDir(j1)then return o(j1,i1)end if not fs.exists(i1)then local q1,l1=pcall(fs.makeDir,i1)if not q1 then return nil,"mkdir '"..i1.."' failed: "..tostring(l1)end end local k1=fs.list(j1)or{}for r1,n1 in ipairs(k1)do if n1~="."and n1~=".."then local p1,m1=p(v(j1,n1),v(i1,n1))if not p1 then return nil,m1 end end end if a then local o1=r(j1)if o1 and o1.mode and fs.chmod then pcall(fs.chmod,i1,o1.mode)end end return true end for g1,j in ipairs(g)do if not fs.exists(j)then c("cp: "..j..": No such file or directory\n")return 1 end local k if fs.isDir(u)or n then k=v(u,t(j))else if#g>1 then c("cp: target '"..l.."' is not a directory\n")return 1 end k=u end if fs.isDir(j)then if not b then c("cp: "..j..": is a directory (use -r)\n")return 1 end local c1,b1=p(j,k)if not c1 then c("cp: "..j..": "..tostring(b1).."\n");return end else local d1,a1=o(j,k)if not d1 then c("cp: "..j..": "..tostring(a1).."\n");return end end end