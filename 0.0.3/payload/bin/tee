local s=os.msleep or function(l1)os.sleep(math.max((l1 or 0)/1000,0.05))end local k=os.epoch("utc")local function n(m1)local l1=os.epoch("utc")if l1-k>=50 then k=l1 s(0)end end local z=args or{}local q=(type(cwd)=="string"and cwd)or"/"local function w(m1)m1=m1 or""if m1==""then return(q=="/")and"/"or q end if m1:sub(1,1)=="/"then if m1=="/"then return"/"end return m1:gsub("/+$","")end local l1=(q=="/")and""or q return(l1.."/"..m1):gsub("/+","/")end local function c(m1)local l1=io.stderr()if l1 and l1.write then l1:write(m1)end end local function v(m1,l1)local o1,p1,n1=pcall(fs.open,m1,l1)if not o1 then return nil,tostring(p1)end return p1,n1 end local function u(m1)local n1=tostring(m1 or"cannot open")n1=n1:gsub("^.-:%d+: ","")local l1=n1:match(": ([^:]+)$")if l1 and not l1:find("/",1,true)then return l1 end return n1 end local d,b=false,false local f,g={},false for k1,x in ipairs(z)do if g then f[#f+1]=x elseif x=="--"then g=true elseif x=="-a"or x=="--append"then d=true elseif x=="-i"or x=="--ignore-interrupts"then b=true elseif x:sub(1,1)=="-"and x~="-"then for f1=2,#x do local a1=x:sub(f1,f1)if a1=="a"then d=true elseif a1=="i"then b=true else c("tee: invalid option -- '"..a1.."'\n");return 1 end end else f[#f+1]=x end end if b then local l=syscalls and syscalls["signal.install"]if not l then c("tee: -i: signal.install syscall not available\n")return 1 end l(2,function()end)end local h=0 local r=io.stdout()local j=io.stdin()if not j then c("tee: standard input: not available\n")return 1 end local o=d and"a"or"w"local a={}for j1,m in ipairs(f)do if m=="-"then else local h1=w(m)local e1,c1=v(h1,o)if not e1 then c("tee: "..m..": "..u(c1).."\n")h=1 else a[#a+1]={name=m,h=e1}end end end local function p(l1)local n1=1 while n1<=#a do local p1=a[n1]local o1,m1=p1.h.write(l1)if not o1 then c("tee: "..p1.name..": "..tostring(m1 or"write failed").."\n")h=1 p1.h.close()table.remove(a,n1)else n1=n1+1 end end end local i=(r==nil)local t=j.readAll~=nil while true do local e if t then e=j.read(4096)else local y=j.readLine()if y~=nil then e=y.."\n"end end if e==nil then break end if not i then local d1,b1=r.write(e)if not d1 then c("tee: standard output: "..tostring(b1 or"write failed").."\n")h=1 i=true end end p(e)n(#e)end for i1,g1 in ipairs(a)do g1.h.flush()g1.h.close()end if r then r.flush()end return h