local x=args or{}local u=(type(cwd)=="string"and cwd)or"/"local function n(e1)e1=e1 or""if e1==""then return(u=="/")and"/"or u end if e1:sub(1,1)=="/"then if e1=="/"then return"/"end return e1:gsub("/+$","")end local d1=(u=="/")and""or u return(d1.."/"..e1):gsub("/+","/")end local function c(e1)local d1=io.stderr()if d1 and d1.write then d1:write(e1)end end local b,p,d,j=false,false,false,false local a={}local f=false local function t(d1)if d1=="i"then b=true elseif d1=="f"then p=true elseif d1=="n"then d=true elseif d1=="v"then j=true else c("mv: invalid option -- '"..d1.."'\n");return false end return true end for c1,v in ipairs(x)do if f then a[#a+1]=v elseif v=="--"then f=true elseif v=="--interactive"then b=true elseif v=="--force"then p=true elseif v=="--no-clobber"then d=true elseif v=="--verbose"then j=true elseif v:sub(1,1)=="-"and v~="-"then for b1=2,#v do if not t(v:sub(b1,b1))then return end end else a[#a+1]=v end end if#a<2 then c("mv: missing destination file operand\n")return 1 end local e=a[#a]local k=e:sub(-1)=="/"local s=n(e)local function q(d1,e1)return(d1.."/"..e1):gsub("/+","/")end local function r(d1)d1=(type(d1)=="string"and d1)or""d1=d1:gsub("/+$","")return(d1:match("([^/]+)$"))or d1 end local function h(e1)if d then return false end if not fs.exists(e1)then return true end if p then return true end if b then io.write("mv: overwrite '"..e1.."'? ")io.flush()local f1=io.stdin()local d1=f1 and f1.readLine and f1:readLine()or nil if d1 and d1:match("^[yY]")then return true end return false end return true end local function l(h1,g1)local f1,i1=fs.open(h1,"r")if not f1 then return nil,(i1 or("cannot open "..h1))end local e1,j1=fs.open(g1,"w")if not e1 then f1.close();return nil,(j1 or("cannot write "..g1))end while true do local d1=f1.read(4096)if not d1 or d1==""then break end e1.write(d1)end f1.close()e1.close()return true end local function m(e1,d1)if not fs.isDir(e1)then return l(e1,d1)end if not fs.exists(d1)then local k1,g1=pcall(fs.makeDir,d1)if not k1 then return nil,"mkdir '"..d1.."' failed: "..tostring(g1)end end local f1=fs.list(e1)or{}for l1,i1 in ipairs(f1)do if i1~="."and i1~=".."then local j1,h1=m(q(e1,i1),q(d1,i1))if not j1 then return nil,h1 end end end return true end local function g(e1)if fs.isDir(e1)then local d1=fs.list(e1)or{}for g1,f1 in ipairs(d1)do g(q(e1,f1))end fs.delete(e1)else fs.delete(e1)end end local function w(e1,d1)if not h(d1)then return true,"skip"end local i1,g1 if fs.isDir(e1)then i1,g1=m(e1,d1)else i1,g1=l(e1,d1)end if not i1 then return nil,g1 end local h1,f1=pcall(g,e1)if not h1 then return nil,f1 end if j then io.write("'"..e1.."' -> '"..d1.."'\n")end return true end for y=1,#a-1 do local o=n(a[y])if not fs.exists(o)then c("mv: "..o..": No such file or directory\n")return 1 end local i if fs.isDir(s)or k then i=q(s,r(o))else if#a-1>1 then c("mv: target '"..e.."' is not a directory\n")return 1 end i=s end if o==i then c("mv: "..a[y].." and "..e.." are the same file\n")return 1 end local a1,z=w(o,i)if not a1 then c("mv: "..o..": "..tostring(z).."\n")return 1 end end