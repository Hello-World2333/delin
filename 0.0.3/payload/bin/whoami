local b=args or{}local function a(e)local d=io.stderr()if d and d.write then d:write(e)end end if b[1]then a("whoami: extra operand '"..tostring(b[1]).."'\n")a("Try 'whoami --help' for more information.\n")return 1 end local c=syscalls and syscalls["user.byUid"]and syscalls["user.byUid"](uid)if not c then a("whoami: cannot find name for user ID "..tostring(uid).."\n")return 1 end io.write(c.name.."\n")return 0