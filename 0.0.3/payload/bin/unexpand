local g=args or{}local n=(type(cwd)=="string"and cwd)or"/"local function o(a1)a1=a1 or""if a1==""then return(n=="/")and"/"or n end if a1:sub(1,1)=="/"then if a1=="/"then return"/"end return a1:gsub("/+$","")end local z=(n=="/")and""or n return(z.."/"..a1):gsub("/+","/")end local function a(a1)local z=io.stderr()if z and z.write then z:write(a1)end end local function q(z)if z and(z:find("permission")or z:find("denied"))then return"Permission denied"end if z and z:lower():find("no such file")then return"No such file or directory"end if z and z:find("directory")then return"Is a directory"end return"No such file or directory"end local c=false local j,h=nil,8 local d={}local f=false local function e(a1)local z={}for c1 in a1:gmatch("[^,%s]+")do local d1=tonumber(c1)if not d1 or d1<1 or d1~=math.floor(d1)then a("unexpand: tab size contains invalid character(s): '"..c1.."'\n")return false end z[#z+1]=d1 end if#z==0 then a("unexpand: tab size contains invalid character(s): '"..a1.."'\n")return false end if#z==1 then h,j=z[1],nil return true end for b1=2,#z do if z[b1]<=z[b1-1]then a("unexpand: tab sizes must be ascending\n")return false end end j=z return true end local p=1 while p<=#g do local m=g[p]if f then d[#d+1]=m elseif m=="--"then f=true elseif m=="-a"or m=="--all"then c=true elseif m:match("^%-%-tabs=")then if not e(m:sub(8))then return 1 end elseif m=="-t"or m=="--tabs"then p=p+1 if not g[p]then a("unexpand: option requires an argument -- 't'\n");return 1 end if not e(g[p])then return 1 end elseif m:match("^%-%d+$")then if not e(m:sub(2))then return 1 end elseif m:sub(1,1)=="-"and m~="-"and m:sub(1,2)~="--"then for x=2,#m do local u=m:sub(x,x)if u=="a"then c=true elseif u=="t"then local s=m:sub(x+1)if s==""then p=p+1 if not g[p]then a("unexpand: option requires an argument -- 't'\n");return 1 end s=g[p]end if not e(s)then return 1 end break else a("unexpand: invalid option -- '"..u.."'\n")return 1 end end elseif m:sub(1,2)=="--"then a("unexpand: unrecognized option '"..m.."'\n")return 1 else d[#d+1]=m end p=p+1 end if#d==0 then d={"-"}end local function k(z)if j then for b1,a1 in ipairs(j)do if a1>z then return a1 end end return nil end return z+(h-z%h)end local b={}local function i()if#b>0 then io.write(table.concat(b));b={}end end local function l(e1)local z,d1=0,true local b1=1 while b1<=#e1 do local h1=e1:sub(b1,b1)local c1=(h1==" "or h1=="\t")if c1 and(c or d1)then local g1=b1 local a1=z while g1<=#e1 do local i1=e1:sub(g1,g1)if i1==" "then a1=a1+1 elseif i1=="\t"then a1=k(a1)or(a1+1)else break end g1=g1+1 end while true do local f1=k(z)if not f1 or f1>a1 or(f1-z)<2 then break end b[#b+1]="\t"z=f1 end if a1>z then b[#b+1]=string.rep(" ",a1-z)z=a1 end if#b>=512 then i()end b1=g1 else if h1=="\b"then if z>0 then z=z-1 end elseif h1=="\r"then z=0 elseif c1 then z=z+1 else z=z+1 d1=false end b[#b+1]=h1 b1=b1+1 if#b>=512 then i()end end end b[#b+1]="\n"end for y,w in ipairs(d)do local v if w=="-"then v=io.stdin()if not v then a("unexpand: 无法读取 stdin\n");return 1 end else local t v,t=fs.open(o(w),"r")if not v then a("unexpand: "..w..": "..q(t).."\n")return 1 end end while true do local r=v.readLine()if r==nil then break end l(r)if#b>=512 then i()end end if w~="-"then v:close()end end i()