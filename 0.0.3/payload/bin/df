local k1=args or{}local b1=(type(cwd)=="string"and cwd)or"/"local function e1(e2)e2=e2 or""if e2==""then return(b1=="/")and"/"or b1 end if e2:sub(1,1)=="/"then if e2=="/"then return"/"end return e2:gsub("/+$","")end local d2=(b1=="/")and""or b1 return(d2.."/"..e2):gsub("/+","/")end local function h(e2)local d2=io.stderr()if d2 and d2.write then d2:write(e2)end end local function o1(d2)if d2 and(d2:find("permission")or d2:find("denied"))then return"Permission denied"end if d2 and(d2:find("[Nn]o such")or d2:find("not found"))then return"No such file or directory"end if d2 and d2:lower():find("no such file")then return"No such file or directory"end if d2 and d2:find("directory")then return"Is a directory"end return"No such file or directory"end local f,c,n,e,b=512,false,false,false,false local j=false local d,k={},false local function z(d2)if d2=="k"then f,c=1024,false elseif d2=="h"then c=true elseif d2=="P"then b=true elseif d2=="a"then n=true elseif d2=="T"then e=true elseif d2=="i"then j=true else h("df: invalid option -- '"..d2.."'\n");return false end return true end for z1,d1 in ipairs(k1)do if k then d[#d+1]=d1 elseif d1=="--"then k=true elseif d1=="--kilobytes"then f,c=1024,false elseif d1=="--human-readable"then c=true elseif d1=="--portability"then b=true elseif d1=="--all"then n=true elseif d1=="--print-type"then e=true elseif d1=="--inodes"then j=true elseif d1:sub(1,1)=="-"and d1~="-"then for u1=2,#d1 do if not z(d1:sub(u1,u1))then return 1 end end else d[#d+1]=d1 end end if j then h("df: -i: inode statistics are not available\n")return 1 end local r=syscalls and syscalls["fs.mounts"]if not r then h("df: fs.mounts syscall not available\n")return 1 end local v=r()or{}local function i1(i2)if i2<1024 then return string.format("%d",i2)end local e2={"K","M","G","T","P","E"}local d2,h2=1,i2/1024 while h2>=1024 and d2<#e2 do h2=h2/1024;d2=d2+1 end if h2<10 then local f2=math.ceil(h2*10)/10 if f2<10 then return string.format("%.1f",f2)..e2[d2]end end local g2=math.ceil(h2)if g2>=1024 and d2<#e2 then g2,d2=1,d2+1 end return string.format("%d",g2)..e2[d2]end local function x(f2)local e2=fs.getCapacity(f2.root)local g2=fs.getFreeSpace(f2.root)local d2=e2-g2 if d2<0 then d2=0 end return{dev=f2.device or((f2.root=="/")and"rootfs"or"-"),fstype=f2.fstype or"-",root=f2.root,cap=e2,used=d2,free=g2,pct=(e2>0)and math.ceil(d2*100/e2)or nil,}end local m,m1={},0 if#d==0 then for b2,l1 in ipairs(v)do if not fs.exists(l1.root)then h("df: "..l1.root..": No such file or directory\n")m1=1 else local j1=x(l1)if n or j1.cap>0 then m[#m+1]=j1 end end end else local h1={}for c2,g1 in ipairs(d)do local y=e1(g1)if not fs.exists(y)then h("df: "..g1..": No such file or directory\n")return 1 end local i for a2,p1 in ipairs(v)do local s=p1.root if s=="/"or y==s or y:sub(1,#s+1)==s.."/"then if not i or#s>#i.root then i=p1 end end end if not i then h("df: "..g1..": not a mounted filesystem\n")return 1 end if not h1[i.root]then h1[i.root]=true m[#m+1]=x(i)end end end local function l(d2)if c then return i1(d2)end return string.format("%d",math.ceil(d2/f))end local a={}a[#a+1]={head="Filesystem",right=false,min=b and 14 or 0,vals={}}if e then a[#a+1]={head="Type",right=false,min=0,vals={}}end local a1=c and"Size"or(f==1024 and"1024-blocks"or"512-blocks")a[#a+1]={head=a1,right=true,min=b and 10 or 0,vals={}}a[#a+1]={head="Used",right=true,min=b and 10 or 0,vals={}}a[#a+1]={head=c and"Avail"or"Available",right=true,min=b and 10 or 0,vals={}}a[#a+1]={head="Capacity",right=true,min=b and 5 or 0,vals={}}a[#a+1]={head="Mounted on",right=false,min=0,vals={}}for x1,p in ipairs(m)do local o=1 a[o].vals[#a[o].vals+1]=p.dev;o=o+1 if e then a[o].vals[#a[o].vals+1]=p.fstype;o=o+1 end a[o].vals[#a[o].vals+1]=l(p.cap);o=o+1 a[o].vals[#a[o].vals+1]=l(p.used);o=o+1 a[o].vals[#a[o].vals+1]=l(p.free);o=o+1 a[o].vals[#a[o].vals+1]=p.pct and(p.pct.."%")or"-";o=o+1 a[o].vals[#a[o].vals+1]=p.root end local u={}for s1,f1 in ipairs(a)do local t1=math.max(#f1.head,f1.min)for y1,v1 in ipairs(f1.vals)do if#v1>t1 then t1=#v1 end end u[s1]=t1 end local q1=b and" "or"  "local function w(d2)local e2={}for f2,g2 in ipairs(a)do e2[f2]=g2.right and string.format("%"..u[f2].."s",d2[f2])or string.format("%-"..u[f2].."s",d2[f2])end return(table.concat(e2,q1):gsub("%s+$",""))end local c1={}for r1,n1 in ipairs(a)do c1[r1]=n1.head end io.write(w(c1).."\n")for w1,q in ipairs(m)do local g={}local t=1 g[t]=q.dev;t=t+1 if e then g[t]=q.fstype;t=t+1 end g[t]=l(q.cap);t=t+1 g[t]=l(q.used);t=t+1 g[t]=l(q.free);t=t+1 g[t]=q.pct and(q.pct.."%")or"-";t=t+1 g[t]=q.root io.write(w(g).."\n")end if m1~=0 then return m1 end