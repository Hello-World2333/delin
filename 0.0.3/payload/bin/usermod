local j=args or{}local function d(u)local t=io.stderr()if t and t.write then t:write(u)end end local function f(t)if t then d("usermod: "..t.."\n")end d("usage: usermod [-u UID] [-g GROUP] [-G GROUPLIST [-a]] [-d HOME] [-s SHELL] [-c COMMENT] [-l NEWNAME] [-L|-U] name\n")return 2 end if not(syscalls and syscalls["user.modUser"])then d("usermod: user syscalls not available\n")return 1 end local a,c,i={},nil,false local o=1 while o<=#j do local m=j[o]if i then if c then return f("extra operand '"..m.."'")end c=m elseif m=="--"then i=true elseif m:sub(1,1)=="-"and m~="-"then local n=2 while n<=#m do local g=m:sub(n,n)if g=="a"then a.a=true;n=n+1 elseif g=="L"then a.lock=true;n=n+1 elseif g=="U"then a.unlock=true;n=n+1 elseif g=="m"then return f("moving the home directory (-m) is not supported")elseif g=="u"or g=="g"or g=="G"or g=="d"or g=="s"or g=="c"or g=="l"then local e=m:sub(n+1)if e==""then o=o+1 e=j[o]end if e==nil then return f("option requires an argument -- '"..g.."'")end if g=="u"then if not e:match("^%d+$")then return f("invalid user ID '"..e.."'")end a.u=tonumber(e)elseif g=="g"then a.g=e elseif g=="G"then a.G=e elseif g=="d"then a.d=e elseif g=="s"then a.s=e elseif g=="c"then a.c=e else a.l=e end n=#m+1 else return f("invalid option -- '"..g.."'")end end else if c then return f("extra operand '"..m.."'")end c=m end o=o+1 end if not c then return f("no user name given")end if not syscalls["user.get"](c)then d("usermod: user '"..c.."' does not exist\n")return 1 end if a.a and not a.G then return f("-a may only be used together with -G")end if a.lock and a.unlock then return f("the options -L and -U are mutually exclusive")end if not(a.u or a.g or a.G or a.d or a.s or a.c or a.l or a.lock or a.unlock)then d("usermod: no changes\n")return 0 end local b={}if a.u then b.uid=a.u end if a.d then b.home=a.d end if a.s then b.shell=a.s end if a.c then b.full=a.c end if a.l then b.name=a.l end if a.lock then b.locked=true end if a.unlock then b.locked=false end if a.g then if a.g:match("^%d+$")then b.gid=tonumber(a.g)else local r=syscalls["user.groupByName"](a.g)if not r then d("usermod: group '"..a.g.."' does not exist\n");return 1 end b.gid=r.gid end end if a.G then local h={}for k in(a.G..","):gmatch("([^,]*),")do if k~=""then h[#h+1]=k end end for s,l in ipairs(h)do if not syscalls["user.groupByName"](l)then d("usermod: group '"..l.."' does not exist\n")return 1 end end if a.a then b.groupsAdd=h else b.groups=h end end local q,p=syscalls["user.modUser"](c,b)if not q then d("usermod: "..tostring(p).."\n")return 1 end return 0