1=d.bytes[d.fill]for u1=1,c1 do table.insert(d.bytes,d.fill,q1)end d.fill=nil end local h={}for y1,r1 in ipairs(m.bytes)do h[r1]=true end local o={}do local i1=0 for x1,m1 in ipairs(m.bytes)do i1=i1+1 if o[m1]==nil then o[m1]=i1 end end if i then local v={}for k1=0,255 do if not h[k1]then v[#v+1]=k1 end end h={}o={}local b1=0 for v1,l1 in ipairs(v)do b1=b1+1 o[l1]=b1 h[l1]=true end m.bytes=v end end local n=nil if f then n={}local g1=(d and d.bytes)or m.bytes for w1,p1 in ipairs(g1)do n[p1]=true end end local function z(a2,z1)if not d then return z1 end local b2=#d.bytes if b2==0 then return z1 end if a2<=b2 then return d.bytes[a2]end if k then return z1 end return d.bytes[b2]end local function w(b2)local z1=true local function a2()if z1 then local c2=b2.read(4096)if type(c2)=="string"then if c2==""then return nil end return c2 end z1=false end local d2=b2.readLine()if d2==nil then return nil end return d2.."\n"end return a2 end local h1 if#a>=1 then h1=io.stdin()if not h1 then c("tr: 无法读取 stdin\n");return 1 end end local j1=w(h1)local p={}local s=nil while true do local u=j1()if u==nil then break end for s1=1,#u do local d1=u:byte(s1)local x if l then if h[d1]then x=nil else x=d1 end else local f1=o[d1]x=f1 and z(f1,d1)or d1 end if x~=nil then if n and n[x]and s==x then else p[#p+1]=string.char(x)s=x end end end if#p>=512 then io.write(table.concat(p));p={}end end if#p>0 then io.write(table.concat(p))end