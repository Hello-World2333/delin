local a1=args or{}local n1=(type(cwd)=="string"and cwd)or"/"local function c(a2)local z1=io.stderr()if z1 and z1.write then z1:write(a2)end end local function e1(z1)if z1 and(z1:find("permission")or z1:find("denied"))then return"Permission denied"end if z1 and z1:lower():find("no such file")then return"No such file or directory"end if z1 and z1:find("directory")then return"Is a directory"end return"No such file or directory"end local i,l,f,k=false,false,false,false local a={}local j=false for t1,t in ipairs(a1)do if j then a[#a+1]=t elseif t=="--"then j=true elseif t=="-c"or t=="-C"or t=="--complement"then i=true elseif t=="-d"or t=="--delete"then l=true elseif t=="-s"or t=="--squeeze-repeats"then f=true elseif t=="-t"or t=="--truncate-set1"then k=true elseif t:sub(1,1)=="-"and t~="-"and t:sub(1,2)~="--"then for o1=2,#t do local y=t:sub(o1,o1)if y=="c"or y=="C"then i=true elseif y=="d"then l=true elseif y=="s"then f=true elseif y=="t"then k=true else c("tr: invalid option -- '"..y.."'\n");return 1 end end elseif t:sub(1,2)=="--"then c("tr: unrecognized option '"..t.."'\n")return 1 else j=true a[#a+1]=t end end if#a<1 then c("tr: missing operand\n")return 1 end if#a>2 then c("tr: extra operand '"..a[3].."'\n")return 1 end if#a==1 and not(l or f)then c("tr: missing operand\n")return 1 end local b={}do local function e(z1)local a2={}for d2,b2 in ipairs(z1)do for c2=b2[1],b2[2]do a2[#a2+1]=c2 end end return a2 end b.alpha=e{{65,90},{97,122}}b.digit=e{{48,57}}b.alnum=e{{48,57},{65,90},{97,122}}b.space={32,9,10,11,12,13}b.upper=e{{65,90}}b.lower=e{{97,122}}b.punct=e{{33,47},{58,64},{91,96},{123,126}}b.cntrl=e{{0,31},{127,127}}b.print=e{{32,126}}b.graph=e{{33,126}}b.xdigit=e{{48,57},{65,70},{97,102}}b.blank={32,9}end local function r(e2,z1)local a2=e2:sub(z1+1,z1+1)if a2==""then return nil,nil end if a2=="\\"then return 92,z1+2 end if a2=="a"then return 7,z1+2 end if a2=="b"then return 8,z1+2 end if a2=="f"then return 12,z1+2 end if a2=="n"then return 10,z1+2 end if a2=="r