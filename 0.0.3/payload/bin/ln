local w=args or{}local u=(type(cwd)=="string"and cwd)or"/"local function c(i1)i1=i1 or""if i1==""then return(u=="/")and"/"or u end if i1:sub(1,1)=="/"then if i1=="/"then return"/"end return i1:gsub("/+$","")end local h1=(u=="/")and""or u return(h1.."/"..i1):gsub("/+","/")end local function b(i1)local h1=io.stderr()if h1 and h1.write then h1:write(i1)end end local function j(i1)local h1=fs.lstat(i1)if not h1 then return nil end if h1.kind=="symlink"then return h1 end if fs.exists(i1)then return h1 end return nil end local function n(h1)h1=(type(h1)=="string"and h1)or""h1=h1:gsub("/+$","")return(h1:match("([^/]+)$"))or h1 end local i,o,k,e,l=false,false,false,false,false local a={}local q=false local function t(h1)if h1=="s"then i=true elseif h1=="f"then o=true elseif h1=="n"then k=true elseif h1=="T"then e=true elseif h1=="v"then l=true else b("ln: invalid option -- '"..h1.."'\n");return false end return true end for f1,v in ipairs(w)do if q then a[#a+1]=v elseif v=="--"then q=true elseif v=="--symbolic"then i=true elseif v=="--force"then o=true elseif v=="--no-dereference"then k=true elseif v=="--no-target-directory"then e=true elseif v=="--verbose"then l=true elseif v:sub(1,1)=="-"and v~="-"then for b1=2,#v do if not t(v:sub(b1,b1))then return 1 end end else a[#a+1]=v end end if#a==0 then b("ln: missing file operand\n")return 1 end local m={}local function g(h1,i1)h1=h1:gsub("/+$","")if h1==""then return"/"..i1 end return h1.."/"..i1 end local f=false local p=nil if#a==1 then f=true p="."m[1]={target=a[1],link=c(n(a[1])),display=g(".",n(a[1]))}else local h=a[#a]if not e then if k then local z=j(c(h))f=(z~=nil)and(z.isDir==true)and(z.kind~="symlink")else f=fs.isDir(c(h))and true or false end end if f then p=h for d1=1,#a-1 do local c1=a[d1]local a1=n(c1)m[#m+1]={target=c1,link=c(g(h,a1)),display=g(h,a1)}end else if#a>2 then local e1=c(h)if fs.exists(e1)then b("ln: target '"..h.."' is not a directory\n")else b("ln: target '"..h.."': No such file or directory\n")end return 1 end m[1]={target=a[1],link=c(h),display=h}end end local function d(i1,h1)if i then return"ln: failed to create symbolic link '"..h1.."': "end return"ln: failed to create hard link '"..h1.."' => '"..i1.."': "end local function s(j1,k1)local h1,i1=j(j1),j(k1)if h1 and i1 and h1.ino and i1.ino then return h1.ino==i1.ino end return j1==k1 end local function r(n1)local h1,i1=n1.target,n1.display local j1,l1=c(h1),n1.link if not i then if not(fs.exists(j1)or j(j1))then b("ln: failed to access '"..h1.."': No such file or directory\n")return false end local s1=j(j1)if s1 and s1.isDir then b("ln: "..h1..": hard link not allowed for directory\n")return false end end local p1=j(l1)if p1 then if not i and s(j1,l1)then b("ln: '"..h1.."' and '"..i1.."' are the same file\n")return false end if not o then b(d(h1,i1).."File exists\n")return false end if p1.isDir and p1.kind~="symlink"then b("ln: cannot overwrite directory '"..i1.."' with non-directory\n")return false end local r1,o1=fs.delete(l1)if not r1 then b("ln: cannot remove '"..i1.."': "..tostring(o1).."\n")return false end end local k1=l1:match("^(.*)/[^/]*$")or"/"if k1==""then k1="/"end local t1=j(k1)if not t1 then b(d(h1,i1).."No such file or directory\n")return false end if not fs.isDir(k1)then b(d(h1,i1).."Not a directory\n")return false end local q1,m1 if i then q1,m1=fs.symlink(h1,l1)else q1,m1=fs.link(j1,l1)end if not q1 then b(d(h1,i1)..tostring(m1).."\n")return false end if l then io.write("'"..i1.."' -> '"..h1.."'\n")end return true end local y=0 for g1,x in ipairs(m)do if not r(x)then y=1 end end return y