local x=args or{}local c1=(type(cwd)=="string"and cwd)or"/"local function n(v1)v1=v1 or""if v1==""then return(c1=="/")and"/"or c1 end if v1:sub(1,1)=="/"then if v1=="/"then return"/"end return v1:gsub("/+$","")end local u1=(c1=="/")and""or c1 return(u1.."/"..v1):gsub("/+","/")end local function a(v1)local u1=io.stderr()if u1 and u1.write then u1:write(v1)end end local function z(u1)if u1 and(u1:find("permission")or u1:find("denied"))then return"Permission denied"end if u1 and(u1:find("[Nn]o such")or u1:find("not found"))then return"No such file or directory"end if u1 and u1:lower():find("no such file")then return"No such file or directory"end if u1 and u1:find("directory")then return"Is a directory"end return"No such file or directory"end local w="Usage: uudecode [-o OUTFILE] [FILE]\n"local i,b=nil,{}local m=false local k1=1 while k1<=#x do local j1=x[k1]if m then b[#b+1]=j1 elseif j1=="--"then m=true elseif j1=="-o"then k1=k1+1 if not x[k1]then a("uudecode: option requires an argument -- 'o'\n"..w)return 1 end i=x[k1]elseif j1:sub(1,2)=="-o"then i=j1:sub(3)elseif j1:sub(1,1)=="-"and j1~="-"then a("uudecode: invalid option -- '"..j1:sub(2,2).."'\n"..w)return 1 else b[#b+1]=j1 end k1=k1+1 end if#b>1 then a("uudecode: extra operand '"..b[2].."'\n"..w)return 1 end local f="<stdin>"local r if b[1]and b[1]~="-"then local r1=n(b[1])f=r1 local s1,o1=fs.open(r1,"r")if not s1 then a("uudecode: "..r1..": "..z(o1).."\n")return 1 end r=s1 else r=io.stdin()if not r then a("uudecode: cannot read stdin\n")return 1 end end local d=0 local e,a1,h while true do local s=r:readLine()if s==nil then a("uudecode: "..f..": no `begin' line\n")return 1 end d=d+1 s=s:gsub("[ \t\r\v\f]+$","")local h1,n1=s:match("^begin%-base64%s+(%S+)%s+(.+)$")if h1 then e,a1,h=h1,n1,true break end h1,n1=s:match("^begin%s+(%S+)%s+(.+)$")if h1 then e,a1,h=h1,n1,false break end end local i1=tonumber(e,8)if not i1 then a("uudecode: "..f..":"..d..": invalid mode '"..e.."'\n")return 1 end local k,c,g if i=="-"then g=true elseif i then c=n(i)else c=n(a1)end if not g then local t1,p1=fs.open(c,"w")if not t1 then a("uudecode: "..c..": "..z(p1).."\n")return 1 end k=t1 end local function b1(u1)if g then io.write(u1)else k:write(u1)end end local function m1(u1)if k then k:close()end a("uudecode: "..f..":"..d..": "..u1.."\n")return 1 end local function u(u1)local w1=(u1:byte(1)or 0)-0x20 w1=w1%0x40 if w1>45 then return false end local v1=1+4*math.ceil(w1/3)if#u1<v1 then return false end for y1=1,v1 do local x1=u1:byte(y1)if x1<0x20 or x1>0x60 then return false end end return true end local function f1(u1)local v1=u1:byte(1)if not v1 or v1<0x20 or v1>0x60 then return nil end return(v1-0x20)%0x40 end local function q(v1)local a2=f1(v1)if not a2 or a2>45 or#v1<1+4*math.ceil(a2/3)then return nil,"invalid uuencoded line"end for k2=1,1+4*math.ceil(a2/3)do local j2=v1:byte(k2)if j2<0x20 or j2>0x60 then return nil,"invalid uuencoded character"end end local x1,u1,g2={},0,0 while u1<a2 do local w1=2+4*g2 local h2=(v1:byte(w1)-0x20)%0x40 local b2=(v1:byte(w1+1)-0x20)%0x40 local c2=(v1:byte(w1+2)-0x20)%0x40 local i2=(v1:byte(w1+3)-0x20)%0x40 local d2=h2*4+math.floor(b2/16)local e2=(b2%16)*16+math.floor(c2/4)local f2=(c2%4)*64+i2 local z1={d2,e2,f2}local y1=a2-u1 if y1>3 then y1=3 end for l2=1,y1 do x1[#x1+1]=string.char(z1[l2])end u1=u1+3 g2=g2+1 end return table.concat(x1)end local function g1(v1)local u1=v1:byte(1)if not u1 then return nil end if u1>=0x41 and u1<=0x5A then return u1-0x41 end if u1>=0x61 and u1<=0x7A then return u1-0x61+26 end if u1>=0x30 and u1<=0x39 then return u1-0x30+52 end if u1==0x2B then return 62 end if u1==0x2F then return 63 end return nil end local function o(u1)if#u1%4~=0 then return nil,"invalid base64 line length"end local x1=0 if u1:sub(-2)=="=="then x1=2 elseif u1:sub(-1)=="="then x1=1 end local v1={}for e2=1,#u1,4 do local w1=e2+3>=#u1 local z1={}for d2=0,3 do local c2=u1:sub(e2+d2,e2+d2)if c2=="="then if not w1 or d2<4-x1 then return nil,"invalid base64 character"end z1[d2+1]=0 else local a2=g1(c2)if not a2 then return nil,"invalid base64 character"end z1[d2+1]=a2 end end local y1={z1[1]*4+math.floor(z1[2]/16),(z1[2]%16)*16+math.floor(z1[3]/4),(z1[3]%4)*64+z1[4],}local b2=w1 and(3-x1)or 3 for f2=1,b2 do v1[#v1+1]=string.char(y1[f2])end end return table.concat(v1)end local e1,p,t=h and"b64"or nil,false,false while true do local v=r:readLine()if v==nil then break end d=d+1 local j=v:gsub("[\r\v\f]+$","")local y=j:gsub("[ \t]+$","")if y=="end"then t=true break end if e1=="b64"and y:match("^=+$")then t=true break end if y~=""and not p then if not e1 then e1=u(j)and"uu"or"b64"end local l,d1 if e1=="uu"then if f1(j)==0 then p=true else l,d1=q(j)end else l,d1=o(y)end if d1 then return m1(d1)end if l and#l>0 then b1(l)end end end if not t then if k then k:close()end a("uudecode: "..f..": no `end' line\n")return 1 end if r.close then r:close()end if g then io.flush()return end k:close()local q1,l1=fs.chmod(c,i1)if not q1 then a("uudecode: "..c..": chmod "..e.." failed: "..tostring(l1 or"unknown error").."\n")return 1 end