local l=args or{}local m1=(type(cwd)=="string"and cwd)or"/"local function o1(g2)g2=g2 or""if g2==""then return(m1=="/")and"/"or m1 end if g2:sub(1,1)=="/"then if g2=="/"then return"/"end return g2:gsub("/+$","")end local f2=(m1=="/")and""or m1 return(f2.."/"..g2):gsub("/+","/")end local function c(g2)local f2=io.stderr()if f2 and f2.write then f2:write(g2)end end local function r1(f2)if f2 and(f2:find("permission")or f2:find("denied"))then return"Permission denied"end if f2 and f2:lower():find("no such file")then return"No such file or directory"end if f2 and f2:find("directory")then return"Is a directory"end return"No such file or directory"end local f,m,i=false,false,false local h=nil local d={0,0}local a={}local r=false local function g(j2)local h2=j2:match("^%s*([^%s]*)")if not h2 or h2==""then return nil end local g2=1 local f2=h2:sub(-1)if f2=="b"or f2=="B"then g2=512;h2=h2:sub(1,-2)elseif f2=="k"or f2=="K"then g2=1024;h2=h2:sub(1,-2)elseif f2=="m"or f2=="M"then g2=1024*1024;h2=h2:sub(1,-2)end local i2 if h2:match("^0[xX]")then i2=tonumber(h2:sub(3),16)elseif h2:match("^0%d")then i2=tonumber(h2:sub(2),8)else i2=tonumber(h2)end if not i2 then return nil end return math.floor(i2*g2)end local function n(f2)local i2,j2=f2:match("^([^:]*):(.*)$")if i2==nil then i2=f2 end local g2=g(i2)if g2==nil then c("cmp: invalid --ignore-initial value '"..f2.."'\n");return false end local h2=g2 if j2~=nil then if j2==""then h2=g2 else h2=g(j2)if h2==nil then c("cmp: invalid --ignore-initial value '"..f2.."'\n");return false end end end d[1],d[2]=g2,h2 return true end local b1=1 while b1<=#l do local s=l[b1]if r then a[#a+1]=s elseif s=="--"then r=true elseif s=="-l"or s=="--verbose"then f=true elseif s=="-s"or s=="--silent"or s=="--quiet"then m=true elseif s=="-b"or s=="--print-bytes"then i=true elseif s:match("^%-%-bytes=")then h=g(s:sub(9))if h==nil then c("cmp: invalid --bytes value '"..s:sub(9).."'\n");return 2 end elseif s:match("^%-%-ignore%-initial=")then if not n(s:sub(18))then return 2 end elseif s=="-n"or s=="--bytes"then b1=b1+1 if not l[b1]then c("cmp: option requires an argument -- 'n'\n");return 2 end h=g(l[b1])if h==nil then c("cmp: invalid --bytes value '"..l[b1].."'\n");return 2 end elseif s=="-i"or s=="--ignore-initial"then b1=b1+1 if not l[b1]then c("cmp: option requires an argument -- 'i'\n");return 2 end if not n(l[b1])then return 2 end elseif s:sub(1,1)=="-"and s~="-"and s:sub(1,2)~="--"then local s1=2 while s1<=#s do local a1=s:sub(s1,s1)if a1=="l"then f=true;s1=s1+1 elseif a1=="s"then m=true;s1=s1+1 elseif a1=="b"then i=true;s1=s1+1 elseif a1=="n"or a1=="i"then local c1=s:sub(s1+1)if c1==""then b1=b1+1 if not l[b1]then c("cmp: option requires an argument -- '"..a1.."'\n");return 2 end c1=l[b1]end if a1=="n"then h=g(c1)if h==nil then c("cmp: invalid --bytes value '"..c1.."'\n");return 2 end else if not n(c1)then return 2 end end s1=#s+1 else c("cmp: invalid option -- '"..a1.."'\n")return 2 end end elseif s:sub(1,2)=="--"then c("cmp: unrecognized option '"..s.."'\n")return 2 else a[#a+1]=s end b1=b1+1 end local n1,h1=a[1],a[2]if n1==nil then c("cmp: missing operand\n")return 2 end if h1==nil then h1="-"end local x,y if a[3]~=nil then x=g(a[3])end if a[4]~=nil then y=g(a[4])end if x~=nil then d[1]=x end if y~=nil then d[2]=y end if a[5]~=nil then c("cmp: extra operand '"..a[5].."'\n");return 2 end local function k(f2)if not m then c(f2)end end local function z(g2)if g2>=32 and g2<127 then return string.char(g2)end local f2=""if g2>=128 then f2="M-";g2=g2-128 end if g2<32 then return f2.."^"..string.char(g2+64)end if g2==127 then return f2.."^?"end return f2..string.char(g2)end local function u(f2)if f2=="-"then local k2=io.stdin()if not k2 then k("cmp: 无法读取 stdin\n");return nil end return k2,nil end local j2=o1(f2)if not fs.exists(j2)then k("cmp: "..f2..": No such file or directory\n")return nil end if fs.isDir(j2)then k("cmp: "..f2..": Is a directory\n")return nil end local l2,i2=fs.open(j2,"r")if not l2 then k("cmp: "..f2..": "..r1(i2).."\n");return nil end local h2=fs.attributes(j2)local g2=nil if h2 and not h2.isDir then g2=h2.size end return l2,g2 end local function q(i2)local g2=true local f2=nil local function h2(l2)if g2 then local j2=i2.read(l2)if type(j2)=="string"then if j2==""then return nil end return j2 end g2=false end if f2 then local m2=f2;f2=nil;return m2 end local k2=i2.readLine()if k2==nil then return nil end return k2.."\n"end return h2 end local w1,u1=u(n1)if not w1 then return 2 end local x1,v1=u(h1)if not x1 then return 2 end local a2,b2=q(w1),q(x1)local e=1 if f then local t=0 local y1=u1 and(u1-d[1])or-1 local z1=v1 and(v1-d[2])or-1 if y1>=0 and z1>=0 then t=(y1<z1)and y1 or z1 if h and h<t then t=h end end if t<0 then t=0 end e=1 local c2=t while c2>=10 do c2=math.floor(c2/10);e=e+1 end end local function w(k2,l2,g2,h2)if g2==0 then return true end if k2.seek then local i2=k2.seek("set",g2)if i2 then return true end end local f2=g2 while f2>0 do local j2=l2(f2<4096 and f2 or 4096)if j2==nil then return false end f2=f2-#j2 end return true end if d[1]>0 and not w(w1,a2,d[1],n1)then k("cmp: "..n1..": cannot skip past end of file\n")return 2 end if d[2]>0 and not w(x1,b2,d[2],h1)then k("cmp: "..h1..": cannot skip past end of file\n")return 2 end local b=0 local j=1 local o=false local v={}local function p()if#v>0 then io.write(table.concat(v));v={}end end local d1,e1=nil,nil local k1,l1=1,1 local f1,g1=false,false while true do if not f1 and(d1==nil or k1>#d1)then local d2=a2(8192)if d2==nil then f1=true else d1,k1=d2,1 end end if not g1 and(e1==nil or l1>#e1)then local e2=b2(8192)if e2==nil then g1=true else e1,l1=e2,1 end end local i1=(not f1)and d1~=nil and k1<=#d1 local q1=(not g1)and e1~=nil and l1<=#e1 if not i1 and not q1 then break end if not i1 or not q1 then local j1=i1 and h1 or n1 p()if b==0 then k("cmp: EOF on "..j1.." which is empty\n")elseif f then k("cmp: EOF on "..j1.." after byte "..b.."\n")else k("cmp: EOF on "..j1.." after byte "..b..", in line "..j.."\n")end return 1 end while k1<=#d1 and l1<=#e1 do local p1,t1=d1:byte(k1),e1:byte(l1)b=b+1 if p1~=t1 then o=true if f then if i then v[#v+1]=string.format("%"..e.."d %3o %-4s %3o %s\n",b,p1,z(p1),t1,z(t1))else v[#v+1]=string.format("%"..e.."d %3o %3o\n",b,p1,t1)end if#v>=256 then p()end else k(n1.." "..h1.." differ: char "..b..", line "..j.."\n")p()return 1 end end if p1==10 then j=j+1 end k1,l1=k1+1,l1+1 if h and b>=h then p()if o then return 1 end return end end end p()if o then return 1 end