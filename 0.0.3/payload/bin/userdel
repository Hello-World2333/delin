local j=args or{}local function b(q)local p=io.stderr()if p and p.write then p:write(q)end end local function d(p)if p then b("userdel: "..p.."\n")end b("usage: userdel [-r] name\n")return 2 end if not(syscalls and syscalls["user.delUser"])then b("userdel: user syscalls not available\n")return 1 end local g,a,e=false,nil,false for o,h in ipairs(j)do if e then if a then return d("extra operand '"..h.."'")end a=h elseif h=="--"then e=true elseif h:sub(1,1)=="-"and h~="-"then for m=2,#h do if h:sub(m,m)=="r"then g=true else return d("invalid option -- '"..h:sub(m,m).."'")end end else if a then return d("extra operand '"..h.."'")end a=h end end if not a then return d("no user name given")end local i,l=syscalls["user.delUser"](a)if not i then b("userdel: "..tostring(l).."\n")return 1 end if g then local c=i.home if c==nil or c==""or c=="/"then b("userdel: refusing to remove home directory '"..tostring(c).."'\n")return 1 end local function f(q)if fs.isDir(q)then for t,s in ipairs(fs.list(q)or{})do f(fs.combine(q,s))end end local r,p=pcall(fs.delete,q)if not r then return nil,tostring(p)end return true end if fs.exists(c)then local n,k=f(c)if not n then b("userdel: cannot remove '"..c.."': "..tostring(k).."\n")return 1 end end end return 0