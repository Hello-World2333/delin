local b=args or{}local w=(type(cwd)=="string"and cwd)or"/"local function z(n1)n1=n1 or""if n1==""then return(w=="/")and"/"or w end if n1:sub(1,1)=="/"then if n1=="/"then return"/"end return n1:gsub("/+$","")end local m1=(w=="/")and""or w return(m1.."/"..n1):gsub("/+","/")end local function a(n1)local m1=io.stderr()if m1 and m1.write then m1:write(n1)end end local function a1(m1)if m1 and(m1:find("permission")or m1:find("denied"))then return"Permission denied"end if m1 and m1:lower():find("no such file")then return"No such file or directory"end if m1 and m1:find("directory")then return"Is a directory"end return"No such file or directory"end local i1=2000000000 local n=nil local c={}local o="\t"local d,j=false,false local g=nil local f={}local k=false local function y(m1)local n1,o1 local p1,q1=m1:match("^(%d+)%-(%d+)$")if p1 then n1,o1=tonumber(p1),tonumber(q1)if o1<n1 then a("cut: invalid decreasing range\n");return false end elseif m1:match("^%d+$")then n1,o1=tonumber(m1),tonumber(m1)elseif m1:match("^%d+%-$")then n1,o1=tonumber(m1:match("^(%d+)")),i1 elseif m1:match("^%-%d+$")then n1,o1=1,tonumber(m1:match("(%d+)$"))else a("cut: invalid range: '"..m1.."'\n")return false end if n1<1 then a("cut: fields are numbered from 1\n");return false end c[#c+1]={lo=n1,hi=o1}return true end local function u(m1)if m1==""then a("cut: invalid empty list\n");return false end for n1 in m1:gmatch("[^,%s]+")do if not y(n1)then return false end end if#c==0 then a("cut: invalid empty list\n");return false end return true end local function t()table.sort(c,function(q1,r1)return q1.lo<r1.lo end)local n1={}for p1,o1 in ipairs(c)do local m1=n1[#n1]if m1 and o1.lo<=m1.hi+1 then if o1.hi>m1.hi then m1.hi=o1.hi end else n1[#n1+1]={lo=o1.lo,hi=o1.hi}end end c=n1 end local function e(m1,n1)if n and n~=n1 then a("cut: only one type of list may be specified\n")return false end n=n1 if not u(m1)then return false end return true end local function h(m1)if#m1~=1 then a("cut: the delimiter must be a single character\n")return false end o=m1 return true end local m=1 while m<=#b do local i=b[m]if k then f[#f+1]=i elseif i=="--"then k=true elseif i=="--complement"then j=true elseif i=="--only-delimited"then d=true elseif i=="-s"then d=true elseif i=="-n"then elseif i:match("^%-%-bytes=")then if not e(i:sub(9),"b")then return 1 end elseif i:match("^%-%-characters=")then if not e(i:sub(14),"c")then return 1 end elseif i:match("^%-%-fields=")then if not e(i:sub(10),"f")then return 1 end elseif i=="--bytes"or i=="--characters"or i=="--fields"then m=m+1 if not b[m]then a("cut: option '"..i.."' requires an argument\n");return 1 end if not e(b[m],i=="--bytes"and"b"or(i=="--characters"and"c"or"f"))then return 1 end elseif i:match("^%-%-delimiter=")then local k1=i:sub(13)if not h(k1)then return 1 end elseif i=="--delimiter"then m=m+1 if not b[m]then a("cut: option '--delimiter' requires an argument\n");return 1 end if not h(b[m])then return 1 end elseif i:match("^%-%-output%-delimiter=")then g=i:sub(20)elseif i=="--output-delimiter"then m=m+1 if not b[m]then a("cut: option '--output-delimiter' requires an argument\n");return 1 end g=b[m]elseif i=="-d"then m=m+1 if not b[m]then a("cut: option requires an argument -- 'd'\n");return 1 end if not h(b[m])then return 1 end elseif i:sub(1,1)=="-"and i~="-"and i:sub(1,2)~="--"then local b1=2 while b1<=#i do local s=i:sub(b1,b1)if s=="s"then d=true;b1=b1+1 elseif s=="n"then b1=b1+1 elseif s=="b"or s=="c"or s=="f"then local d1=i:sub(b1+1)if d1==""then m=m+1 if not b[m]then a("cut: option requires an argument -- '"..s.."'\n");return 1 end d1=b[m]end if not e(d1,s)then return 1 end b1=#i+1 elseif s=="d"then local e1=i:sub(b1+1)if e1==""then m=m+1 if not b[m]then a("cut: option requires an argument -- 'd'\n");return 1 end e1=b[m]end if not h(e1)then return 1 end b1=#i+1 else a("cut: invalid option -- '"..s.."'\n")return 1 end end elseif i:sub(1,2)=="--"then a("cut: unrecognized option '"..i.."'\n")return 1 else f[#f+1]=i end m=m+1 end if not n then a("cut: you must specify a list of bytes, characters, or fields\n")return 1 end if#f==0 then f={"-"}end t()local function p(n1)local m1=false for p1,o1 in ipairs(c)do if n1>=o1.lo and n1<=o1.hi then m1=true;break end if o1.lo>n1 then break end end if j then return not m1 end return m1 end local l if g~=nil then l=g elseif n=="f"then l=o else l=""end local function v(m1)return table.concat(m1,l)end local function q(n1)if n=="f"then local r1=n1:find(o,1,true)~=nil if not r1 then if d then return nil end return n1 end local m1={}local s1=1 while true do local v1=n1:find(o,s1,true)if not v1 then m1[#m1+1]=n1:sub(s1);break end m1[#m1+1]=n1:sub(s1,v1-1)s1=v1+1 end local t1={}for u1=1,#m1 do if p(u1)then t1[#t1+1]=m1[u1]end end return v(t1)end local p1,o1={},nil for q1=1,#n1 do if p(q1)then if o1 then o1=o1..n1:sub(q1,q1)else o1=n1:sub(q1,q1)end elseif o1 then p1[#p1+1]=o1;o1=nil end end if o1 then p1[#p1+1]=o1 end return v(p1)end local r={}local function x()if#r>0 then io.write(table.concat(r));r={}end end for l1,j1 in ipairs(f)do local h1 if j1=="-"then h1=io.stdin()if not h1 then a("cut: 无法读取 stdin\n");return 1 end else local f1 h1,f1=fs.open(z(j1),"r")if not h1 then a("cut: "..j1..": "..a1(f1).."\n")return 1 end end while true do local c1=h1.readLine()if c1==nil then break end local g1=q(c1)if g1~=nil then r[#r+1]=g1.."\n"end if#r>=512 then x()end end if j1~="-"then h1:close()end end x()