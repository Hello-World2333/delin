local b=args or{}local n=(type(cwd)=="string"and cwd)or"/"local function o(b1)b1=b1 or""if b1==""then return(n=="/")and"/"or n end if b1:sub(1,1)=="/"then if b1=="/"then return"/"end return b1:gsub("/+$","")end local a1=(n=="/")and""or n return(a1.."/"..b1):gsub("/+","/")end local function a(b1)local a1=io.stderr()if a1 and a1.write then a1:write(b1)end end local function p(a1)if a1 and(a1:find("permission")or a1:find("denied"))then return"Permission denied"end if a1 and a1:lower():find("no such file")then return"No such file or directory"end if a1 and a1:find("directory")then return"Is a directory"end return"No such file or directory"end local f=4 local i=nil local e=false local c={}local g=false local function d(a1)if a1=="d"or a1=="o"or a1=="x"then i=a1;return true end a("strings: invalid radix: '"..a1.."'\n")return false end local j=1 while j<=#b do local h=b[j]if g then c[#c+1]=h elseif h=="--"then g=true elseif h=="-a"or h=="-all"or h=="--all"then elseif h=="-f"or h=="--print-file-name"then e=true elseif h:match("^%-%-bytes=")then local x=tonumber(h:sub(9))if not x or x<1 then a("strings: invalid integer argument '"..h:sub(9).."'\n");return 1 end f=x elseif h:match("^%-%-radix=")then if not d(h:sub(9))then return 1 end elseif h=="-n"or h=="--bytes"then j=j+1 if not b[j]then a("strings: option requires an argument -- 'n'\n");return 1 end local v=tonumber(b[j])if not v or v<1 then a("strings: invalid integer argument '"..b[j].."'\n");return 1 end f=v elseif h=="-t"or h=="--radix"then j=j+1 if not b[j]then a("strings: option requires an argument -- 't'\n");return 1 end if not d(b[j])then return 1 end elseif h:sub(1,1)=="-"and h~="-"and h:sub(1,2)~="--"then local r=2 while r<=#h do local m=h:sub(r,r)if m=="a"then r=r+1 elseif m=="f"then e=true;r=r+1 elseif m=="n"or m=="t"then local l=h:sub(r+1)if l==""then j=j+1 if not b[j]then a("strings: option requires an argument -- '"..m.."'\n");return 1 end l=b[j]end if m=="n"then local w=tonumber(l)if not w or w<1 then a("strings: invalid integer argument '"..l.."'\n");return 1 end f=w else if not d(l)then return 1 end end r=#h+1 else a("strings: invalid option -- '"..m.."'\n")return 1 end end elseif h:sub(1,2)=="--"then a("strings: unrecognized option '"..h.."'\n")return 1 else c[#c+1]=h end j=j+1 end if#c==0 then c={"-"}end local function k(a1)return(a1>=0x20 and a1<=0x7E)or a1==0x09 end local function q(j1,i1)local c1={}local function g1()if#c1>0 then io.write(table.concat(c1));c1={}end end local e1=0 local a1=nil local f1={}local function d1()if a1 and#f1>=f then if e then c1[#c1+1]=i1..": "end if i then local m1=(i=="d"and"%7d")or(i=="o"and"%7o")or"%7x"c1[#c1+1]=string.format(m1,a1).." "end c1[#c1+1]=table.concat(f1).."\n"if#c1>=256 then g1()end end a1=nil f1={}end while true do local b1 if j1.read then b1=j1.read(65536)end if type(b1)~="string"or b1==""then local k1=j1.readLine()if k1==nil then break end b1=k1.."\n"end for h1=1,#b1 do local l1=b1:byte(h1)if k(l1)then if not a1 then a1=e1 end f1[#f1+1]=b1:sub(h1,h1)else d1()end e1=e1+1 end end d1()g1()end for z,t in ipairs(c)do if t=="-"then local y=io.stdin()if not y then a("strings: 无法读取 stdin\n");return 1 end q(y,"-")else local u,s=fs.open(o(t),"r")if not u then a("strings: "..t..": "..p(s).."\n")return 1 end q(u,t)u:close()end end