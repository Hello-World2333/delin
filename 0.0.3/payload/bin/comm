local y=args or{}local p=(type(cwd)=="string"and cwd)or"/"local function s(e1)e1=e1 or""if e1==""then return(p=="/")and"/"or p end if e1:sub(1,1)=="/"then if e1=="/"then return"/"end return e1:gsub("/+$","")end local d1=(p=="/")and""or p return(d1.."/"..e1):gsub("/+","/")end local function a(e1)local d1=io.stderr()if d1 and d1.write then d1:write(e1)end end local function u(d1)if d1 and(d1:find("permission")or d1:find("denied"))then return"Permission denied"end if d1 and d1:lower():find("no such file")then return"No such file or directory"end if d1 and d1:find("directory")then return"Is a directory"end return"No such file or directory"end local k,l,q=false,false,false local e=true local c={}local i=false for c1,t in ipairs(y)do if i then c[#c+1]=t elseif t=="--"then i=true elseif t=="--check-order"then e=true elseif t=="--nocheck-order"then e=false elseif t:sub(1,1)=="-"and t~="-"and t:sub(1,2)~="--"then for z=2,#t do local x=t:sub(z,z)if x=="1"then k=true elseif x=="2"then l=true elseif x=="3"then q=true else a("comm: invalid option -- '"..x.."'\n");return 1 end end elseif t:sub(1,2)=="--"then a("comm: unrecognized option '"..t.."'\n")return 1 else c[#c+1]=t end end if#c<2 then a("comm: missing operand\n")return 1 end if#c>2 then a("comm: extra operand '"..c[3].."'\n")return 1 end local function m(d1)if d1=="-"then local g1=io.stdin()if not g1 then a("comm: 无法读取 stdin\n");return nil end return g1 end local f1,e1=fs.open(s(d1),"r")if not f1 then a("comm: "..d1..": "..u(e1).."\n")return nil end return f1 end local function h(e1)local h1=m(e1)if not h1 then return nil end local f1,g1=nil,false local d1=false return{name=e1,read=function()if g1 then return nil end local i1=h1.readLine()if i1==nil then g1=true;return nil end if f1 and i1<f1 then d1=true end f1=i1 return i1 end,close=function()if e1~="-"then h1:close()end end,disorder=function()return d1 end,}end local n=h(c[1])if not n then return 1 end local o=h(c[2])if not o then return 1 end local j=k and""or"\t"local r=j..(l and""or"\t")local b={}local function f()if#b>0 then io.write(table.concat(b));b={}end end local d=nil local function g(d1)if e then a("comm: file "..d1.." is not in sorted order\n")return 1 end d=d or d1 return nil end local v,w=n.read(),o.read()while v~=nil and w~=nil do if v<w then if not k then b[#b+1]=v.."\n"end v=n.read()elseif v>w then if not l then b[#b+1]=j..w.."\n"end w=o.read()else if not q then b[#b+1]=r..v.."\n"end v=n.read()w=o.read()end if#b>256 then f()end if n.disorder()then local a1=g(1);if a1 then f();return a1 end end if o.disorder()then local b1=g(2);if b1 then f();return b1 end end end while v~=nil do if not k then b[#b+1]=v.."\n"end v=n.read()if#b>256 then f()end end while w~=nil do if not l then b[#b+1]=j..w.."\n"end w=o.read()if#b>256 then f()end end f()n.close()o.close()if d then a("comm: input is not in sorted order\n")return 1 end