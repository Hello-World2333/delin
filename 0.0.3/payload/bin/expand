local g=args or{}local n=(type(cwd)=="string"and cwd)or"/"local function o(a1)a1=a1 or""if a1==""then return(n=="/")and"/"or n end if a1:sub(1,1)=="/"then if a1=="/"then return"/"end return a1:gsub("/+$","")end local z=(n=="/")and""or n return(z.."/"..a1):gsub("/+","/")end local function a(a1)local z=io.stderr()if z and z.write then z:write(a1)end end local function q(z)if z and(z:find("permission")or z:find("denied"))then return"Permission denied"end if z and z:lower():find("no such file")then return"No such file or directory"end if z and z:find("directory")then return"Is a directory"end return"No such file or directory"end local c=false local i=nil local h=8 local d={}local f=false local function e(a1,d1)local z={}for c1 in a1:gmatch("[^,%s]+")do local e1=tonumber(c1)if not e1 or e1<1 or e1~=math.floor(e1)then a("expand: tab size contains invalid character(s): '"..c1.."'\n")return false end z[#z+1]=e1 end if#z==0 then a("expand: tab size contains invalid character(s): '"..a1.."'\n")return false end if#z==1 then h=z[1]i=nil return true end for b1=2,#z do if z[b1]<=z[b1-1]then a("expand: tab sizes must be ascending\n")return false end end i=z return true end local p=1 while p<=#g do local k=g[p]if f then d[#d+1]=k elseif k=="--"then f=true elseif k=="-i"or k=="--initial"then c=true elseif k:match("^%-%-tabs=")then if not e(k:sub(8))then return 1 end elseif k=="-t"or k=="--tabs"then p=p+1 if not g[p]then a("expand: option requires an argument -- 't'\n");return 1 end if not e(g[p])then return 1 end elseif k:match("^%-%d+$")then if not e(k:sub(2))then return 1 end elseif k:sub(1,1)=="-"and k~="-"and k:sub(1,2)~="--"then for x=2,#k do local u=k:sub(x,x)if u=="i"then c=true elseif u=="t"then local s=k:sub(x+1)if s==""then p=p+1 if not g[p]then a("expand: option requires an argument -- 't'\n");return 1 end s=g[p]end if not e(s)then return 1 end break else a("expand: invalid option -- '"..u.."'\n")return 1 end end elseif k:sub(1,2)=="--"then a("expand: unrecognized option '"..k.."'\n")return 1 else d[#d+1]=k end p=p+1 end if#d==0 then d={"-"}end local function j(z)if i then for b1,a1 in ipairs(i)do if a1>z then return a1 end end return z+1 end return z+(h-z%h)end local b={}local function m()if#b>0 then io.write(table.concat(b));b={}end end local function l(b1)local z,a1=0,false for c1=1,#b1 do local e1=b1:sub(c1,c1)if e1=="\t"then if c and a1 then b[#b+1]="\t"z=j(z)else local d1=j(z)b[#b+1]=string.rep(" ",d1-z)z=d1 end elseif e1=="\b"then b[#b+1]=e1 if z>0 then z=z-1 end elseif e1=="\r"then b[#b+1]=e1 z=0 else b[#b+1]=e1 z=z+1 if e1~=" "then a1=true end end if#b>=512 then m()end end b[#b+1]="\n"end for y,w in ipairs(d)do local v if w=="-"then v=io.stdin()if not v then a("expand: 无法读取 stdin\n");return 1 end else local t v,t=fs.open(o(w),"r")if not v then a("expand: "..w..": "..q(t).."\n")return 1 end end while true do local r=v.readLine()if r==nil then break end l(r)if#b>=512 then m()end end if w~="-"then v:close()end end m()