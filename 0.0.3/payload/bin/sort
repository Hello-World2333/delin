local d=args or{}local j1=(type(cwd)=="string"and cwd)or"/"local function z(o2)o2=o2 or""if o2==""then return(j1=="/")and"/"or j1 end if o2:sub(1,1)=="/"then if o2=="/"then return"/"end return o2:gsub("/+$","")end local n2=(j1=="/")and""or j1 return(n2.."/"..o2):gsub("/+","/")end local function a(o2)local n2=io.stderr()if n2 and n2.write then n2:write(o2)end end local function c1(n2)if n2 and(n2:find("permission")or n2:find("denied"))then return"Permission denied"end if n2 and n2:lower():find("no such file")then return"No such file or directory"end if n2 and n2:find("directory")then return"Is a directory"end return"No such file or directory"end local c={}local b={}local e=nil local l=nil local j=false local f={}local q=false local function g(r2)local q2={f1=1,c1=nil,o1={},f2=nil,c2=nil,o2={}}local p2,o2=r2:match("^([^,]*),(.*)$")if p2==nil then p2=r2 end local function n2(u2,w2)local z2,y2=u2:match("^(%d+)(.*)$")if not z2 then a("sort: invalid number at field start: '"..u2.."'\n")return false end local x2=tonumber(z2)if x2<1 then a("sort: field number is zero: '"..u2.."'\n")return false end local t2,s2=y2:match("^%.(%d+)(.*)$")local v2={}if t2 then if tonumber(t2)<1 then a("sort: character offset is zero: '"..u2.."'\n")return false end s2=s2 or""else s2=y2 end for a3 in(s2 or""):gmatch(".")do if a3:match("[bdfginrhVM]")then v2[a3]=true else a("sort: invalid field specification: '"..r2.."'\n")return false end end if w2 then q2.f1,q2.c1,q2.o1=x2,t2 and tonumber(t2)or nil,v2 else q2.f2,q2.c2,q2.o2=x2,t2 and tonumber(t2)or nil,v2 end return true end if not n2(p2,true)then return nil end if o2~=nil and o2~=""then if not n2(o2,false)then return nil end end return q2 end local s=1 while s<=#d do local h=d[s]if q then f[#f+1]=h elseif h=="--"then q=true elseif h:match("^%-%-key=")then local s1=g(h:sub(7))if not s1 then return 1 end b[#b+1]=s1 elseif h:match("^%-%-output=")then e=h:sub(10)elseif h:match("^%-%-field%-separator=")then local b2=h:sub(19)if#b2~=1 then a("sort: multi-character tab '"..b2.."'\n");return 1 end l=b2 elseif h:match("^%-%-check=")and h:sub(9)=="quiet"then j=true elseif h=="--check"or h=="-c"or h=="--quiet"then j=true elseif h=="--ignore-leading-blanks"then c.b=true elseif h=="--dictionary-order"then c.d=true elseif h=="--ignore-case"then c.f=true elseif h=="--general-numeric-sort"then c.g=true elseif h=="--human-numeric-sort"then c.h=true elseif h=="--ignore-nonprinting"then c.i=true elseif h=="--merge"then c.m=true elseif h=="--numeric-sort"then c.n=true elseif h=="--reverse"then c.r=true elseif h=="--stable"then c.s=true elseif h=="--unique"then c.u=true elseif h=="--version-sort"then c.V=true elseif h=="--zero-terminated"then c.z=true elseif h=="-k"or h=="--key"then s=s+1 if not d[s]then a("sort: option requires an argument -- 'k'\n");return 1 end local u1=g(d[s])if not u1 then return 1 end b[#b+1]=u1 elseif h=="-o"or h=="--output"then s=s+1 if not d[s]then a("sort: option requires an argument -- 'o'\n");return 1 end e=d[s]elseif h=="-t"or h=="--field-separator"then s=s+1 if not d[s]then a("sort: option requires an argument -- 't'\n");return 1 end if#d[s]~=1 then a("sort: multi-character tab '"..d[s].."'\n");return 1 end l=d[s]elseif h=="-S"then s=s+1 elseif h:match("^%-%-")then a("sort: unrecognized option '"..h.."'\n")return 1 elseif h:sub(1,1)=="-"and h~="-"then local o1=2 while o1<=#h do local t=h:sub(o1,o1)if t=="k"or t=="o"or t=="t"or t=="S"then local y=h:sub(o1+1)if y==""then s=s+1 if not d[s]then a("sort: option requires an argument -- '"..t.."'\n");return 1 end y=d[s]end if t=="k"then local t1=g(y)if not t1 then return 1 end b[#b+1]=t1 elseif t=="o"then e=y elseif t=="t"then if#y~=1 then a("sort: multi-character tab '"..y.."'\n");return 1 end l=y end o1=#h+1 elseif t:match("[bdfgihmnrsuVz]")then c[t]=true o1=o1+1 else a("sort: invalid option -- '"..t.."'\n")return 1 end end else f[#f+1]=h end s=s+1 end if c.n and c.g then a("sort: options '-g' and '-n' are incompatible\n");return 1 end if c.h and(c.n or c.g)then a("sort: options '-h' and '-n'/'-g' are incompatible\n");return 1 end local function f1(o2)local q2={}if l then local p2=1 while true do local r2=o2:find(l,p2,true)if not r2 then q2[#q2+1]={s=p2,e=#o2};break end q2[#q2+1]={s=p2,e=r2-1}p2=r2+1 end else local n2,s2=1,#o2 while n2<=s2 do local t2=n2 while n2<=s2 and o2:sub(n2,n2):match("[ \t]")do n2=n2+1 end while n2<=s2 and not o2:sub(n2,n2):match("[ \t]")do n2=n2+1 end q2[#q2+1]={s=t2,e=n2-1}end end return q2 end local function a1(p2,q2,r2)local t2=q2[r2.f1]if not t2 then return""end local n2=t2.s if r2.o1.b or c.b then while n2<=#p2 and p2:sub(n2,n2):match("[ \t]")do n2=n2+1 end end if r2.c1 then n2=n2+(r2.c1-1)end local o2 if r2.f2 then local s2=q2[r2.f2]if not s2 then o2=0 elseif r2.c2 then o2=s2.s+(r2.c2-1)else o2=s2.e end else o2=#p2 end if n2>o2 or n2>#p2 then return""end if o2>#p2 then o2=#p2 end return p2:sub(n2,o2)end local function x(q2)q2=q2:gsub("^[ \t]+","")local t2=#q2 local n2=1 if q2:sub(n2,n2)=="+"or q2:sub(n2,n2)=="-"then n2=n2+1 end local o2=false while n2<=t2 and q2:sub(n2,n2):match("%d")do n2=n2+1;o2=true end if q2:sub(n2,n2)=="."then n2=n2+1 while n2<=t2 and q2:sub(n2,n2):match("%d")do n2=n2+1;o2=true end end if not o2 then return 0 end local r2=n2-1 if q2:sub(n2,n2)=="e"or q2:sub(n2,n2)=="E"then local p2=n2+1 if q2:sub(p2,p2)=="+"or q2:sub(p2,p2)=="-"then p2=p2+1 end local s2=p2 while p2<=t2 and q2:sub(p2,p2):match("%d")do p2=p2+1 end if p2>s2 then r2=p2-1 end end return tonumber(q2:sub(1,r2))or 0 end local function p(o2)local n2=o2:gsub("^[ \t]+",""):lower()if n2:match("^%-?inf")then return n2:sub(1,1)=="-"and-math.huge or math.huge end if n2:match("^%-?nan")then return 0/0 end return x(o2)end local v1={k=1024,m=1024,g=1024,t=1024,p=1024,e=1024,z=1024,y=1024}local function v(t2)local s2=t2:gsub("^[ \t]+","")local n2=s2:match("^[-+]?%d*%.?%d+")if not n2 then return 0 end local q2=tonumber(n2)or 0 local p2=s2:sub(#n2+1,#n2+1):lower()local o2={k=1,m=2,g=3,t=4,p=5,e=6,z=7,y=8}local r2=o2[p2]if r2 then for u2=1,r2 do q2=q2*1024 end end return q2 end local function e1(o2)if o2==""then return-1 end local n2=o2:byte()if n2>=48 and n2<=57 then return 0 end if(n2>=65 and n2<=90)or(n2>=97 and n2<=122)then return n2 end if o2=="~"then return-1 end return n2+256 end local function p1(b3,c3)local n2,o2=1,1 local v2,w2=#b3,#c3 while n2<=v2 or o2<=w2 do local d3,e3=n2,o2 while n2<=v2 and not b3:sub(n2,n2):match("%d")do n2=n2+1 end while o2<=w2 and not c3:sub(o2,o2):match("%d")do o2=o2+1 end local x2,y2=d3,e3 while x2<n2 or y2<o2 do local r2=(x2<n2)and b3:sub(x2,x2)or""local s2=(y2<o2)and c3:sub(y2,y2)or""x2,y2=x2+1,y2+1 if r2~=s2 then if r2=="~"then return-1 end if s2=="~"then return 1 end local z2,a3=e1(r2),e1(s2)if z2~=a3 then return z2<a3 and-1 or 1 end return(r2<s2)and-1 or 1 end end local p2,q2=b3:match("^%d+",n2),c3:match("^%d+",o2)if p2 or q2 then p2,q2=p2 or"",q2 or""local t2,u2=p2:gsub("^0+",""),q2:gsub("^0+","")if#t2~=#u2 then return#t2<#u2 and-1 or 1 end if t2~=u2 then return t2<u2 and-1 or 1 end n2,o2=n2+#p2,o2+#q2 end end if n2<=v2 then return 1 end if o2<=w2 then return-1 end return 0 end local function r(n2,u2)if u2.d then local p2={}for t2=1,#n2 do local s2=n2:sub(t2,t2)if s2:match("[ \t%w]")then p2[#p2+1]=s2 end end n2=table.concat(p2)end if u2.i then local q2={}for o2=1,#n2 do local r2=n2:byte(o2)if r2>=32 and r2<=126 then q2[#q2+1]=n2:sub(o2,o2)end end n2=table.concat(q2)end return n2 end local function o(n2,o2,p2)n2=r(n2,p2)o2=r(o2,p2)if p2.f then n2,o2=n2:lower(),o2:lower()end if p2.V then return p1(n2,o2)end if p2.n then local t2,u2=x(n2),x(o2)if t2~=u2 then return t2<u2 and-1 or 1 end return 0 end if p2.g then local q2,r2=p(n2),p(o2)if q2~=q2 and r2~=r2 then return 0 end if q2~=q2 then return-1 end if r2~=r2 then return 1 end if q2~=r2 then return q2<r2 and-1 or 1 end return 0 end if p2.h then local s2,v2=v(n2),v(o2)if s2~=v2 then return s2<v2 and-1 or 1 end return 0 end if n2==o2 then return 0 end return n2<o2 and-1 or 1 end local function w(o2)local n2=nil local p2={}if#b==0 then local s2=o2 if c.b then s2=s2:gsub("^[ \t]+","")end p2[1]=s2 else for q2,r2 in ipairs(b)do if not n2 then n2=f1(o2)end p2[q2]=a1(o2,n2,r2)end end return p2 end local function d1(n2)local o2={}for q2,t2 in pairs(c)do o2[q2]=t2 end if#b>0 and n2<=#b then for r2,s2 in pairs(b[n2].o1)do o2[r2]=s2 end for p2,u2 in pairs(b[n2].o2)do o2[p2]=u2 end end return o2 end local function u(o2,p2)local q2,t2=w(o2),w(p2)local v2=#q2 for n2=1,v2 do local u2=d1(n2)local r2=o(q2[n2],t2[n2],u2)if u2.r then r2=-r2 end if r2~=0 then return r2 end end if not(c.s or c.u)and o2~=p2 then local s2=o2<p2 and-1 or 1 if c.r then s2=-s2 end return s2 end return 0 end local function k(p2)local r2 if p2=="-"then r2=io.stdin()if not r2 then a("sort: 无法读取 stdin\n");return nil end else local s2 r2,s2=fs.open(z(p2),"r")if not r2 then a("sort: "..p2..": "..c1(s2).."\n")return nil end end local o2={}if c.z then local n2 if r2.readAll then n2=r2.readAll()or""else local u2={}while true do local w2=r2.readLine();if w2==nil then break end;u2[#u2+1]=w2 end n2=table.concat(u2,"\n")end local q2,x2=1,#n2 while q2<=x2 do local t2=n2:find("\0",q2,true)if not t2 then o2[#o2+1]=n2:sub(q2);break end o2[#o2+1]=n2:sub(q2,t2-1)q2=t2+1 end else while true do local v2=r2.readLine()if v2==nil then break end o2[#o2+1]=v2 end end if p2~="-"then r2:close()end return o2 end if#f==0 then f={"-"}end if j then local g1,h1=nil,nil for l2,w1 in ipairs(f)do local k1=k(w1)if not k1 then return 1 end for g2,a2 in ipairs(k1)do if g1 then local c2=u(g1,a2)if c2>0 or(c.u and c2==0)then a("sort: "..w1..":"..g2..": disorder: "..a2.."\n")return 1 end end g1,h1=a2,w1 end end return end local m={}for i2,e2 in ipairs(f)do local l1=k(e2)if not l1 then return 1 end for k2,f2 in ipairs(l1)do m[#m+1]={line=f2,idx=#m+1}end end table.sort(m,function(o2,p2)local n2=u(o2.line,p2.line)if n2~=0 then return n2<0 end return o2.idx<p2.idx end)local i={}if c.u then local n=nil for j2,r1 in ipairs(m)do local z1=w(r1.line)local i1=false if n then i1=true for m1=1,#z1 do local h2=d1(m1)local d2=o(n[m1],z1[m1],h2)if d2~=0 then i1=false;break end end end if not i1 then i[#i+1]=r1.line;n=z1 end end else for m2,y1 in ipairs(m)do i[#i+1]=y1.line end end local n1=c.z and"\0"or"\n"local b1=table.concat(i,n1)if#i>0 then b1=b1..n1 end if e then local x1,q1=fs.open(z(e),"w")if not x1 then a("sort: "..e..": "..c1(q1).."\n")return 1 end x1:write(b1)x1:close()else io.write(b1)end