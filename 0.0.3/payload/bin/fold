local j=args or{}local k=(type(cwd)=="string"and cwd)or"/"local function m(a1)a1=a1 or""if a1==""then return(k=="/")and"/"or k end if a1:sub(1,1)=="/"then if a1=="/"then return"/"end return a1:gsub("/+$","")end local z=(k=="/")and""or k return(z.."/"..a1):gsub("/+","/")end local function a(a1)local z=io.stderr()if z and z.write then z:write(a1)end end local function n(z)if z and(z:find("permission")or z:find("denied"))then return"Permission denied"end if z and z:lower():find("no such file")then return"No such file or directory"end if z and z:find("directory")then return"Is a directory"end return"No such file or directory"end local e,b=false,false local h=80 local d={}local g=false local q=1 while q<=#j do local i=j[q]if g then d[#d+1]=i elseif i=="--"then g=true elseif i=="-b"or i=="--bytes"then e=true elseif i=="-s"or i=="--spaces"then b=true elseif i:match("^%-%-width=")then local w=tonumber(i:sub(9))if not w or w<1 then a("fold: invalid number of columns: '"..i:sub(9).."'\n");return 1 end h=w elseif i:match("^%-%-")then a("fold: unrecognized option '"..i.."'\n")return 1 elseif i:match("^%-%d+$")then local v=tonumber(i:sub(2))if not v or v<1 then a("fold: invalid number of columns: '"..i:sub(2).."'\n");return 1 end h=v elseif i:sub(1,1)=="-"and i~="-"then local p=2 while p<=#i do local o=i:sub(p,p)if o=="b"then e=true;p=p+1 elseif o=="s"then b=true;p=p+1 elseif o=="w"then local l=i:sub(p+1)if l==""then q=q+1 if not j[q]then a("fold: option requires an argument -- 'w'\n");return 1 end l=j[q]end local u=tonumber(l)if not u or u<1 then a("fold: invalid number of columns: '"..l.."'\n");return 1 end h=u p=#i+1 else a("fold: invalid option -- '"..o.."'\n")return 1 end end else d[#d+1]=i end q=q+1 end if#d==0 then d={"-"}end local function c(a1,z)if e then return z+1 end if a1=="\t"then return z+(8-z%8)end if a1=="\b"then return z>0 and z-1 or 0 end if a1=="\r"then return 0 end return z+1 end local function f(o1)local a1,g1={},0 local z=0 local b1=0 local f1={}local function e1()if#f1>0 then io.write(table.concat(f1));f1={}end end local function d1(q1)f1[#f1+1]=q1 if#f1>=512 then e1()end end local function j1(s1)local r1=0 for q1=1,#s1 do r1=c(s1:sub(q1,q1),r1)end return r1 end local function i1()d1("\n")a1,g1,z,b1={},0,0,0 end while true do local c1=o1.read and o1.read(4096)if type(c1)~="string"or c1==""then c1=nil end if not c1 then local p1=o1.readLine()if p1==nil then break end c1=p1.."\n"end for l1=1,#c1 do local n1=c1:sub(l1,l1)if n1=="\n"then d1(table.concat(a1,"",1,g1))a1,g1,z={},0,0 i1()b1=0 else local k1=c(n1,b1)if k1>h and b1>0 then if b and z>0 and z<g1 then local m1=table.concat(a1,"",1,z)local h1=table.concat(a1,"",z+1,g1)d1(m1)d1("\n")a1,g1={},0 if h1~=""then a1[1]=h1;g1=1 end z=0 b1=j1(h1)else d1(table.concat(a1,"",1,g1))d1("\n")a1,g1,z={},0,0 b1=0 end end g1=g1+1 a1[g1]=n1 if n1==" "or n1=="\t"then z=g1 end b1=c(n1,b1)end end end if g1>0 then d1(table.concat(a1,"",1,g1))end e1()end for y,s in ipairs(d)do if s=="-"then local x=io.stdin()if x then f(x)end else local t,r=fs.open(m(s),"r")if not t then a("fold: "..s..": "..n(r).."\n")return 1 end f(t)t:close()end end