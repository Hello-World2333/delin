local b=args or{}local function d(s)local r=io.stderr()if r and r.write then r:write(s)end end local h,m="user.notice","logger"local a={}local j=1 while j<=#b do local i=b[j]if i=="-p"and b[j+1]then h=b[j+1];j=j+1 elseif i:match("^%-%-priority=")then h=i:sub(12)elseif i=="-t"and b[j+1]then m=b[j+1];j=j+1 elseif i:match("^%-%-tag=")then m=i:sub(7)elseif i=="--"then for q=j+1,#b do a[#a+1]=b[q]end break elseif i=="--help"or i=="-h"then io.write("usage: logger [-p facility.severity] [-t tag] [message ...]\n")return 0 elseif i:sub(1,1)=="-"and i~="-"then d("logger: invalid option '"..i.."'\n")return 1 else a[#a+1]=i end j=j+1 end local c,e=h:match("^([%w]+)%.([%w]+)$")if not c then c,e=h,"notice"end local n=syscalls["syslog.facility"](c)local o=syscalls["syslog.severity"](e)if not n then d("logger: unknown facility '"..c.."'\n")return 1 end if not o then d("logger: unknown severity '"..e.."'\n")return 1 end local p=n*8+o local g=fs.open("/dev/log","w")if not g then d("logger: /dev/log: cannot open\n")return 1 end local function l(r)g:writeLine("<"..p..">"..m..": "..r)end if#a>0 then l(table.concat(a," "))else local f=io.stdin()while true do local k=f and f.readLine and f:readLine()if k==nil then break end l(k)end end g:flush()g:close()return 0