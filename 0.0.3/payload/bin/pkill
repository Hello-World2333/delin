local g=args or{}local function a(o1)local n1=io.stderr()if n1 and n1.write then n1:write(o1)end end local function e(n1)local o1=fs.open(n1,"r")if not o1 then return nil end local p1=o1.readAll()o1.close()return p1 end local function b1(n1)if not n1 or n1==""then return nil end local o1,q1={},0 for p1=1,#n1 do local s1=n1:byte(p1)q1=q1+1 o1[q1]=(s1==0)and" "or n1:sub(p1,p1)end local r1=table.concat(o1,""):gsub("%s+$","")if r1==""then return nil end return r1 end local function i(o1)local q1={}for n1 in o1:gmatch("[^\n]+")do local p1,r1=n1:match("^(%w+):%s*(.*)$")if p1 then q1[p1]=r1 end end return q1 end local function v()local n1=e("/proc/self/stat")if not n1 then return nil end return tonumber(n1:match("^(%d+)"))end local function l()local n1={}for r1,q1 in ipairs(fs.list("/proc")or{})do local o1=tonumber(q1)if o1 then local p1=e("/proc/"..o1.."/comm")if p1 then n1[#n1+1]={pid=o1,comm=(p1:gsub("\n$","")),cmd=b1(e("/proc/"..o1.."/cmdline")),}end end end table.sort(n1,function(s1,t1)return s1.pid<t1.pid end)return n1 end local function j(n1)local o1=tonumber(n1)if o1 then return o1 end local p1=syscalls and syscalls["user.get"]and syscalls["user.get"](n1)if not p1 then return nil end return p1.uid end local function b(n1)local o1=tostring(n1):gsub("^%-","")if o1:match("^%d+$")then return tonumber(o1)end if o1:match("^SIG")then o1=o1:sub(4)end return syscalls["signal.number"](o1)end local x,z,y,r,s=false,false,false,false,false local f=nil local h=15 local c=nil local m=1 while m<=#g do local k=g[m]if k=="--"then m=m+1 if not g[m]then a("pkill: missing pattern\n");return 2 end c=g[m]elseif k:sub(1,2)=="--"then local d1,n=k:match("^%-%-([%w-]+)=?(.*)$")if d1=="signal"then if n==""then m=m+1;n=g[m]end if not n then a("pkill: option '--signal' requires an argument\n");return 2 end h=b(n)if not h then a("pkill: unknown signal "..n.."\n");return 2 end else a("pkill: unrecognized option '"..k.."'\n")return 2 end elseif k:sub(1,1)=="-"and#k>1 then local q=2 while q<=#k do local a1=k:sub(q,q)if a1=="f"then x=true elseif a1=="x"then z=true elseif a1=="v"then y=true elseif a1=="n"then r=true elseif a1=="o"then s=true elseif a1=="s"then local p=k:sub(q+1)if p==""then m=m+1;p=g[m]end if not p then a("pkill: option requires an argument -- 's'\n");return 2 end h=b(p)if not h then a("pkill: unknown signal "..p.."\n");return 2 end q=#k elseif a1=="u"then local o=k:sub(q+1)if o==""then m=m+1;o=g[m]end if not o then a("pkill: option requires an argument -- 'u'\n");return 2 end f=j(o)if f==nil then a("pkill: user '"..o.."' does not exist\n");return 2 end q=#k elseif a1:match("%d")then h=b(k:sub(q))if not h then a("pkill: unknown signal "..k:sub(q).."\n");return 2 end q=#k elseif a1:match("%u")then h=b(k:sub(q))if not h then a("pkill: unknown signal "..k:sub(q).."\n");return 2 end q=#k else a("pkill: invalid option -- '"..a1.."'\n")return 2 end q=q+1 end else if c then a("pkill: too many operands\n");return 2 end c=k end m=m+1 end if not c then a("usage: pkill [-SIGNAL] [-fxvno] [-u user] pattern\n");return 2 end if r and s then a("pkill: -n and -o are mutually exclusive\n");return 2 end local self=v()local d={}for m1,f1 in ipairs(l())do if f1.pid~=self then local u=true if f~=nil then local k1=i(e("/proc/"..f1.pid.."/status")or"")u=(tonumber(k1.Uid)or-1)==f end if u then local e1=x and(f1.cmd or f1.comm)or f1.comm local i1,w=pcall(string.find,e1,z and("^"..c.."$")or c)if not i1 then a("pkill: invalid pattern: "..tostring(w).."\n")return 2 end local c1=w~=nil if c1~=y then d[#d+1]=f1 end end end end if r and#d>0 then d={d[#d]}end if s and#d>0 then d={d[1]}end local t=0 for l1,j1 in ipairs(d)do local h1,g1=syscalls["signal.kill"](j1.pid,h)if h1 then t=t+1 else a("pkill: "..j1.pid..": "..tostring(g1).."\n")end end if t==0 then return 1 end