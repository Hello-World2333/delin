local u=args or{}local z=(type(cwd)=="string"and cwd)or"/"local function b1(l1)l1=l1 or""if l1==""then return(z=="/")and"/"or z end if l1:sub(1,1)=="/"then if l1=="/"then return"/"end return l1:gsub("/+$","")end local k1=(z=="/")and""or z return(k1.."/"..l1):gsub("/+","/")end local function d(l1)local k1=io.stderr()if k1 and k1.write then k1:write(l1)end end local function e1(k1)if k1 and(k1:find("permission")or k1:find("denied"))then return"Permission denied"end if k1 and(k1:find("[Nn]o such")or k1:find("not found"))then return"No such file or directory"end if k1 and k1:lower():find("no such file")then return"No such file or directory"end if k1 and k1:find("directory")then return"Is a directory"end return"No such file or directory"end local k,e,n,i=false,false,false,false local a,b=512,false local h,c,j=math.huge,{},false local function y(k1)if k1=="a"then k=true elseif k1=="s"then e=true elseif k1=="k"then a,b=1024,false elseif k1=="b"then a,b=1,false elseif k1=="h"then a,b=1,true elseif k1=="c"then i=true elseif k1=="x"then n=true else d("du: invalid option -- '"..k1.."'\n");return false end return true end local function f(l1)local k1=tonumber(l1)if not k1 or k1<0 or k1~=math.floor(k1)then d("du: invalid maximum depth '"..tostring(l1).."'\n")return false end h=k1 return true end local d1=1 while d1<=#u do local v=u[d1]if j then c[#c+1]=v elseif v=="--"then j=true elseif v=="--all"then k=true elseif v=="--summarize"then e=true elseif v=="--bytes"then a,b=1,false elseif v=="--human-readable"then a,b=1,true elseif v=="--total"then i=true elseif v=="--one-file-system"then n=true elseif v=="--max-depth"then if not u[d1+1]then d("du: option '--max-depth' requires an argument\n");return 1 end if not f(u[d1+1])then return 1 end d1=d1+1 elseif v:match("^%-%-max%-depth=")then if not f(v:sub(13))then return 1 end elseif v:match("^%-%-block%-size=")then local h1=v:sub(14)local f1=tonumber(h1)if not f1 or f1<1 or f1~=math.floor(f1)then d("du: invalid block size '"..h1.."'\n")return 1 end a,b=f1,false elseif v:sub(1,1)=="-"and v~="-"then for g1=2,#v do if not y(v:sub(g1,g1))then return 1 end end else c[#c+1]=v end d1=d1+1 end if e then h=0 end local function a1(p1)if p1<1024 then return string.format("%d",p1)end local l1={"K","M","G","T","P","E"}local k1,o1=1,p1/1024 while o1>=1024 and k1<#l1 do o1=o1/1024;k1=k1+1 end if o1<10 then local m1=math.ceil(o1*10)/10 if m1<10 then return string.format("%.1f",m1)..l1[k1]end end local n1=math.ceil(o1)if n1>=1024 and k1<#l1 then n1,k1=1,k1+1 end return string.format("%d",n1)..l1[k1]end local function t(k1)return math.ceil(k1/a)*a end local function x(k1,m1,l1)if l1>h then return end local n1=b and a1(k1)or string.format("%d",k1/a)io.write(n1.."\t"..m1.."\n")end local function w(k1)return k1=="/dev"or k1=="/proc"or k1=="/sys"or k1:sub(1,5)=="/dev/"or k1:sub(1,6)=="/proc/"or k1:sub(1,5)=="/sys/"end local function p(l1)local k1=fs.attributes(l1)return k1~=nil and k1.kind=="device"end local function q(l1,k1)if l1=="/"then return"/"..k1 end return l1.."/"..k1 end local function c1(t1,p1,o1,n1,r1)local s1=fs.list(t1)or{}table.sort(s1)local l1=0 for v1,u1 in ipairs(s1)do if u1~="."and u1~=".."then local k1=q(t1,u1)local m1=q(o1,u1)if not w(k1)then if fs.isDir(k1)then if not(n and fs.getDrive(k1)~=r1)then l1=l1+c1(k1,m1,m1,n1+1,r1)end elseif not p(k1)then local q1=t(fs.getSize(k1))if k then x(q1,m1,n1+1)end l1=l1+q1 end end end end x(l1,p1,n1)return l1 end if#c==0 then c={"."}end local m=0 for j1,s in ipairs(c)do if s=="-"then d("du: -: No such file or directory\n")return 1 end local r=b1(s)if not fs.exists(r)then d("du: "..s..": No such file or directory\n")return 1 end local g=s:gsub("/+$","")if g==""then g="/"end local o if fs.isDir(r)then local l=nil if n then l=fs.getDrive(r)if l==nil or l==""then d("du: -x: cannot determine the filesystem of '"..s.."': fs.getDrive returned no drive name\n")return 1 end end o=c1(r,s,g,0,l)else o=t(fs.getSize(r))x(o,s,0)end m=m+o end if i then local i1=b and a1(m)or string.format("%d",m/a)io.write(i1.."\ttotal\n")end