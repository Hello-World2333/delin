local t=args or{}local d1=(type(cwd)=="string"and cwd)or"/"local function e1(u1)u1=u1 or""if u1==""then return(d1=="/")and"/"or d1 end if u1:sub(1,1)=="/"then if u1=="/"then return"/"end return u1:gsub("/+$","")end local t1=(d1=="/")and""or d1 return(t1.."/"..u1):gsub("/+","/")end local function a(u1)local t1=io.stderr()if t1 and t1.write then t1:write(u1)end end local function f1(t1)if t1 and(t1:find("permission")or t1:find("denied"))then return"Permission denied"end if t1 and t1:lower():find("no such file")then return"No such file or directory"end if t1 and t1:find("directory")then return"Is a directory"end return"No such file or directory"end local f,g=1,1 local r,m1={},{}local j={}local k=nil local d=nil local a1=nil local i=false local c={}local m=false local function x(v1)local u1={}for t1 in v1:gmatch("[^,%s]+")do if t1=="0"then u1[#u1+1]={file=0,field=0}else local x1,y1=t1:match("^(%d+)%.(%d+)$")if not x1 then a("join: invalid field specifier: '"..t1.."'\n")return nil end if x1~="1"and x1~="2"then a("join: invalid file number in field spec: '"..t1.."'\n")return nil end local w1=tonumber(y1)if w1<1 then a("join: invalid field number: '"..t1.."'\n")return nil end u1[#u1+1]={file=tonumber(x1),field=w1}end end if#u1==0 then a("join: invalid field list\n")return nil end return u1 end local i1=1 while i1<=#t do local b1=t[i1]if m then c[#c+1]=b1 elseif b1=="--"then m=true elseif b1=="--ignore-case"then i=true elseif b1:match("^%-%-field%-separator=")then local n1=b1:sub(19)if#n1~=1 then a("join: multi-character tab '"..n1.."'\n");return 1 end a1=n1 elseif b1:sub(1,1)=="-"and b1~="-"and b1:sub(1,2)~="--"then local k1=2 while k1<=#b1 do local e=b1:sub(k1,k1)if e=="i"then i=true;k1=k1+1 elseif e=="1"or e=="2"or e=="j"or e=="a"or e=="v"or e=="e"or e=="o"or e=="t"then local h=b1:sub(k1+1)if h==""then i1=i1+1 if not t[i1]then a("join: option requires an argument -- '"..e.."'\n");return 1 end h=t[i1]end if e=="1"or e=="2"or e=="j"then local j1=tonumber(h)if not j1 or j1<1 or j1~=math.floor(j1)then a("join: invalid field number: '"..h.."'\n");return 1 end if e=="1"then f=j1 elseif e=="2"then g=j1 else f,g=j1,j1 end elseif e=="a"or e=="v"then if h~="1"and h~="2"then a("join: invalid file number: '"..h.."'\n");return 1 end local o1=tonumber(h)r[o1]=true if e=="v"then j[o1]=true end elseif e=="e"then k=h elseif e=="o"then d=x(h)if not d then return 1 end else if#h~=1 then a("join: multi-character tab '"..h.."'\n");return 1 end a1=h end k1=#b1+1 else a("join: invalid option -- '"..e.."'\n")return 1 end end elseif b1:sub(1,2)=="--"then a("join: unrecognized option '"..b1.."'\n")return 1 else c[#c+1]=b1 end i1=i1+1 end if#c<2 then a("join: missing operand\n")return 1 end if#c>2 then a("join: extra operand '"..c[3].."'\n")return 1 end local w=a1 or" "local function s(t1)local v1={}if a1 then local u1=1 while true do local w1=t1:find(a1,u1,true)if not w1 then v1[#v1+1]=t1:sub(u1);break end v1[#v1+1]=t1:sub(u1,w1-1)u1=w1+1 end else for x1 in t1:gmatch("%S+")do v1[#v1+1]=x1 end end return v1 end local function v(t1)if t1=="-"then local w1=io.stdin()if not w1 then a("join: 无法读取 stdin\n");return nil end return w1 end local v1,u1=fs.open(e1(t1),"r")if not v1 then a("join: "..t1..": "..f1(u1).."\n")return nil end return v1 end local function l(v1)local x1=v(v1)if not x1 then return nil end local u1,t1=0,nil local w1={name=v1,h=x1}function w1.next()local b2=x1.readLine()if b2==nil then return nil end u1=u1+1 local z1=s(b2)local a2=z1[w1.keyField]if a2==nil then a2=""end local y1=i and a2:lower()or a2 if t1 and y1<t1 then a("join: "..v1..":"..u1..": is not sorted: "..b2.."\n")a("join: input is not in sorted order\n")return nil,true end t1=y1 return{line=b2,fields=z1,key=y1,rawKey=a2}end function w1.close()if v1~="-"then x1:close()end end return w1 end local y=l(c[1])if not y then return 1 end y.keyField=f local z=l(c[2])if not z then return 1 end z.keyField=g local n={}local function u()if#n>0 then io.write(table.concat(n));n={}end end local function q(t1,v1)local u1=t1[v1]if u1==nil then return k or""end return u1 end local function c1(u1,w1)local t1={}if d then for z1,v1 in ipairs(d)do if v1.file==0 then t1[#t1+1]=u1.rawKey elseif v1.file==1 then t1[#t1+1]=q(u1.fields,v1.field)else t1[#t1+1]=q(w1.fields,v1.field)end end else t1[#t1+1]=u1.rawKey for y1=1,#u1.fields do if y1~=f then t1[#t1+1]=u1.fields[y1]end end for x1=1,#w1.fields do if x1~=g then t1[#t1+1]=w1.fields[x1]end end end n[#n+1]=table.concat(t1,w).."\n"if#n>=256 then u()end end local function b(v1,u1)local t1={}if d then for y1,w1 in ipairs(d)do if w1.file==0 then t1[#t1+1]=v1.rawKey elseif w1.file==u1 then t1[#t1+1]=q(v1.fields,w1.field)else t1[#t1+1]=k or""end end else t1[#t1+1]=v1.rawKey for x1=1,#v1.fields do if x1~=(u1==1 and f or g)then t1[#t1+1]=v1.fields[x1]end end end n[#n+1]=table.concat(t1,w).."\n"if#n>=256 then u()end end local o=y.next()local p=z.next()while o~=nil and p~=nil do local l1=false if o.key<p.key then if(r[1]or j[1])then b(o,1)end o=y.next()elseif o.key>p.key then if(r[2]or j[2])then b(p,2)end p=z.next()else local g1,h1={o},{p}o=y.next()while o~=nil and o.key==g1[1].key do g1[#g1+1]=o;o=y.next()end p=z.next()while p~=nil and p.key==h1[1].key do h1[#h1+1]=p;p=z.next()end if not(j[1]or j[2])then for r1,p1 in ipairs(g1)do for s1,q1 in ipairs(h1)do c1(p1,q1)end end end end end while o~=nil do if(r[1]or j[1])then b(o,1)end o=y.next()end while p~=nil do if(r[2]or j[2])then b(p,2)end p=z.next()end u()y.close()z.close()