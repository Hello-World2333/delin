local f=args or{}local function a(i1)local h1=io.stderr()if h1 and h1.write then h1:write(i1)end end local function d(h1)local i1=fs.open(h1,"r")if not i1 then return nil end local j1=i1.readAll()i1.close()return j1 end local function x(h1)if not h1 or h1==""then return nil end local i1,k1={},0 for j1=1,#h1 do local m1=h1:byte(j1)k1=k1+1 i1[k1]=(m1==0)and" "or h1:sub(j1,j1)end local l1=table.concat(i1,""):gsub("%s+$","")if l1==""then return nil end return l1 end local function g(i1)local k1={}for h1 in i1:gmatch("[^\n]+")do local j1,l1=h1:match("^(%w+):%s*(.*)$")if j1 then k1[j1]=l1 end end return k1 end local function n()local h1=d("/proc/self/stat")if not h1 then return nil end return tonumber(h1:match("^(%d+)"))end local function i()local h1={}for l1,k1 in ipairs(fs.list("/proc")or{})do local i1=tonumber(k1)if i1 then local j1=d("/proc/"..i1.."/comm")if j1 then h1[#h1+1]={pid=i1,comm=(j1:gsub("\n$","")),cmd=x(d("/proc/"..i1.."/cmdline")),}end end end table.sort(h1,function(m1,n1)return m1.pid<n1.pid end)return h1 end local function h(h1)local i1=tonumber(h1)if i1 then return i1 end local j1=syscalls and syscalls["user.get"]and syscalls["user.get"](h1)if not j1 then return nil end return j1.uid end local r,u,t,s,q,k,l=false,false,false,false,false,false,false local e=nil local b=nil local p=1 while p<=#f do local v=f[p]if v=="--"then p=p+1 if not f[p]then a("pgrep: missing pattern\n");return 2 end b=f[p]elseif v:sub(1,2)=="--"then a("pgrep: unrecognized option '"..v.."'\n")return 2 elseif v:sub(1,1)=="-"and#v>1 then local z=2 while z<=#v do local w=v:sub(z,z)if w=="f"then r=true elseif w=="x"then u=true elseif w=="v"then t=true elseif w=="l"then s=true elseif w=="a"then q=true elseif w=="n"then k=true elseif w=="o"then l=true elseif w=="u"then local j=v:sub(z+1)if j==""then p=p+1;j=f[p]end if not j then a("pgrep: option requires an argument -- 'u'\n");return 2 end e=h(j)if e==nil then a("pgrep: user '"..j.."' does not exist\n");return 2 end z=#v else a("pgrep: invalid option -- '"..w.."'\n")return 2 end z=z+1 end else if b then a("pgrep: too many operands\n");return 2 end b=v end p=p+1 end if not b then a("usage: pgrep [-flnvoax] [-u user] pattern\n");return 2 end if k and l then a("pgrep: -n and -o are mutually exclusive\n");return 2 end local self=n()local c={}for g1,c1 in ipairs(i())do if c1.pid~=self then local m=true if e~=nil then local e1=g(d("/proc/"..c1.pid.."/status")or"")m=(tonumber(e1.Uid)or-1)==e end if m then local a1=r and(c1.cmd or c1.comm)or c1.comm local d1,o=pcall(string.find,a1,u and("^"..b.."$")or b)if not d1 then a("pgrep: invalid pattern: "..tostring(o).."\n")return 2 end local y=o~=nil if y~=t then c[#c+1]=c1 end end end end if k and#c>0 then c={c[#c]}end if l and#c>0 then c={c[1]}end for f1,b1 in ipairs(c)do if q then io.write(tostring(b1.pid).." "..(b1.cmd or("["..b1.comm.."]")).."\n")elseif s then io.write(tostring(b1.pid).." "..b1.comm.."\n")else io.write(tostring(b1.pid).."\n")end end if#c==0 then return 1 end