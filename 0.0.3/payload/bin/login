local c=args[1]local l=fs.open("/dev/"..(c or""),"rw")if not l then print("login: cannot open /dev/"..tostring(c))return end syscalls["stdio.set"](l,l)syscalls["job.setsid"]()local e=syscalls["job.group"]()syscalls["job.tcsetpgrp"](c,e)syscalls["signal.install"](2,function()end)syscalls["signal.install"](20,function()end)local d=io.stdin()local a=io.stdout()local function b(m)if a and a.write then a:write((m or"").."\n")end end local function j(m)if not fs.exists(m)then return nil end if not fs.canExecute(m)then b("login: "..m..": Permission denied")return nil end local n=fs.open(m,"r")if not n then return nil end local o=n.readAll();n.close()return o end local h=j("/bin/sh")if not h then b("login: /bin/sh not found")return end if not(syscalls and syscalls["user.verify"])then b("login: user.verify syscall not available")return end local k=tonumber((c or""):match("^tty(%d+)$"))local g=k and(k+1)or nil if not g then g="?"end local function f(m)if a and a.write then a:write(m)end if d.setEcho then d:setEcho(false)end local n=d:readLine()if d.setEcho then d:setEcho(true)end return n end local function i()while true do if a and a.write then a:write("\27[0m\27[2J\27[H")end b("Delin OS "..tostring(c).." login:")b("  switch to this console: Ctrl+Alt+"..tostring(g))if a and a.write then a:write("login: ")end local m=d:readLine()if m==nil then return end m=m:gsub("^%s+",""):gsub("%s+$","")if m==""then b("")else local q=f("Password: ")or""if syscalls["user.verify"](m,q)then local o=syscalls["user.get"](m)b("Welcome, "..m.."!")local p={USER=m,LOGNAME=m,PATH="/bin",TERM="linux",HOME=(o and o.home)or"/",SHELL=(o and o.shell)or"/bin/sh",}local n=spawn(h,"sh",o and o.uid or 0,o and o.gid or 0,{[0]="/bin/sh"},{env=p})if not n then b("login: failed to start shell for "..m)else syscalls["proc.wait"](n)syscalls["job.tcsetpgrp"](c,e)end b("")else b("Login incorrect")end end end end i()