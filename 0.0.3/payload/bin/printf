local d1=args or{}local function x(h1)local g1=io.stderr()if g1 and g1.write then g1:write(h1)end end local d={}local s=0 local e=false local function u(g1)x("printf: "..g1.."\n")end local function c(g1)u(g1)s=1 end local function k(g1)u(g1)s=1 e=true end local function g(l1)local q1=l1:match("^%s*")local g1=l1:sub(#q1+1)local m1=(g1:match("%s+$")~=nil)local r1=1 if g1:sub(1,1)=="+"then g1=g1:sub(2)elseif g1:sub(1,1)=="-"then r1=-1;g1=g1:sub(2)end local k1,h1,j1=10,g1,false if g1:match("^0[xX]")then k1,h1,j1=16,g1:sub(3),true elseif#g1>1 and g1:sub(1,1)=="0"then k1,h1=8,g1:sub(2)end local i1 if k1==16 then i1=h1:match("^%x*")elseif k1==8 then i1=h1:match("^[0-7]*")else i1=h1:match("^%d*")end if#i1==0 then if j1 then c("'"..l1.."': needs a hexadecimal number")else c("'"..l1.."': needs a number")end return 0,false end local s1=r1*(tonumber(i1,k1)or 0)local p1=(#i1==#h1)and not m1 if not p1 then c("'"..l1.."': not completely converted")end local o1=2^53 if s1>o1 or s1<-o1 then u("'"..l1.."': numerical result out of range")local n1=2^63 if s1>n1 then s1=n1 elseif s1<-n1 then s1=-n1 end end return s1,p1 end local function q(g1)local k1=tonumber(g1)local h1=(g1:match("%s$")~=nil)local i1=(g1:match("^%s*[+-]?[%d%.eExXa-fA-F]*$")~=nil)if k1~=nil and i1 and not h1 then return k1,true end if k1==nil then local j1=g1:match("^%s*([+-]?%d+%.?%d*[eE][+-]?%d+)")or g1:match("^%s*([+-]?%d*%.?%d+)")or g1:match("^%s*([+-]?%d+)")k1=j1 and tonumber(j1)end if k1==nil then c("'"..g1.."': needs a number")return 0,false end c("'"..g1.."': not completely converted")return k1,false end local a1="0123456789abcdef"local z={[8]="2"..string.rep("0",21),[10]="18446744073709551616",[16]="1"..string.rep("0",16),}local function y(j1,g1)local i1={}for h1=1,#j1 do i1[h1]=tonumber(j1:sub(h1,h1),g1)end return i1 end local function l(i1,g1)if i1==0 then return{0}end local h1={}while i1>0 do local l1=math.floor(i1/g1)h1[#h1+1]=i1-l1*g1 i1=l1 end local k1=#h1 for j1=1,math.floor(k1/2)do h1[j1],h1[k1+1-j1]=h