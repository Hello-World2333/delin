local n1=os.msleep or function(j2)os.sleep(math.max((j2 or 0)/1000,0.05))end local w=os.epoch("utc")local function k(k2)local j2=os.epoch("utc")if j2-w>=50 then w=j2 n1(0)end end local e1=args or{}local k1=(type(cwd)=="string"and cwd)or"/"local function d1(k2)k2=k2 or""if k2==""then return(k1=="/")and"/"or k1 end if k2:sub(1,1)=="/"then if k2=="/"then return"/"end return k2:gsub("/+$","")end local j2=(k1=="/")and""or k1 return(j2.."/"..k2):gsub("/+","/")end local function g(k2)local j2=io.stderr()if j2 and j2.write then j2:write(k2)end end local function p1(j2)if j2 and(j2:find("permission")or j2:find("denied"))then return"Permission denied"end if j2 and j2:lower():find("no such file")then return"No such file or directory"end if j2 and j2:find("directory")then return"Is a directory"end return"No such file or directory"end local u,s1,z,e,o=false,false,false,false,false local c,t,f,h1,l,d,i,b=false,false,false,false,false,false,false,false local g1=false local a={}local n={}local r=false local function j1(j2)if j2=="n"then u=true elseif j2=="i"then s1=true elseif j2=="v"then z=true elseif j2=="w"then e=true elseif j2=="x"then o=true elseif j2=="c"then c=true elseif j2=="l"then t=true elseif j2=="r"or j2=="R"then f=true elseif j2=="q"then h1=true elseif j2=="o"then l=true elseif j2=="H"then d=true elseif j2=="h"then i=true elseif j2=="s"then b=true elseif j2=="F"then g1=true elseif j2=="e"then else g("grep: invalid option -- '"..j2.."'\n");return false end return true end local r1=1 while r1<=#e1 do local p=e1[r1]if r then n[#n+1]=p elseif p=="--"then r=true elseif p=="--line-number"then u=true elseif p=="--ignore-case"then s1=true elseif p=="--invert-match"then z=true elseif p=="--word-regexp"then e=true elseif p=="--line-regexp"then o=true elseif p=="--count"then c=true elseif p=="--files-with-matches"then t=true elseif p=="--recursive"then f=true elseif p=="--quiet"or p=="--silent"then h1=true elseif p=="--only-matching"then l=true elseif p=="--with-filename"then d=true elseif p=="--no-filename"then i=true elseif p=="--no-messages"then b=true elseif p=="--fixed-strings"then g1=true elseif p:sub(1,2)=="--"and p:match("^%-%-regexp=")then a[#a+1]=p:sub(10)elseif p:sub(1,2)=="--"and p:match("^%-%-[a-z][a-z-]+$")then g("grep: unrecognized option '"..p.."'\n");return elseif p:sub(1,1)=="-"and p~="-"then local x=false for z1=2,#p do local v1=p:sub(z1,z1)if v1=="e"then local i1=p:sub(z1+1)if i1~=""then a[#a+1]=i1 else r1=r1+1 if not e1[r1]then g("grep: option requires an argument -- 'e'\n");return end a[#a+1]=e1[r1]end x=true break else if not j1(v1)then return end end end if x then end else n[#n+1]=p end r1=r1+1 end local m={}if#a>0 then for i2,e2 in ipairs(a)do m[#m+1]=e2 end else if#n<1 then g("grep: missing pattern\n");return end m[#m+1]=n[1]table.remove(n,1)end if g1 then for x1,d2 in ipairs(m)do m[x1]=d2:gsub("([^%w])","%%%1")end end local v={}for g2,c2 in ipairs(n)do v[#v+1]=c2 end local function q(j2)return j2~=""and j2:match("[%w_]")~=nil end local function y(j2,p2)local m2=1 while true do local o2,n2=j2:find(p2,m2)if not o2 then return false end local k2=(o2>1)and j2:sub(o2-1,o2-1)or""local l2=(n2<#j2)and j2:sub(n2+1,n2+1)or""if not q(k2)and not q(l2)then return true end m2=n2+1 end end local function c1(j2)for m2,l2 in ipairs(m)do local k2 if o then k2=j2:match("^"..l2.."$")~=nil elseif e then k2=y(j2,l2)else k2=j2:find(l2,1)~=nil end if k2 then return true end end return false end local function s(n2)local l2={}local m2=1 while m2<=#n2+1 do local j2,k2 for r2,q2 in ipairs(m)do local o2,p2=n2:find(q2,m2)if o2 then if(not j2)or o2<j2 then j2,k2=o2,p2 end end end if not j2 then break end l2[#l2+1]={j2,k2}m2=k2+1 end return l2 end local function b1(l2)local j2={}local function k2(q2)if fs.isDir(q2)then local o2=fs.list(q2)or{}table.sort(o2)for s2,r2 in ipairs(o2)do if r2~="."and r2~=".."then local p2=(q2=="/")and("/"..r2)or(q2.."/"..r2)k2(p2)end end else j2[#j2+1]=q2 end end for n2,m2 in ipairs(l2)do k2(d1(m2))end return j2 end local h=v if f then local o1={}for f2,b2 in ipairs(v)do o1[#o1+1]=b2 end h=b1(o1)end local u1=#h>1 local a1=(not i)and(d or u1 or f)local function q1(t2,m2)local k2=0 local s2=0 while true do local l2=t2.readLine()if l2==nil then break end s2=s2+1 local o2=s1 and l2:lower()or l2 local u2=c1(o2)if z then u2=not u2 end if u2 then k2=k2+1 if h1 then return k2,s2 end if t then local q2=(m2 or"").."\n"io.write(q2)k(#q2)return k2,s2 elseif not c then local j2=""if a1 and m2 then j2=m2..":"end if u then j2=j2..tostring(s2)..":"end if l then for v2,n2 in ipairs(s(o2))do local p2=j2..l2:sub(n2[1],n2[2]).."\n"io.write(p2)k(#p2)end else local r2=j2..l2.."\n"io.write(r2)k(#r2)end end end end return k2,s2 end local f1=false local function j(j2,k2)local l2=q1(k2,j2)if l2>0 then f1=true end if c then if a1 and j2 then io.write(j2..":")end io.write(tostring(l2).."\n")end end if#h==0 then local l1=io.stdin()if l1 then j("standard input",l1)end else for h2,a2 in ipairs(h)do if a2=="-"then local m1=io.stdin()if m1 then j("standard input",m1)end else local y1=d1(a2)if not fs.exists(y1)then if not b then g("grep: "..y1..": No such file or directory\n")end if c then io.write("0\n")end else local t1,w1=fs.open(y1,"r")if not t1 then if not b then g("grep: "..y1..": "..p1(w1).."\n")end if c then io.write("0\n")end else j(y1,t1)t1.close()end end end end end