local y=args or{}local q1=(type(cwd)=="string"and cwd)or"/"local function t1(n2)n2=n2 or""if n2==""then return(q1=="/")and"/"or q1 end if n2:sub(1,1)=="/"then if n2=="/"then return"/"end return n2:gsub("/+$","")end local m2=(q1=="/")and""or q1 return(m2.."/"..n2):gsub("/+","/")end local function d(n2)local m2=io.stderr()if m2 and m2.write then m2:write(n2)end end local function u1(m2)if m2 and(m2:find("permission")or m2:find("denied"))then return"Permission denied"end if m2 and m2:lower():find("no such file")then return"No such file or directory"end if m2 and m2:find("directory")then return"Is a directory"end return"No such file or directory"end local f=1 local b,n,p=false,false,false local m1=nil local g=66 local o,d1,s=false,"\t",5 local h=0 local e=nil local k1=72 local q=false local u,w=1,nil local m={}local b1=false local function a1(o2)local m2,n2=o2:match("^%+(%d+):(%d+)$")if m2 then u,w=tonumber(m2),tonumber(n2);return true end local p2=o2:match("^%+(%d+)$")if p2 then u=tonumber(p2);return true end return false end local x1=1 while x1<=#y do local c1=y[x1]if c1=="--"then for j2=x1+1,#y do m[#m+1]=y[j2]end break elseif c1:match("^%+%d")then if not a1(c1)then d("pr: invalid page range '"..c1.."'\n")return 1 end elseif c1=="-t"or c1=="--omit-header"then p=true elseif c1=="-d"or c1=="--double-space"then b=true elseif c1=="-F"or c1=="--form-feed"then n=true elseif c1:match("^%-%-")then d("pr: unrecognized option '"..c1.."'\n")return 1 elseif c1:sub(1,1)=="-"and c1~="-"then local p1=2 while p1<=#c1 do local v=c1:sub(p1,p1)if v:match("%d")then local v1=c1:match("^(%d+)$",p1)if not v1 then d("pr: invalid number of columns: '"..c1:sub(p1).."'\n");return 1 end f=tonumber(v1)if f<1 then d("pr: invalid number of columns: '"..v1.."'\n");return 1 end p1=#c1+1 elseif v=="d"then b=true;p1=p1+1 elseif v=="F"then n=true;p1=p1+1 elseif v=="t"then p=true;p1=p1+1 elseif v=="h"or v=="l"or v=="o"or v=="w"then local z=c1:sub(p1+1)if z==""then x1=x1+1 if not y[x1]then d("pr: option requires an argument -- '"..v.."'\n");return 1 end z=y[x1]end if v=="h"then m1=z else local c2=tonumber(z)if not c2 then d("pr: invalid number: '"..z.."'\n");return 1 end if v=="l"then if c2<1 then d("pr: invalid number of lines: '"..z.."'\n");return 1 end g=c2 elseif v=="o"then if c2<0 then d("pr: invalid number: '"..z.."'\n");return 1 end h=c2 else if c2<1 then d("pr: invalid number of columns: '"..z.."'\n");return 1 end k1=c2 q=true end end p1=#c1+1 elseif v=="n"or v=="s"then local e1=c1:sub(p1+1)if v=="n"then o=true if e1~=""then local b2,y1=e1:match("^(.)(%d*)$")if b2 then d1=b2 if y1~=""then s=tonumber(y1)end else d("pr: invalid number of digits: '"..e1.."'\n");return 1 end end else if e1==""then e="\t"else e=e1 end end p1=#c1+1 else d("pr: invalid option -- '"..v.."'\n")return 1 end end else m[#m+1]=c1 b1=true end x1=x1+1 end if#m==0 then m={"-"}end if f<1 then d("pr: invalid number of columns: '"..f.."'\n")return 1 end local j=(not p)and g>=10 local f1=j and 5 or 0 local a if j then a=g-10 if b then a=math.floor(a/2)end if a<1 then a=1 end else a=g if b then a=math.floor(a/2)end if a<1 then a=1 end end local c if e and not q then c=0 else c=math.floor((k1-1)/f)end local function n1(m2)if m2=="-"then local p2=io.stdin()if not p2 then d("pr: 无法读取 stdin\n");return nil end return p2 end local o2,n2=fs.open(t1(m2),"r")if not o2 then d("pr: "..m2..": "..u1(n2).."\n")return nil end return o2 end local h1={}local function r1()if#h1>0 then io.write(table.concat(h1));h1={}end end local function k(m2)h1[#h1+1]=m2 if#h1>=512 then r1()end end local function x(q2,o2)local m2={}local p2=q2 while true do local n2=p2+(8-p2%8)if n2<=o2 then m2[#m2+1]="\t";p2=n2 else break end end if p2<o2 then m2[#m2+1]=string.rep(" ",o2-p2)end return table.concat(m2),o2 end local function o1(w2,p2)if f==1 then for c3,i3 in ipairs(w2)do local r2=""if h>0 then r2=string.rep(" ",h)end if o then local j3=p2+c3-1 r2=r2..string.format("%"..s.."d",j3)..d1 end k(r2..i3.."\n")if b then k("\n")end end return end local q2=math.ceil(#w2/f)if q2<1 then q2=1 end local v2=e and#e or 0 local a3=c+(e and v2 or 1)for k3=1,q2 do local n2={}local o2=0 if h>0 then n2[#n2+1]=string.rep(" ",h)o2=h end local t2=false for d3=0,f-1 do local b3=d3*q2+k3 local x2=w2[b3]if x2==nil then t2=true break end local u2=h+d3*a3 if d3>0 then if e then local y2=u2-v2 if o2<y2 then local h3,f3=x(o2,y2)n2[#n2+1]=h3 o2=f3 end n2[#n2+1]=e o2=o2+v2 else local g3,e3=x(o2,u2)n2[#n2+1]=g3 o2=e3 end end local s2=""if o then s2=string.format("%"..s.."d",p2+b3-1)..d1 end local m2=s2..x2 if c>0 and#m2>c then m2=m2:sub(1,c)end n2[#n2+1]=m2 o2=o2+#m2 end local z2=table.concat(n2)if z2:match("%S")or not t2 then k(z2.."\n")end if b then k("\n")end end end local l=0 local a2=os.date("%Y-%m-%d %H:%M")local function g1(r2)local m2=m1 if m2==nil then m2=r2 end local n2="Page "..l local o2=k1-16-#n2 local p2=string.rep(" ",h)k(p2.."\n\n")if o2<#m2 then k(p2..a2.." "..m2.." "..n2.."\n")else local q2=math.floor((o2-#m2)/2)local s2=o2-#m2-q2 k(p2..a2..string.rep(" ",q2)..m2..string.rep(" ",s2)..n2.."\n")end k("\n\n")end local function j1(n2)local m2=nil return function()if m2~=nil then local o2=m2;m2=nil;return o2 end return n2.readLine()end,function(o2)m2=o2 end end for k2,g2 in ipairs(m)do local h2=n1(g2)if not h2 then return 1 end local d2=(g2=="-")and""or g2 local w1=j1(h2)local z1=false local r=1 l=0 local l1=true while true do local t={}local f2=a*f while#t<f2 do local i2=w1()if i2==nil then z1=true;break end l1=false t[#t+1]=i2 end if#t==0 then break end l=l+1 local s1=(l>=u)and(w==nil or l<=w)if s1 then if j then g1(d2)end o1(t,r)r=r+#t if j and not n then local i1=math.ceil(#t/f)local e2=f1+i1+(b and i1 or 0)local i=g if b and i%2==1 then i=i+1 end for l2=e2+1,i do k("\n")end end if n then k("\f")end else r=r+#t end if z1 then break end end if g2~="-"then h2:close()end end r1()