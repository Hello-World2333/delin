local j=args or{}local function b(a1)local z=io.stderr()if z and z.write then z:write(a1)end end local function f(z)if z then b("useradd: "..z.."\n")end b("usage: useradd [-u UID] [-g GROUP] [-G GROUPLIST] [-d HOME] [-s SHELL] [-c COMMENT] [-m] name\n")return 2 end if not(syscalls and syscalls["user.addUser"])then b("useradd: user syscalls not available\n")return 1 end local a={m=false}local c,i=nil,false local r=1 while r<=#j do local n=j[r]if i then if c then return f("extra operand '"..n.."'")end c=n elseif n=="--"then i=true elseif n:sub(1,1)=="-"and n~="-"then local p=2 while p<=#n do local g=n:sub(p,p)if g=="m"then a.m=true;p=p+1 elseif g=="M"then a.m=false;p=p+1 elseif g=="u"or g=="g"or g=="G"or g=="d"or g=="s"or g=="c"then local d=n:sub(p+1)if d==""then r=r+1 d=j[r]end if d==nil then return f("option requires an argument -- '"..g.."'")end if g=="u"then if not d:match("^%d+$")then return f("invalid user ID '"..d.."'")end a.u=tonumber(d)elseif g=="g"then a.g=d elseif g=="G"then a.G=d elseif g=="d"then a.d=d elseif g=="s"then a.s=d else a.c=d end p=#n+1 else return f("invalid option -- '"..g.."'")end end else if c then return f("extra operand '"..n.."'")end c=n end r=r+1 end if not c then return f("no user name given")end local t=c local e={name=t}if a.u then e.uid=a.u end if a.d then e.home=a.d end if a.s then e.shell=a.s end if a.c then e.full=a.c end if a.g then if a.g:match("^%d+$")then e.gid=tonumber(a.g)else local x=syscalls["user.groupByName"](a.g)if not x then b("useradd: group '"..a.g.."' does not exist\n");return 1 end e.gid=x.gid end end if a.G then e.groups={}for k in(a.G..","):gmatch("([^,]*),")do if k~=""then e.groups[#e.groups+1]=k end end for y,l in ipairs(e.groups)do if not syscalls["user.groupByName"](l)then b("useradd: group '"..l.."' does not exist\n")return 1 end end end local m,u=syscalls["user.addUser"](e)if not m then b("useradd: "..tostring(u).."\n")return 1 end if a.m then local h=m.home local function o(b1)local z=""for c1 in b1:gmatch("[^/]+")do z=z.."/"..c1 if not fs.exists(z)then local d1,a1=fs.makeDir(z)if not d1 and not fs.exists(z)then return nil,tostring(a1 or"mkdir failed")end end end return true end if not fs.exists(h)then local v,s=o(h)if not v then b("useradd: cannot create home directory '"..h.."': "..tostring(s).."\n")return 1 end end local w,q=fs.chown(h,m.uid,m.gid)if not w then b("useradd: cannot chown home directory '"..h.."': "..tostring(q).."\n")return 1 end end return 0