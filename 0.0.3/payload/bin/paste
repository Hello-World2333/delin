local h=args or{}local q=(type(cwd)=="string"and cwd)or"/"local function r(m1)m1=m1 or""if m1==""then return(q=="/")and"/"or q end if m1:sub(1,1)=="/"then if m1=="/"then return"/"end return m1:gsub("/+$","")end local l1=(q=="/")and""or q return(l1.."/"..m1):gsub("/+","/")end local function b(m1)local l1=io.stderr()if l1 and l1.write then l1:write(m1)end end local function v(l1)if l1 and(l1:find("permission")or l1:find("denied"))then return"Permission denied"end if l1 and l1:lower():find("no such file")then return"No such file or directory"end if l1 and l1:find("directory")then return"Is a directory"end return"No such file or directory"end local function d(m1)local l1,n1={},1 while n1<=#m1 do local p1=m1:sub(n1,n1)if p1=="\\"then local o1=m1:sub(n1+1,n1+1)if o1==""then b("paste: delimiter list ends with an unescaped backslash: "..m1.."\n")return nil end if o1=="n"then l1[#l1+1]="\n"elseif o1=="t"then l1[#l1+1]="\t"elseif o1=="\\"then l1[#l1+1]="\\"elseif o1=="0"then l1[#l1+1]=""elseif o1=="r"then l1[#l1+1]="\r"else l1[#l1+1]=o1 end n1=n1+2 else l1[#l1+1]=p1 n1=n1+1 end end if#l1==0 then b("paste: empty delimiter list\n")return nil end return l1 end local a={"\t"}local l,f=false,false local c={}local g=false local s=1 while s<=#h do local m=h[s]if g then c[#c+1]=m elseif m=="--"then g=true elseif m=="-s"or m=="--serial"then l=true elseif m=="-z"or m=="--zero-terminated"then f=true elseif m=="-d"or m=="--delimiters"then s=s+1 if not h[s]then b("paste: option requires an argument -- 'd'\n");return 1 end a=d(h[s])if not a then return 1 end elseif m:match("^%-%-delimiters=")then a=d(m:sub(14))if not a then return 1 end elseif m:sub(1,1)=="-"and m~="-"and m:sub(1,2)~="--"then local z=2 while z<=#m do local y=m:sub(z,z)if y=="s"then l=true;z=z+1 elseif y=="z"then f=true;z=z+1 elseif y=="d"then local x=m:sub(z+1)if x==""then s=s+1 if not h[s]then b("paste: option requires an argument -- 'd'\n");return 1 end x=h[s]end a=d(x)if not a then return 1 end z=#m+1 else b("paste: invalid option -- '"..y.."'\n")return 1 end end elseif m:sub(1,2)=="--"then b("paste: unrecognized option '"..m.."'\n")return 1 else c[#c+1]=m end s=s+1 end if#c==0 then c={"-"}end local c1=f and"\0"or"\n"local w=io.stdout()local p=0 local function i()p=p+1 return a[(p-1)%#a+1]end local function j(l1)if l1=="-"then local o1=io.stdin()if not o1 then b("paste: 无法读取 stdin\n");return nil end return o1 end local n1,m1=fs.open(r(l1),"r")if not n1 then b("paste: "..l1..": "..v(m1).."\n")return nil end return n1 end local function o(n1)local o1=j(n1)if not o1 then return false end local m1=true local l1={}while true do local p1=o1.readLine()if p1==nil then break end if m1 then l1[#l1+1]=p1;m1=false else l1[#l1+1]=i();l1[#l1+1]=p1 end end if n1~="-"then o1:close()end l1[#l1+1]=c1 w:write(table.concat(l1))return true end if l then for k1,j1 in ipairs(c)do if not o(j1)then return 1 end end return end local e={}for d1,h1 in ipairs(c)do local f1=j(h1)if not f1 then return 1 end e[d1]=f1 end local t=false while not t do local n,a1={},false for u=1,#e do local g1=e[u].readLine()if g1==nil then n[u]=nil else n[u]=g1;a1=true end end if not a1 then t=true else local k={}for b1=1,#e do if b1>1 then k[#k+1]=i()end k[#k+1]=n[b1]or""end k[#k+1]=c1 w:write(table.concat(k))end end for e1,i1 in ipairs(c)do if i1~="-"then e[e1]:close()end end