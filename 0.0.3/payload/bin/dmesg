local h=args or{}local function c(n)local m=io.stderr()if m and m.write then m:write(n)end end local b=false for l,g in ipairs(h)do if g=="-x"or g=="--decode"then b=true elseif g=="--help"or g=="-h"then io.write("usage: dmesg [-x]\n")return 0 elseif g:sub(1,1)=="-"and g~="-"then c("dmesg: invalid option '"..g.."'\n")return 1 end end local k=fs.open("/dev/kmsg","r")if not k then c("dmesg: /dev/kmsg: cannot open\n")return 1 end while true do local d=k:readAvailable()if not d or d==""then break end for e in d:gmatch("[^\n]+")do local f,j,i=e:match("^(%d+),%d+,(%d+),%-?%d*;(.*)$")if f then local a=string.format("[%12.6f] ",tonumber(j)/1000000)if b then a=a..syscalls["syslog.facilityName"](math.floor(tonumber(f)/8)).."."..syscalls["syslog.severityName"](tonumber(f)%8)..": "end io.write(a..i.."\n")else io.write(e.."\n")end end end k:close()return 0