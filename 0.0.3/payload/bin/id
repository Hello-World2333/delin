local r=args or{}local function e(a1)local z=io.stderr()if z and z.write then z:write(a1)end end local function f(z)if z then e("id: "..z.."\n")end e("usage: id [-u] [-g] [-G] [-n] [-r] [USER]\n")return 2 end local d,k,a,o=nil,false,nil,false for y,q in ipairs(r)do if o then if a then return f("extra operand '"..q.."'")end a=q elseif q=="--"then o=true elseif q:sub(1,1)=="-"and q~="-"then for v=2,#q do local n=q:sub(v,v)if n=="u"or n=="g"or n=="G"then if d and d~=n then return f("cannot print \"only\" of more than one choice")end d=n elseif n=="n"then k=true elseif n=="r"then else return f("invalid option -- '"..n.."'")end end else if a then return f("extra operand '"..q.."'")end a=q end end if k and not d then return f("cannot print only names in default format")end if not(syscalls and syscalls["user.byUid"]and syscalls["user.groupByName"])then e("id: user syscalls not available\n")return 1 end local b,m if a then b=syscalls["user.get"](a)if not b then e("id: '"..a.."': no such user\n")return 1 end m=b.uid else m=uid b=syscalls["user.byUid"](uid)end local c=b and b.gid if c==nil then c=gid end local function g()local a1={}local z=syscalls["user.groupByGid"]and syscalls["user.groupByGid"](c)a1[#a1+1]={gid=c,name=z and z.name or nil}if b and syscalls["user.groupsOf"]then for d1,b1 in ipairs(syscalls["user.groupsOf"](b.name)or{})do local c1=syscalls["user.groupByName"](b1)if c1 and c1.gid~=c then a1[#a1+1]={gid=c1.gid,name=b1}end end end return a1 end local function p(a1,z)return z and(a1.."("..z..")")or tostring(a1)end local function j(a1,z)if k then return tostring(z or a1)end return tostring(a1)end if d=="u"then io.write(j(m,b and b.name).."\n")elseif d=="g"then local i=syscalls["user.groupByGid"]and syscalls["user.groupByGid"](c)io.write(j(c,i and i.name).."\n")elseif d=="G"then local l={}for w,u in ipairs(g())do l[#l+1]=j(u.gid,u.name)end io.write(table.concat(l," ").."\n")else local h=g()local s={}for x,t in ipairs(h)do s[#s+1]=p(t.gid,t.name)end io.write("uid="..p(m,b and b.name).." gid="..p(c,h[1]and h[1].name).." groups="..table.concat(s,",").."\n")end return 0