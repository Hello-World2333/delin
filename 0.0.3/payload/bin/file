local t1=args or{}local i1=(type(cwd)=="string"and cwd)or"/"local function k1(e2)e2=e2 or""if e2==""then return(i1=="/")and"/"or i1 end if e2:sub(1,1)=="/"then if e2=="/"then return"/"end return e2:gsub("/+$","")end local d2=(i1=="/")and""or i1 return(d2.."/"..e2):gsub("/+","/")end local function b(e2)local d2=io.stderr()if d2 and d2.write then d2:write(e2)end end local function n1(d2)if d2 and(d2:find("permission")or d2:find("denied"))then return"Permission denied"end if d2 and(d2:find("[Nn]o such")or d2:find("not found"))then return"No such file or directory"end if d2 and d2:lower():find("no such file")then return"No such file or directory"end if d2 and d2:find("directory")then return"Is a directory"end return"No such file or directory"end local s1=fs.lstat or fs.attributes local w=fs.readlink local f=5120 local l,a,t,k,o=false,false,false,false,false local j={}local n=false local function h1(d2)if d2=="b"then l=true elseif d2=="L"then a=true elseif d2=="h"then a=false elseif d2=="i"then t=true else b("file: invalid option -- '"..d2.."'\n");return false end return true end for c2,g1 in ipairs(t1)do if n then j[#j+1]=g1 elseif g1=="--"then n=true elseif g1=="--brief"then l=true elseif g1=="--dereference"then a=true elseif g1=="--no-dereference"then a=false elseif g1=="--mime"then t=true elseif g1=="--mime-type"then k=true elseif g1=="--mime-encoding"then o=true elseif g1:sub(1,2)=="--"then b("file: unrecognized option '"..g1.."'\n");return 1 elseif g1:sub(1,1)=="-"and g1~="-"then for z1=2,#g1 do if not h1(g1:sub(z1,z1))then return 1 end end else j[#j+1]=g1 end end if#j==0 then b("Usage: file [-bLhi] FILE...\n")return 1 end local function c1(g2,d2)local e2,f2=g2:byte(d2+1),g2:byte(d2+2)if not e2 or not f2 then return nil end return e2+f2*256 end local function d1(e2,d2)local f2,g2,h2,i2=e2:byte(d2+1),e2:byte(d2+2),e2:byte(d2+3),e2:byte(d2+4)if not f2 or not g2 or not h2 or not i2 then return nil end return((i2*256+h2)*256+g2)*256+f2 end local function m1(e2,d2)local f2,g2,h2,i2=e2:byte(d2+1),e2:byte(d2+2),e2:byte(d2+3),e2:byte(d2+4)if not f2 or not g2 or not h2 or not i2 then return nil end return((f2*256+g2)*256+h2)*256+i2 end local function z(f2)if not f2:find("[^\32-\126]")then return f2 end local d2={}for g2=1,#f2 do local e2=f2:byte(g2)if e2>=32 and e2<=126 then d2[#d2+1]=string.char(e2)else d2[#d2+1]=string.format("\\%03o",e2)end end return table.concat(d2)end local function m(d2)if d2>=32 and d2<=126 then return true end return d2==9 or d2==10 or d2==13 or d2==12 or d2==8 or d2==27 end local function o1(h2,e2)local f2,j2=1,#h2 while f2<=j2 do local g2=h2:byte(f2)if g2<128 then f2=f2+1 else local d2 if g2>=194 and g2<=223 then d2=2 elseif g2>=224 and g2<=239 then d2=3 elseif g2>=240 and g2<=244 then d2=4 else return false end if f2+d2-1>j2 then return e2 end for k2=1,d2-1 do local i2=h2:byte(f2+k2)if i2<128 or i2>191 then return false end end f2=f2+d2 end end return true end local function a1(j2,e2)local d2,f2=0,1 while true do local i2=j2:find("\n",f2,true)if not i2 then break end local g2=i2-f2 if g2>d2 then d2=g2 end f2=i2+1 end if not e2 then local h2=#j2-f2+1 if h2>d2 then d2=h2 end end return d2 end local function u(g2,e2)if e2 and g2:sub(-1)=="\r"then g2=g2:sub(1,-2)end local f2=0 for h2 in g2:gmatch("\n")do f2=f2+1 end if f2==0 then if g2:find("\r",1,true)then return"with CR line terminators"end return"with no line terminators"end local d2=0 for i2 in g2:gmatch("\r\n")do d2=d2+1 end if d2==0 then return nil end if d2==f2 then return"with CRLF line terminators"end return"with CRLF, LF line terminators"end local function g(n2,d2)local m2,k2,j2,i2=false,0,0,false for p2=1,#n2 do local o2=n2:byte(p2)if o2==0 then m2=true;break end if o2>=128 then j2=j2+1 if o2<160 then i2=true end elseif not m(o2)then k2=k2+1 end end if m2 then return{binary=true}end if k2*10>#n2*3 then return{binary=true}end local f2,g2 if j2==0 then f2,g2="ASCII text","us-ascii"elseif o1(n2,d2)then g2="utf-8"if n2:sub(1,3)=="\239\187\191"then f2="Unicode text, UTF-8 (with BOM) text"else f2="Unicode text, UTF-8 text"end elseif i2 then f2,g2="Non-ISO extended-ASCII text","unknown-8bit"else f2,g2="ISO-8859 text","iso-8859-1"end local e2={}local h2=a1(n2,d2)if h2>300 then e2[#e2+1]="with very long lines ("..h2..")"end local l2=u(n2,d2)if l2 then e2[#e2+1]=l2 end return{binary=false,base=f2,enc=g2,notes=(#e2>0)and(", "..table.concat(e2,", "))or"",}end local l1={{match="sh",dirs={["/bin"]=true},desc="POSIX shell script",mime="text/x-shellscript"},{match="ksh",dirs={["/bin"]=true},desc="Korn shell script",mime="text/x-shellscript"},{match="dash",dirs={["/bin"]=true,["/usr/bin"]=true},desc="Dash shell script",mime="text/x-shellscript"},{match="bash",dirs={["/bin"]=true,["/usr/bin"]=true,["/usr/local/bin"]=true},env=true,desc="Bourne-Again shell script",mime="text/x-shellscript"},{match="zsh",dirs={["/bin"]=true,["/usr/bin"]=true,["/usr/local/bin"]=true},env=true,desc="Paul Falstad's zsh script",mime="text/x-shellscript"},{match="tcsh",dirs={["/bin"]=true,["/usr/bin"]=true,["/usr/local/bin"]=true},env=true,desc="Tenex C shell script",mime="text/x-shellscript"},{match="fish",dirs={["/usr/bin"]=true,["/usr/local/bin"]=true},env=true,desc="fish shell script",mime="text/x-shellscript"},{match="python",prefix=true,dirs={["/usr/bin"]=true,["/usr/local/bin"]=true},env=true,desc="Python script",mime="text/x-script.python"},{match="lua",prefix=true,dirs={["/usr/bin"]=true,["/usr/local/bin"]=true},env=true,desc="Lua script",mime="text/x-lua"},{match="ruby",dirs={["/usr/bin"]=true,["/usr/local/bin"]=true},env=true,desc="Ruby script",mime="text/x-ruby"},{match="php",dirs={["/usr/bin"]=true,["/usr/local/bin"]=true},env=true,desc="PHP script",mime="text/x-php"},{match="awk",dirs={["/bin"]=true,["/usr/bin"]=true},env=true,desc="awk script",mime="text/x-awk"},{match="perl",dirs={["/bin"]=true,["/usr/bin"]=true,["/usr/local/bin"]=true},env=true,desc="Perl script",mime="text/x-perl",glue=true},}local function b1(d2,e2)if d2.prefix then return e2:sub(1,#d2.match)==d2.match end return e2==d2.match end local function i(e2,f2,d2)for h2,g2 in ipairs(l1)do if b1(g2,e2)then if d2 then if g2.env then return g2 end elseif g2.dirs[f2]then return g2 end end end return nil end local function v(s2,k2)local f2=s2:match("^#!(.-)[\r\n]")or s2:sub(3)f2=f2:gsub("^%s+",""):gsub("%s+$","")local i2=f2:match("^%S+")or""local m2=i2:match("([^/]+)$")or i2 local l2,d2,p2=f2,nil,false if m2=="env"then p2=true local q2=f2:match("^%S+%s+(.*)$")or""l2=q2:gsub("%s+$","")local o2=l2:match("^%S+")if o2 then d2=i(o2:match("([^/]+)$")or o2,nil,true)end else local r2=i2:match("^(.*)/[^/]+$")or""d2=i(m2,r2,false)end local g2=g(s2,k2)local h2,e2,j2 if d2 and d2.glue then h2=d2.desc.." text executable"e2=d2.mime j2=g2.binary and"binary"or g2.enc else local n2=d2 and d2.desc or("a "..z(l2).." script")if g2.binary then h2=n2.." executable (binary data)"e2=d2 and d2.mime or"application/octet-stream"j2="binary"else h2=n2..", "..g2.base.." executable"..g2.notes e2=d2 and d2.mime or"text/plain"j2=g2.enc end end return{desc=h2,mtype=e2,menc=j2}end local e1={[0]="grayscale",[2]="color RGB",[3]="colormap",[4]="gray+alpha",[6]="color RGBA"}local f1={[2]=true,[6]=true}local function r1(i2,f2)local d2={}for h2=0,15 do local g2=i2:byte(f2+h2+1)if not g2 then return nil end d2[#d2+1]=string.format("%02x",g2)end local e2=table.concat(d2)return e2:sub(1,8).."-"..e2:sub(9,12).."-"..e2:sub(13,16).."-"..e2:sub(17,20).."-"..e2:sub(21,32)end local function y(e2)if e2:sub(1,8)=="\137PNG\r\n\26\n"then local k2="PNG image data"if e2:sub(13,16)=="IHDR"then local z2,y2=m1(e2,16)or 0,m1(e2,20)or 0 local u2,q2=e2:byte(25)or 0,e2:byte(26)or 0 local n2=e1[q2]or"unknown"local t2=f1[q2]and"/"or" "local v2=(e2:byte(29)==1)and"interlaced"or"non-interlaced"k2=k2..", "..z2.." x "..y2..", "..u2.."-bit"..t2..n2..", "..v2 end return{desc=k2,mtype="image/png",menc="binary"}end if e2:sub(1,3)=="\255\216\255"then return{desc="JPEG image data",mtype="image/jpeg",menc="binary"}end local g2=e2:match("^GIF(87a)")or e2:match("^GIF(89a)")if g2 then local f2="GIF image data, version "..g2 if#e2>=10 then f2=f2..", "..c1(e2,6).." x "..c1(e2,8)else f2=f2..","end return{desc=f2,mtype="image/gif",menc="binary"}end if e2:sub(1,2)=="BM"then local j2="PC bitmap"local x2,w2,o2=d1(e2,18),d1(e2,22),c1(e2,28)if d1(e2,14)==40 and x2 and w2 and o2 then j2=j2..", Windows 3.x format, "..x2.." x "..w2.." x "..o2 end return{desc=j2,mtype="image/bmp",menc="binary"}end if e2:sub(1,2)=="\31\139"then local i2="gzip compressed data"if e2:byte(10)==3 then i2=i2..", from Unix"end return{desc=i2,mtype="application/gzip",menc="binary"}end if e2:sub(1,5)=="%PDF-"then local p2=e2:match("^%%PDF%-(%d%.%d)")local h2="PDF document"if p2 then h2=h2..", version "..p2 end return{desc=h2,mtype="application/pdf",menc="iso-8859-1"}end local r2=e2:sub(1,4)if r2=="PK\3\4"then return{desc="Zip archive data",mtype="application/zip",menc="binary"}end if r2=="PK\5\6"then return{desc="Zip archive data (empty)",mtype="application/zip",menc="binary"}end if e2:sub(1+0x438,2+0x438)=="\83\239"then local s2=d1(e2,0x44C)or 0 local l2=c1(e2,0x43A)or 0 local d2="Linux rev "..s2..".0 ext2 filesystem data"if l2~=1 then d2=d2.." (mounted or unclean)"end local m2=r1(e2,0x468)if m2 then d2=d2..", UUID="..m2 end if l2==2 then d2=d2.." (errors)"end return{desc=d2,mtype="application/octet-stream",menc="binary"}end return nil end local function d(f2,d2)if#f2==1 then return{desc="very short file (no magic)",mtype="application/octet-stream",menc="binary"}end if f2:sub(1,2)=="#!"then return v(f2,d2)end local g2=y(f2)if g2 then return g2 end local e2=g(f2,d2)if e2.binary then return{desc="data",mtype="application/octet-stream",menc="binary"}end return{desc=e2.base..e2.notes,mtype="text/plain",menc=e2.enc}end local function p(g2)local f2,e2={},0 while e2<f do local d2=g2.read(f-e2)if not d2 or d2==""then break end f2[#f2+1]=d2 e2=e2+#d2 end return table.concat(f2)end local function q()local e2=io.stdin()if not