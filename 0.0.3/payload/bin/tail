local e=args or{}local p=(type(cwd)=="string"and cwd)or"/"local function r(e1)e1=e1 or""if e1==""then return(p=="/")and"/"or p end if e1:sub(1,1)=="/"then if e1=="/"then return"/"end return e1:gsub("/+$","")end local d1=(p=="/")and""or p return(d1.."/"..e1):gsub("/+","/")end local function d(e1)local d1=io.stderr()if d1 and d1.write then d1:write(e1)end end local function u(d1)if d1 and(d1:find("permission")or d1:find("denied"))then return"Permission denied"end if d1 and d1:lower():find("no such file")then return"No such file or directory"end if d1 and d1:find("directory")then return"Is a directory"end return"No such file or directory"end local y,v=10,"lines"local b={}local i,f=false,false local c=false local function a(d1,f1)local e1=tonumber((d1:match("%s*%-?(%d+)"))or d1)if e1 and e1>=0 then y=e1;v=f1 end end local s=1 while s<=#e do local h=e[s]if c then b[#b+1]=h elseif h=="--"then c=true elseif h=="--quiet"or h=="--silent"then i=true elseif h=="--verbose"then f=true elseif h=="-q"then i=true elseif h=="-v"then f=true elseif h:sub(1,2)=="--"and h:match("^%-%-lines=")then a(h:sub(9),"lines")elseif h:sub(1,2)=="--"and h:match("^%-%-bytes=")then a(h:sub(9),"bytes")elseif h:sub(1,1)=="-"and h~="-"then local o=h:match("^%-n(.*)$")local n=h:match("^%-c(.*)$")local g=h:match("^%-(%d+)$")if o then if o==""then s=s+1 if not e[s]then d("tail: option requires an argument -- 'n'\n");return end a(e[s],"lines")else a(o,"lines")end elseif n then if n==""then s=s+1 if not e[s]then d("tail: option requires an argument -- 'c'\n");return end a(e[s],"bytes")else a(n,"bytes")end elseif g then a(g,"lines")else d("tail: invalid option -- '"..h.."'\n")return 1 end else b[#b+1]=h end s=s+1 end if#b==0 then b={"-"}end local x=#b local j=(not i)and(x>1 or f)local function m(d1)if not j then return end local e1=(d1=="-")and"standard input"or d1 io.write("==> "..e1.." <==\n")end local function l(g1)local d1={}while true do local e1=g1.readLine()if e1==nil then break end d1[#d1+1]=e1 end local f1=math.max(1,#d1-y+1)if y==0 then return end for h1=f1,#d1 do io.write(d1[h1].."\n")end end local function k(f1)if f1.readAll then local g1=f1.readAll()or""io.write((y==0)and""or g1:sub(-y))return end local d1={}while true do local e1=f1.readLine()if e1==nil then break end d1[#d1+1]=e1 end local h1=table.concat(d1,"\n")io.write((y==0)and""or h1:sub(-y))end local function t(d1)if v=="bytes"then k(d1)else l(d1)end end for b1,w in ipairs(b)do if w=="-"then m("-")local q=io.stdin()if q then t(q)end else local c1=r(w)local a1,z=fs.open(c1,"r")if not a1 then d("tail: "..c1..": "..u(z).."\n")return 1 end m(w)t(a1)a1.close()end end