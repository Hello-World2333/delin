local d1=args or{}local l1=(type(cwd)=="string"and cwd)or"/"local function c1(v1)v1=v1 or""if v1==""then return(l1=="/")and"/"or l1 end if v1:sub(1,1)=="/"then if v1=="/"then return"/"end return v1:gsub("/+$","")end local u1=(l1=="/")and""or l1 return(u1.."/"..v1):gsub("/+","/")end local function b(v1)local u1=io.stderr()if u1 and u1.write then u1:write(v1)end end local function h1(u1)if u1 and(u1:find("permission")or u1:find("denied"))then return"Permission denied"end if u1 and u1:lower():find("no such file")then return"No such file or directory"end if u1 and u1:find("directory")then return"Is a directory"end return"No such file or directory"end local z="xx"local g=2 local k1,a1,f1=false,false,false local a={}local o=false local p1=1 while p1<=#d1 do local u=d1[p1]if o then a[#a+1]=u elseif u=="--"then o=true elseif u=="-k"or u=="--keep-files"then k1=true elseif u=="-s"or u=="-q"or u=="--quiet"or u=="--silent"then a1=true elseif u=="-z"or u=="--elide-empty-files"then f1=true elseif u:match("^%-%-prefix=")then z=u:sub(10)elseif u:match("^%-%-digits=")then g=tonumber(u:sub(10))if not g or g<1 then b("csplit: invalid number: '"..u:sub(10).."'\n");return 1 end elseif u:sub(1,1)=="-"and u~="-"and u:sub(1,2)~="--"then local m1=2 while m1<=#u do local e1=u:sub(m1,m1)if e1=="k"then k1=true;m1=m1+1 elseif e1=="s"or e1=="q"then a1=true;m1=m1+1 elseif e1=="z"then f1=true;m1=m1+1 elseif e1=="f"or e1=="n"then local j1=u:sub(m1+1)if j1==""then p1=p1+1 if not d1[p1]then b("csplit: option requires an argument -- '"..e1.."'\n");return 1 end j1=d1[p1]end if e1=="f"then z=j1 else g=tonumber(j1)if not g or g<1 then b("csplit: invalid number: '"..j1.."'\n");return 1 end end m1=#u+1 else b("csplit: invalid option -- '"..e1.."'\n")return 1 end end elseif u:sub(1,2)=="--"then b("csplit: unrecognized option '"..u.."'\n")return 1 else a[#a+1]=u end p1=p1+1 end if#a<1 then b("csplit: missing operand\n")return 1 end local l=a[1]if#a<2 then b("csplit: missing operand after '"..l.."'\n")return 1 end local o1 if l=="-"then o1=io.stdin()if not o1 then b("csplit: 无法读取 stdin\n");return 1 end else local n1 o1,n1=fs.open(c1(l),"r")if not o1 then b("csplit: cannot open '"..l.."' for reading: "..h1(n1).."\n")return 1 end end local j=""do local w={}if o1.readAll then w[1]=o1.readAll()or""else while true do local s1=o1.readLine()if s1==nil then break end w[#w+1]=s1.."\n"end end j=table.concat(w)end if l~="-"then o1:close()end local h={}do local i1=1 while i1<=#j do local q1=j:find("\n",i1,true)if not q1 then h[#h+1]=j:sub(i1);break end h[#h+1]=j:sub(i1,q1)i1=q1+1 end end local s={}local n=0 local function b1()if k1 then return end for v1,u1 in ipairs(s)do fs.delete(u1)end end local function g1(u1)b1()b(u1)return 1 end local function e(y1,a2)local u1={}for b2=y1,a2 do u1[#u1+1]=h[b2]end local w1=table.concat(u1)if#w1==0 and f1 then return true end local v1=z..string.format("%0"..g.."d",n)n=n+1 local x1,z1=fs.open(c1(v1),"w")if not x1 then b1()b("csplit: "..v1..": "..h1(z1).."\n")return false end x1:write(w1)x1:close()s[#s+1]=v1 if not a1 then io.write(#w1.."\n")end return true end local function y(arg)local w1=arg:match("^/(.*)/$")if w1 then return{kind="re",pat=w1,offset=0}end local u1,v1=arg:match("^/(.*)/([%+%-]%d+)$")if u1 then return{kind="re",pat=u1,offset=tonumber(v1)}end if arg:match("^/")then b("csplit: '"..arg.."': integer expected after delimiter\n")return nil end local x1=tonumber(arg)if x1 then if x1<0 then b("csplit: "..arg..": line number must be greater than zero\n");return nil end if x1==0 then b("csplit: "..arg..": line number must be greater than zero\n");return nil end return{kind="line",num=x1}end b("csplit: '"..arg.."': invalid pattern\n")return nil end local m=1 local k=#h local f=2 while f<=#a do local p=y(a[f])if not p then return g1("")end local i,t=false,0 local d=f+1 if d<=#a then local t1=a[d]:match("^{(%d+)}$")if a[d]=="{*}"then i=true;d=d+1 elseif t1 then t=tonumber(t1);d=d+1 end end local r=m local x=1 if i then x=math.huge elseif t>0 then x=t+1 end for q=1,x do local c if p.kind=="line"then if q==1 then c=p.num else c=m+p.num end else local v=nil for r1=r,k do if h[r1]:sub(1,-2):match(p.pat)or h[r1]:match(p.pat)then v=r1;break end end if not v then if i and q>1 then break end if i then break end if q>1 then return g1("csplit: '"..a[f].."': match not found on repetition "..(q-1).."\n")end return g1("csplit: '"..a[f].."': match not found\n")end r=v+1 c=v+p.offset if c<m then c=m end end if p.kind=="line"and c>k then if not e(m,k)then return 1 end return g1("csplit: '"..a[f].."': line number out of range\n")end if c>k then if not e(m,k)then return 1 end m=k+1 break end if not e(m,c-1)then return 1 end m=c if p.kind=="line"and q==x then break end end f=d end if not e(m,k)then return 1 end