--@name tom
--@version 0.1.0
--@description Tom's Peripherals GPU display driver (unified 0-based ScreenDevice).
--@deps
return{init=function(e,g)local f=g local a=peripheral.wrap(f)a.refreshSize()if sleep and type(sleep)=="function"then pcall(sleep,0)end a.setSize(64)local c,d,k,j,i=a.getSize()e.log("tom: refreshSize+getSize -> "..tostring(c).."x"..tostring(d).." px "..tostring(k).."x"..tostring(j).." blk res "..tostring(i))if not c or c==0 then e.log("tom: NO monitor detected by GPU (0 blocks). Is a Tom's Monitor arranged to the GPU's right/up?")return end local b=i or 64 local h={id="tom:"..f,type="gpu",mode="pixel",cellW=6,cellH=8,name=f,device=a,width=c,height=d,getSize=function()return c,d end,getTextWidth=function(l)return a.getTextLength(l)end,blit=function(o,p,l,n,m)a.drawText(o+1,p+1,l,n or-1,m or-1)end,text=function(o,p,n,m,l)a.drawText(o+1,p+1,n,m or-1,l or-1)end,fill=function(l)pcall(a.fill,l or-1)end,rect=function(o,p,n,m,l)pcall(a.filledRectangle,math.max(o+1,1),math.max(p+1,1),n,m,l)end,setPixel=function(m,n,l)pcall(a.filledRectangle,m+1,n+1,1,1,l)end,flush=function()if a.sync then pcall(a.sync)end end,release=function()end,listConfig=function()return{"resolution"}end,getConfig=function(l)if l=="resolution"then return tostring(b)elseif l=="size"then return c.."x"..d end return nil end,setConfig=function(l,m)if l~="resolution"then return nil,"read-only or unknown config: "..tostring(l)end local p=tonumber((m or""):match("^%s*(.-)%s*$"))if not p or p<16 or p>64 then return nil,"bad resolution (expected 16-64)"end b=p local r,o=pcall(a.setSize,p)if not r then return nil,"setSize failed: "..tostring(o)end local n,q=a.getSize()if n and n>0 then c,d=n,q end return true end,}e.registerDisplay(h)e.log("tom: display '"..h.id.."' registered ("..c.."x"..d..")")end,}